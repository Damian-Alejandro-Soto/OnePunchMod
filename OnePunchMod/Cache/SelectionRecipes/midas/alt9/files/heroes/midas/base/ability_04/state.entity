<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Midas_Ability4"

	icon="/heroes/midas/alt9/ability_04/icon.dds"
	passiveeffect="/heroes/midas/alt9/ability_04/effects/gold.effect"
	
	stunned="true"
	revealed="true"
	immobilized="true"
	disarmed="true"
	frozen="true"
	
	effecttype="StatusDisable"
	allowtransfer="true"

	negativeeffect="stunned"
	dynamicprecache="effects/sound_hero.effect,effects/sound.effect"
>
	<onimpact/>
	
	<oninflict>
		<!-- Damage -->
		<hasmodifier entity="source_entity" name="Midas1">
			<damage effecttype="Magic" amount="100" />
		</hasmodifier>
		<else>
			<hasmodifier entity="source_entity" name="Midas2">
				<damage effecttype="Magic" amount="175" />
			</hasmodifier>
			<else>
				<damage effecttype="Magic" amount="250" />
			</else>
		</else>

		<!-- SFX -->
		<targettype type="hero">
			<hasmodifier entity="source_entity" name="Midas1">
				<givegold amount="15" target="source_entity" />
			</hasmodifier>
			<else>
				<hasmodifier entity="source_entity" name="Midas2">
					<givegold amount="30" target="source_entity" />
				</hasmodifier>
				<else>
					<givegold amount="45" target="source_entity" />
				</else>
			</else>

			<setstr0 a="altavatar_path" b="effects/sound_hero.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/sound_hero.effect" source="target_entity" target="target_entity" />
			</else>
		</targettype>
		<else>
			<setstr0 a="altavatar_path" b="effects/sound.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/sound.effect" source="target_entity" target="target_entity" />
			</else>
		</else>
	</oninflict>

	<onframe>
		<dispel target="this_owner_entity" type="Transfigure" />
	</onframe>

	<onattackedpreimpact />
	
	<onexpired>
		<playanim name="idle" target="this_owner_entity" />
	</onexpired>
</state>
