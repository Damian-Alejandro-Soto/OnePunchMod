<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Berzerker3"

	statuseffecttooltip="State_Berzerker_Ability3"
	statuseffectheader="true"
	icon="/heroes/berzerker/alt8/ability_02/icon.dds"
	
	anim=""

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="no_target"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nonaggressive="true"
	
	casttime="0"
	castactiontime="0"
	casteffect="effects/cast.effect"
	
	targetradius="600"
	
	manacost="50"
	cooldowntime="15000"
	dynamicprecache="effects/impact.effect"
>
	<onactivatestart>
		<!-- This event fires for every tool the owner activates. -->
		<entitytype type="Ability_Berzerker3" target="inflictor_entity">
			<applystate name="State_Berzerker_Ability3_CastAnim" target="source_entity" duration="320" />
		</entitytype>
	</onactivatestart>

	<onimpact>
		<applystate name="State_Berzerker_Ability3" target="source_entity" duration="1600,2600,3600,4600" />
		
		<areaofeffect
			radius="600"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype=""
			maximpactspertarget="1"
		>
			<targettype type="hero" />
			<else>
				<damage effecttype="Magic" amount="100,150,200,250" />
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" target="source_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="source_entity" />
				</else>
			</else>
		</areaofeffect>
	</onimpact>
</ability>
