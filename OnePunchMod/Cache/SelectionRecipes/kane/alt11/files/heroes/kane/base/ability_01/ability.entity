<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Kane1"

	icon="/heroes/kane/alt11/ability_01/icon.dds"
	anim="ability_1"
	casttime="800"
	castactiontime="150"
	casteffect=""
	passiveeffect=""
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	statuseffecttooltip=""

	actiontype="target_position"
	casteffecttype="Physical Push"	
	targetscheme="enemy_nonboss_units"
	
	manacost="90,100,110,120"
	cooldowntime="16000,14000,12000,10000"
	novoiceresponse="true"
	
	range="440"
	forcerange="440"
	targetradius="110"

	allowoutofboundscast="true"

	showlinecast="true"
	linecastrange="550"
	linecastwidth="110"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/impact.effect,effects/affector.effect,effects/state_kinesis.effect"
>
	<onimpact>
		<setpos0 entity="source_entity" offset="0 110 0" offsetspace="source_entity" />
		<getrange />
		<evaluate a="result" b="110" op="sub" />
		<setpos1 position="pos0" positionend="target_position" positionmodifier="pointonline" positionvalue="result" />
		
		<!-- Get level of E state -->
		<pushtool name="Ability_Kane3" />
		<setvar0 a="source_level" source="stack_entity" />
		
		<lineofeffect
			start="pos0"
			end="pos1"
			radius="110"
			targetselection="all"
			targetscheme="enemy_nonboss_units"
			effecttype="Physical"
		>
			<unbind target="target_entity" />
			<applystate name="State_Kane_Ability1_Initial" target="target_entity" duration="100" />
			
			<!-- E state application -->
			<cantarget targetscheme="enemy_units_and_structures_and_noboss">
				<compare a="var0" b="0" op="gt">
					<applystate name="State_Kane_Ability3" duration="4000" pushentity="true" statelevel="var0" source="source_entity" owner="source_entity" target="target_entity" />
					<addcharges entity="stack_entity" count="1" />
				</compare>
			</cantarget>
			
			<!-- Damage -->
			<damage effecttype="Physical" amount="110,185,260,335" />

			<!-- Art -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="source_entity" />
			</else>
		</lineofeffect>
		
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/affector.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="pos0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/affector.effect" target="pos0" source="source_entity" />
		</else>
		<applystate name="State_Kane_Ability1_Self" duration="300" target="source_entity" proxy="stack_entity" />
		
		<!-- Kinesis Thoughtsteal accommodation ( removed atm but will keep this if it comes back ) -->
		<entitytype type="Hero_Kinesis" target="source_entity">
			<setstr0 a="altavatar_path" b="effects/state_kinesis.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="pos0" source="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/state_kinesis.effect" target="pos0" source="source_entity" />
			</else>
		</entitytype>		
	</onimpact>
	
	<modifier key="alt_JadeSpire" modpriority="100"
		anim="ability_1_boost"
	/>
	
	<modifier key="Kane_Offense_Stance"
		anim="ability_1"
	/>
	
	<modifier key="Kane_Defense_Stance"
		anim="ability_defense_1"
	/>
</ability>