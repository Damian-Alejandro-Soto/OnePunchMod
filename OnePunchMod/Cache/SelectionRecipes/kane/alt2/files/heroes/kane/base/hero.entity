	confirmmovesound="/heroes/kane/alt2/sounds/voice/move_%.wav"
	confirmattacksound="/heroes/kane/alt2/sounds/voice/attack_%.wav"
	nomanasound="/heroes/kane/alt2/sounds/voice/no_mana.wav"
	cooldownsound="/heroes/kane/alt2/sounds/voice/cooldown.wav"
	announcersound="sounds/voice/hero_select.wav"
	tauntedsound="/heroes/kane/alt2/sounds/voice/taunt_prior.wav"
	tauntkillsound="/heroes/kane/alt2/sounds/voice/taunt_after.wav"
	
	infoheight="190"
