<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Pharaoh3"

	
	
	icon="../../icon.dds"
	
	anim="ability_3"
	casttime="1000"
	castactiontime="300"
	casteffect="/heroes/mumra/alt7/ability_03/effects/cast.effect"
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetradius="600"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	targetscheme="enemy_units"
	casteffecttype="Magic"
	
	manacost="50"
	cooldowntime="24000,21000,18000,15000"
	range="99999"
	dontshowhovercast="true"
	
	showrangeandradiusintooltip="true"
>
	<onimpact>
		<spawnunit name="Gadget_Pharaoh_Ability3_SoulReveal" count="1" target="source_position" pushentity="true" />
		<spawnprojectile name="Projectile_Pharaoh_Ability_03_Soul" source="source_entity" target="target_position" bind="stack_entity" proxy="stack_entity" />
	</onimpact>	
</ability>
