<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Succubus2"

	
	
	icon="../../icon.dds"
	
	anim="ability_2"
	casttime="1000"
	castactiontime="500"
	impacteffect="/heroes/succubis/alt7/ability_02/effects/impact.effect"
	casteffect="/heroes/succubis/alt7/ability_02/effects/impact_self.effect"
	dynamicprecache="effects/impact.effect"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="enemy_units"
	casteffecttype="Magic"
	
	manacost="90,110,130,150"
	cooldowntime="15000,14000,13000,12000"
	novoiceresponse="true"
	
	range="625"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

>
	<onimpact >
		<damage effecttype="" amount="75,150,225,300" />
		<heal target="source_entity" a="75,150,225,300" />

		<!-- Preserve the enemy as the impact effect's source while exposing Succubus as its target. -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="source_entity" />
		</else>
	</onimpact>
</ability>
