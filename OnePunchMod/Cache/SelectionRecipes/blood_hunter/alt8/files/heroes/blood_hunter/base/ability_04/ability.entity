		<pausevoiceovers duration="3000" />
		<delayannouncer duration="3000" source="target_entity" sourceonly="true" />
		<spawnunit name="Gadget_BloodHunter_Ability4" count="1" target="target_position" pushentity="true" />
		<applystate name="State_BloodHunter_Ability4" duration="5000,7000,9000" proxy="stack_entity" />
		<damage effecttype="SuperiorMagic" amount="250,375,500" />
		<clientuitrigger name="bh_ult" entity="target_entity" />
	</onimpact>

	<modifier key="ult_boost" modpriority="100"
		displayname="true"
		targetradius="325"
		targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	>
		<onimpact>
			<areaofeffect
				targetscheme="enemy_units"
				effecttype="SuperiorMagic"
				targetselection="all"
				radius="325"
				maxtotalimpacts=""
				maximpactspertarget="1"
			>
				<spawnunit name="Gadget_BloodHunter_Ability4" count="1" target="target_position" pushentity="true" />
				<applystate name="State_BloodHunter_Ability4" duration="5000,7000,9000" proxy="stack_entity" />
				<damage effecttype="SuperiorMagic" amount="250,375,500" />
			</areaofeffect>
		</onimpact>
	</modifier>
</ability>
