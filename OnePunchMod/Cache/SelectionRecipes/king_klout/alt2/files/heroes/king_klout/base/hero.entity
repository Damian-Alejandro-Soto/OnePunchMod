	<onspawn>
		<activatemodifierkey name="Klout_Sound" />
		<chance threshold="0.50">
			<pausevoiceovers duration="6135" />
			<setstr0 a="altavatar_path" b="sounds/interactions/spawn.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="sounds/interactions/spawn.effect" source="source_entity" />
			</else>
		</chance>
	</onspawn>

	<onlevelup>
		<compare a="level" b="6" op="ge">
			<setstr0 a="altavatar_path" b="sounds/interactions/levelup.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="sounds/interactions/levelup.effect" source="source_entity" />
			</else>
		</compare>
	</onlevelup>

	<modifier key="ult_boost" modpriority="101"
    >
        <aura state="State_KingKlout_Ult_Boost" radius="0" targetscheme="self" />
    </modifier>
