<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Vindicator_Ability4"
	
	icon="/heroes/vindicator/alt9/ability_04/icon.dds"
	passiveeffect="effects/state_slow.effect"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	
	silenced="true"
	perplexed="false"
	
	movespeedslow="0.40"
	negativeeffect="silenced"
>
	<onframe>
		<compare a="lifetime_remaining" b="accumulator" op="le">
			<setactivemodifierkey name="Vind_R_NoSlow" />
		</compare>
		<else>
			<setactivemodifierkey name="" />
		</else>
	</onframe>
	
	<modifier key="Vind_R_NoSlow" modpriority="100"
		movespeedslow="0.0"
		passiveeffect="effects/state.effect"
	>
	</modifier>
</state>
