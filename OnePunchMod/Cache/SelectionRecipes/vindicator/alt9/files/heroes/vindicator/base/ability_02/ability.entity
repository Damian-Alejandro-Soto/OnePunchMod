<?xml version="1.0" encoding="UTF-8"?>
<abilityattribute
	name="Ability_Vindicator2"

	icon="/heroes/vindicator/alt9/ability_02/icon.dds"

	casttime="851"
	castactiontime="300"
	
	maxlevel="5"
	requiredlevel="1,1,3,5,7"
	baselevel="1"
	disabled="true,false"
	
	cooldowntime="0"

	activatescheme="canattack"
	actiontype="attack"
	targetscheme="enemy_units"
	casteffecttype="Attack"
	projectile="Projectile_Vindicator_Ability2"
	
	manacost="7"
	casteffect="/heroes/vindicator/alt9/ability_02/effects/cast.effect"
	
	doubleactivate="true"

>	
	<aura state="State_Vindicator_Ability2" radius="925" targetscheme="nonillusion_enemy_heroes" stack="true" notooltip="true" propagatecondition="not_illusion" />
	
	<onaction>
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/cast_impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast_impact.effect" source="source_entity" target="" />
		</else>
	</onaction>
	
	<onattack>
		<!-- Required to allow the skill to stack with Attack Modifiers -->
		<setvalue name="combat_attackability" a="0" />
	</onattack>
	
	<onimpact>
		<!-- True Damage bonus multiplier & Mana Drain-->
		<targettype type="silenced">
			<setaccumulator value="1.5" />
			<compare a="target_mana" b="0" op="gt">
				<takemana amount="25,30,35,40" />
				<popup name="manaburn" source="target_entity" target="source_entity" a="result" b="1" op="div" />
			</compare>
		</targettype>
		<else>
			<setaccumulator value="1" />
		</else>
		
		<setvar0 a="0,0.26,0.37,0.48,0.59" b="source_intelligence" op="mult" />
		<setvar0 a="var0" b="accumulator" op="mult" />
		<setvar0 a="var0" op="ceil" />
		<damage effecttype="" amount="1" b="var0" op="mult" />
		<popup name="execution" a="var0" source="target_entity" target="source_entity" />
	</onimpact>
	
	<onkill propagatetoillusions="false" >
		<targettype type="hero">
			<targettype type="illusion" />
			<else> 
				<targettype type="mimic" />
				<else> 
					<targettype type="self" />
					<else>
						<targettype type="heropet" />
						<else>
							<adjustintelligence value="1" />
							<addcharges count="1" />
						</else>
					</else>
				</else>
			</else>
		</targettype>
	</onkill>

	<modifier key="ult_boost" modpriority="150"
		attackspeed="0.8"
	>
		<onimpact>
			<!-- True Damage bonus multiplier -->
			<targettype type="silenced">
				<setaccumulator value="2" />
				<compare a="target_mana" b="0" op="gt">
					<takemana amount="25,30,35,40" />
					<popup name="manaburn" source="target_entity" target="source_entity" a="result" b="1" op="div" />
				</compare>
			</targettype>
			<else>
				<setaccumulator value="1" />
			</else>
			
			<setvar0 a="0,0.33,0.44,0.55,0.66" b="source_intelligence" op="mult" />
			<setvar0 a="var0" b="accumulator" op="mult" />
			<setvar0 a="var0" op="ceil" />
			<damage effecttype="" amount="1" b="var0" op="mult" />
			<popup name="execution" a="var0" source="target_entity" target="source_entity" />
		</onimpact>
	</modifier>	
</abilityattribute>