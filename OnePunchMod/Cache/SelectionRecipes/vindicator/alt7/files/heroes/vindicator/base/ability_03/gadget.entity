<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_Vindicator_Ability3"

	icon="../../icon.dds"
	portrait=""
	model="/heroes/vindicator/alt7/ability_03/effects/pedestal/model.mdf"
	skin=""
	
	passiveeffect="/heroes/vindicator/alt7/ability_03/effects/pedestal.effect"
	spawneffect=""

	infoheight="200"
	preglobalscale="1.6"
	modelscale="1.0"
	effectscale="1.0"
	boundsheight="64"
	boundsradius="16"
	selectionradius="48"
	targetoffset="0 0 64"

	unitwalking="true"
	nothreat="true"
	
	invulnerable="false"
	isselectable="true"
	iscontrollable="false"
	ismobile="false"
	canrotate="false"
	movespeed="100"
	turnrate="900"
	turnsmoothing=".3"

	maxhealth="2"
	healthregen="0"
	maxmana="0"
	manaregen="0"
	armor="0"
	magicarmor="0"
	immunity="GadgetImmunity"

	canattack="false"
	
	attacktype="none"
	combattype="Ranged"

	sightrangeday="100"
	sightrangenight="100"

	experiencebounty="10"
	
	goldbountymin="10"
	goldbountymax="10"
	
	drawonmap="false"
	lifetime="5000"
	showlifetime="true"
	
	unittype="PseudoPet"
	
	corpsetime="5000"
	corpsefadetime="5000"
	corpsefadeeffect="/shared/effects/corpse_sinkfast.effect"
	dynamicprecache="effects/pedestal/death.effect"
>
	<aura state="State_Vindicator_Ability3_Aura" radius="300" targetscheme="enemy_units" effecttype="Magic" duration="500" />
	
	<onspawn>
		<spawnaffector name="Affector_Vindicator_Ability3" target="this_entity" />
		<playanim name="spawn" />
	</onspawn>
	
	<onattackedpreimpact>
		<setvalue name="combat_truestrike" a="1" />
	</onattackedpreimpact>
	
	<ondamaged>
		<changedamage b="1" op="min"/>
	</ondamaged>	
	
	<ondeath>
		<setstr0 a="altavatar_path" b="effects/pedestal/death.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_entity" target="this_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/pedestal/death.effect" source="this_entity" target="this_entity" />
		</else>
	</ondeath>
</gadget>
