<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Solstice3"

	icon="../../icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	maxcharges="3"
	
	actiontype="no_target"
	casteffect="effects/cast.effect"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"
	cooldowntime="45000"
	
	dynamicprecache="/heroes/solstice/alt10/ability_03/effects/day_impact.effect,/heroes/solstice/alt10/ability_03/effects/night_impact.effect"
>
	<onlearn>
		<setcharges a="3" />
	</onlearn>
	
	<onattackstart>
		<compare a="charges" b="1" op="eq">
			<playanim name="ability_3" speed="source_attackspeed" target="source_entity" />
		</compare>
	</onattackstart>
	
	<onattack>
		<hasmodifier name="Day_Solstice">
			<!-- Day mode logic -->
			<hasmodifier name="ult_boost" entity="source_entity">
				<setaccumulator value="75,95,120,145" /> <!-- Damage with Staff -->
			</hasmodifier>
			<else>
				<setaccumulator value="55,75,100,125" /> <!-- Damage without Staff -->
			</else>
			
			<cantarget targetscheme="enemy_units">
				<removecharge />
				<compare a="charges" b="0" op="eq">
					<addattackpreimpactactions>
						<cantarget targetscheme="enemy_heroes">
							<setvar0 a="accumulator" />
							
							<bonusdamageadd target="" a="var0"  /> <!-- Add bonus damage to your attack -->
							<setvar0 a="var0" b="source_attackdamage" op="add" /> <!-- Calculate damage specifically for lifesteal -->
							<calculatedamage amount="var0" effecttype="Physical" />
							<setvar1 a="result" />
							<hasmodifier name="ult_boost" entity="source_entity">
								<heal target="source_entity" a="var1" b="0.25,0.3,0.35,0.4" op="mult" />
							</hasmodifier>
							<else>
								<heal target="source_entity" a="var1" b="0.10,0.15,0.20,0.25" op="mult" />
							</else>
							<spawnaffector name="Affector_Solstice_Ability3" source="source_entity" target="source_entity" level="level" ignore="target_entity" />
						</cantarget>
						<else>
							<setvar0 a="accumulator" b="2.2" op="mult" /> <!-- Bonus damage multiplier vs. creeps -->
							
							<bonusdamageadd target="" a="var0" />
							<setvar0 a="var0" b="source_attackdamage" op="add" />
							<calculatedamage amount="var0" effecttype="Physical" />
							<setvar1 a="result" />
							<hasmodifier name="ult_boost" entity="source_entity">
								<heal target="source_entity" a="var1" b="0.25,0.3,0.35,0.4" op="mult" />
							</hasmodifier>
							<else>
								<heal target="source_entity" a="var1" b="0.10,0.15,0.20,0.25" op="mult" />
							</else>
							<spawnaffector name="Affector_Solstice_Ability3" source="source_entity" target="source_entity" level="level" proxy="target_entity" ignore="target_entity" />
						</else>
					</addattackpreimpactactions>
					
					<!-- Charge reset mechanism -->
					<setcharges a="3" />
					
					<!-- VFX -->
						<setstr0 a="altavatar_path" b="effects/day_impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/day_impact.effect" source="target_entity" occlude="true" />
		</else>
				</compare>
			</cantarget>
		</hasmodifier>
		<else>
			<!-- Night mode logic -->
			<hasmodifier name="ult_boost" entity="source_entity">
				<evaluate a="0.05" b="target_maxhealth" op="mult" />
				<evaluate a="80,115,150,185" b="result" op="add" />
				<setaccumulator value="result" /> <!-- Damage with Staff -->
			</hasmodifier>
			<else>
				<setaccumulator value="80,115,150,185" /> <!-- Damage without Staff -->
			</else>
			
			<cantarget targetscheme="enemy_units">
				<removecharge />
				<compare a="charges" b="0" op="eq">
					<addattackpreimpactactions>
						<setvar0 a="accumulator" />
						
						<bonusdamageadd target="" a="var0" />
						<setvar0 a="var0" b="source_attackdamage" op="add" />
						<calculatedamage amount="var0" effecttype="Physical" />
						<heal target="source_entity" a="result" b="0.10,0.15,0.20,0.25" op="mult" />					
					</addattackpreimpactactions>
					
					<!-- Charge reset mechanism -->
					<setcharges a="3" />
					
					<!-- VFX -->
						<setstr0 a="altavatar_path" b="effects/night_impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/night_impact.effect" source="target_entity" occlude="true" />
		</else>
				</compare>
			</cantarget>
		</else>
	</onattack>
	
	<modifier key="ult_boost" modpriority="99">
		<onimpact>
			<applystate name="State_Solstice_NightFX" target="this_owner_entity" continuous="true" />
			<expirestate name="State_Solstice_DayFX" target="this_owner_entity" />
			<setactivemodifierkey name="Night_Solstice_Ult" />
		</onimpact>
	</modifier>

	<modifier key="Day_Solstice" modpriority="101"
		icon="../../icon.dds"
		targetradius="250"
	>
		<onframe>
			<hasmodifier name="ult_boost" entity="source_entity">
				<setactivemodifierkey name="Day_Solstice_Ult" />
			</hasmodifier>
			<else>
				<setactivemodifierkey name="" />
			</else>
		</onframe>
		
		<onimpact>
			<applystate name="State_Solstice_NightFX" target="this_owner_entity" continuous="true" />
			<expirestate name="State_Solstice_DayFX" target="this_owner_entity" />
			<setactivemodifierkey name="Night_Solstice" />
		</onimpact>
	</modifier>
	
	<modifier key="Night_Solstice" modpriority="101"
		icon="icon_b.tga"
	>
		<onframe>
			<hasmodifier name="ult_boost" entity="source_entity">
				<setactivemodifierkey name="Night_Solstice_Ult" />
			</hasmodifier>
			<else>
				<setactivemodifierkey name="" />
			</else>
		</onframe>

		<onimpact>
			<applystate name="State_Solstice_DayFX" target="this_owner_entity" continuous="true" />
			<expirestate name="State_Solstice_NightFX" target="this_owner_entity" />
			<setactivemodifierkey name="Day_Solstice" />
		</onimpact>
	</modifier>
	
	<!-- Below 2 modifiers are required to make the text work on ability descriptions when the sotm is active -->
	
	<modifier key="Day_Solstice_Ult" modpriority="110"
		cooldowntime="0"
	>
		<onframe>
			<hasmodifier name="ult_boost" entity="source_entity" />
			<else>
				<setactivemodifierkey name="Day_Solstice" />
			</else>
		</onframe>
		
		<onimpact>
			<applystate name="State_Solstice_NightFX" target="this_owner_entity" continuous="true" />
			<expirestate name="State_Solstice_DayFX" target="this_owner_entity" />
			<setactivemodifierkey name="Night_Solstice_Ult" />
		</onimpact>
	</modifier>
	
	<modifier key="Night_Solstice_Ult" modpriority="110"
		cooldowntime="0"
	>
		<onframe>
			<hasmodifier name="ult_boost" entity="source_entity" />
			<else>
				<setactivemodifierkey name="Night_Solstice" />
			</else>
		</onframe>
		
		<onimpact>
			<applystate name="State_Solstice_DayFX" target="this_owner_entity" continuous="true" />
			<expirestate name="State_Solstice_NightFX" target="this_owner_entity" />
			<setactivemodifierkey name="Day_Solstice_Ult" />
		</onimpact>
	</modifier>
</ability>