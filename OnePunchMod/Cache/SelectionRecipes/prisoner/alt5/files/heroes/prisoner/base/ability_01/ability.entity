<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Prisoner1"

	icon="/heroes/prisoner/alt5/ability_01/icon.dds"	
	anim="ability_1"
	casttime="1000"
	castactiontime="300"
	casteffect=""
	passiveeffect=""
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	statuseffecttooltip=""

	actiontype="target_position"
	casteffecttype="Physical Push"
	
	targetscheme="enemy_nonboss_units"
	
	manacost="110,120,130,140"
	cooldowntime="14000"
	novoiceresponse="true"
	
	range="1000"
	forcerange="1000"
	targetradius="100"
	
	showlinecast="true"
	linecastrange="1045"
	linecastwidth="100"
	
	allowoutofboundscast="true"
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/link.effect,effects/link_return.effect,effects/return_sound.effect,effects/return_character_sound.effect"
>
	<onabilityimpact>
		<applystate name="State_Prisoner_Ability1_Data" duration="2000" target="source_entity" />
	</onabilityimpact>
	
	<onimpact>
		<spawnprojectile 
			name="Projectile_Prisoner_Ability1" 
			source="source_entity"
			target="target_position" 
			offset="80 0 125" 
			bind="stack_entity"
			proxy="stack_entity" 
			unbindondeath="true" 
			pushentity="true"
		/>
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/link.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="stack_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/link.effect" source="stack_entity" target="source_entity" />
		</else>
	</onimpact>

	<onready>
		<expirestate name="State_Prisoner_Bonus_Ability3" target="source_entity" />
	</onready>
</ability>
