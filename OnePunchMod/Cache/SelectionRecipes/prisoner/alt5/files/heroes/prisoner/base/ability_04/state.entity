<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Prisoner_Ability4"

	icon="/heroes/prisoner/alt5/ability_04/icon.dds"

	effecttype=""
	
	impactinterval="2500"
	passiveeffect="/heroes/prisoner/alt5/ability_04/effects/link.effect"
	dynamicprecache="effects/chain_pull.effect"
>
	<oninflict>
		<hasmodifier name="ult_boost">
			<setaccumulator value="700" />
		</hasmodifier>
		<else>
			<setaccumulator value="600" />
		</else>
	</oninflict>
	
	<onframe>
		<distance />
		<compare a="result" b="accumulator" op="gt">
			<expire />
			
			<!-- expire state from prisoner if this is the last link -->
			<areaofeffect
				center="this_inflictor_entity"
				radius="accumulator"
				targetselection="all"
				targetscheme="enemy_heroes"
				effecttype="Physical"
			/>
			<compare a="result" b="0" op="le" >
				<expirestate name="State_Prisoner_Ability4_Self" target="this_inflictor_entity" />
			</compare>
		</compare>
	</onframe>
	
	<onimpact>
		<spawnaffector name="Affector_Prisoner_Ability4" source="this_owner_entity" />
		
		<!-- Physical type check for state's auxiliary effects -->
		<cantarget effecttype="Physical">
			<applystate name="State_Stunned" duration="1500,2000,2500" />
			
			<!-- Push check -->
			<cantarget effecttype="Push">
				<distance />
				<!-- Subtracting 25 from distance so it will end up 25 units away from Prisoner 945 rather than colliding -->
				<evaluate a="result" b="25" op="sub" />
				<evaluate a="result" b="400" op="min" />
				<setvar0 a="result" b="-4" op="mult" />
				
				<!-- Check to see if the force is positive; if yes, then static pull force -->
				<compare a="var0" b="0" op="ge">
					<push force="-100" duration="250" />
				</compare>
				<else>
					<push force="var0" duration="250" />
				</else>
			</cantarget>
			
			<damage effecttype="Physical" amount="200,300,400" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/chain_pull.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/chain_pull.effect" source="target_entity" target="" occlude="true" />
			</else>
		</cantarget>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100" />
</state>