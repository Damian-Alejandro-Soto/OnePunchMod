<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Bubbles2"

	icon="../../icon.dds"

	anim="ability_2"
	casttime="600"
	castactiontime="100"

	maxlevel="4"
	requiredlevel="1,3,5,7"
	targetradius="400"

	actiontype="self_position"
	targetscheme="enemy_units"

	casteffecttype="Magic"
	casteffect="/heroes/bubbles/alt15/ability_02/effects/cast.effect"
	manacost="100,110,120,130"
	cooldowntime="18000,16000,14000,12000"

	dynamicprecache="effects/aoe.effect"
>
	<modifier key="bubbles_noshell" modpriority="100"
		anim="noshell_ability_2"
	/>

	<onimpact>
		<areaofeffect
			radius="400"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
		>
			<applystate name="State_Bubbles_Ability2" duration="1500,2000,2500,3000" />
			<damage effecttype="Magic" amount="100,160,220,280" />
		</areaofeffect>

		<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/aoe.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/aoe.effect" source="source_position" target="source_position" occlude="true" />
		</else>
	</onimpact>
</ability>