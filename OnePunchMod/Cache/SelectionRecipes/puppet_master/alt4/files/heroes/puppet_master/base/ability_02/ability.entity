<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_PuppetMaster2"

	statuseffecttooltip="State_PuppetMaster_Ability2_Expire"
	statuseffectheader="true"

	icon="../../icon.dds"
	anim="ability_2"
	casttime="600"
	castactiontime="300"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="enemy_units"
	targetradius="400"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
		
	casteffecttype="Magic"
	casteffect="/heroes/puppetmaster/alt4/ability_02/effects/cast.effect"
	
	manacost="115,130,145,160"
	cooldowntime="20000"
	
	range="700"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"

	targetpriorities="enemy_heroes"
	dynamicprecache="../ability_04/effects/transfer.effect"
>
	<onimpact>
	    <delayannouncer duration="2500" sourceonly="true" />

		<targettype type="PuppetPuppet">
			<pushentity entity="target_entity" />
			<applystate name="State_PuppetMaster_Ability2_Expire" duration="2000,2500,3000,3500" target="stack_proxy_entity" />
			<applystate name="State_PuppetMaster_Ability2_Assist" duration="100" target="stack_proxy_entity" />
			<setproxy entity="this_entity" target="stack_proxy_entity" />
			<setstr0 a="altavatar_path" b="../ability_04/effects/transfer.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="this_proxy_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="../ability_04/effects/transfer.effect" source="target_entity" target="this_proxy_entity" />
			</else>
			<areaofeffect
				radius="400"
				source="this_proxy_entity"
				targetselection="closest"
				targetscheme="other_ally_heroes"
				maxtotalimpacts="1"
				effecttype=""
				center="this_proxy_entity"
				ignoreinvulnerable="false"
			>
				<applystate name="State_PuppetMaster_Ability2" duration="2000,2500,3000,3500" target="this_proxy_entity" proxy="target_entity" />
				<order command="stop" force="true" source="this_proxy_entity" target="target_entity" />
				<order command="attack" force="true" forceduration="2000,2500,3000,3500" source="this_proxy_entity" target="target_entity" />
			</areaofeffect>
			
			<compare a="result" b="0" op="eq">
				<areaofeffect
					radius="400"
					source="this_proxy_entity"
					targetselection="closest"
					targetscheme="other_ally_units_and_gadgets"
					maxtotalimpacts="1"
					effecttype=""
					center="this_proxy_entity"
					ignoreinvulnerable="false"
				>
					<applystate name="State_PuppetMaster_Ability2" duration="2000,2500,3000,3500" target="this_proxy_entity" proxy="target_entity" />
					<order command="stop" force="true" source="this_proxy_entity" target="target_entity" />
					<order command="attack" force="true" forceduration="2000,2500,3000,3500" source="this_proxy_entity" target="target_entity" />
				</areaofeffect>
				
				<compare a="result" b="0" op="eq">
					<spawnaffector name="Affector_PuppetMaster_Ability2" target="this_proxy_entity" firsttarget="" proxy="this_proxy_entity" />
				</compare>
			</compare>
		</targettype>
		<else>
			<applystate name="State_PuppetMaster_Ability2_Expire" duration="2000,2500,3000,3500" />
			<applystate name="State_PuppetMaster_Ability2_Assist" duration="100" />
			<setproxy entity="this_entity" target="target_entity" />
			<areaofeffect
				radius="400"
				source="this_proxy_entity"
				targetselection="closest"
				targetscheme="other_ally_heroes"
				maxtotalimpacts="1"
				effecttype=""
				center="this_proxy_entity"
				ignoreinvulnerable="false"
			>
				<applystate name="State_PuppetMaster_Ability2" duration="2000,2500,3000,3500" target="this_proxy_entity" proxy="target_entity" />
				<order command="stop" force="true" source="this_proxy_entity" target="target_entity" />
				<order command="attack" force="true" forceduration="2000,2500,3000,3500" source="this_proxy_entity" target="target_entity" />
			</areaofeffect>
			
			<compare a="result" b="0" op="eq">
				<areaofeffect
					radius="400"
					source="this_proxy_entity"
					targetselection="closest"
					targetscheme="other_ally_units"
					maxtotalimpacts="1"
					effecttype=""
					center="this_proxy_entity"
					ignoreinvulnerable="false"
				>
					<applystate name="State_PuppetMaster_Ability2" duration="2000,2500,3000,3500" target="this_proxy_entity" proxy="target_entity" />
					<order command="stop" force="true" source="this_proxy_entity" target="target_entity" />
					<order command="attack" force="true" forceduration="2000,2500,3000,3500" source="this_proxy_entity" target="target_entity" />
				</areaofeffect>
				
				<compare a="result" b="0" op="eq">
					<spawnaffector name="Affector_PuppetMaster_Ability2" target="this_proxy_entity" firsttarget="" proxy="this_proxy_entity" />
				</compare>
			</compare>
		</else>
	</onimpact>
</ability>