	<recommendeditem name="Item_WhisperingHelm" />
	<recommendeditem name="Item_Shieldbreaker" />
	<recommendeditem name="Item_SymboloftheRage" />
	<recommendeditem name="Item_ElderParasite" />
	<recommendeditem name="Item_Hypercrown" />
	
	<gooditemagainst name="Item_BarbedArmor" />
	<gooditemagainst name="Item_SpikedBola" />
	
	<modifier key="iamsheeped" modpriority="201"
		passiveeffect=""
	/>
</hero>
