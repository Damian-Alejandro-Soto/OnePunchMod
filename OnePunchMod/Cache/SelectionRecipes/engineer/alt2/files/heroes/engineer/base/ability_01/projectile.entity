<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Engineer_Ability1"

	lifetime="1000"
	useexactlifetime="true"
	gravity="6500"

	model="/heroes/engineer/alt2/ability_01/effects/projectile.mdf"
	modelscale="1.7"
	traileffect="/heroes/engineer/alt2/ability_01/effects/trail.effect"
	impacteffect=""
 dynamicprecache="/heroes/engineer/alt2/ability_01/effects/impact.effect">
	
	<onimpact>
		<spawnaffector name="Affector_Engineer_Ability1" target="target_position" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_position" target="" occlude="true" />
		</else>
	</onimpact>
</projectile>