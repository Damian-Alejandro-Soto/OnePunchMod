<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_EmeraldWarden4_c"

	icon="/heroes/emerald_warden/alt9/ability_04/effects/ability_03/icon.dds"
	
	actiontype="passive"
	maxlevel="3"
	
	cooldowntime="50000"
	
	frontqueue="true"
	noninterrupting="true"
	inheritmovement="true"
	noturntotarget="true"
	nostun="true"
	nosilence="true"
	
	range="400"
	targetradius="500"
	
	noshuffle="true"
>

	<onframe>
		<compare a="source_level" b="3" op="ge" source="this_entity">
			<isready>
				<targettype type="alive" target="source_owner_entity">
					
					<isstealthed entity="source_owner_entity" />	
					<else>
						<hasmodifier name="Gawain_3_Channeling" entity="source_entity" />
						<else>
							<areaofeffect
								radius="400"
								targetscheme="visible_enemy_heroes"
								targetselection="all"
								center="source_owner_entity"
							/>
							<compare a="result" b="2" op="ge">
								<areaofeffect
									radius="400"
									targetscheme="visible_enemy_heroes"
									maxtotalimpacts="1"
									targetselection="closest"
									center="source_owner_entity"
								>
									<startcooldown />
									<popup name="EmeraldWarden3" source="source_owner_entity" target="source_owner_entity" />
									<teleport source="source_entity" target="target_entity" />
									<applystate name="State_EmeraldWardenpet_Ability3_Self" target="source_entity" duration="4000" />
								</areaofeffect>
							</compare>
						</else>
					</else>
				</targettype>
			</isready>
		</compare>
	</onframe>
	
	<modifier key="Gawain_Illusion" modpriority="101" condition="illusion"
	>
		<onframe />
	</modifier>
</ability>
