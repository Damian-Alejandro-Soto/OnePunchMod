<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Pet_EmeraldWarden_Ability2"
	
	speed="600"
	gravity="0"
	flyheight="0"
	flying="true"
	
	effectscale="1"
	modelscale="1.35"
	canturn="true"
	pathing="true"
	
	icon="/heroes/emerald_warden/alt5/ability_02/icon.dds"
	portrait="../../icon.dds"
	model="/heroes/emerald_warden/alt5/ability_02/effects/wolves/model.mdf"
	skin=""
	impactdistance="300"
	
>
	<onimpact>
		<compare a="target_entity" b="0" op="ne">
			<spawnprojectile name="Projectile_EmeraldWarden_Ability2" source="this_entity" bind="this_entity" bindturn="true" target="target_entity" proxy="source_owner_entity" noresponse="true"/>
		</compare>
		<else>
			<setstr0 a="altavatar_path" b="effects/nullimpact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="this_position" source="this_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/nullimpact.effect" target="this_position" source="this_position" occlude="true" />
			</else>
		</else>
	</onimpact>
</projectile>
