<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_EmeraldWardenpet_Ability1"

	speed="1900"
	gravity="0"

	modelscale="1.0"
	model=""
	
	canturn="false"
	flying="true"
	flyheight="200"
	impacteffect="/heroes/emerald_warden/alt4/ability_04/effects/ability_01/impact.effect"

>
	<onimpact>
		<!-- SotM -->
		<pushentity entity="source_entity" />
		<hasmodifier name="ult_boost" entity="stack_proxy_entity">
			<cantarget effecttype="Magic" target="target_entity" source="source_owner_entity">
				<applystate name="State_Stunned" duration="300" target="target_entity" source="source_owner_entity" />
			</cantarget>
		</hasmodifier>
		
		<damage effecttype="Physical" amount="100,200,300" target="target_entity" source="source_owner_entity" />
		<popup name="critical" a="result" source="source_owner_entity" target="source_owner_entity" />
		<order command="follow" source="source_entity" target="source_owner_entity" queue="front" />
		<applystate name="State_EmeraldWardenpet_Ability1_Speed" duration="3000" target="source_entity" />
		<delete target="this_entity" />
	</onimpact>
</projectile>
