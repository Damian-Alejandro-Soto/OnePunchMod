<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_EmeraldWarden4"
	
	icon="/heroes/emerald_warden/alt2/ability_04/effects/ability_01/icon.dds"
	
	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="passive"
	casttime="0"
	castactiontime="0"
	
	modifierkey="gawain"
	
	frontqueue="true"
	noninterrupting="true"
	inheritmovement="true"
	noturntotarget="true"
	nostun="true"
	nosilence="true"
	noresponse="true"
	
	noshuffle="true"
	
	cooldowntime="0"
>
	<onlearn>
		<!-- Bugfix for Deadlift's Resurrection -->
		<targettype type="mimic" target="this_owner_entity">
			<!-- If Circe spawns the mimic with Twisted Visage, then she still spawns Gawain -->
			<entitytype type="Hero_Circe" target="source_owner_entity">
				<targettype type="alive" target="source_entity">
					<spawnunit name="Pet_EmeraldWarden" target="source_position" count="1" offsetspace="source_entity" offset="-50 50" pushentity="true" proxy="source_entity" />
					<order command="follow" source="stack_entity" target="source_entity" queue="front" />
					
					<!-- Use Emerald Warden's 1 ability to store proxy of non-SotM Gawain -->
					<pushtool name="Ability_EmeraldWarden1" />
					<setent0 entity="stack_entity" />
					<popentity />
					<setproxy entity="ent0" target="stack_entity" />
				</targettype>
			</entitytype>
		</targettype>
		<else>
			<targettype type="alive" target="source_entity">
				<spawnunit name="Pet_EmeraldWarden" target="source_position" count="1" offsetspace="source_entity" offset="-50 50" pushentity="true" proxy="source_entity" />
				<order command="follow" source="stack_entity" target="source_entity" queue="front" />
				
				<!-- Use Emerald Warden's 1 ability to store proxy of non-SotM Gawain -->
				<pushtool name="Ability_EmeraldWarden1" />
				<setent0 entity="stack_entity" />
				<popentity />
				<setproxy entity="ent0" target="stack_entity" />
			</targettype>
		</else>
	</onlearn>

	<onupgrade>
		<targettype type="alive" target="source_entity">
			<levelpets name="Pet_EmeraldWarden" value="level" />
		</targettype>
	</onupgrade>
	
	<onrespawn>
		<spawnunit name="Pet_EmeraldWarden" target="source_position" count="1" offsetspace="source_entity" offset="-50 50" pushentity="true" proxy="source_entity" />
		<order command="follow" source="stack_entity" target="source_entity" queue="front" />
		
		<!-- Use Emerald Warden's ability1 to store proxy of non-SotM Gawain -->
		<pushtool name="Ability_EmeraldWarden1" />
		<setent0 entity="stack_entity" />
		<popentity />
		<setproxy entity="ent0" target="stack_entity" />
	</onrespawn>
	
	<onorderdisjointed>
		<!-- Use Emerald Warden's ability1 proxy of non-SotM Gawain -->
		<pushtool name="Ability_EmeraldWarden1" />
		<order command="follow" source="stack_proxy_entity" target="source_entity" queue="front" />
	</onorderdisjointed>

	<modifier key="ult_boost" modpriority="100"
		actiontype="target_entity"
		targetscheme="other_ally_heroes"
		range="900"
		cooldowntime="60000"
		showareacast="true"
		areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	>
		
		<onimpact>
			<kill target="this_proxy_entity" source="" />
			<spawnunit name="Pet_EmeraldWarden" target="target_position" count="1" offsetspace="target_entity" offset="-50 50" pushentity="true" inflictor="target_entity" owner="target_entity" source="target_entity" proxy="source_entity" />
			<order command="follow" source="stack_entity" target="target_entity" queue="front" />
			<setproxy entity="this_entity" target="stack_entity" />
			<applystate name="State_EmeraldWarden_Ability4_Orderdisjoint" target="target_entity" continuous="true" />
		</onimpact>
	</modifier>
</ability>