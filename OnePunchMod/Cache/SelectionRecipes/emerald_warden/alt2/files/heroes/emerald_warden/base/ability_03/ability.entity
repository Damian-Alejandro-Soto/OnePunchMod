<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_EmeraldWarden3"
	icon="/heroes/emerald_warden/alt2/ability_03/icon.dds"
	
	anim="ability_3"
	casttime="1000"
	castactiontime="300"
	casteffect=""
	novoiceresponse="true"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetradius="175"
	targetmaterial="/shared/materials/area_cast_indicator.material"

	targetscheme="visible_enemy_units"
	casteffecttype=""
	
	manacost="60,70,80,90"
	cooldowntime="10000"

	interface="single_plus_one"

	modifierkey="trap1,trap2,trap3,trap4"
	
	range="650"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/cast.effect"
	
>
	<onaction>
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="" occlude="true" />
		</else>
	</onaction>
	
	<onimpact>
		<spawnunit name="Gadget_EmeraldWarden_Ability3" count="1" target="target_position" pushentity="true" maxactive="2,3,4,5" proxy="source_entity" />
		<addcharges count="1" entity="this_entity" />
		<applystate name="State_EmeraldWarden_Ability3_Set" duration="1500" target="stack_entity" />
		<applystate name="State_EmeraldWarden_Ability3_Disabled" duration="500" target="stack_entity" />
		<applystate name="State_EmeraldWarden_Ability3_Disabled" duration="500" target="this_owner_entity" />
	</onimpact>
</ability>