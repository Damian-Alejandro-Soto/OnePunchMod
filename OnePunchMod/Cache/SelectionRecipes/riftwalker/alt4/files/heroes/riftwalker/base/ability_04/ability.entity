<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Riftwalker4"

	icon="/heroes/riftmage/alt4/ability_04/icon.dds"
	
	anim="ability_4"
	casttime="0"
	castactiontime="0"
	channeltime="2000"
	ischanneling="true"
	safechannel="true"
	
	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_position"
	targetradius="400"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	
	casteffecttype="SuperiorMagic"
	casteffect=""
	targetscheme="enemy_units"
	
	manacost="125,175,225"
	cooldowntime="70000,60000,50000"
	
	
	range="1200"
	maxcharges="4"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/impact.effect,effects/explosion.effect,effects/wormhole_top.effect,effects/state_arrive.effect"
>
	<onimpact />
	
	<onchannelstart>
		<applystate name="State_Riftwalker_Ability4_Channel" target="source_entity" ischannel="true" />
		<spawnunit name="Gadget_Riftwalker_Ability4_Art" target="target_position" count="1" fixedposition="true" pushentity="true" />
		<setproxy entity="this_entity" target="stack_entity" />
		<pushtool name="Ability_Riftwalker4a" />
		<startcooldown entity="stack_entity" duration="500" />
		<setcharges a="0" />
	</onchannelstart>
	
	<onchannelbreak>
		<condition test="hasstate State_Riftwalker_Ability4_Channel_Break" target="source_entity" >
			<teleport source="source_entity" target="target_position" interpolate="false" />
			<disjoint target="source_entity" />
			<unbind target="source_entity" />

			<evaluate a="1000,1250,1500" b="4" op="div" /> <!-- Maximum additional duration of stun that can be gained through channeling divided by maximum number of charges possible from channeling -->
			<evaluate a="result" b="charges" op="mult" /> <!-- Bonus duration is set to an amount depending on the channel time -->
			<evaluate a="1000" b="result" op="add" /> <!-- Added base duration -->
			<setvar0 a="result" />

			<evaluate a="150,250,350" b="4" op="div" /> <!-- Maximum additional damage that can be gained through channeling divided by maximum number of charges possible from channeling -->
			<evaluate a="result" b="charges" op="mult" /> <!-- Bonus damage is set to an amount depending on the channel time -->
			<evaluate a="100" b="result" op="add" /> <!-- Added base damage -->
			<setvar1 a="result" />

			<areaofeffect
				radius="400"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="SuperiorMagic"
				center="target_position"
			>
				<applystate name="State_Stunned" duration="var0" />
				<damage effecttype="Magic" amount="1" b="var1" op="mult" />
				
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" target="target_entity" occlude="true" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" occlude="true" />
				</else>
			</areaofeffect>
			<killtrees target="source_entity" radius="400" />

			<setstr0 a="altavatar_path" b="effects/explosion.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/explosion.effect" source="source_position" occlude="true" />
			</else>
			<setstr0 a="altavatar_path" b="effects/wormhole_top.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/wormhole_top.effect" source="source_position" occlude="true" />
			</else>
			<setstr0 a="altavatar_path" b="effects/state_arrive.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/state_arrive.effect" source="source_entity" occlude="true" />
			</else>

			<setcharges a="0" />
		</condition>
		<else>
			<kill target="this_proxy_entity" source="" />
			<setcharges a="0" />
		</else>
	</onchannelbreak>
	
	<onchannelend>
		<teleport source="source_entity" target="target_position" interpolate="false" />
		<disjoint target="source_entity" />
		<unbind target="source_entity" />
		
		<areaofeffect
			radius="400"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="SuperiorMagic"
			center="target_position"
		>
			<applystate name="State_Stunned" duration="2000,2250,2500" />
			<damage effecttype="Magic" amount="250,350,450" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="target_entity" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" occlude="true" />
			</else>
		</areaofeffect>
		<killtrees target="source_entity" radius="400" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/explosion.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/explosion.effect" source="source_position" occlude="true" />
		</else>
		<setstr0 a="altavatar_path" b="effects/wormhole_top.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/wormhole_top.effect" source="source_position" occlude="true" />
		</else>
		<setstr0 a="altavatar_path" b="effects/state_arrive.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/state_arrive.effect" source="source_entity" occlude="true" />
		</else>

		<setcharges a="0" />
	</onchannelend>

	<modifier key="riftwalk_channel" modpriority="90"
		ignorecooldown="true"
	/>

	<modifier key="ult_boost" modpriority="90"
		range="1400"
	>
		<onchannelend>
			<spawnunit name="Gadget_Riftwalker_Ability4_Staff_Tracker_Target" target="target_position" pushentity="true" fixedposition="true" />
			<spawnunit name="Gadget_Riftwalker_Ability4_Staff_Tracker_Source" target="source_position" pushentity="true" fixedposition="true" proxy="stack_entity" />
			<applystate name="State_Riftwalker_Ability4_Staff" target="source_entity" duration="2000,2250,2500" spawner="stack_entity" proxy="stack_entity" />
			<setproxy entity="this_entity" target="stack_entity" />

			<teleport source="source_entity" target="target_position" interpolate="false" />
			<disjoint target="source_entity" />
			<unbind target="source_entity" />
			
			<areaofeffect
				radius="400"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="SuperiorMagic"
				center="target_position"
			>
				<applystate name="State_Stunned" duration="2000,2250,2500" />
				<damage effecttype="Magic" amount="250,350,450" />
				
				<!-- VFX -->
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" target="target_entity" occlude="true" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" occlude="true" />
				</else>
			</areaofeffect>
			<killtrees target="source_entity" radius="400" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/explosion.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/explosion.effect" source="source_position" occlude="true" />
			</else>
			<setstr0 a="altavatar_path" b="effects/wormhole_top.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/wormhole_top.effect" source="source_position" occlude="true" />
			</else>
			<setstr0 a="altavatar_path" b="effects/state_arrive.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/state_arrive.effect" source="source_entity" occlude="true" />
			</else>

			<starttimer entity="this_entity" duration="2000,2250,2500" />
			<setcharges a="0" />
		</onchannelend>

		<onchannelbreak>
			<condition test="hasstate State_Riftwalker_Ability4_Channel_Break" target="source_entity" >
				<spawnunit name="Gadget_Riftwalker_Ability4_Staff_Tracker_Target" target="target_position" pushentity="true" fixedposition="true" />
				<spawnunit name="Gadget_Riftwalker_Ability4_Staff_Tracker_Source" target="source_position" pushentity="true" fixedposition="true" proxy="stack_entity" />
				<applystate name="State_Riftwalker_Ability4_Staff" target="source_entity" duration="2000,2250,2500" spawner="stack_entity" proxy="stack_entity" />
				<setproxy entity="this_entity" target="stack_entity" />

				<teleport source="source_entity" target="target_position" interpolate="false" />
				<disjoint target="source_entity" />
				<unbind target="source_entity" />

				<evaluate a="1000,1250,1500" b="4" op="div" /> <!-- Maximum additional duration of stun that can be gained through channeling divided by maximum number of charges possible from channeling -->
				<evaluate a="result" b="charges" op="mult" /> <!-- Bonus duration is set to an amount depending on the channel time -->
				<evaluate a="1000" b="result" op="add" /> <!-- Added base duration -->
				<setvar0 a="result" />

				<evaluate a="150,250,350" b="4" op="div" /> <!-- Maximum additional damage that can be gained through channeling divided by maximum number of charges possible from channeling -->
				<evaluate a="result" b="charges" op="mult" /> <!-- Bonus damage is set to an amount depending on the channel time -->
				<evaluate a="100" b="result" op="add" /> <!-- Added base damage -->
				<setvar1 a="result" />

				<areaofeffect
					radius="400"
					targetselection="all"
					targetscheme="enemy_units"
					effecttype="SuperiorMagic"
					center="target_position"
				>
					<applystate name="State_Stunned" duration="var0" />
					<damage effecttype="Magic" amount="1" b="var1" op="mult" />
					
					<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
					<exists path="str0">
						<playeffectdynamic effect="str0" source="target_entity" target="target_entity" occlude="true" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" occlude="true" />
					</else>
				</areaofeffect>
				<killtrees target="source_entity" radius="400" />

				<setstr0 a="altavatar_path" b="effects/explosion.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_position" occlude="true" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/explosion.effect" source="source_position" occlude="true" />
				</else>
				<setstr0 a="altavatar_path" b="effects/wormhole_top.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_position" occlude="true" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/wormhole_top.effect" source="source_position" occlude="true" />
				</else>
				<setstr0 a="altavatar_path" b="effects/state_arrive.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_entity" occlude="true" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/state_arrive.effect" source="source_entity" occlude="true" />
				</else>

				<setcharges a="0" />
			</condition>
			<else>
				<kill target="this_proxy_entity" source="" />
				<setcharges a="0" />
			</else>
		</onchannelbreak>

		<onimpact />
	</modifier>

	<modifier key="Riftwalker_staff_port" modpriority="100"
		actiontype="target_self"
		ignorecooldown="true"
		channeltime="0"
		manacost="0"
		cooldowntime="0"
		icon="iconb.tga"
	>
		<checkcost>
			<distance target="this_proxy_entity" />
			<compare a="result" b="3500" op="ge">
				<invalidate />
			</compare>
		</checkcost>
		
		<onimpact>
			<unbind />
			<spawnprojectile name="Projectile_Riftwalker_Ability4_Staff" source="source_entity" target="this_proxy_entity" bind="source_entity" pushentity="true" />
			<pushentity entity="this_proxy_entity" />
			<areaofeffect
				radius="400"
				targetselection="all"
				targetscheme="enemy_nonboss_units"
				effecttype="SuperiorMagic Push"
				center="stack_proxy_entity"
				source="stack_proxy_entity"
			>
				<unbind />
				<setpos0 position="stack_proxy_position" positionend="target_position" positionmodifier="subtract" />
				<setpos1 position="this_proxy_position" positionend="pos0" positionmodifier="add" />
				<spawnprojectile name="Projectile_Riftwalker_Ability4_Staff" source="target_entity" target="pos1" bind="target_entity" />
			</areaofeffect>
			
			<spawnunit name="Gadget_Riftwalker_Ability4_Staff_Tracker_Target" target="stack_proxy_position" pushentity="true" />
			<spawnprojectile name="Projectile_Riftwalker_Ability4_Staff" source="stack_entity" target="this_proxy_entity" bind="stack_entity" pushentity="true" />
			
			<expirestate name="State_Riftwalker_Ability4_Staff" target="source_entity" />
			<resettimer />
		</onimpact>
		
		<onchannelstart />
		<onchannelbreak />
		<onchannelend />
	</modifier>
</ability>