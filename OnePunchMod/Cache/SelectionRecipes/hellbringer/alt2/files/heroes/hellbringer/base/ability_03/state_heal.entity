<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Hellbringer_Ability3_Heal"

	icon="/heroes/hellbringer/alt2/ability_03/icon.dds"
	passiveeffect=""
	displaylevel="true"
	
	dynamicprecache="/heroes/hellbringer/alt2/ability_03/effects/lifesteal.effect"
>
	<oninflict>
		<setaccumulator value="0" />
	</oninflict>

	<ondamage>
		<cantarget targetscheme="enemy_units">
			<!-- Lifesteal values -->
			<setvar0 a="damage_applied" b="0.04,0.08,0.12,0.16" op="mult" />
			<heal a="var0" source="this_owner_entity" target="this_owner_entity" />
			
			<damageeffecttype effecttype="DOT">
				<compare a="accumulator" b="25" op="gt">
					<setaccumulator value="0" />
					
					<!-- Dynamic visual effects -->
					<setstr0 a="altavatar_path" b="effects/lifesteal.effect" op="add" />
					<exists path="str0">
						<playeffectdynamic effect="str0" ource="source_entity" target="this_proxy_entity" occlude="true" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/lifesteal.effect" ource="source_entity" target="this_proxy_entity" occlude="true" />
					</else>
				</compare>
				<else>
					<setaccumulator value="accumulator" valueb="1" valueop="add" />
				</else>
			</damageeffecttype>
			<else>
				<!-- Dynamic visual effects -->
				<setstr0 a="altavatar_path" b="effects/lifesteal.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" ource="source_entity" target="this_proxy_entity" occlude="true" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/lifesteal.effect" ource="source_entity" target="this_proxy_entity" occlude="true" />
				</else>
			</else>
		</cantarget>
	</ondamage>
	
	<onframe />
</state>
