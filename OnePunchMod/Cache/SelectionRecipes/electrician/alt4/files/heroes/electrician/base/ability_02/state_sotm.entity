<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Electrician_Ability2_SotM"

	icon="../../icon.dds"
	passiveeffect="/heroes/electrician/alt4/ability_02/effects/state.effect"
	
	effecttype=""
	dynamicprecache="effects/on_attacked.effect,effects/state_expire.effect"
>
	<onframe />
	
	<aura name="electricianshieldaura" state="State_Electrician_Ability2_Areadamage" radius="300" targetscheme="enemy_units"  />
	
	<onattackedpostimpact>
		<targettype type="enemy">
			<setstr0 a="altavatar_path" b="effects/on_attacked.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/on_attacked.effect" source="source_entity" />
			</else>
		</targettype>
	</onattackedpostimpact>
	
	<ondamaged>
		<setvar0 a="source_damage" b="0.5" op="mult" />
		<compare a="var0" b="source_mana" op="ge"> 
			<evaluate a="var0" b="source_mana" op="sub" />
			<evaluate a="result" b="var0" op="add" />
			<changedamage b="result" op="min" />
			<takemana amount="result" b="0.75,0.9,1.05,1.2" op="div" target="source_entity" />
		</compare>
		<else>
			<changedamage b="0.5" op="mult" />
			<takemana amount="result" b="0.75,0.9,1.05,1.2" op="div" target="source_entity" />
		</else>
	</ondamaged>
	
	<onexpired>
		<setstr0 a="altavatar_path" b="effects/state_expire.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/state_expire.effect" source="source_entity" />
		</else>
	</onexpired>
	
	<!-- make the state stack incase you have multiple of these, also disable it working on illusions -->
	<modifier key="krosmode" modpriority="101"
	>
		<aura name="electricianshieldaura" state="State_Electrician_Ability2_Areadamage" radius="300" targetscheme="enemy_units" propagatecondition="not_illusion" stack="true" />
	</modifier>
</state>
