<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Slither_Ability1_DoT"

	icon="../../icon.dds"
	
	impactinterval="2000"
	deniable="true"
	
	passiveeffect="/heroes/ebulus/alt6/ability_01/effects/state.effect"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	dynamicprecache="effects/impact.effect"
>
	<onframe />

	<onimpact>
		<damage effecttype="Magic DOT" amount="15,30,45,60" />
		<popup name="poison" a="result" source="target_entity" target="source_entity" />
		
		<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
		</else>
	</onimpact>
	
	<onattackedpostimpact>
		<entitytype target="inflictor_entity" type="Projectile_SlitherWardAttack">
			<changeduration entity="this_entity" b="1000" op="add" />
		</entitytype>
	</onattackedpostimpact>
</state>
