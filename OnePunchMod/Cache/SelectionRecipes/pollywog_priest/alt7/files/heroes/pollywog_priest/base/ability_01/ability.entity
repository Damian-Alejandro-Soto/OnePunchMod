<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_PollywogPriest1"

	icon="/heroes/pollywogpriest/alt7/ability_01/icon.dds"
	
	anim="ability_1"
	casttime="600"
	castactiontime="100"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="enemy_units"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	casteffecttype="Magic"
	
	manacost="90,110,130,150"
	cooldowntime="10000"
	
	range="600"
	targetradius="300"
	
	showconecast="true"
	conecastmaterial="/shared/materials/cone_cast_wide2.material"
	conecastwidth="412"
	conecastrange="1235"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/impact.effect,effects/cast.effect"
>
	<onimpact>
		<damage effecttype="Magic" amount="105,170,235,300" target="target_entity" />
		
		<setvar0 a="0.312" /> <!-- Lifetime (s) -->
		<getrange />
		<setvar1 a="result" b="150" op="sub" /> <!-- Cast range, minus the initial spawn distance -->
		<setvar1 a="result" b="400" op="add" /> <!-- Cast range, plus the extra travel distance -->
		<setvar1 a="var1" b="var0" op="div" /> <!-- Final Affector Speed, v = d/t -->		
		<setvar0 a="var0" b="1000" op="mult" /> <!-- Lifetime (s) to (ms) -->
		<spawnaffector name="Affector_PollywogPriest_Ability1" target="source_position" ignore="target_entity" distance="150" speed="var1" lifetime="var0" />
		
		<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
			</else>
			<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" target="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="target_entity" />
			</else>
	</onimpact>

	<modifier key="ult_boost" modpriority="100"
		cooldowntime="4000"
	>
		<onimpact>
			<damage effecttype="Magic" amount="105,170,235,300" target="target_entity" />
			
			<setvar0 a="0.312" /> <!-- Lifetime (s) -->
			<getrange />
			<setvar1 a="result" b="150" op="sub" /> <!-- Cast range, minus the initial spawn distance -->
			<setvar1 a="result" b="400" op="add" /> <!-- Cast range, plus the extra travel distance -->
			<setvar1 a="var1" b="var0" op="div" /> <!-- Final Affector Speed, v = d/t -->		
			<setvar0 a="var0" b="1000" op="mult" /> <!-- Lifetime (s) to (ms) -->
			<spawnaffector name="Affector_PollywogPriest_Ability1" target="source_position" ignore="target_entity" distance="150" speed="var1" lifetime="var0" />
			<spawnaffector name="Affector_PollywogPriest_Ability1_Staff" target="source_position" ignore="target_entity" distance="150" speed="var1" lifetime="var0" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
			</else>
			<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" target="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="target_entity" />
			</else>
		</onimpact>
	</modifier>
</ability>
