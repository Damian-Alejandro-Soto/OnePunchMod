<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Legionnaire_Ability2_Self"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/legionnaire/alt10/legion/ability_02/effects/state_self.effect"
	ishidden="true"
	
	armor="0,2,4,6"
	magicarmor="0,2,4,6"
	
	movespeed="100,200,300,400"
	basedamagemultiplier="0.5,1,1.5,2"
	
	unitwalking="true"
	perplexed="true"
	
	modifierkey="legionnairecharging"	
>
	<onframe>
		<targettype target="this_owner_entity" type="stunned">
			<expire />
		</targettype>
		<targettype target="this_owner_entity" type="immobilized">
			<expire />
		</targettype>
		<targettype target="this_owner_entity" type="restrained">
			<expire />
		</targettype>
	</onframe>
	
	<onexpired>
		<compare a="param" b="1" op="eq">
			<targettype type="alive" target="source_entity">
				<playanim name="idle" />
			</targettype>
		</compare>
	</onexpired>
</state>
