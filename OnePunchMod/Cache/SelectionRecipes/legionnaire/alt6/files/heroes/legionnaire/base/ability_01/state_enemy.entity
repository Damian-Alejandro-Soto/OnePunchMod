<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Legionnaire_Ability1_Enemy"

	icon="/heroes/legionnaire/alt6/ability_01/icon.dds"
	passiveeffect="/heroes/legionnaire/alt6/ability_01/state.effect"
	
	silenced="true"
	perplexed="true"

	negativeeffect="taunted"
	
	effecttype="StatusDisable"
	allowtransfer="false"
	
	modifierkey="forced_Attack"
>
	<onframe>
		<targettype type="alive" target="source_entity" />
		<else>
			<expire />
		</else>
	</onframe>
	
	<oninflict>
		<aggression />
		<order command="stop" force="true" source="this_owner_entity" target="target_entity" />
		<order command="attack" force="true" forceduration="2000,2400,2800,3200" source="target_entity" target="proxy_entity" />
	</oninflict>
	
	<onrefresh>
		<aggression />
		<order command="attack" force="true" forceduration="2000,2400,2800,3200" source="target_entity" target="proxy_entity" />
	</onrefresh>

	<onexpired>
		<targettype type="creep">
			<order command="stop" source="this_owner_entity" target="this_owner_entity" />
		</targettype>
	</onexpired>
</state>
