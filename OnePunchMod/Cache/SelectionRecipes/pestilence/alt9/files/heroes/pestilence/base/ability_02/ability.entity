<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Pestilence2"

	icon="/heroes/Pestilence/alt9/ability_02/icon.dds"

	anim="ability_2"
	casttime="500"
	castactiontime="250"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="self_position"
	targetscheme="enemy_units"
	targetradius="350"
	casteffecttype="Magic"

	manacost="85,95,105,115"
	cooldowntime="8000"
	dynamicprecache="effects/area.effect"
>
	<onimpact >
		<spawnaffector name="Affector_Pestilence_Ability2_Stun" target="source_entity" />
		<spawnaffector name="Affector_Pestilence_Ability2_Slow" target="source_entity" />

		<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/area.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="target_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/area.effect" source="target_position" target="target_position" occlude="true" />
		</else>
	</onimpact>
</ability>
