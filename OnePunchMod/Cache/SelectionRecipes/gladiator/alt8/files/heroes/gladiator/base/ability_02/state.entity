<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Gladiator_Ability2"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/gladiator/alt8/ability_02/effects/state.effect"

	effecttype=""
	
>
	<onframe />

	<onexpired>
		<expirestate target="this_inflictor_entity" name="State_Gladiator_Ability2_Return" />
		<cantarget effecttype="Magic Push" ignoreinvulnerable="false">
			<unbind target="target_entity" />
			<disjoint target="target_entity" />
