	dynamicprecache="/heroes/gladiator/alt8/ability_02/effects/impact.effect"
>
	<onspawn>
	</onspawn>
	
	<ondeath>
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="" source="target_position" occlude="true" />
		</exists>
