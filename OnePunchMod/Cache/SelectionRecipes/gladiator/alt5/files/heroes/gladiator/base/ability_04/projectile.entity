<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Gladiator_Ability4"

	speed="600"
	gravity="0"

	modelscale="1.0"
	model="/shared/models/invis.mdf"
	traileffect=""
	canturn="true"
	flying="true"
	flyheight="0"
	
	touchradius="450"
	touchradiusdiradjust="true"
	touchtargetscheme="ally_units"
	toucheffecttype=""
	
	maxtouchespertarget="1"
 deatheffect="/heroes/gladiator/alt5/ability_04/effects/area.effect">
	<onspawn />

	<onimpact>
		<setparam a="0" /> <!-- Reset param, which store the # of targets hit -->
		<setvar0 a="300,450,600" />

		<!-- Bonus Damage from allies that hopped onto the Chariot -->
		<hasmodifier name="ult_boost" entity="this_owner_entity">
			<pushtool source="this_owner_entity" name="Ability_Gladiator4" />
			<addcharges count="0" entity="stack_entity" />
			<setparam a="result" />

			<!-- Reset charges on ability entity -->
			<setcharges a="0" entity="stack_entity" />
		</hasmodifier>

		<!-- Radius -->
		<!-- TODO: note that VFX aren't updated at this time! -->
		<evaluate a="param" b="75" op="mult" />
		<setvar1 a="result" b="450" op="add" />

		<!-- Damage adjustment -->
		<evaluate a="param" b="0.10" op="mult" />
		<evaluate a="result" b="1" op="add" />
		<setvar2 a="var0" b="result" op="mult" />

		<areaofeffect
			radius="var1"
			center="this_position"
			targetselection="all"
			targetscheme="enemy_units"
		>
			<applystate name="State_Stunned" duration="1000" />
			<damage effecttype="Magic" amount="1" b="var2" op="mult" />
		</areaofeffect>
		<kill target="this_proxy_entity" source="" />
		<spawnunit name="Gadget_Gladiator_Ability4_Linger" count="1" target="target_position" />

		<setvar3 a="param" />

		<case a="0">
			<setstr0 a="altavatar_path" b="effects/area.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="target_position" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/area.effect" source="target_position" target="target_position" />
			</else>
		</case>
		<case a="1">
			<setstr0 a="altavatar_path" b="effects/area_1.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="target_position" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/area_1.effect" source="target_position" target="target_position" />
			</else>
		</case>
		<case a="2">
			<setstr0 a="altavatar_path" b="effects/area_2.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="target_position" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/area_2.effect" source="target_position" target="target_position" />
			</else>
		</case>
		<case a="3">
			<setstr0 a="altavatar_path" b="effects/area_3.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="target_position" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/area_3.effect" source="target_position" target="target_position" />
			</else>
		</case>
		<case a="4">
			<setstr0 a="altavatar_path" b="effects/area_4.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="target_position" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/area_4.effect" source="target_position" target="target_position" />
			</else>
		</case>
		<case a="5">
			<setstr0 a="altavatar_path" b="effects/area_5.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="target_position" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/area_5.effect" source="target_position" target="target_position" />
			</else>
		</case>
	</onimpact>
	
	<ontouch>
		<applystate name="State_Gladiator_Ability4" duration="6000" />
	</ontouch>
</projectile>
