	linecastrange="1225"
	linecastwidth="200"
	
	showrangeandradiusintooltip="true"
	novoiceresponse="true"
>
	<onimpact>
		<getrange />
		<setvar0 a="result" b="0" op="add" />
		<spawnlinearaffector name="Affector_Behemoth_Ability1" target="source_position" direction="target_position" firsttarget="" minlength="var0" maxlength="var0" />
		<spawnlinearaffector name="Affector_Behemoth_Ability1_Wall" target="source_position" direction="target_position" firsttarget=""  minlength="var0" maxlength="var0" proxy="this_entity" />
		<applystate name="State_Behemoth_Ability1_Self" target="this_owner_entity" duration="6500,7000,7500,8000" />
		<starttimer duration="6500,7000,7500,8000" />
		<setactivemodifierkey name="behemoth_ability1_Active" />
	</onimpact>
	
	<modifier key="behemoth_ability1_NoResponse" modpriority="140"
		noresponse="true"
	>
	</modifier>
	
	<modifier key="behemoth_ability1_Self" modpriority="150"
		ignorecooldown="true"
		casteffect=""
		casttime="0"
		castactiontime="0"
		actiontype="no_target"
		manacost="0"
		cooldowntime="0"
		icon="/shared/icons/off.tga"
		
		anim=""
		frontqueue="true"
		inheritmovement="true"
		noninterrupting="true"
	>
		<onimpact>
			<expirestate name="State_Behemoth_Ability1_Self" target="this_owner_entity" />
			<setactivemodifierkey name="" />
			<resettimer />
