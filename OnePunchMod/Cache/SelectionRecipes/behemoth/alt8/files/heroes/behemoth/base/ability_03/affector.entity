<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Behemoth_Ability3"

	radius="280"
	targetscheme="enemy_units"
	targetselection="all"
	effecttype="Magic"
 dynamicprecache="/heroes/behemoth/alt8/ability_03/effects/impact.effect">
	<onimpact>
		<applystate name="State_Stunned" duration="600,900,1200,1500" />
		<damage effecttype="Magic" amount="40,60,80,100" />
	</onimpact>
	
	<onspawn>
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<setscriptvalue name="impact_effect" value="str0" entity="this_entity" />
		</exists>
		<else>
			<setscriptvalue name="impact_effect" value="effects/impact.effect" entity="this_entity" />
		</else>
	</onspawn>
	
	<onexpired>
		<!-- Dynamic visual effects -->
		<getscriptvalue name="impact_effect" destvar="str0" entity="this_entity" />
		<playeffectdynamic effect="str0" source="source_position" target="source_position" occlude="true" />
	</onexpired>
</affector>
