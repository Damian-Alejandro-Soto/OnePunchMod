<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Deadwood_Ability2"

	icon="../../icon.dds"
	passiveeffect="/heroes/deadwood/alt4/ability_02/effects/tree.effect"

	damage="15,30,45,60"
	effecttype=""
	modifierkey="deadwood_ihasatree"
	dynamicprecache="effects/attack_follow_through.effect,effects/attack_impact.effect"
>
	<oninflict>
		<setcharges a="4" />
	</oninflict>
	
	<onrefresh>
		<setcharges a="4" />
	</onrefresh>
	
	<onattackimpact>
		<removecharge />
		<compare a="charges" b="0" op="eq">
			<expire />
		</compare>
		
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/attack_follow_through.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/attack_follow_through.effect" target="source_entity" />
		</else>
		<setstr0 a="altavatar_path" b="effects/attack_impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/attack_impact.effect" source="target_entity" />
		</else>
	
	</onattackimpact>
	
	<onframe>
		<hasmodifier name="iamsheeped" entity="this_owner_entity">
			<activatemodifierkey name="iamsheeped" />
		</hasmodifier>
		<else>
			<deactivatemodifierkey name="iamsheeped" />
		</else>
	</onframe>
	
	<onexpired>
		<setcharges entity="this_proxy_entity" a="0" />
	</onexpired>
	
	<modifier key="iamsheeped" modpriority="1000"
		passiveeffect=""
	/>

	<modifier key="ult_boost" modpriority="105"
	>
		<oninflict/>
		
		<onrefresh/>

		<onattackimpact>
			<compare a="charges" b="4" op="lt">
				<addcharges count="1" />
			</compare>
			<compare a="charges" b="4" op="ge">
				<cantarget targetscheme="enemy_units">
					<cantarget effecttype="Magic">
						<applystate name="State_Stunned" duration="100" target="target_entity" />
						<applystate name="State_Deadwood_Ability2_Slow" duration="1000" target="target_entity" />
						<setcharges a="0" />
					</cantarget>
				</cantarget>
			</compare>
			<targettype type="melee" source="this_owner_entity" target="this_owner_entity">
				<cantarget targetscheme="enemy_units">
					<splashdamage a="total_adjusted_damage" b="0.50" op="mult" radius="300" effecttype="Physical Splash Cleave" targetscheme="enemy_units" />
					<pushentity entity="target_entity" />
					
					<setpos0 position="source_entity" positionend="stack_position" positionmodifier="pointonline" positionvalue="325" />
					<areaofeffect
						targetselection="all"
						targetscheme="enemy_units"
						center="pos0"
						radius="300"
						effecttype="Physical Splash Cleave"
						ignore="stack_entity"
					>
						<!-- playeffect doesn't work if the modifier has no name. -->
						<playeffect effect="/shared/effects/splash_damage.effect" source="target_entity" target="stack_entity"/>
					</areaofeffect>
				</cantarget>
			</targettype>
			
			<!-- Art -->
			<setstr0 a="altavatar_path" b="effects/attack_follow_through.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/attack_follow_through.effect" target="source_entity" />
			</else>
			<setstr0 a="altavatar_path" b="effects/attack_impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/attack_impact.effect" source="target_entity" />
			</else>
		</onattackimpact>
		
		<onexpired />
	</modifier>

</state>
