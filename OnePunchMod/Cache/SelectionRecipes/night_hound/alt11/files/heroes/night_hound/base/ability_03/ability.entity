<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_NightHound3"

	icon="/heroes/hantumon/alt11/ability_03/icon.dds"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="passive"

	modifierkey="NightHound_backstab_1,NightHound_backstab_2,NightHound_backstab_3,NightHound_backstab_4"
	dynamicprecache="effects/ability_03.effect,effects/impact.effect"
>

	<onattackstart>
		<condition test="target_angle lt 105">
			<cantarget targetscheme="enemy_units">
				<playanim name="ability_3_attack_" variations="3" speed="source_attackspeed" target="source_entity" />
			</cantarget>
		</condition>
	</onattackstart>

	<onattack>
		<condition test="target_angle lt 105">
			<cantarget targetscheme="enemy_units">
				<setstr0 a="altavatar_path" b="effects/ability_03.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/ability_03.effect" source="target_entity" />
				</else>
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
				</else>
				<bonusdamageadd target="" a="0.30,0.60,0.90,1.2" b="source_agility" op="mult" />
			</cantarget>
		</condition>
	</onattack>

	<modifier key="night_hound_w_attacking" modpriority="100">
		<onattack>
			<cantarget targetscheme="enemy_units">
				<setstr0 a="altavatar_path" b="effects/ability_03.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/ability_03.effect" source="target_entity" />
				</else>
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
				</else>
				<bonusdamageadd target="" a="0.30,0.60,0.90,1.2" b="source_agility" op="mult" />
			</cantarget>
		</onattack>
	</modifier>
</ability>
