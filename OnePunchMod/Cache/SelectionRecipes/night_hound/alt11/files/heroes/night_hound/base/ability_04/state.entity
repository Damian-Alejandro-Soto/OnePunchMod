<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_NightHound_Ability4"

	icon="/heroes/hantumon/alt11/ability_04/icon.dds"
	
	passiveeffect=""
	
	stealthtype="hero"
	hideshadow="true"
	fadetime="4000,3250,2500"
>
	<oninflict>
		<startfade />
		<starttimer entity="this_proxy_entity" duration="4000,3250,2500" />
	</oninflict>
	
	<onattack>
		<startfade />
		<starttimer entity="this_proxy_entity" duration="4000,3250,2500" />
	</onattack>
	
	<onactivatepreimpact ignoreresponsetype="NoBreakStealth">
		<!-- TODO: in the future, if we want certain items to break stealth, remove this isitem check & tag items with responsetype="NoBreakStealth" -->
		<isitem entity="inflictor_entity" />
		<else>
			<hasmodifier name="NoBreakStealth" entity="source_entity" />
			<else>
				<startfade />
				<starttimer entity="this_proxy_entity" duration="4000,3250,2500" />
			</else>			
		</else>
	</onactivatepreimpact>
	
	<onexpired>
		<resettimer entity="this_proxy_entity" />
	</onexpired>
</state>
