<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_NightHound1"
	
	statuseffecttooltip="State_NightHound_Ability1"
	icon="/heroes/hantumon/alt12/ability_01/icon.dds"
	
	anim="ability_1"
	casttime="1000"
	castactiontime="200"
	casteffect=""

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetradius="325"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	casteffecttype="Magic"
	targetscheme="enemy_units"
	
	manacost="75,80,85,90"
	cooldowntime="21000,19000,17000,15000"
	
	range="425"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/cast.effect,effects/trail.effect,effects/impact.effect"
>
	<!-- Client-visible art only: no collision, gameplay callbacks, or response. -->
	<onstart>
		<!-- Avatar-aware release effect. -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="source_entity" />
		</else>

		<spawnprojectile
			name="Projectile_NightHound_Ability1_Art"
			source="source_entity"
			target="target_position"
			offset="18 32 76"
			offsetspace="source_entity"
			noresponse="true"
			pushentity="true"
		/>
		<setproxy entity="this_entity" target="stack_entity" />
	</onstart>
	<oncancel>
		<compare a="this_proxy_entity" b="0" op="ne">
			<delete target="this_proxy_entity" />
		</compare>
		<setproxy entity="this_entity" target="" />
	</oncancel>
	<onimpact >
		<spawnunit name="Gadget_NightHound_Ability1" target="target_position"/>
		<setproxy entity="this_entity" target="" />
	</onimpact>
</ability>
