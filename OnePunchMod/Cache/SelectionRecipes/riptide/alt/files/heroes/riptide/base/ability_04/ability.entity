<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Riptide4"
	
	icon="/heroes/riptide/alt/ability_04/icon.dds"
	
	anim="ability_4"
	casttime="0"
	castactiontime="0"

	maxlevel="3"
	requiredlevel="6,11,16"
	targetscheme="all_units"
	actiontype="no_target"
	casteffecttype="SuperiorMagic GlobalAbility"

	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"

	manacost="100"
	cooldowntime="110000,95000,80000"
	
	noshuffle="true"
	dynamicprecache="../ability_03/effects/start.effect,effects/storm.effect"
>
	<onimpact>
		<setpos0 entity="this_entity" position="0" offset="8000 8000 0" />
		<spawnunit name="Gadget_Riptide_Ability4" target="pos0" pushentity="true" />
		<applystate name="State_Riptide_Ability4" target="source_entity" duration="30000" />
		<starttimer duration="30000" />
		
		<!-- Art -->
		<hasmodifier entity="source_entity" name="riptide_inwater">
			<playeffect effect="" source="source_entity" target="" />
		</hasmodifier>
		<else>
					<setstr0 a="altavatar_path" b="../ability_03/effects/start.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="../ability_03/effects/start.effect" source="source_entity" target="" />
			</else>
		</else>	
				<setstr0 a="altavatar_path" b="effects/storm.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="stack_entity" target="stack_entity" ignoreculling="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/storm.effect" source="stack_entity" target="stack_entity" ignoreculling="true" />
		</else>
	</onimpact>
	
	<ondeath>
		<resettimer />
	</ondeath>
	
	<modifier key="riptide_ult_active" modpriority="90"
		disabled="true"
	/>

</ability>
