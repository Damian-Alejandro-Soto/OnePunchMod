<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Riptide_Ability1"

	speed="3000"
	gravity="0"

	modelscale="1"
	model="/shared/models/invis.mdf"
	traileffect="/heroes/riptide/alt6/ability_01/effects/projectile.effect"
	effectscale="1.0"
	impacteffect=""
>
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<cantarget effecttype="Magic">
					<applystate name="State_Riptide_Ability1_Slow" duration="2000,2500,3000,3500" />
					<damage effecttype="Magic" amount="100,175,250,325" />
					<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" occlude="true" />
		</else>
				</cantarget>
			</onimpact>
		</combatevent>
		<hasmodifier name="ult_boost" entity="source_entity">
			<bounce count="2" range="600" damagemult="1" targetscheme="visible_enemy_units" seek="random" maxbouncespertarget="1" />
		</hasmodifier>
	</onimpact>

</projectile>
