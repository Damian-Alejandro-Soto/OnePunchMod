<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Tarot_Ability3_Effect"
	
	ishidden="true"
	icon="icon.tga"
	passiveeffect="/heroes/tarot/alt6/ability_03/effects/state_link.effect"

	effecttype=""
	allowtransfer="false"
	
	alwaystransmitdata="true"
	dynamicprecache="effects/link_break.effect"
>
	<onexpired>
		<compare a="this_proxy_entity" b="0" op="ne">
			<expirestate name="State_Tarot_Ability3_Effect" target="this_proxy_entity" />

			<setstr0 a="altavatar_path" b="effects/link_break.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/link_break.effect" />
			</else>
			<setstr0 a="altavatar_path" b="effects/link_break.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="this_proxy_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/link_break.effect" source="target_entity" target="this_proxy_entity" />
			</else>
		</compare>
	</onexpired>
</state>