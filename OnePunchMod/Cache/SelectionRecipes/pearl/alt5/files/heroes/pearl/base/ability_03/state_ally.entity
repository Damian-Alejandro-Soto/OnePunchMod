<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Pearl_Ability3_Ally"

	healthregenpercharge="1.2,1.6,2.0,2.4"
	ishidden="true"
	passiveeffect="/heroes/pearl/alt5/ability_03/effects/aura.effect"
	
>
	<onframe />
	
	<oninflict>
		<!-- Fixes a bug where this state gets applied on the frame after Pearl's death and incorrectly shows the visuals -->
		<targettype type="alive" />
		<else>
			<expire />
		</else>
	</oninflict>
</state>
