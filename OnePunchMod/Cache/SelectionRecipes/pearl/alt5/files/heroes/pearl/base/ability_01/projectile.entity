<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Pearl_Ability1"

	speed="2000"
	gravity="1000"

	modelscale="1.7"
	model="/shared/models/invis.mdf"
	
	traileffect="/heroes/pearl/alt5/ability_01/effects/trail.effect"

	effectscale="2.0"
	impacteffect=""
>
	<onimpact>
		<targettype type="enemy">
			<combatevent effecttype="AbilityBasedProjectile">
				<onimpact>
					<!-- Dispel Jeraziah's Protective Charm (W) if it is on the target -->
					<expirestate name="State_Jeraziah_Ability2" target="target_entity"/>
					<cantarget target="target_entity" effecttype="Magic">
						<dispel type="StatusBuff" />
						<applystate name="State_Pearl_Ability1" duration="1500" />
						<applystate name="State_Second_Pearl_Ability1" duration="600" />
						<damage effecttype="Magic" amount="40" />
					</cantarget>
				</onimpact>
			</combatevent>
		</targettype>
		<else>
			<applystate name="State_Pearl_Ability1_Ally" duration="1500" />
		</else>
	</onimpact>
</projectile>