<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Pearl4"

	icon="/heroes/pearl/alt3/ability_04/icon.dds"
	
	statuseffecttooltip="State_Pearl_Ability4"
	anim="ability_4"
	casttime="450"
	castactiontime="0"

	maxlevel="3"
	requiredlevel="6,11,16"

	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	actiontype="target_self"
	targetradius="400"
	casteffecttype="SuperiorMagic"
	casteffect=""
	
	targetscheme="ally_units"
	
	manacost="150,175,200"
	cooldowntime="100000,85000,70000"
	dynamicprecache="effects/affector.effect,effects/death.effect"
	
>
	<onimpact>
		<spawnunit name="Gadget_Pearl_Ability4" target="target_position" pushentity="true" />
		<setproxy entity="this_entity" target="stack_entity" />
		<setent0 entity="stack_entity" />
		<spawnaffector name="Affector_Pearl_Ability4" target="stack_entity" pushentity="true" />
		<setproxy entity="ent0" target="stack_entity" />

		<setvar0 a="source_lifetime" source="ent0" />

		<!-- Instant heal state applied on the gadget -->
		<applystate name="State_Pearl_Ability4_InstantHeal" target="ent0" duration="var0" accumulator="1.0" />

		<starttimer duration="var0" />
	</onimpact>

	<modifier key="ult_boost" modpriority="100">
		<onimpact>
			<spawnunit name="Gadget_Pearl_Ability4" target="target_position" pushentity="true" />
			<setproxy entity="this_entity" target="stack_entity" />
			<setent0 entity="stack_entity" />
			<spawnaffector name="Affector_Pearl_Ability4" target="stack_entity" pushentity="true" />
			<setproxy entity="ent0" target="stack_entity" />

			<setvar0 a="source_lifetime" source="ent0" />

			<!-- Instant heal state applied on the gadget -->
			<applystate name="State_Pearl_Ability4_InstantHeal" target="ent0" duration="var0" accumulator="1.0" />

			<applystate name="State_Pearl_Ability4_Modifier" duration="var0" target="source_entity" />
			<starttimer duration="var0" />
		</onimpact>
	</modifier>

	<modifier key="pearl_R_can_move" modpriority="110"
		casttime="0"
		castactiontime="0"

		actiontype="target_position"
		range="700"

		ignorecooldown="true"
		noresponse="true"

		showareacast="true"
		areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

		showrangeandradiusintooltip="true"
	>
		<onimpact>
			<compare a="this_proxy_entity" b="0" op="ne">
				<setvar0 a="source_lifetime" source="this_proxy_entity" /> <!-- Retrieve lifetime from gadget -->

				<!-- Clean up old gadget and affector -->
				<pushentity entity="this_proxy_entity" />
				<delete target="stack_proxy_entity" source="" />
				<delete target="this_proxy_entity" />
				
				<!-- Spawn new gadget and affector with the appropriate parameters -->
				<spawnunit name="Gadget_Pearl_Ability4" target="target_position" lifetime="var0" pushentity="true" />
				<setproxy entity="this_entity" target="stack_entity" />
				<setent0 entity="stack_entity" />
				<spawnaffector name="Affector_Pearl_Ability4" target="stack_entity" pushentity="true" />
				<setproxy entity="ent0" target="stack_entity" />

				<!-- Instant heal state (lesser) applied on the gadget -->
				<applystate name="State_Pearl_Ability4_InstantHeal_Lesser" target="ent0" duration="var0" accumulator="0.5" />

				<expirestate name="State_Pearl_Ability4_Modifier" target="source_entity" />
			</compare>
		</onimpact>
	</modifier>
</ability>
