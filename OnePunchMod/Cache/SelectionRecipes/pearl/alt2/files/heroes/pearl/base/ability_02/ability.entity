<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Pearl2"

	icon="../../icon.dds"
	
	anim="ability_2"
	casttime="700"
	castactiontime="100"
	casteffect="/heroes/pearl/alt2/ability_02/effects/cast.effect"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	casteffecttype="Magic"
	targetscheme="enemy_units"

	actiontype="target_position"
	
	manacost="100,110,120,130"
	cooldowntime="15000"
	
	range="700"
	forcerange="700"
	targetradius="275"
	allowoutofboundscast="true"
	
	showlinecast="true"
	linecastrange="725"
	linecastwidth="100"
	
	showareacast="false"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/impact_enemy.effect,effects/bubble_pop.effect"
>
	<onimpact>
		<distance target="target_position" />
		<compare a="result" b="1500" op="lt">
			<spawnunit name="Gadget_Pearl_Ability2" target="source_position" proxy="this_entity" pushentity="true" />
			<spawnprojectile name="Projectile_Pearl_Ability2" target="target_position" bind="stack_entity" proxy="stack_entity" pushentity="true" offset="0 50 0"/>
			<spawnaffector name="Affector_Pearl_Ability2" target="stack_entity" proxy="stack_entity" />
		</compare>
	</onimpact>
</ability>