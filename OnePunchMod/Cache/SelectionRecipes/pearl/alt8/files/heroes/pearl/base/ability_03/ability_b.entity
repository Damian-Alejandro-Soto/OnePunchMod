<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Pearl3b"

	icon="/heroes/pearl/alt8/ability_03/icon.dds"
	
	anim="ability_3"
	casteffect=""
	
	baselevel="0"
	maxlevel="4"

	casttime="100"
	castactiontime="100"
	
	range="600,675,750,825"
	
	actiontype="target_position"
	casteffecttype=""
	targetscheme="all_heroes"
	activatescheme="movement"
	
	manacost="50"
	cooldowntime="35000,30000,25000,20000"
	
	showareacast="true"
	disabled="true"
	dynamicprecache="effects/takeoff.effect,effects/impact.effect"
>
	<onframe>
		<setcharges entity="this_entity" a="0" />
	</onframe>
	
	<ondamaged>
		<applystate name="State_Pearl_Ability3_Dazed" target="source_entity" duration="3000" />
	</ondamaged>

	<onimpact>
		<spawnprojectile name="Projectile_Pearl_Ability3" source="source_entity" target="target_position" bind="source_entity" bindturn="true" bindstate="State_Pearl_Ability3_Bind" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/takeoff.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/takeoff.effect" source="source_position" target="source_position" occlude="true" />
		</else>	
	</onimpact>
	
	<modifier key="Pearl_E1" modpriority="100"
		baselevel="1"
		disabled="false"
		keyslot="5"
	/>
	
	<modifier key="Pearl_E2" modpriority="101"
		baselevel="2"
		disabled="false"
		keyslot="5"
	/>
	
	<modifier key="Pearl_E3" modpriority="102"
		baselevel="3"
		disabled="false"
		keyslot="5"
	/>
	
	<modifier key="Pearl_E4" modpriority="103"
		baselevel="4"
		disabled="false"
		keyslot="5"
	/>

	<modifier key="Pearl_Dazed" modpriority="104"
		range="300,337.5,375,412.5"
	/>
	
</ability>