<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Blacksmith1"

	icon="/heroes/dwarf_magi/alt6/ability_01/icon.dds"
	
	anim="ability_1"
	casttime="800"
	castactiontime="400"
	casteffect="/heroes/dwarf_magi/alt6/ability_01/effects/cast.effect"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	casteffecttype="Magic"
	targetscheme="enemy_units"
	
	manacost="75,85,95,105"
	cooldowntime="9000"

	range="600"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes"
	dynamicprecache="effects/impact.effect,effects/multicast_impact.effect"
>
	<onimpact>
		<applystate name="State_Stunned" duration="1500" />
		<damage effecttype="Magic" amount="95,155,215,275" />
		
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
		</else>
	</onimpact>
	
	<modifier key="Blacksmith_Ability4_1" modpriority="100"
		cooldowntime="8000"
		manacost="85,95,105,115"
	>
		<onimpact>
			<applystate name="State_Stunned" duration="1500" />
			<damage effecttype="Magic" amount="95,155,215,275" />
			
			<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
		</else>
			<setaccumulator entity="this_entity" value="1" />
			<randomfloat min="1" max="100" />
			<setvar0 a="result" />
			
			<!-- Level 1 Ultimate - Multicast threshold for 1/2/3/4x is 70/30/0/0% -->
			
			<!-- 2x Multicast -->
			<compare a="var0" b="30" op="le">				
				<setaccumulator entity="this_entity" value="2" />
				<popup name="multicast" a="2" source="target_entity" target="source_entity" />
				<spawnaffector name="Affector_Blacksmith_Ability1_2x" target="target_entity" />	
			</compare>			
		</onimpact>
	</modifier>
	
	<modifier key="Blacksmith_Ability4_2" modpriority="100"
		cooldowntime="7000"
		manacost="115,125,135,145"
	>
		<onimpact>
			<applystate name="State_Stunned" duration="1500" />
			<damage effecttype="Magic" amount="95,155,215,275" />
			
			<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
		</else>
			
			<setaccumulator entity="this_entity" value="1" />			
			<randomfloat min="1" max="100" />
			<setvar0 a="result" />
			
			<!-- Level 2 Ultimate - Multicast threshold for 1/2/3/4x is 45/35/20/0% -->
			
			<!-- 3x Multicast -->
			<compare a="var0" b="20" op="le">
				<setaccumulator entity="this_entity" value="3" />
				<spawnaffector name="Affector_Blacksmith_Ability1_3x" target="target_entity" />
				<spawnaffector name="Affector_Blacksmith_Ability1_2x" target="target_entity" />
				<popup name="multicast" a="3" target="source_entity" />
			</compare>
			<else>
				<!-- 2x Multicast: check threshold = 3x chance + 2x chance -->
				<compare a="var0" b="55" op="le">
					<setaccumulator entity="this_entity" value="2" />
					<spawnaffector name="Affector_Blacksmith_Ability1_2x" target="target_entity" />					
					<popup name="multicast" a="2" target="source_entity" />
				</compare>
			</else>
		</onimpact>
	</modifier>
	
	<modifier key="Blacksmith_Ability4_3" modpriority="100"
		cooldowntime="6000"
		manacost="145,155,165,175"
	>
		<onimpact>
			<applystate name="State_Stunned" duration="1500" />
			<damage effecttype="Magic" amount="95,155,215,275" />
			
			<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
		</else>
			<setaccumulator entity="this_entity" value="1" />
			<randomfloat min="1" max="100" />
			<setvar0 a="result" />
			
			<!-- Level 3 Ultimate - Multicast threshold for 1/2/3/4x is 30/35/20/15% -->
			
			<!-- 4x Multicast -->
			<compare a="var0" b="15" op="le">
				<setaccumulator entity="this_entity" value="4" />
				<spawnaffector name="Affector_Blacksmith_Ability1_4x" target="target_entity" />
				<spawnaffector name="Affector_Blacksmith_Ability1_3x" target="target_entity" />
				<spawnaffector name="Affector_Blacksmith_Ability1_2x" target="target_entity" />
				<popup name="multicast" a="4" target="source_entity" />
			</compare>
			<else>
				<!-- 3x Multicast: check threshold = 4x chance + 3x chance -->
				<compare a="var0" b="35" op="le">
					
					<setaccumulator entity="this_entity" value="3" />
					<spawnaffector name="Affector_Blacksmith_Ability1_3x" target="target_entity" />
					<spawnaffector name="Affector_Blacksmith_Ability1_2x" target="target_entity" />
					<popup name="multicast" a="3" target="source_entity" />
				</compare>
				<else>
					<!-- 2x Multicast: check threshold = 4x chance + 3x chance + 2x chance -->
					<compare a="var0" b="70" op="le">
						
						<setaccumulator entity="this_entity" value="2" />
						<spawnaffector name="Affector_Blacksmith_Ability1_2x" target="target_entity" />
						<popup name="multicast" a="2" target="source_entity" />
					</compare>
				</else>
			</else>		
		</onimpact>
	</modifier>
</ability>
