<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_VoodooJester_Ability1_Bounce"

	speed="700"
	gravity="0"	

	modelscale=".75"
	model="/heroes/voodoo/alt4/ability_01/effects/staff.mdf"

	impacteffect="/heroes/voodoo/alt4/ability_01/effects/impact.effect"
	invalideffect="effects/impact.effect"
	traileffect="/heroes/voodoo/alt4/ability_01/effects/trail.effect"
>
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<cantarget effecttype="Magic">
					<!-- This check prevents same-frame bugs on death -->
					<targettype type="alive">
						<cantarget targetscheme="all_heroes_and_boss_and_ElitePet_units">
							<applystate name="State_Stunned" duration="1000" />
								<damage effecttype="Magic" amount="50" />
						</cantarget>
						<else>
							<applystate name="State_Stunned" duration="5000" />
							<damage effecttype="Magic" amount="75,100,125,150" />
						</else>
					</targettype>
				</cantarget>
			</onimpact>
		</combatevent>
		<bounce count="1,3,5,7" range="600" targetscheme="visible_enemy_units" effecttype="Magic" />
	</onimpact>
</projectile>
