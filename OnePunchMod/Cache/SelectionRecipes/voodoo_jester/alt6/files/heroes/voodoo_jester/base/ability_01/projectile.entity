<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_VoodooJester_Ability1"

	speed="1200"
	gravity="0"

	modelscale=".75"
	model="/shared/models/invis.mdf"

	impacteffect="/heroes/voodoo/alt6/ability_01/effects/impact.effect"
	invalideffect="effects/impact.effect"
	traileffect="/heroes/voodoo/alt6/ability_01/effects/trail.effect"
>
	<onimpact activateonbounces="true">
		<compare a="target_entity" b="0" op="ne">
			<combatevent effecttype="AbilityBasedProjectile">
				<onimpact>
					<cantarget effecttype="Magic">
						<!-- This check prevents same-frame bugs on death -->
						<targettype type="alive">
							<cantarget targetscheme="all_heroes_and_boss_and_ElitePet_units">
								<applystate name="State_Stunned" duration="1500" />
								<damage effecttype="Magic" amount="50" />
							</cantarget>
							<else>
								<applystate name="State_Stunned" duration="5000" />
								<damage effecttype="Magic" amount="75,100,125,150" />
							</else>
						</targettype>
					</cantarget>
				</onimpact>
			</combatevent>

			<setproxy entity="this_entity" target="target_entity" />
			<areaofeffect
				radius="600"
				maxtotalimpacts="1"
				targetselection="random"
				targetscheme="visible_enemy_units"
				center="this_proxy_entity"
				ignore="this_proxy_entity"
			>
				<spawnprojectile name="Projectile_VoodooJester_Ability1_Bounce" source="this_proxy_position" target="target_entity" noresponse="true" />
			</areaofeffect>
		</compare>
		<else>
			<spawnaffector name="Affector_VoodooJester_Ability1_NullTarget" target="target_position" />
		</else>
	</onimpact>
	
	<onimpactinvalid activateonbounces="true">
		<spawnaffector name="Affector_VoodooJester_Ability1_NullTarget" target="target_entity" proxy="target_entity" firstimpact="target_entity" />
	</onimpactinvalid>
</projectile>