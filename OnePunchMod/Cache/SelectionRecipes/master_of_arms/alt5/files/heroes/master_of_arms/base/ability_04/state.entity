<?xml version="1.0" encoding="UTF-8"?>
<statenetaccum
	name="State_MasterOfArms_Ability4"
	
	icon="icon.tga"
	
	passiveeffect="/heroes/master_of_arms/alt5/ability_04/effects/magnetic_shield_state.effect"
	
	shield="true"
	maxaccumulator="200,400,600"
	
	effecttype="StatusBuff"
	allowtransfer="true"
	
	modifierkey="MasterOfArms_Shield_Active"
>
	<onframe />
	
	<oninflict>
		<setaccumulator value="200,400,600" />
	</oninflict>
	
	<onrefresh>
		<setaccumulator value="200,400,600" />
	</onrefresh>
	
	<ondamaged>
		<setvar0 a="source_damage" b="1" op="mult" />
		<compare a="var0" b="accumulator" op="ge">
			<evaluate a="var0" b="accumulator" op="sub" />
			<changedamage b="result" op="min" />
			<expire />
		</compare>
		<else>
			<changedamage b="0" op="mult" />
			<evaluate a="accumulator" b="var0" op="sub" />
			<setaccumulator value="result" />
		</else>
	</ondamaged>
	
	<onframe />
	
	<modifier key="MasterOfArms_Magnetic" modpriority="99"
		passiveeffect="/heroes/master_of_arms/alt5/ability_04/effects/magnetic_shield_state_red.effect"
	/>
</statenetaccum>