<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Swiftblade1"
	
	statuseffecttooltip="State_Swiftblade_Ability1"
	icon="/heroes/hiro/alt14/ability_01/icon.dds"
	
	anim="ability_1_start"
	casttime="0"
	castactiontime="0"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_self"
	targetscheme="enemy_units" 
	targetradius="250"
	casteffecttype="Magic"
	
	manacost="110"
	cooldowntime="33000,28000,23000,18000"
>
	<onimpact>
		<dispel type="StatusDebuff" />
		
		<!-- Ability immunity overrides Void Talisman's physical immunity (no simultaneous physical + magic immunity) -->
		<expirestate name="State_VoidTalisman" target="source_entity" noexpiretrigger="true" />
		<applystate name="State_Swiftblade_Ability1" target="source_entity" duration="5000" />
	</onimpact>
</ability>
