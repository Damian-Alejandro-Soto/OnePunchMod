<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Swiftblade4"

	statuseffecttooltip="State_Swiftblade_Ability4"
	icon="icon.tga"
	
	casttime="1700,2500,3700"
	castactiontime="300"

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_entity"
	targetscheme="enemy_units"
	casteffecttype="Physical"
	activatescheme="movement"
	
	manacost="200,275,350"
	cooldowntime="130000,120000,110000"

	range="400"
	targetradius="400"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"

	targetpriorities="enemy_heroes"
 casteffect="/heroes/hiro/alt8/ability_04/effects/castsound.effect">
	<onpreimpact>
		<applystate name="State_Swiftblade_Ability4_Sight" target="target_entity" duration="450" />
	</onpreimpact>
	
	<onimpact>
		<applystate name="State_Stunned_Static" duration="100" target="target_entity" />
		<applystate name="State_Swiftblade_Ability4" duration="800,1600,2800" target="source_entity" />
		<teleport interpolate="true" facetarget="true" />
		<damage effecttype="Physical" min="200" max="200" />
		
		<!-- Anim -->
		<targettype type="alive" target="source_entity">
			<playanim name="ability_4_attack" variations="4" length="400" target="source_entity" />
		</targettype>
		
		<resetattackcooldown />
		<order command="attack" />
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100"
		displayname="true"
		cooldowntime="110000,100000,90000"
	>
		<onimpact>
			<applystate name="State_Stunned_Static" duration="100"  target="target_entity" />
			<applystate name="State_Swiftblade_Ability4" duration="1600,2400,3600" target="source_entity" />
			<teleport interpolate="true" facetarget="true" />
			<damage effecttype="Physical" min="200" max="200" />
			
			<!-- Anim -->
			<targettype type="alive" target="source_entity">
				<playanim name="ability_4_attack" variations="4" length="400" target="source_entity" />
			</targettype>
			
			<resetattackcooldown />
			<order command="attack" />
		</onimpact>
	</modifier>
</ability>
