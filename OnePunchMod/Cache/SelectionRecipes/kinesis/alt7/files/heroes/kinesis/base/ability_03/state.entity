<?xml version="1.0" encoding="UTF-8"?>
<statenetaccum
	name="State_Kinesis_Ability3"

	icon="../../icon.dds"
	passiveeffect="/heroes/kenisis/alt7/ability_03/effects/state_shield.effect"
	
	shield="true"
	maxaccumulator="500"

	movespeedpercharge="1"
	movespeed="10"
	
	effecttype=""
	allowtransfer="false"
	
	modifierkey="kinesis_shield_on"
	dynamicprecache="effects/impact.effect,effects/state_expire.effect"
>
	<onattackedpostimpact>
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="source_entity" />
		</else>
	</onattackedpostimpact>
	
	<onexpired>
		<setstr0 a="altavatar_path" b="effects/state_expire.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/state_expire.effect" source="source_entity" />
		</else>
		<setaccumulator entity="this_proxy_entity" value="0" />
	</onexpired>

	<onframe>
		<evaluate a="accumulator" b="4" op="div" />
		<setcharges a="result" />
	</onframe>
</statenetaccum>