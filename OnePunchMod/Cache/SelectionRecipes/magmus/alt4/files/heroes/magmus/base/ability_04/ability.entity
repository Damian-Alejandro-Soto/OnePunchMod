<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Magmus4"

	icon="/heroes/magmar/alt4/ability_04/icon.dds"

	statuseffecttooltip="State_Magmus_Ability4"
	anim="idle"
	casttime="2000"
	castactiontime="2000"
	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="self_position"
	targetradius="300"
	casteffecttype="Magic"
	casteffect=""
	targetscheme="enemy_units"
	manacost="175,250,325"
	cooldowntime="140000,120000,100000"
	dynamicprecache="effects/start.effect,effects/self.effect,effects/rad.effect,effects/impact.effect,effects/rad_boost.effect"

>
	<onstart>
		<!-- Account for cast speed -->
		<compare a="source_castspeed" b="0" op="gt">
			<evaluate a="1" b="source_castspeed" op="div" source="source_entity" target="source_entity" />
			<setvar0 a="result" b="2000" op="mult" />
			<showchannelbar duration="var0" />
		</compare>
		<applystate name="State_Magmus_Ability4_SelfCast" duration="2000" target="source_entity" />

		<!-- Delay animation for 1 frame so it plays immediately after using ability_01 -->
		<evaluate a="frametime" b="1000" op="mult" />
		<applystate name="State_Magmus_Ability4_AnimSync" duration="result" target="source_entity" />
	</onstart>
	
	<oncancel>
		<hidechannelbar />
		<expirestate name="State_Magmus_Ability4_SelfCast" target="source_entity" />
	</oncancel>

	<onimpact>
		<setstr0 a="altavatar_path" b="effects/start.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/start.effect" source="source_position" target="source_position" occlude="true" />
		</else>
			<setstr0 a="altavatar_path" b="effects/self.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/self.effect" source="source_entity" target="source_entity" />
		</else>
		<spawnaffector name="Affector_Magmus_Ability4" target="source_entity" proxy="source_entity" param="0" />
	</onimpact>
</ability>