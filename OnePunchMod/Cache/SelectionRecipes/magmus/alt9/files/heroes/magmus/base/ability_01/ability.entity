<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Magmus1"
	
	icon="/heroes/magmar/alt9/ability_01/icon.dds"
	
	anim="ability_1"
	casttime="100"
	castactiontime="0"
	casteffect=""
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_dual_position"
	activatescheme="movement"
	
	casteffecttype="Magic"
	targetscheme="enemy_units"
	manacost="110,120,130,140"
	cooldowntime="12000"
	
	range="400,500,600,700"
	targetradius="145"
	
	showlinecast="true"
	linecastrange="-1"
	linecastmaxrange="430,530,630,730"
	linecastwidth="145"
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/cast.effect"
>
	<onimpact>
		<setpos0 position="target_position" />
		<distance target="pos0" />
		<compare a="result" b="1500" op="lt">
			<spawnprojectile name="Projectile_Magmus_Ability1" source="source_entity" target="target_position" bind="source_entity" bindturn="true" />
			<spawnunit name="Gadget_Magmus_Ability1_Trail" source="source_entity" target="source_position" pushentity="true" />
			<spawnprojectile name="Projectile_Magmus_Ability1b" source="source_entity" target="target_position" bind="stack_entity" proxy="stack_entity" />
			<applystate name="State_Magmus_Ability1_Self" target="source_entity" duration="550" />
		</compare>
		<else>
			<!-- Animation correction if distance check fails -->
			<playanim name="idle" target="source_entity" />
		</else>

		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" occlude="true" />
		</else>
	</onimpact>

	<modifier key="ult_boost" modpriority="100"
		range="800,900,1000,1100"
		linecastmaxrange="830,930,1030,1130"
	>
	</modifier>
</ability>
