<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Torturer_Ability3"

	radius="600"
	effect=""
	targetselection="closest"
	maxtotalimpacts="4,5,6,7"
	targetscheme="visible_enemy_units"
	effecttype="Magic"
	impacteffect="/heroes/xalynx/alt5/ability_03/effects/impact.effect"
 dynamicprecache="/heroes/xalynx/alt5/ability_03/effects/beam.effect">
	<onspawn>
	</onspawn>
	
	<onimpact>
		<applystate name="State_Torturer_Ability3" proxy="this_proxy_entity" duration="200" />
		<damage effecttype="Magic" amount="80,140,200,260" />
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/beam.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="this_proxy_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/beam.effect" source="target_entity" target="this_proxy_entity" occlude="true" />
		</else>
	</onimpact>	
</affector>
