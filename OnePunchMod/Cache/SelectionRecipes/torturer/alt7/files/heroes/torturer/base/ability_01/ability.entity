<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Torturer1"

	icon="../../icon.dds"
	
	anim="ability_1"
	casttime="1000"
	castactiontime="500"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetradius="225"
	targetmaterial="/shared/materials/area_cast_indicator.material"
	casteffecttype="Magic"
	targetscheme="enemy_units_and_trees"

	manacost="105,120,135,150"
	cooldowntime="9000"
	
	range="650"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	
	dynamicprecache="/heroes/xalynx/alt7/ability_01/effects/area_impact4.effect"
>
	
	<onimpact>
		<spawnaffector name="Affector_Torturer_Ability1" target="target_position" />
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/area_impact4.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="target_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/area_impact4.effect" source="target_position" target="target_position" occlude="true" />
		</else>
	</onimpact>
</ability>
