<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Hammerstorm_Ability1"

	speed="1300"
	gravity="5000"

	modelscale="2.5"
	model="/heroes/hammerstorm/alt10/ability_01/effects/projectile/model.mdf"

	effectscale="2.0"
	impacteffect="/heroes/hammerstorm/alt10/ability_01/effects/impact.effect"

 traileffect="/heroes/hammerstorm/alt10/ability_01/effects/trail.effect">
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<spawnaffector name="Affector_Hammerstorm_Ability1" target="this_position" />
				
				<!-- Staff of the Master -->
				<hasmodifier name="ult_boost" entity="source_entity">
					<spawnunit name="Gadget_Hammerstorm_Ability1" target="this_position" offset="0 0 300" pushentity="true" />
					<setproxy entity="this_proxy_entity" target="stack_entity" />
					<applystate name="State_Hammerstorm_Ability1" target="source_entity" duration="3000" proxy="stack_entity" />
					<starttimer duration="3000" entity="this_proxy_entity" />
				</hasmodifier>
			</onimpact>
		</combatevent>
	</onimpact>

	<modifier key="ult_boost" modpriority="100"
		speed="1800"
	>
	</modifier>
</projectile>
