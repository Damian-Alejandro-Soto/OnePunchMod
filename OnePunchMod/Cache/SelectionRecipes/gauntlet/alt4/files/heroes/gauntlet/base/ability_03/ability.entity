		showrangeandradiusintooltip="true"
	>
		<onimpact>
			<setpos0 position="source_position" positionend="target_position" positionmodifier="pointonline" positionvalue="100" />
			<useability slot="1" target="pos0" />
		</onimpact>
	</modifier>
</ability>