	anim="ability_4"
	casttime="600"
	castactiontime="300"

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_entity"
	casteffecttype="SuperiorMagic"
	targetscheme="enemy_units"
	
	manacost="100,150,200"
	cooldowntime="80000,70000,60000"
	cooldowntype="Gauntlet_R"
	
	range="600"
	allowoutofboundscast="true"
	
	targetradius="200,225,250"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"

	targetpriorities="enemy_heroes"	
	modifierkey="Gauntlet_R1,Gauntlet_R2,Gauntlet_R3"
	dynamicprecache="effects/link.effect"
>
	<onimpact>
		<spawnunit name="Gadget_Gauntlet_Ability4" target="source_position" pushentity="true" duration="-1" />
		<spawnprojectile name="Projectile_Gauntlet_Ability4" source="source_entity" bind="stack_entity" bindturn="true" proxy="stack_entity" target="target_entity" offset="50 60 0" />
		<spawnaffector name="Affector_Gauntlet_Ability4" target="stack_entity" ignore="target_entity" proxy="stack_entity" />
		<targettype type="alive" target="source_entity">
			<playanim name="nohand_idle" target="source_entity" />
		</targettype>
	</onimpact>

	<modifier key="ult_boost" modpriority="100"
		cooldowntime="70000,60000,50000"
		targetradius="300,350,400"
		interface="single_plus_one"
	>
	</modifier>

</ability>