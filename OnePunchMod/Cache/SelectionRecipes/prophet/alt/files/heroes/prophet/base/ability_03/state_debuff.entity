<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Prophet_Ability3_Debuff"

	icon="../../icon.dds"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	
	passiveeffect="/heroes/prophet/alt2/ability_03/effects/state2.effect,/heroes/prophet/alt2/ability_03/effects/state3.effect,/heroes/prophet/alt2/ability_03/effects/state4.effect"
	
	maxcharges="1,2,3,4"
	dynamicprecache="effects/explosion.effect"
>
	<onframe />
	
	<oninflict>
		<setcharges a="1,2,3,4" />
		<applystate name="State_Stunned" duration="500" source="this_proxy_entity" />
		<damage effecttype="Magic" amount="50" source="this_proxy_entity" />
	</oninflict>
	
	<onrefresh>
		<setcharges a="1,2,3,4" />
		<applystate name="State_Stunned" duration="500" source="this_proxy_entity" />
		<damage effecttype="Magic" amount="50" source="this_proxy_entity" />
	</onrefresh>
	
	<onattackedpreimpact>
		<targettype type="enemy">
			<targettype type="player_controlled" >
				<combatsupertype supertype="attack">
					<combateffecttype effecttype="Attack">
						<applystate name="State_Stunned" duration="250" source="this_proxy_entity" target="source_entity" />
						<damage effecttype="Magic" amount="50" source="this_proxy_entity" target="source_entity" />
						<removecharge />
						
						<!-- Start of art -->
						<setstr0 a="altavatar_path" b="effects/explosion.effect" op="add" />
						<exists path="str0">
							<playeffectdynamic effect="str0" source="source_position" occlude="true" />
						</exists>
						<else>
							<playeffectdynamic effect="effects/explosion.effect" source="source_position" occlude="true" />
						</else>
						
						<compare a="charges" b="3" op="eq">
							<setactivemodifierkey entity="this_entity" name="Prophet_Ability3_3" />
						</compare>
						<compare a="charges" b="2" op="eq">
							<setactivemodifierkey entity="this_entity" name="Prophet_Ability3_2" />
						</compare>
						<compare a="charges" b="1" op="eq">
							<setactivemodifierkey entity="this_entity" name="Prophet_Ability3_1" />
						</compare>
						<compare a="charges" b="0" op="eq">
							<expire />
						</compare>
						<!-- End of art -->
					</combateffecttype>
				</combatsupertype>
				
				<!-- Prophet ultimate split projectiles -->
				<else>
					<hasmodifier entity="this_owner_entity" name="Prophet_Proc">
						<applystate name="State_Stunned" duration="250" source="this_proxy_entity" target="source_entity" />
						<damage effecttype="Magic" amount="50" source="this_proxy_entity" target="source_entity" />
						<removecharge />
						
						<!-- Start of art -->
						<setstr1 a="altavatar_path" b="effects/explosion.effect" op="add" />
						<exists path="str1">
							<playeffectdynamic effect="str1" source="source_position" occlude="true" />
						</exists>
						<else>
							<playeffectdynamic effect="effects/explosion.effect" source="source_position" occlude="true" />
						</else>
						
						<compare a="charges" b="3" op="eq">
							<setactivemodifierkey entity="this_entity" name="Prophet_Ability3_3" />
						</compare>
						<compare a="charges" b="2" op="eq">
							<setactivemodifierkey entity="this_entity" name="Prophet_Ability3_2" />
						</compare>
						<compare a="charges" b="1" op="eq">
							<setactivemodifierkey entity="this_entity" name="Prophet_Ability3_1" />
						</compare>
						<compare a="charges" b="0" op="eq">
							<expire />
						</compare>
						<!-- End of art -->
					</hasmodifier>
				</else>
			</targettype>
		</targettype>
	</onattackedpreimpact>

	<modifier key="Prophet_Ability3_3" modpriority="100"
		passiveeffect="effects/state3.effect"
	/>
	
	<modifier key="Prophet_Ability3_2" modpriority="100"
		passiveeffect="effects/state2.effect"
	/>
	
	<modifier key="Prophet_Ability3_1" modpriority="100"
		passiveeffect="effects/state1.effect"
	/>
</state>
