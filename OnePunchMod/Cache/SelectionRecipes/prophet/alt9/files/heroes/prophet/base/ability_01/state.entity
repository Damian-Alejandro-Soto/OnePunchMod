<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Prophet_Ability1"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/prophet/alt9/ability_01/effects/state.effect"
	
	movespeedslowstart="0.25"
	movespeedslowmid="0.15"
	movespeedslowend="0.0"
	movespeedslowduration="4000"
	movespeedslowmidpos="0.2"

	incomingdamagemultiplier="0.04,0.08,0.12,0.16"
	effecttype="StatusDebuff"
	allowtransfer="true"
	dynamicprecache="effects/damage_impact.effect"
>
	<onframe />
	
	<ondamaged>
		<targettype type="hero" >
			<damageeffecttype effecttype="DOT" />
			<else>
				<setstr0 a="altavatar_path" b="effects/damage_impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" target="source_entity" source="source_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/damage_impact.effect" target="source_entity" source="source_entity" />
				</else>
			</else>
		</targettype>
	</ondamaged>
</state>