<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Chronos2"

	icon="/heroes/chronos/alt9/ability_02/icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="passive"
	passiveeffect=""
	dynamicprecache="effects/impact.effect"
>
	<onframe />
	
	<ondamaged priority="-1">
		<chance threshold="0.25">
			<setvar2 a="source_damage" b="0.65,0.7,0.75,0.8" op="mult" />
			<setvar2 a="var2" b="accumulator" op="add" /> 
			<setaccumulator value="var2" />
			<setactivemodifierkey name="chronos_W_active" />

			<!-- Only play VFX and SFX for non-DoT instances of damage -->
			<damageeffecttype effecttype="DOT" />
			<else>
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_entity" target="" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="source_entity" target="" />
				</else>
			</else>
		</chance>
	</ondamaged>

	<modifier key="chronos_W_active" modpriority="100"
		passiveeffect="/heroes/chronos/base/ability_02/effects/state.effect"
	>
		<onframe>
			<compare a="accumulator" b="0" op="gt">
				<setvar0 a="frametime" b="source_maxhealth" op="mult" />
				<heal target="source_entity" a="var0" b="0.04,0.06,0.08,0.10" op="mult" ishealingovertime="true" />
				<setvar1 a="accumulator" b="result" op="sub" />
				<setaccumulator value="var1" />
			</compare>
			<else>
				<setactivemodifierkey name="" />
			</else>
		</onframe>
	</modifier>
</ability>
