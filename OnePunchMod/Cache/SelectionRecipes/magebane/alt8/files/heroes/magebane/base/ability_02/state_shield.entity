<?xml version="1.0" encoding="UTF-8"?>
<statenetaccum
	name="State_Magebane_Ability2_Shield"

	icon="../../icon.dds"
	effecttype="StatusBuff"
	allowtransfer="true"
	
	passiveeffect="/heroes/javaras/alt8/ability_02/effects/state_shield.effect"
	
	shield="true"
	maxaccumulator="40,70,100,130"
>
	<onframe />
	
	<oninflict>
		<setaccumulator value="40,70,100,130" />
	</oninflict>
	
	<onrefresh>
		<setaccumulator value="40,70,100,130" />
	</onrefresh>
	
	<ondamaged>
		<!-- % Damage to potentially be absorbed by the shield -->
		<setvar0 a="source_damage" b="0.5" op="mult" />
		
		<damageeffecttype effecttype="Magic">
			<compare a="var0" b="accumulator" op="ge">
				<evaluate a="var0" b="accumulator" op="sub" />
				<evaluate a="result" b="var0" op="add" />
				<changedamage b="result" op="min" />
				<setaccumulator value="0" />
				<expire />
			</compare>
			<else>
				<changedamage b="0.5" op="mult" />
				<evaluate a="accumulator" b="var0" op="sub" />
				<setaccumulator value="result" />
			</else>
		</damageeffecttype>
		<else>
			<damageeffecttype effecttype="SuperiorMagic">
				<compare a="var0" b="accumulator" op="ge">
					<evaluate a="var0" b="accumulator" op="sub" />
					<evaluate a="result" b="var0" op="add" />
					<changedamage b="result" op="min" />
					<setaccumulator value="0" />
					<expire />
				</compare>
				<else>
					<changedamage b="0.5" op="mult" />
					<evaluate a="accumulator" b="var0" op="sub" />
					<setaccumulator value="result" />
				</else>
			</damageeffecttype>
		</else>
	</ondamaged>
</statenetaccum>
