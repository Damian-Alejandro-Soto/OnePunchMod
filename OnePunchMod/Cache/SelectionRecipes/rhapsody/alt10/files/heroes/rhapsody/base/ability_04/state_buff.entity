				<scaledamage scale="0.0" />
			</damageeffecttype>
			<else>
				<damageeffecttype effecttype="Physical" >
					<scaledamage scale="0.0" />
				</damageeffecttype>
				<else>
					<damageeffecttype effecttype="SuperiorPhysical" >
						<scaledamage scale="0.0" />
					</damageeffecttype>
					<else>
						<damageeffecttype effecttype="Returned" >
							<scaledamage scale="0.0" />
						</damageeffecttype>
					</else>
				</else>
			</else>
		</else>
	</ondamaged>
</state>
