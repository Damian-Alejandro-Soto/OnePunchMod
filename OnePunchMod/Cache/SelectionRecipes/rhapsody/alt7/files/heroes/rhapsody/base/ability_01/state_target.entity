<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Rhapsody_Ability1_Target"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/rhapsody/alt7/ability_01/effects/state_enemy.effect"
	effecttype="StatusDebuff"
	
>
	<oninflict>
		<setcharges a="1,2,3,4" />
	</oninflict>
	
	<onframe>
		<compare a="charges" b="0" op="eq">
			<expire />
		</compare>
	</onframe>
	
	<onexpired>
		<expire entity="proxy_entity" />
	</onexpired>
</state>