<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Chipper1"

	icon="../../icon.dds"
	
	anim="ability_1"
	casttime="0"
	castactiontime="0"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	casteffecttype="Magic"
	targetscheme="nonneutral_enemy_units"
	casteffect="/heroes/chipper/trophy_skin/model_01/ability_01/effects/cast.effect"
	
	manacost="40,50,60,70"
	cooldowntime="0"
	frontqueue="true"
	inheritmovement="true"
	noturntotarget="false"
	nonaggressive="true"

	range="3000"
	forcerange="3000"
	allowoutofboundscast="true"
	targetradius="75"
	
	maxcharges="1,2,3,4"
	chargerefreshtime="3000,2660,2330,2000"

	showlinecast="true"
	linecastrange="3070"
	linecastwidth="70"
	
	passiveeffect=""
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/impact.effect"
>
	
	<onlearn>
		<setcharges a="1" />
	</onlearn>
	
	<onupgrade>
		<addcharges count="1" />
	</onupgrade>

	<onframe>
		<compare a="charges" b="0" op="gt">
			<setactivemodifierkey name="" />
		</compare>
	</onframe>

	<onimpact>
		<spawnunit name="Gadget_Chipper_Ability1_Reveal" count="1" target="source_position" pushentity="true" facing="target_position" />
		<spawnprojectile name="Projectile_Chipper_Ability1" source="source_entity" target="target_position" bind="stack_entity" proxy="stack_entity" offset="0 60 120" offsetspace="stack_entity" />

		<removecharge />
		<compare a="charges" b="0" op="eq">
			<setactivemodifierkey name="chipperrocketdisabled" />
		</compare>
	</onimpact>
	
	<ondeath>
		<setcharges a="1,2,3,4" />
	</ondeath>

	<modifier key="ult_boost" modpriority="101"
		maxcharges="3,4,5,6"
	>
		<ondeath>
			<setcharges a="3,4,5,6" />
		</ondeath>
	</modifier>

	<!-- Midwars-only tooltip routing -->
	<modifier key="OnlyMidMap" modpriority="100"
	/>

	<modifier key="chipperrocketdisabled" modpriority="100"
		disabled="true"
	>
	</modifier>
	
	<modifier key="iamsheeped" modpriority="100"
		passiveeffect=""
	/>
</ability>
