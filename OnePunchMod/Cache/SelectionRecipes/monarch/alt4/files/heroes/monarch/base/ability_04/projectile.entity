<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Monarch_Ability4"

	speed="3250"
	gravity=""
	
	flying="true"
	flyheight="60"
	
	modelscale="14,17,20"
	model="/heroes/tempest/base/projectile/effects/spinner.mdf"
	traileffect="/heroes/monarch/alt4/ability_04/effects/trail.effect"
	effectscale="1.0"
	
	maxtouchespertarget="1"
	touchradius="300,300,300"
	toucheffecttype="SuperiorMagic"
 dynamicprecache="/heroes/monarch/alt4/ability_04/effects/impact.effect">
	<onspawn>
		<!-- Dynamic impact effect -->
	</onspawn>
	
	<onimpact>
		<kill target="this_proxy_entity" source="" />
	</onimpact>
	
	<ontouch>
		<cantarget targetscheme="ally_units">
			<!-- Dynamic impact effect -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
			</else>

			<dispel type="StatusDebuff" />
			<dispel type="StatusDisable" />
			<applystate name="State_Monarch_Ability4" duration="6000" />
		</cantarget>
	</ontouch>

	<modifier key="ult_boost" modpriority="105"
		touchradius="900"
	>
		<ontouch>
			<cantarget targetscheme="ally_units">
				<!-- Dynamic impact effect -->
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" target="" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
				</else>

				<dispel type="StatusDebuff" />
				<dispel type="StatusDisable" />
				<applystate name="State_Monarch_Ability4" duration="6000" />
				<applystate name="State_Monarch_Ability4_Staff" duration="3000" />
			</cantarget>
	    </ontouch>
	</modifier>

</projectile>
