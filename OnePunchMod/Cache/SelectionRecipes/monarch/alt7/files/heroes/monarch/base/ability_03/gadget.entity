<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_Monarch_Ability3"
	
	icon="icon2.tga"
	portrait="icon2.tga"
	
	model="/heroes/monarch/alt7/ability_03/effects/bug/model01.mdf"
	
	preglobalscale="1"
	modelscale="1.5"
	effectscale="1"
	boundsheight="64"
	boundsradius="16"
	isselectable="true"
	iscontrollable="true"
	selectionradius="20"
	targetoffset="0 0 64"

	canrotate="false"
	ismobile="false"
	unitwalking="true"

	maxhealth="1"
	inventory0=""
	inventory1=""
	inventory2="Ability_Gadget_Monarch3"

	immunity="GadgetImmunity"
	unittype="SightWard"

	attacktype="none"
	combattype="Ranged"
	stealthtype="hero"
	fadetime="500"
	stealthproximity="250"

	sightrangeday="1200"
	sightrangenight="1200"
	
	goldbountymin="80"
	goldbountymax="80"
	experiencebounty="0"
	
	nothreat="true"
	
	corpsetime="50"
	corpsefadetime="100"
	corpsefadeeffect="/shared/effects/corpse_sink.effect"
	
	lifetime="240000"
	showlifetime="true"

	noblockneutralspawn="true"
	dynamicprecache="effects/spawn.effect,effects/death.effect"
	
>
	<onframe>
		<areaofeffect
			radius="250"
			targetselection="all"
			targetscheme="visible_enemy_units"
			effecttype=""
			center="this_entity"
		/>
		<compare a="result" b="1" op="ge">
			<kill target="this_entity" source="" />
		</compare>
	</onframe>

	<onattackedpreimpact>
		<setvalue name="combat_truestrike" a="1" />
	</onattackedpreimpact>
	
	<onspawn>
		<setstr0 a="altavatar_path" b="effects/spawn.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/spawn.effect" source="this_position" occlude="true" />
		</else>
		<startfade />
		<addcharges entity="this_proxy_entity" count="1"  />
	</onspawn>
	
	<ondeath>
		<setstr0 a="altavatar_path" b="effects/death.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/death.effect" source="source_entity" target="" />
		</else>
		<addcharges entity="this_proxy_entity" count="-1" />
		<spawnunit name="Gadget_Monarch_Cloud_Ability3" target="source_entity" pushentity="true" count="1" />
		<spawnaffector name="Affector_Monarch_Ability3" target="stack_entity" source="this_owner_entity" owner="this_owner_entity" />
	</ondeath>
		
	<onexpired>
		<setstr0 a="altavatar_path" b="effects/death.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/death.effect" source="source_entity" target="" />
		</else>
		<delete target="this_entity" />
		<addcharges entity="this_proxy_entity" count="-1" />
	</onexpired>
</gadget>