<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Glacius_Ability1"

	radius="400"
	
	targetselection="all"
	targetscheme="enemy_units"
	effecttype="Magic"
 icon="/heroes/frosty/alt4/ability_01/icon.dds">
	<onimpact>
		<damage effecttype="Magic" amount="110,160,210,260" />
		<applystate name="State_Glacius_Ability1" duration="3000,3500,4000,4500" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/affector.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/affector.effect" source="target_position" />
		</else>
	</onimpact>	
	
	<!-- Midwars-only changes -->
	<modifier key="OnlyMidMap" modpriority="100">
		<onimpact>
		<damage effecttype="Magic" amount="170,200,230,260" />
		<applystate name="State_Glacius_Ability1" duration="3000,3500,4000,4500" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/affector.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/affector.effect" source="target_position" />
		</else>
	</onimpact>	
	</modifier>
</affector>