<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Drunkenmaster_Ability2"

	lifetime="400"
	useexactlifetime="true"
	
	gravity="0"

	modelscale="2"
	model="/shared/models/invis.mdf"
	
	traileffect="/heroes/drunkenmaster/alt5/ability_02/effects/warp.effect"
	
	canturn="false"
	flying="true"
	pathing="true"
	flyheight="0"
	
	range="400"
 dynamicprecache="/heroes/drunkenmaster/alt5/ability_02/effects/aoe_impact.effect">
	<onspawn>
	</onspawn>
	
	<onimpact>
		<!-- Damage -->
		<setvar0 a="45,70,95,120" />
		<areaofeffect
			radius="200"
			targetselection="closest"
			targetscheme="enemy_units"
			effecttype="Physical"
		>
			<targettype type="hero">
				<damage effecttype="Physical" amount="1" b="var0" op="mult" />
			</targettype>
			<else>
				<damage effecttype="Physical" amount="1.75" b="var0" op="mult" />
			</else>
			
		</areaofeffect>
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/aoe_impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/aoe_impact.effect" source="source_position" target="" occlude="true" />
		</else>
	</onimpact>	
</projectile>
