		<!-- Cooldown reduction -->
		<pushtool name="Ability_DrunkenMaster1" />
		<reducecooldown duration="500" entity="stack_entity" />
		<pushtool name="Ability_DrunkenMaster2" />
		<reducecooldown duration="500" entity="stack_entity" />
	</onimpact>	
</state>
