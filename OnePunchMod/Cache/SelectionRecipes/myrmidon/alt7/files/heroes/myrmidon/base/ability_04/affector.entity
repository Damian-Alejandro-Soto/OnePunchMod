<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Myrmidon_Ability4"

	radius="250"

	targetselection="all"
	targetscheme="enemy_units"
	effecttype=""
 dynamicprecache="/heroes/hydromancer/alt7/ability_04/effects/splash_damage.effect">
	<onspawn>
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/splash_damage.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_owner_target_entity" target="" occlude="true" />
		</exists>			
		<else>	
			<setstr0 a="altavatar_path" b="effects/splash_damage.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="this_owner_target_entity" target="" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/splash_damage.effect" source="this_owner_target_entity" target="" occlude="true" />
			</else>
		</else>
	</onspawn>
	
	<onimpact>
		<cantarget effecttype="Magic">
			<cantarget targetscheme="all_units">
				<applystate name="State_Myrmidon_Ability4_Slow" duration="3000" target="target_entity" disablenegativeeffectpopuponrefresh="true" />
			</cantarget>

			<hasmodifier name="ult_boost" entity="source_entity" />
			<else>
				<setparam a="70,120,170" />
			</else>

			<setvar0 a="param" />
			<compare a="source_attackdamage" b="var0" op="le">
				<targettype type="illusion" target="source_entity">
					<damage effecttype="SuperiorMagic Splash Cleave" amount="0.33" b="var0" op="mult" />
				</targettype>
				<else>
					<damage effecttype="SuperiorMagic Splash Cleave" amount="1" b="var0" op="mult" />
				</else>
			</compare>
			<else>
				<!-- Convert a percentage of the extra Attack Damage to extra Magic Damage -->
				<setvar1 a="source_attackdamage" b="var0" op="sub" />
				<setvar1 a="var1" b="0.7" op="mult" />
				<setvar1 a="var0" b="var1" op="add" />
				
				<targettype type="illusion" target="source_entity">
					<damage effecttype="SuperiorMagic Splash Cleave" amount="0.33" b="var1" op="mult" />
				</targettype>
				<else>
					<damage effecttype="SuperiorMagic Splash Cleave" amount="1" b="var1" op="mult" />
				</else>
			</else>
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" occlude="true" />
			</else>			
			
		</cantarget>
		<else>
			<applystate name="State_Myrmidon_Ability4_Slow" duration="3000" target="target_entity" />
			
			<targettype type="illusion" target="source_entity">
				<damage effecttype="Physical" amount="0.33" b="source_attackdamage" op="mult" />
			</targettype>
			<else>
				<damage effecttype="Physical" amount="1" b="source_attackdamage" op="mult" />
			</else>
		</else>
	</onimpact>
</affector>
