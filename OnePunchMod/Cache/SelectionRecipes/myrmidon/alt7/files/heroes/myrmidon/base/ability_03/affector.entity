<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Myrmidon_Ability3"

	radius="200"
	lifetime="-1"

	targetselection="all"
	targetscheme="enemy_units"
	maximpactspertarget="1"
	
	effecttype="Magic"
	impacteffect="/heroes/hydromancer/alt7/ability_03/effects/impact.effect"
>
	<onimpact>
		<applystate name="State_Myrmidon_Ability3_Slow" target="target_entity" duration="3000" />
		
		<targettype type="Boss" />
		<else>
			<applystate name="State_Myrmidon_Ability3_MagicArmor" target="target_entity" duration="6000" />
		</else>
	</onimpact>
</affector>
