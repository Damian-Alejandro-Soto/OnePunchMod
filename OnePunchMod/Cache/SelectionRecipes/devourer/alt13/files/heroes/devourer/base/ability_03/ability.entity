<?xml version="1.0" encoding="UTF-8"?>
<abilityattribute
	name="Ability_Devourer3"

	icon="/heroes/Devourer/alt13/ability_03/icon.dds"

	maxlevel="5"
	requiredlevel="0,1,3,5,7"
	baselevel="1"

	actiontype="passive"

	strengthpercharge="0,1,1.25,1.5,1.75"
	
	magicarmor="0,2,3,4,5"
>
	<aura state="State_Devourer_Ability3" radius="500" targetscheme="enemy_heroes" stack="true" notooltip="true" />

	<onkill propagatetoillusions="false" >
		<targettype type="hero">
			<targettype type="illusion" />
			<else>               
				<targettype type="mimic" />
				<else> 
					<targettype type="self" />
					<else>
						<targettype type="heropet" />
						<else>
							<addcharges />
						</else>
					</else>
				</else>
			</else>
		</targettype>
	</onkill>
	
	<onimpact />   
</abilityattribute>