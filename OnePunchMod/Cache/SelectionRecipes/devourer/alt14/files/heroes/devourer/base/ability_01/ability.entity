<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Devourer1"

	icon="/heroes/Devourer/alt14/ability_01/icon.dds"

	anim="ability_1"
	casttime="600"
	castactiontime="300"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	casteffecttype="Physical Push"
	targetscheme="hook_targets"
	casteffect="/heroes/devourer/alt14/ability_01/effects/cast.effect"

	manacost="100,110,120,130"
	cooldowntime="15000,14000,13000,12000"

	projectile="Projectile_Devourer_Ability1"

	range="925,1050,1175,1300"
	forcerange="925,1050,1175,1300"	
	targetradius="70"
	allowoutofboundscast="true"

	showlinecast="true"
	linecastrange="955,1080,1205,1330"
	linecastwidth="70"

	showrangeandradiusintooltip="true"
	dynamicprecache="effects/trail.effect,effects/impact.effect"
>
	<onlearn>
		<hasmodifier entity="source_entity" name="track_abilities">
			<setgameplaystat index="0" target="source_entity" a="0" /> <!-- Attempts to hook -->
			<setgameplaystat index="1" target="source_entity" a="0" /> <!-- Hook hits -->
		</hasmodifier>
	</onlearn>

	<onabilityimpact>
		<entitytype type="Ability_Devourer1" target="inflictor_entity" source="inflictor_entity">
			<hasmodifier entity="source_entity" name="track_abilities">
				<setgameplaystat index="0" target="source_entity" a="target_gameplaystat0" b="1" op="add" /> <!-- Hook Attempt! +1 -->
			</hasmodifier>
		</entitytype>
		<applystate name="State_Devourer_Ability1_Data" duration="2000" target="source_entity" />
	</onabilityimpact>

	<onimpact />
	
</ability>