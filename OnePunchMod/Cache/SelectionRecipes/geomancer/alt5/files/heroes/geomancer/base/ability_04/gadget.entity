<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_Geomancer_Ability4"
	
	model="/shared/models/invis.mdf"
	skin=""
	unitwalking="true"
	diewithowner="false"
	
	passiveeffect="/heroes/geomancer/alt5/ability_04/effects/delay.effect"
	spawneffect=""
	
	
	
	isselectable="false"
	iscontrollable="false"
	
	
	preglobalscale="1.5"
	modelscale="1.0"
	effectscale="0.9"
	boundsheight="64"
	boundsradius="16"
	selectionradius="36"
	targetoffset="0 0 0"

	drawonmap="false"
	invulnerable="true"
	canattack="false"

	corpsetime="0"
	corpsefadetime="0"
	deathtime="0"
	
	lifetime="2500"
	dynamicprecache="effects/explosion.effect,effects/explosion_boost.effect"
>
	<onexpired>
		<setstr0 a="altavatar_path" b="effects/explosion.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="this_position" source="this_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/explosion.effect" target="this_position" source="this_position" occlude="true" />
		</else>
		<areaofeffect
			radius="350"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
		>
			<applystate name="State_Geomancer_Ability4" duration="2000,2500,3000" />
			<damage effecttype="Magic" amount="300,450,600" source="this_owner_entity" />
		</areaofeffect>
	</onexpired>
	
	
	<modifier key="ult_boost" modpriority="100"
		passiveeffect="/heroes/geomancer/alt5/ability_04/effects/delay_boost.effect"
	>
		<aura state="State_Geomancer_Ability4_Slow_Initial" effecttype="" targetscheme="enemy_units" radius="600" />
		
		<onexpired>
			<setstr0 a="altavatar_path" b="effects/explosion_boost.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="this_position" source="this_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/explosion_boost.effect" target="this_position" source="this_position" occlude="true" />
			</else>
			<areaofeffect
				radius="350"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="Magic"
			>
				<applystate name="State_Geomancer_Ability4" duration="2000,2500,3000" />
				<damage effecttype="Magic" amount="300,450,600" source="this_owner_entity" />
			</areaofeffect>
			<areaofeffect
				radius="600"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="Magic"
			>
				<applystate name="State_Geomancer_Ability4_Slow" duration="4000" />
				<damage effecttype="Magic" amount="100,120,140" source="this_owner_entity" />
			</areaofeffect>
		</onexpired>
	</modifier>
</gadget>
