<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Revenant_Ability3"

	icon="../../icon.dds"
	passiveeffect="/heroes/revenant/alt3/ability_03/effects/state.effect"
	
	stealthtype="hero"
	hideshadow="true"
	fadetime="1000"
	unitwalking="true"

	effecttype="StatusStealth"
	dynamicprecache="effects/initial_impact.effect"
>
	<oninflict>
		<setstr0 a="altavatar_path" b="effects/initial_impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/initial_impact.effect" source="target_entity" />
		</else>
		<forgetattacks />
		<startfade />
	</oninflict>
	
	<onattackpredamage>
		<cantarget targetscheme="enemy_units">
			<targettype type="Boss" />
			<else>
				<applystate name="State_Revenant_Ability3_Armor" target="target_entity" duration="6000" />
			</else>
		</cantarget>
	</onattackpredamage>
	
	<onattack>
		<expire />
	</onattack>
	
	<onactivatepreimpact>
		<expire />
		<isitem entity="inflictor_entity" >
			<expire />
		</isitem>
	</onactivatepreimpact>
	
	
	<modifier key="Revenant_Ability4_1" modpriority="100"
		movespeedmultiplier="0.18"
	>
		<onactivatepreimpact>
			<condition target="this_inflictor_entity" source="source_entity" test="target_entity eq source_entity" />
			<else>
				<expire />
			</else>
			<isitem entity="inflictor_entity" >
				<expire />
			</isitem>
		</onactivatepreimpact>
	</modifier>
	
