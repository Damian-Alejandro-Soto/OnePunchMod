<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Revenant4"

	icon="/heroes/revenant/alt4/ability_04/icon.dds"
	
	maxlevel="3"
	requiredlevel="4,8,12"

	actiontype="passive"

	noshuffle="true"

	modifierkey="Revenant_Ability4_1,Revenant_Ability4_2,Revenant_Ability4_3"
>

	<onframe />
	
	<onlearn>
		<targettype type="alive" target="source_entity" >
			<applystate name="State_Revenant_Ability4_Effect1" target="source_entity" duration="-1" />
		</targettype>
	</onlearn>
	
	<onupgrade>
		<targettype type="alive" target="source_entity" >
			<applystate name="State_Revenant_Ability4_Effect2" target="source_entity" duration="-1" />
			<expirestate name="State_Revenant_Ability4_Effect1" target="source_entity" />
		</targettype>
	</onupgrade>

	<modifier key="Revenant_Ability4_2" modpriority="100" >
		<onupgrade>
			<targettype type="alive" target="source_entity" >
				<applystate name="State_Revenant_Ability4_Effect3" target="source_entity" duration="-1" />
				<expirestate name="State_Revenant_Ability4_Effect2" target="source_entity" />
			</targettype>
		</onupgrade>
	</modifier>
	
	<modifier key="ult_boost" modpriority="101"
		modifierkey="Revenant_Ability4_1boost,Revenant_Ability4_2boost,Revenant_Ability4_3boost"
	>
	</modifier>
</ability>
