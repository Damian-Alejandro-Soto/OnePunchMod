<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_ReturnDrill_Lodestone_Ability1"
	
	speed="2500"
	
	modelscale="3.0"
	model="/shared/models/invis.mdf"
	traileffect="/heroes/lodestone/alt6/ability_01/effects/trail_return.effect"
	effectscale="1.5"
	impacteffect=""
	
	
>
	<onspawn>
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/link.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_entity" target="this_proxy_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/link.effect" source="this_entity" target="this_proxy_entity" />
		</else>
	</onspawn>
	
	<onimpact>
		<expirestate name="State_NoWeapon_Lodestone_Ability1" target="target_entity" />
		<expirestate name="State_NoWeapon_Lodestone_Ability1" target="this_proxy_entity" />
	</onimpact>
</projectile>