<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Lodestone1"

	icon="/heroes/lodestone/alt5/ability_01/icon.dds"	
	anim="ability_1_cast"
	casttime="300"
	castactiontime="0"
	casteffect="/heroes/lodestone/alt5/ability_01/effects/cast.effect"
	casteffecttype="Magic"
	passiveeffect=""
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	statuseffecttooltip=""

	actiontype="target_position"
	targetradius="200"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	targetscheme="enemy_units"
	
	
	manacost="120"
	cooldowntime="14000"
	
	range="700"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/link.effect,effects/impact.effect,effects/stun_sound.effect"
>
	<onimpact>
		<applystate name="Lodestone_Refresher_Orb_Ability1" target="source_entity" duration="500" />
		<applystate name="State_NoWeapon_Lodestone_Ability1" target="source_entity" duration="11000" />
		<spawnprojectile name="Projectile_Lodestone_Ability1" source="source_entity" offset="50 0 125" target="target_position" proxy="this_entity" pushentity="true" />
		
		<!-- Kinesis Thoughtsteal accommodation -->
		<applystate name="State_Teleport_Lodestone_Ability1" duration="6000" target="source_entity" />
	</onimpact>

	<modifier key="LodestoneTeleport" modpriority="100"
		ignorecooldown="true"
		anim="ability_1_leap"
		icon="icon_b.tga"
		casttime="0"
		castactiontime="0"
		manacost="0"
		actiontype="no_target"
		cooldowntime="0"
		casteffect=""
		activatescheme="movement"
	>
		<onimpact>
			<!-- Cornercase fix for Kinesis Q if Kinesis receives a morphpriority state -->
			<compare a="this_proxy_entity" b="0" op="eq">
				<areaofeffect
					center="source_entity"
					radius="1500"
					targetscheme="my_Lodestone_Q_gadgets"
					targetselection="all"
					ignoreinvulnerable="true"
				>
					<setproxy entity="this_entity" target="target_entity" />
				</areaofeffect>
			</compare>
			
			<distance target="this_proxy_entity" source="source_entity" />
			<compare a="result" b="1500" op="le" >
				<expirestate name="State_Teleport_Lodestone_Ability1" target="source_entity" />
				<setpos0 position="this_proxy_entity" positionend="source_position" positionmodifier="pointonline" positionvalue="-300" />
				<spawnprojectile name="Projectile_Second_Lodestone_Ability1" source="source_entity" target="pos0" bind="source_entity" bindturn="true" bindstate="State_Lodestone_Ability1_Bound" noresponse="true" pushentity="true" />
				<spawnaffector name="Affector_Lodestone_Ability1" target="stack_entity" />
			</compare>
		</onimpact>
	</modifier>
	
	<modifier key="LodestoneRefresherOrb" modpriority="150"
		disabled="true"
	>
	</modifier>
</ability>