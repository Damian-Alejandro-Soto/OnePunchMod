<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Armadon1"

	statuseffecttooltip="State_Armadon_Ability1"
	icon="../../icon.dds"
	
	anim="ability_1"
	casttime="1000"
	castactiontime="200"
	maxlevel="4"
	requiredlevel="1,3,5,7"
	casteffect="/heroes/armadon/alt6/ability_01/effects/cast.effect"

	actiontype="target_entity"
	casteffecttype="Magic"
	targetscheme="enemy_units"
	
	manacost="30"
	cooldowntime="1500"
	
	range="600"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes"
>
	<onimpact>
		<spawnprojectile name="Projectile_Armadon_Ability1" target="target_entity" />
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100" 
	>
		<onimpact>
			<spawnprojectile name="Projectile_Armadon_Ability1" source="source_entity" target="target_entity" proxy="target_entity" param="2" />
		</onimpact>
	</modifier>
	
</ability>
