<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Fayde_Ability4_DoT_Mini"

	icon="/heroes/fade/alt6/ability_04/icon.dds"
	passiveeffect=""
	ishidden="true"
	
	impactinterval="1000"
	
	effecttype="ForceTransferrable"
	allowtransfer="true"
>
	<onframe />
	
	<oninflict>
		<hasmodifier name="fade_R_dot" entity="target_entity" />
		<else>
			<evaluate a="target_health" b="0.10,0.15,0.20" op="mult" />
			<evaluate a="result" b="150,200,250" op="add" />
			<evaluate a="result" b="3" op="div" /> <!-- State damages three times (oninflict, onimpact x2) -->
			
			<damage effecttype="Magic DOT" amount="0.6" b="result" op="mult" /> <!-- Adjust multiplier here -->
			<popup name="poison" a="result" source="target_entity" target="source_entity"/>
		</else>
	</oninflict>

	<onimpact>
		<hasmodifier name="fade_R_dot" entity="target_entity" />
		<else>
			<evaluate a="target_health" b="0.10,0.15,0.20" op="mult" />
			<evaluate a="result" b="150,200,250" op="add" />
			<evaluate a="result" b="3" op="div" /> <!-- State damages three times (oninflict, onimpact x2) -->
			
			<damage effecttype="Magic DOT" amount="0.6" b="result" op="mult" /> <!-- Adjust multiplier here -->
			<popup name="poison" a="result" source="target_entity" target="source_entity"/>
		</else>
	</onimpact>
</state>
