<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_ForsakenArcher4"
	
	icon="/heroes/forsaken_archer/alt9/ability_04/icon.dds"
	
	anim="ability_4"
	casttime="0"
	castactiontime="0"

	maxlevel="3"
	requiredlevel="6,11,16"
	
	actiontype="target_position"
	casteffecttype="Magic"
	targetscheme="enemy_units"
	
	manacost="100,200,300"
	cooldowntime="100000,80000,60000"
	
	range="1475"
	targetradius="175"
	
	showlinecast="true"
	linecastrange="1475"
	linecastwidth="175"
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/cast.effect"
>

	<onimpact>
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_position" />
		</else>

		<spawnunit name="Pet_ForsakenArcher_Ability4" count="1" target="source_position" facing="target_position" pushentity="true" />
		<useability slot="0" source="stack_entity" target="target_position" />
	</onimpact>
</ability>