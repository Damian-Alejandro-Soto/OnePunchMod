<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Moraxus1"

	icon="/heroes/moraxus/alt/ability_01/icon.dds"
	
	anim="ability_1"
	casttime="500"
	castactiontime="300"

	maxlevel="4"
	requiredlevel="1,3,5,7"
	
	actiontype="self_position"
	targetscheme="enemy_units"
	frontqueue="true"
	
	targetradius="300"
	
	casteffecttype="Magic"
	manacost="90,105,120,135"
	cooldowntime="12000"
	dynamicprecache="effects/cast.effect"
>
	<onimpact>
		<areaofeffect
			radius="300"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
		>
			<applystate name="State_Stunned" duration="1750,2000,2250,2500" />
			<damage effecttype="Magic" amount="100,150,200,250" />
		</areaofeffect>

		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_position" target="" occlude="true" />
		</else>
	</onimpact>
</ability>