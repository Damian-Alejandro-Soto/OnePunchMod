<?xml version="1.0" encoding="UTF-8"?>
<statenetaccum
	name="State_Moraxus_Ability4"

	icon="../../icon.dds"
	passiveeffect="/heroes/moraxus/ability_04/effects/state_alt2.effect"
	
	modifierkey="moraxusulton"
	impactinterval="250"
	
	effecttype=""
	
	shield="true"
	maxaccumulator="400,600,800"
	
	maxcharges="8"
	dynamicprecache="effects/impact.effect,effects/cast.effect,../ability_03/effects/impact.effect"
>
	<oninflict>
		<setaccumulator value="200,300,400" />
	</oninflict>
	
	<onimpact>
		<areaofeffect
			radius="800"
			targetselection="all"
			targetscheme="nonillusion_enemy_heroes"
		/>
		<setvar0 a="5,6.25,7.5" b="result" op="mult" />
		<setaccumulator value="accumulator" valueb="var0" valueop="add" />
		<setaccumulator value="accumulator" valueb="400,600,800" valueop="min" />
	</onimpact>
	
	<ondamaged>
		<setvar0 a="source_damage" />
		<compare a="var0" b="accumulator" op="ge">
			<evaluate a="var0" b="accumulator" op="sub" />
			<changedamage b="result" op="min" />
			<setaccumulator value="0" />
		</compare>
		<else>
			<changedamage b="0" op="min" />
			<evaluate a="accumulator" b="var0" op="sub" />
			<setaccumulator value="result" />
		</else>
	</ondamaged>
	
	<onexpired>
		<compare a="accumulator" b="200,300,400" op="lt">
			<setaccumulator value="200,300,400" />
		</compare>
		<popup name="morult" a="accumulator" source="source_entity" target="source_entity"/>
		
		<evaluate a="70000,60000,50000" b="lifetime_remaining" op="add" />
		<startcooldown toolname="Ability_Moraxus4" duration="result" />
		<areaofeffect
			radius="400"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
		>
			<damage effecttype="Magic" amount="1" b="accumulator" op="mult" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
			</else>
		</areaofeffect>
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="" />
		</else>
	</onexpired>
	
	<onframe />
		
	<ondamage />
	
	<modifier key="ult_boost" modpriority="99">
		<onimpact>
			<areaofeffect
				radius="800"
				targetselection="all"
				targetscheme="nonillusion_enemy_heroes"
			/>
			<setvar0 a="5,6.25,7.5" b="result" op="mult" />
			<setaccumulator value="accumulator" valueb="var0" valueop="add" />
			<setaccumulator value="accumulator" valueb="400,600,800" valueop="min" />
			
			<pushtool name="Ability_Moraxus3" />
			<setvar1 a="source_level" source="stack_entity" />
			
			<!-- SotM Specific Stuff; impactinterval = 250ms -->
			<compare a="charges" b="0" op="eq">
				<setpos0 position="source_entity" offset="0 1000 0" offsetspace="" />
				<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="0 150 0" offsetspace="" pushentity="true" />
				<setlevel entity="stack_entity" value="var1" />
			</compare>
			<else>
				<compare a="charges" b="1" op="eq">
					<setpos0 position="source_entity" offset="707 707 0" offsetspace="" />
					<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="106 106 0" offsetspace="" pushentity="true" />
					<setlevel entity="stack_entity" value="var1" />
				</compare>
				<else>
					<compare a="charges" b="2" op="eq">
						<setpos0 position="source_entity" offset="1000 0 0" offsetspace="" />
						<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="150 0 0" offsetspace="" pushentity="true" />
						<setlevel entity="stack_entity" value="var1" />
					</compare>
					<else>
						<compare a="charges" b="3" op="eq">
							<setpos0 position="source_entity" offset="707 -707 0" offsetspace="" />
							<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="106 -106 0" offsetspace="" pushentity="true" />
							<setlevel entity="stack_entity" value="var1" />
						</compare>
						<else>
							<compare a="charges" b="4" op="eq">
								<setpos0 position="source_entity" offset="0 -1000 0" offsetspace="" />
								<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="0 -150 0" offsetspace="" pushentity="true" />
								<setlevel entity="stack_entity" value="var1" />
							</compare>
							<else>
								<compare a="charges" b="5" op="eq">
									<setpos0 position="source_entity" offset="-707 -707 0" offsetspace="" />
									<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="-106 -106 0" offsetspace="" pushentity="true" />
									<setlevel entity="stack_entity" value="var1" />
								</compare>
								<else>
									<compare a="charges" b="6" op="eq">
										<setpos0 position="source_entity" offset="-1000 0 0" offsetspace="" />
										<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="-150 0 0" offsetspace="" pushentity="true" />
										<setlevel entity="stack_entity" value="var1" />
									</compare>
									<else>
										<compare a="charges" b="7" op="eq">
											<setpos0 position="source_entity" offset="-707 707 0" offsetspace="" />
											<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="pos0" offset="-106 106 0" offsetspace="" pushentity="true" />
											<setlevel entity="stack_entity" value="var1" />
										</compare>
									</else>
								</else>
							</else>
						</else>
					</else>
				</else>
			</else>
			
			<addcharges />
			<compare a="charges" b="8" op="ge">
				<setcharges a="0" />
			</compare>
		</onimpact>
		
		<onexpired>
			<compare a="accumulator" b="200,300,400" op="lt">
				<setaccumulator value="200,300,400" />
			</compare>
			<popup name="morult" a="accumulator" source="source_entity" target="source_entity"/>
			
			<evaluate a="70000,60000,50000" b="lifetime_remaining" op="add" />
			<startcooldown toolname="Ability_Moraxus4" duration="result" />
			<areaofeffect
				radius="400"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="Magic"
			>
				<damage effecttype="Magic" amount="1" b="accumulator" op="mult" />
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" target="" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
				</else>				
			</areaofeffect>
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="" />
			</else>
		</onexpired>	
	</modifier>
</statenetaccum>
