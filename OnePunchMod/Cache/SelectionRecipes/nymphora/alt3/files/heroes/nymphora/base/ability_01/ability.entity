	anim="ability_1"
	casttime="1000"
	castactiontime="500"
	casteffecttype="Magic"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetscheme="all_units"

	manacost="140,150,160,170"
	cooldowntime="14000"

	range="800"
	targetradius="425"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"

	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	showrangeandradiusintooltip="true"
>
	<onimpact>
		<spawnunit name="Gadget_Nymphora_Ability1" target="target_position" pushentity="true" />
		<setproxy entity="this_entity" target="stack_entity" />
		<applystate name="State_Nymphora_Ability1" duration="3000" target="source_entity" />
		<starttimer duration="3000" />
	</onimpact>
	
	<modifier key="fairy_Q_active" modpriority="100"
		ignorecooldown="true"
		anim=""
		icon="/heroes/bubbles/base/ability_01/icon_b.tga"
		casttime="0"
		castactiontime="0"
		noresponse="true"
		manacost="0"
		actiontype="no_target"
		cooldowntime="0"
		
		doubleactivate="false"
		nostun="true"
		nosilence="true"
	>
		<onimpact>
			<kill target="this_proxy_entity" source="" />
			<expirestate name="State_Nymphora_Ability1" target="source_entity" />
			<resettimer />
		</onimpact>
	</modifier>
</ability>
