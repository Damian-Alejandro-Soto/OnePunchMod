<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Nymphora_Ability2"

	speed="1100"
	gravity="0"

	modelscale="2"
	model="/heroes/fairy/ability_02/effects/model.mdf"

	effectscale="1.0"
	impacteffect="/heroes/fairy/trophy_skin/projectile/impact.effect"
	traileffect="/heroes/fairy/trophy_skin/ability_03/glow01.effect"
	
	canturn="true"
	flying="true"
	flyheight="100"
	
	maxtouches="0"
	maxtouchespertarget="1"
	touchradius="120"
	touchtargetscheme="enemy_units"
	toucheffecttype="Magic"
>
	<onimpact>
		<resettouches source="this_entity" />
		<condition test="redirect" />
		<else>
			<distance source="this_entity" target="this_owner_entity" />
			<compare a="result" b="3000" op="le">
				<retarget target="this_owner_entity" />
			</compare>
		</else>
	</onimpact>
	
	<ontouch>
		<applystate name="State_Stunned" duration="1000,1100,1200,1300" />
		<damage effecttype="Magic" amount="50,80,110,140" />
	</ontouch>
	
	<!-- Staff of the Master effects -->
	<modifier key="Fairy_R_SotM" modpriority="100">
		<ontouch>
			<applystate name="State_Stunned" duration="1000,1100,1200,1300" />
		</ontouch>
	</modifier>
</projectile>
