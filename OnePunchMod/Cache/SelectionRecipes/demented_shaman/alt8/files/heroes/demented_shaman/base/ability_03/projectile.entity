<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_DementedShaman_Ability3"

	speed="2000"
	gravity="1000"

	modelscale="1.25"
	model="/heroes/shaman/alt8/ability_04/effects/hide.mdf"
	impacteffect="/heroes/shaman/alt8/ability_04/effects/impact.effect"
	traileffect="/heroes/shaman/alt8/ability_04/effects/trail.effect"
	
	impactdistance="0"
>
	<onspawn>
		<expirestate name="State_DementedShaman_Ability3" target="source_entity" />
	</onspawn>
	
	<onimpact ignoreinvulnerable="true">
		<compare a="target_entity" b="0" op="eq">
			<setparam a="1" />
		</compare>
		<else>
			<targettype type="dead" target="target_entity">
				<setparam a="1" />
			</targettype>
		</else>
		
		<!-- If Unbreakable fails to apply to the target, reapply it to Demented Shaman -->
		<compare a="param" b="1" op="eq">
			<pushtool name="Ability_DementedShaman3" source="source_entity" />
			<resetcooldown entity="stack_entity" />
			<applystate name="State_DementedShaman_Ability3" target="source_entity" continuous="true" />	
		</compare>
		<else>
			<pushtool name="Ability_DementedShaman3" source="source_entity" />
			<resetcooldown entity="stack_entity" />
			<startcooldown duration="50000,40000,30000,20000" entity="stack_entity" />
			<applystate name="State_DementedShaman_Ability3" duration="5000" pushentity="true" />
			<setactivemodifierkey name="dsham_unbreakable_active" entity="stack_entity" />
		</else>
	</onimpact>
</projectile>