<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_DementedShaman_Ability2"

	radius="500"

	maximpactsperinterval="1"
	maximpactspertarget="1"
	targetscheme="ally_units"
	targetselection="closest"
	effecttype="Physical"
	persist="true"
	
	impacteffect="/heroes/shaman/alt4/ability_03/effects/impact.effect"
	linkeffect="effects/link.effect"
>
	<onimpact>
		<heal a="80,100,120,140" />
		<chain count="1,2,3,4" />
		<spawnaffector name="Affector_DementedShaman_Ability2_Damage" target="target_entity" />
	</onimpact>
</affector>
