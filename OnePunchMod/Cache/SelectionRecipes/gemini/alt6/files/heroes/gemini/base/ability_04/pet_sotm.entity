<?xml version="1.0" encoding="UTF-8"?>
<heropet
	name="Heropet_Gemini_Ability4_SotM"

	icon="../../icon.dds"
	portrait="../../icon.dds"
	model="/heroes/gemini/alt6/wolf.mdf"
	skin=""
	
	passiveeffect="/heroes/gemini/alt6/effects/body.effect"
	spawneffect="effects/spawn.effect"
	
	selectedsound="../pets/sotm/sounds/voice/select_%.wav"
	selectedflavorsound="../pets/sotm/sounds/voice/select_flavour_%.wav"
	confirmmovesound="../pets/sotm/sounds/voice/move_%.wav"
	confirmattacksound="../pets/sotm/sounds/voice/attack_%.wav"
	nomanasound="../pets/sotm/sounds/voice/no_mana.wav"
	cooldownsound="../pets/sotm/sounds/voice/cooldown.wav"
	tauntedsound="../pets/sotm/sounds/voice/taunt_prior.wav"
	tauntkillsound="../pets/sotm/sounds/voice/taunt_after.wav"
	
	preglobalscale="1.5"
	modelscale="1.0"
	effectscale="0.7"
	boundsheight="112"
	boundsradius="24"
	selectionradius="62"
	targetoffset="0 0 90"
	
	movespeed="300"
	turnrate="800"
	turnsmoothing="0.05"
	
	maxhealth="150"
	healthregen="1.00"
	maxmana="0"
	manaregen="0.01"
	
	mapicon="../../icon.dds"
	mapiconsize="0.05"
	mapiconcolor="1 1 .0 1"
	
	immunity="TransfigureImmunity"
	invulnerable="false"
	
	armor="1.0"
	magicarmor="5.5,7.5,9.5"
	
	
	inventory0="Ability_SotMCat1"
	inventory1="Ability_SotMCat2"
	inventory2="Ability_SotMCat3"
	inventory3="Ability_SotMCat4"
	inventory4=""
	inventory5="Ability_SotMCat3b"
	inventory6="Ability_SotMCat_Stats"
	inventory7=""
	inventory8=""
	
	attackduration="900"
	attackactiontime="400"
	attackcooldown="1700"
	attackdamagemin="24"
	attackdamagemax="29"
	attacknumanims="2"
	attackoffset="0 30 100"
	attackprojectile=""
	attackrange="128"
	attackstarteffect=""
	attackactioneffect=""
	attackimpacteffect="../pets/sotm/effects/impact.effect"
	attacktype="melee"
	combattype="Hero"
	
	aggrorange="600"
	sightrangeday="1800"
	sightrangenight="800"
	wanderrange="250"
	
	primaryattribute="agility"
	strength="0"
	agility="0"
	intelligence="0"
	
	continuousmodifiers="true"
	diewithowner="false"
	relayexperience="true"

	unittype="catz heropet Lightcat"
	
	corpsetime="0"
	deathtime="0"
>
	<onattackedpredamage>
		<cantarget targetscheme="player_controlled_enemy_units">
			<applystate name="Gemini_Ability4_Assist" duration="100" inflictor="target_entity" target="source_owner_entity" />
		</cantarget>
	</onattackedpredamage>
	
	<ondamaged>
		<hasmodifier name="alt_Doombringer" entity="source_owner_entity">
			<cantarget targetscheme="player_controlled_enemy_units_and_gadgets" ignoreinvulnerable="true">
				<targettype type="mimic" target="source_owner_entity" />
				<else>
					<targettype type="illusion" target="source_owner_entity" />
					<else>
						<applystate name="State_Doombringer_ItemDrop" target="source_owner_entity" duration="8000" pushentity="true" />
					</else>
				</else>
			</cantarget>
		</hasmodifier>
	</ondamaged>
	
	<onframe>
		<!-- Damage penalty check -->
		<areaofeffect
			center="source_entity"
			radius="900"
			targetscheme="my_other_catz"
			targetselection="all"
		>
		</areaofeffect>
		<compare a="result" b="2" op="ge">
			<applystate name="State_SotMCat_Ability4_Damage" target="source_entity" continuous="true" />
		</compare>
		<else>
			<expirestate name="State_SotMCat_Ability4_Damage" target="source_entity" />
		</else>
		
		<!-- Shop state check -->
		<hasmodifier name="ShopAccess_Main" entity="this_entity">
			<applystate name="State_ShopAccess_Main" target="source_owner_entity" timeout="frametime" />
		</hasmodifier>
		<else>
			<hasmodifier name="ShopAccess_Outpost" entity="this_entity">
				<applystate name="State_ShopAccess_Outpost" target="source_owner_entity" timeout="frametime" />
			</hasmodifier>
			<else>
				<hasmodifier name="ShopAccess_Secret" entity="this_entity">
					<applystate name="State_ShopAccess_Secret" target="source_owner_entity" timeout="frametime" />
				</hasmodifier>
			</else>
		</else>
		
		<compare a="this_proxy_entity" b="0" op="eq">
			<expirestate name="State_Gemini_Ability4_Damage" />
			<kill source="" />
		</compare>
	</onframe>

	<modifier key="Gemini_Ult_Invuln" modpriority="100"
		invulnerable="true"
	/>
	
	<modifier key="iamsheeped" modpriority="1000"
		passiveeffect=""
	/>
	
	<modifier key="SotMCat_Dispersed" modpriority="101"
		passiveeffect=""
		movespeed="300"
		maxmovespeed="650"
	/>
</heropet>
