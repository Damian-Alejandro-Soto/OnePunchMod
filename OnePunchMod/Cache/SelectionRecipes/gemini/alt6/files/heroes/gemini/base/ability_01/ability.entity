<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Gemini1"

	icon="../../icon.dds"
		
	statuseffecttooltip="State_Gemini_Ability1"
	anim="ability_1"
	casttime="700"
	castactiontime="200"
	casteffect="/heroes/gemini/alt6/ability_01/effects/cast.effect"

	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_dual_position"
	targetscheme="enemy_units"
	casteffecttype="Magic"
	
	range="500"
	targetradius="500"
	
	manacost="80,90,100,110"
	cooldowntime="13000"
	
	showareacast="false"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showconecast="true"
	conecastmaterial="/shared/materials/cone_cast.material"
	conecastwidth="500"
	conecastrange="500"
	
	showrangeandradiusintooltip="true"

	novoiceresponse="true"
	dynamicprecache="effects/cast_fire.effect,effects/impact.effect"
>
	<onimpact>
		<getrange />
		<spawnaffector name="Affector_Gemini_Ability1" target="source_position" radius="result" />
	</onimpact>

	<onactivatepreimpact>
		<pushtool name="Ability_Gemini4" />
		<reducecooldown duration="0" />
		<setaccumulator entity="stack_entity" value="result" />
	</onactivatepreimpact>
</ability>