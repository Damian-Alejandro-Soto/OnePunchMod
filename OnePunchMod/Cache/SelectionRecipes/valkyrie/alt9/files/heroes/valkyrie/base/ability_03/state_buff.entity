<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Valkyrie_Ability3_Buff"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/valkyrie/alt9/ability_03/effects/state_ally.effect"

	attackspeed="0.1,0.2,0.3,0.4"
	movespeedmultiplier="0.05,0.10,0.15,0.20"
	
	effecttype="StatusBuff"
	allowtransfer="true"
>
	<onframe>
		<hasmodifier name="iamsheeped" entity="this_owner_entity" >
			<activatemodifierkey name="iamsheeped" entity="this_entity" />
		</hasmodifier>
		<else>
			<deactivatemodifierkey name="iamsheeped" entity="this_entity"/>
		</else>
	</onframe>
	
	<modifier key="iamsheeped" modpriority="100"
		passiveeffect=""
	/>
</state>
