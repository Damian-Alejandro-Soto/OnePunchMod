<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Valkyrie_Ability3"

	radius="800"

	targetselection="all"
	targetscheme="ally_heroes"
	effecttype=""
 dynamicprecache="/heroes/valkyrie/alt12/ability_03/effects/land.effect">
	<onimpact>
		<targettype type="self">
			<applystate name="State_Valkyrie_Ability3_Buff" duration="10000" />
		</targettype>
		<else>
			<applystate name="State_Valkyrie_Ability3_Buff" duration="5000" />
		</else>
		
		<!-- Dynamic visual effects -->
		<getscriptvalue name="land_effect" destvar="str0" entity="this_entity" />
			<setstr0 a="altavatar_path" b="effects/land.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/land.effect" source="source_position" target="source_position" occlude="true" />
		</else>
	</onimpact>
</affector>
