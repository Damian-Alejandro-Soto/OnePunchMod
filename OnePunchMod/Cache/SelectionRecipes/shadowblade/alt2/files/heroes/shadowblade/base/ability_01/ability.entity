<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_ShadowBlade1"
 
	icon="../../icon.dds"
	statuseffecttooltip="State_ShadowBlade_Ability1"
	
	anim="ability_1"
	casttime="100"
	castactiontime="100"
	casteffect="/heroes/shadowblade/alt2/ability_01/effects/cast.effect"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="self_position"
	targetscheme="enemy_units"
	casteffecttype=""
	
	frontqueue="true"
	
	targetradius="300"
	
	manacost="75,85,95,105"
	cooldowntime="10000"
	dynamicprecache="effects/aoe.effect"
>
	<onimpact>
		<applystate name="State_ShadowBlade_Ability1_Morph" target="source_entity" duration="15000" />
		<areaofeffect
			radius="300"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
		>
			<damage effecttype="Magic" amount="70,120,170,220" />
			<applystate name="State_ShadowBlade_Ability1" duration="2500,3000,3500,4000" />
		</areaofeffect>
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/aoe.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/aoe.effect" source="source_position" target="" occlude="true" />
		</else>
	</onimpact>
</ability>
