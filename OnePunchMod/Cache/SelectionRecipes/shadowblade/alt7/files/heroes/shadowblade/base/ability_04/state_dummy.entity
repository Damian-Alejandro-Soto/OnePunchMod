<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_ShadowBlade_Ability4_Dummy"

	icon="/heroes/shadowblade/alt7/ability_04/icon.dds"
	ishidden="true"
	serverentity="true"
	effecttype=""

>
	<onexpired>
		<!-- Self-targeting: use source's form to determine stat -->
		<compare a="target_entity" b="source_entity" op="eq">
			<condition test="hasstate State_ShadowBlade_Ability2_Morph" target="source_entity">
				<applystate name="State_ShadowBlade_Ability4_Agility" duration="-1" target="source_entity" pushentity="true" />
				<evaluate a="target_agility" b="0.2,0.35,0.5" op="mult" />
				<setcharges entity="stack_entity" a="result" />
			</condition>
			<elsecondition test="hasstate State_ShadowBlade_Ability1_Morph" target="source_entity">
				<applystate name="State_ShadowBlade_Ability4_Strength" duration="-1" target="source_entity" pushentity="true" />
				<evaluate a="target_strength" b="0.2,0.35,0.5" op="mult" />
				<setcharges entity="stack_entity" a="result" />
			</elsecondition>
			<elsecondition test="hasstate State_ShadowBlade_Ability3_Morph" target="source_entity">
				<applystate name="State_ShadowBlade_Ability4_Intelligence" duration="-1" target="source_entity" pushentity="true" />
				<evaluate a="target_intelligence" b="0.2,0.35,0.5" op="mult" />
				<setcharges entity="stack_entity" a="result" />
			</elsecondition>
			<else>
				<!-- Default to Agility if not in a form -->
				<applystate name="State_ShadowBlade_Ability4_Agility" duration="-1" target="source_entity" pushentity="true" />
				<evaluate a="target_agility" b="0.2,0.35,0.5" op="mult" />
				<setcharges entity="stack_entity" a="result" />
			</else>
		</compare>

		<else>
			<!-- Expire any existing R state on target for a clean stat reading -->
			<expirestate name="State_ShadowBlade_Ability4_Agility" target="target_entity" noexpiretrigger="true" />
			<expirestate name="State_ShadowBlade_Ability4_Strength" target="target_entity" noexpiretrigger="true" />
			<expirestate name="State_ShadowBlade_Ability4_Intelligence" target="target_entity" noexpiretrigger="true" />

			<!-- Illusion: use source's form to determine stat -->
			<condition test="illusion" target="target_entity">
				<condition test="hasstate State_ShadowBlade_Ability2_Morph" target="source_entity">
					<applystate name="State_ShadowBlade_Ability4_Agility" duration="-1" target="source_entity" pushentity="true" />
					<evaluate a="target_agility" b="0.2,0.35,0.5" op="mult" />
					<setcharges entity="stack_entity" a="result" />
				</condition>
				<elsecondition test="hasstate State_ShadowBlade_Ability1_Morph" target="source_entity">
					<applystate name="State_ShadowBlade_Ability4_Strength" duration="-1" target="source_entity" pushentity="true" />
					<evaluate a="target_strength" b="0.2,0.35,0.5" op="mult" />
					<setcharges entity="stack_entity" a="result" />
				</elsecondition>
				<elsecondition test="hasstate State_ShadowBlade_Ability3_Morph" target="source_entity">
					<applystate name="State_ShadowBlade_Ability4_Intelligence" duration="-1" target="source_entity" pushentity="true" />
					<evaluate a="target_intelligence" b="0.2,0.35,0.5" op="mult" />
					<setcharges entity="stack_entity" a="result" />
				</elsecondition>
				<else>
					<applystate name="State_ShadowBlade_Ability4_Agility" duration="-1" target="source_entity" pushentity="true" />
					<evaluate a="target_agility" b="0.2,0.35,0.5" op="mult" />
					<setcharges entity="stack_entity" a="result" />
				</else>
			</condition>
			<else>
				<!-- Non-illusion: use target's primary attribute -->
				<targettype target="target_entity" type="agility">
					<applystate name="State_ShadowBlade_Ability4_Agility" duration="-1" target="source_entity" pushentity="true" />
					<evaluate a="target_agility" b="0.2,0.35,0.5" op="mult" />
					<setcharges entity="stack_entity" a="result" />
				</targettype>
				<else>
					<targettype target="target_entity" type="strength">
						<applystate name="State_ShadowBlade_Ability4_Strength" duration="-1" target="source_entity" pushentity="true" />
						<evaluate a="target_strength" b="0.2,0.35,0.5" op="mult" />
						<setcharges entity="stack_entity" a="result" />
					</targettype>
					<else>
						<targettype target="target_entity" type="intelligence">
							<applystate name="State_ShadowBlade_Ability4_Intelligence" duration="-1" target="source_entity" pushentity="true" />
							<evaluate a="target_intelligence" b="0.2,0.35,0.5" op="mult" />
							<setcharges entity="stack_entity" a="result" />
						</targettype>
					</else>
				</else>
			</else>
		</else>
	</onexpired>
	
</state>
