<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_ShadowBlade3"
	
	icon="/heroes/shadowblade/alt7/ability_03/icon.dds"
	statuseffecttooltip=""
	
	anim="ability_3"
	casttime="300"
	castactiontime="150"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="self_position"
	targetscheme="enemy_units"
	casteffect=""
	casteffecttype="Magic"

	manacost="50,60,70,80"
	cooldowntime="10000"
	dynamicprecache="effects/hover.effect"
>
	<onimpact>
		<applystate name="State_ShadowBlade_Ability3_Morph" target="source_entity" duration="15000" pushentity="true" />
		<setproxy entity="this_entity" target="stack_entity" />
		<spawnunit name="Gadget_ShadowBlade_Ability3" count="1" target="source_position" />
		<starttimer duration="5000" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/hover.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/hover.effect" source="target_position" target="" occlude="true" />
		</else>
	</onimpact>

	<ontimer>
		<setcharges a="0" entity="this_proxy_entity" />
	</ontimer>
	
	<modifier key="ShadowBlade_E_Form" modpriority="100"
		manacost="70,100,130,160"
	>
	</modifier>

	<modifier key="krosmode" modpriority="100"
	>
		<onimpact>
			<applystate name="State_ShadowBlade_Ability3_Morph" target="source_entity" duration="15000" pushentity="true" stack="true" />
			<setproxy entity="this_entity" target="stack_entity" />
			<spawnunit name="Gadget_ShadowBlade_Ability3" count="1" target="source_position" />
			<starttimer duration="5000" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/hover.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/hover.effect" source="target_position" target="" occlude="true" />
			</else>
		</onimpact>
	</modifier>
</ability>
