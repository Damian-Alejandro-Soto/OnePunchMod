<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Defiler4"

	icon="../../icon.dds"
	
	anim="ability_4"
	
	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_self"
	casteffecttype="Physical"
	
	manacost="200,300,400"
	cooldowntime="130000,115000,100000"
	casteffect="/heroes/defiler/alt2/ability_04/effects/cast.effect"
	targetradius="850"
	
	range="0"
	targetscheme=""
	
	showareacast="false"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	dynamicprecache="effects/heal.effect"
>
	<onimpact>
		<setcharges a="0" />
		<applystate name="State_Defiler_SoundTrack" source="source_entity" proxy="target_entity" duration="30000" />	
		<spawnaffector name="Affector_Defiler_Ability4" target="target_entity" proxy="this_entity" />
		<starttimer duration="30000" />
	</onimpact>
	
	<ondeath ignoreinvulnerable="true">
		<resettimer />
	</ondeath>
	
	<onorderdisjointed>
		<foreachproxy>
			<hasmodifier name="Defiler4_Spirit_Attacking" />
			<else>
				<order command="aggressive_wander" source="target_entity" target="source_entity" />
			</else>
		</foreachproxy>		
	</onorderdisjointed>
	
	<modifier key="ult_boost" modpriority="99"
	>
		<onupgrade>
			<spawnaffector name="Affector_Defiler_Ability4_Sotm" target="this_owner_entity" proxy="this_proxy_entity" />
		</onupgrade>

		<onlearn>
			<spawnaffector name="Affector_Defiler_Ability4_Sotm" target="this_owner_entity" proxy="this_proxy_entity" />
		</onlearn>
	</modifier>
</ability>
