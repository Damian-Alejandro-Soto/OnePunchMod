<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Defiler1"

	icon="../../icon.dds"
	
	anim="ability_1"
	casttime="800"
	castactiontime="500"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_dual_position"
	casteffecttype="Magic"
	casteffect="/heroes/defiler/alt3/ability_01/effects/cast.effect"
	
	targetscheme="enemy_units"
	
	manacost="85,110,135,160"
	cooldowntime="8000,7000,6000,5000"
	
	range="900"
	targetradius="300"
	
	showconecast="true"
	conecastmaterial="/shared/materials/cone_cast_wide2.material"
	conecastwidth="412"
	conecastrange="1210"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/ability.effect"
>
	<onimpact>
		<setvar0 a="0.8" /> <!-- Lifetime (s) -->
		<getrange />
		<setvar1 a="result" b="110" op="sub" /> <!-- Cast range, minus the initial spawn distance -->
		<setvar1 a="var1" b="var0" op="div" /> <!-- Final Affector Speed, v = d/t -->		
		<setvar0 a="var0" b="1000" op="mult" /> <!-- Lifetime (s) to (ms) -->
		<spawnaffector name="Affector_Defiler_Ability1" target="source_position" distance="110" speed="var1" lifetime="var0" />
	</onimpact>
</ability>