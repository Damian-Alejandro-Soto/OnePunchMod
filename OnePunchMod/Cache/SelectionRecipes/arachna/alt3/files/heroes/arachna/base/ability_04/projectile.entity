<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Arachna_Ability4"

	speed="1500"
	gravity="8000"

	impactstealth="true"
	modelscale="2.4"
	model="/heroes/arachna/alt3/summon/model.mdf"
	traileffect="/heroes/arachna/alt3/ability_04/effects/trail.effect"
	effectscale="2.0"
	impacteffect=""
	impactdistance="50"
>
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<targettype type="alive" target="this_proxy_entity">
					<spawnunit name="Gadget_Arachna_Ability4_Spiderling" target="this_position" proxy="this_proxy_entity" facing="this_proxy_entity" pushentity="true" inheritmodifiers="true" />
					<applystate name="State_Arachna_Ability4_CountAttacks" target="stack_entity" proxy="stack_entity" duration="15000" />
					<applystate name="State_Arachna_Ability4_ExpirePet" target="this_proxy_entity" proxy="stack_entity" duration="15000" stack="true" />
					<applystate name="State_Arachna_Ability4" target="this_proxy_entity" duration="1500" proxy="stack_entity" />
				</targettype>
			</onimpact>
		</combatevent>
	</onimpact>
</projectile>
