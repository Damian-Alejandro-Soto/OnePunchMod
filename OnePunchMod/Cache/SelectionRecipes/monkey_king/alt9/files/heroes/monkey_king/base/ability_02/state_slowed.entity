<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_MonkeyKing_Ability2_Slow"

	icon="../../icon.dds"
	passiveeffect="/heroes/monkey_king/alt9/ability_02/effects/daze.effect"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	movespeedslowstart="0.2,0.4,0.6,0.8"
	movespeedslowend="0.0"

	negativeeffect="slowed"
	dynamicprecache="effects/impact.effect"
>
	<onimpact>
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" />
		</else>
	</onimpact>
	
</state>
