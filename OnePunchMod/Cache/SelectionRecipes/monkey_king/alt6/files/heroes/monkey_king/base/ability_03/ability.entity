<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_MonkeyKing3"

	icon="../../icon.dds"
	
	anim="ability_3"
	casttime="200"
	castactiontime="200"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="facing"
	casteffecttype="Magic"
	targetradius="200"
	targetscheme="enemy_units"
	
	manacost="80"
	cooldowntime="13000,11000,9000,7000"
	allowoutofboundscast="true"
	
	dynamicprecache="/heroes/monkey_king/alt6/ability_03/effects/cast.effect"
>
	
	<onimpact>	
		<unbind target="source_entity" />
		<starttimer duration="2000" />
		<spawnunit name="Gadget_MonkeyKing_Ability3" count="1" target="source_entity" offset="0 200 0" offsetspace="source_entity" pushentity="true" />
		<spawnaffector name="Affector_MonkeyKing_Ability3" target="stack_position" />
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="source_entity" occlude="true" />
		</else>
		<setstr1 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str1">
			<playeffectdynamic effect="str1" source="stack_entity" target="stack_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="stack_entity" target="stack_entity" occlude="true" />
		</else>
	</onimpact>
	
	<modifier key="Speeding" modpriority="100"
		casttime="0"
		castactiontime="0"
	>
	</modifier>
	
</ability>