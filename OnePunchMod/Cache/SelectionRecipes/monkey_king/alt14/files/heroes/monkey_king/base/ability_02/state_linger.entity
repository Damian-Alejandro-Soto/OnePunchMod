<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_MonkeyKing_Ability2_Linger"

	icon="../../icon.dds"
	
	passiveeffect="/heroes/monkey_king/alt14/ability_02/effects/launch.effect"
	effecttype=""
	modifierkey=""

	impactinterval="50"
>

	<oninflict>
		<pushtool name="Ability_MonkeyKing2" />
		
		<hasmodifier name="ult_boost" entity="source_entity">
			<setcharges a="2" entity="stack_entity" />
		</hasmodifier>
		<else>
			<setcharges a="1" entity="stack_entity" />
		</else>		
	</oninflict>

	<onimpact>
		<setactivemodifierkey name="MonkeyKingVault_Active" />
	</onimpact>
	
	<onexpired>
		<pushtool name="Ability_MonkeyKing2" />
		<setcharges a="0" entity="stack_entity" />
	</onexpired>

	<modifier key="MonkeyKingVault_Active" modpriority="100"
		modifierkey="MonkeyKingVault2"
		impactinterval="10000"
	>
		<onimpact />
	</modifier>

</state>
