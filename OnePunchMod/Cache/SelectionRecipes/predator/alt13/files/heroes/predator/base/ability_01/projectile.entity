<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Predator_Ability1"

	speed="1500"
	gravity="2500"
	
	modelscale="1.0"
	model=""
	impacteffect="/heroes/predator/alt13/ability_01/effects/impact.effect"
	
	canturn="false"
	flying="false"
	flyheight="0"
	impactdistance="120"
>
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<!-- Apply ult -->
				<cantarget targetscheme="enemy_units" effecttype="Physical">
					<pushtool name="Ability_Predator4" />
					<setvar0 a="target_level" target="stack_entity" />
					<compare a="var0" b="0" op="gt">
						<hasmodifier entity="target_entity" name="predator_terror" />
						<else>
							<applystate name="State_Predator_Ability4_Enemy" duration="3000" proxy="source_entity" level="var0" />
						</else>
					</compare>
				</cantarget>
				<!-- End of apply ult -->
				
				<applystate name="State_Predator_Ability1_Restrain" duration="1600,1900,2200,2500" />
				<applystate name="State_Predator_Ability1" duration="2500,3000,3500,4000" />
				<damage effecttype="Magic" amount="100,150,200,250" />
				
				<targettype type="alive" target="this_owner_entity">
					<playanim name="ability_1_hit" target="this_owner_entity" />
				</targettype>
			</onimpact>
		</combatevent>
		<expirestate name="State_Predator_Ability1_SelfDisarm" target="this_owner_entity" />
	</onimpact>
</projectile>
