<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Jeraziah4"

	statuseffecttooltip="State_Jeraziah_Ability4"

	icon="/heroes/jereziah/alt9/ability_04/icon.dds"
	
	anim="ability_4"
	casttime="700"
	castactiontime="300"
	casteffect=""

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="self_position"
	targetradius="600"
	targetscheme="ally_units"
	casteffecttype="Magic"
	frontqueue="true"
	
	manacost="150,200,250"
	cooldowntime="130000,110000,90000"
	dynamicprecache="effects/cast.effect,effects/area.effect,effects/impact.effect"
>
	<onimpact>
		<spawnaffector name="Affector_Jeraziah_Ability4" target="source_entity" />

		<!-- Alt avatar art -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" />
		</else>
		<setstr0 a="altavatar_path" b="effects/area.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/area.effect" source="source_entity" />
		</else>
		<!-- end of Alt avatar art -->
	</onimpact>
	
	<modifier key="ult_boost" modpriority="1"
		targetradius="2000"
	>
		<onimpact>
			<spawnaffector name="Affector_Jeraziah_Ability4" target="source_entity" />
			<areaofeffect
				radius="99999"
				targetselection="all"
				targetscheme="ally_buildings"
				effecttype=""
				ignoreinvulnerable="false"
			>
				<applystate name="State_Jeraziah_Ability4_Building" duration="5000,6000,7000" proxy="source_entity" />
			</areaofeffect>
			
			<!-- Alt avatar art -->
				<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/cast.effect" source="source_entity" />
				</else>
				<setstr0 a="altavatar_path" b="effects/area.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/area.effect" source="source_entity" />
				</else>	
			<!-- end of Alt avatar art -->
		</onimpact>
	</modifier>	
</ability>
