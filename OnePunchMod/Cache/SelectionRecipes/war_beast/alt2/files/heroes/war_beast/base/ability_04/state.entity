<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_WarBeast_Ability4"
	
	icon="/heroes/wolfman/alt2/ability_04/icon.dds"
	passiveeffect=""
	
	criticalchance="0.3"
	criticalmultiplier="1.6,1.8,2"
	maxhealth="100,200,300"

	modifierkey="wolfmanult"
	modifierkey2="wolfmanult_vision1,wolfmanult_vision2,wolfmanult_vision3"
	
	propagatetoillusions="true"
	dynamicprecache="effects/bridge.effect"
>
	<onframe />
	
	<aura state="State_WarBeast_Ability4_Aura" radius="9999" targetscheme="my_units" propagatecondition="not_illusion" />
	
	<onexpired>
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/bridge.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="target_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/bridge.effect" source="target_position" target="target_position" occlude="true" />
		</else>
	</onexpired>
</state>
