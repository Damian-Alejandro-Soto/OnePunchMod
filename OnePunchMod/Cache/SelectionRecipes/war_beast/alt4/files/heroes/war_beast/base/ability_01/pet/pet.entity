<?xml version="1.0" encoding="UTF-8"?>
<pet
	name="Pet_WarBeast_Ability1"
	
	icon="../../../icon.dds"
	portrait="../../../icon.dds"
	model="/heroes/wolfman/alt4/ability_01/pet/model.mdf"
	skin=""
	
	passiveeffect="/heroes/wolfman/alt4/ability_01/pet/effects/body.effect"
	spawneffect=""
	
	preglobalscale="1.305"
	modelscale="1.0"
	effectscale="0.9"
	boundsheight="64"
	boundsradius="28"
	selectionradius="48"
	targetoffset="0 0 0"

	movespeed="400"
	turnrate="450"
	turnsmoothing="0.05"

	maxhealth="400,425,450,475"
	healthregen="0.25"
	maxmana="0"
	manaregen="0"

	armor="3"
	magicarmor="2"

	
	inventory0="Ability_WarBeast_Ability1_Pet_Ability1"
	inventory1=",,,Ability_WarBeast_Ability1_Pet_Ability2"
	inventory2=""
	inventory3=""

	attackduration="1000"
	attackactiontime="750,700,650,600"
	attackcooldown="1250"
	attackdamagemin="30,38,46,54"
	attackdamagemax="30,38,46,54"
	attacknumanims="2"
	attackoffset="0 60 100"
	attackprojectile=""
	attackrange="100"
	attackstarteffect=""
	attackactioneffect=""
	attackimpacteffect="effects/impact.effect"
	attacktype="melee"
	combattype="Melee"

	aggrorange="600"
	sightrangeday="1200"
	sightrangenight="800"
	
	goldbountymin="21,26,36,41"
	goldbountymax="21,26,36,41"
	experiencebounty="20"
	
	deniablepercent="0.5"
	
	unittype="summoned"

	corpsetime="4000"
	corpsefadetime="4500"
	corpsefadeeffect="/shared/effects/corpse_sink.effect"
	dynamicprecache="effects/spawn.effect"
>
	<modifier key="wolfman_staff" modpriority="101"
		maxhealth="800,850,900,950"
		inventory2="Ability_WarBeast_Ability1_Pet_Ability3"
	/>

	<onspawn>
		<setstr0 a="altavatar_path" b="effects/spawn.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/spawn.effect" source="this_position" target="" occlude="true" />
		</else>
		<condition target="this_owner_entity" test="hasstate State_WarBeast_Ability2" >
			<applystate name="State_WarBeast_Ability2" target="this_owner_entity" duration="0" pushentity="true" />
			<changeduration entity="stack_entity" b="0" op="add" />
			<applystate name="State_WarBeast_Ability2_Units" target="this_entity" duration="result" />
		</condition>
	</onspawn>

	<onframe>
		<targettype type="alive" target="source_owner_entity" >
			<distance source="source_entity" target="source_owner_entity" />
			<compare a="result" b="925" op="ge">
				<setactivemodifierkey name="wolfman_pet_notowers" />
			</compare>
		</targettype>
		<else>
			<setactivemodifierkey name="wolfman_pet_notowers" />
		</else>
	</onframe>

	<modifier key="wolfman_pet_notowers" modpriority="100"
		attacktargetscheme="everything_but_towers"
	>
		<onframe>
			<distance source="source_entity" target="source_owner_entity" />
			<compare a="result" b="925" op="lt">
				<targettype type="alive" target="source_owner_entity" >
					<setactivemodifierkey name="" />
				</targettype>
			</compare>
		</onframe>
	</modifier>
</pet>