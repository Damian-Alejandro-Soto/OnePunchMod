<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_WarBeast3"

	icon="/heroes/wolfman/alt4/ability_03/icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	dontshowhovercast="true"
	actiontype="passive"
>
	<aura name="wolfmanaura" state="State_WarBeast_Ability3" radius="9999" targetscheme="my_units" />

	<!-- Make the aura stack and not work with illusions -->
	<modifier key="krosmode" modpriority="101">
		<aura name="wolfmanaura" state="State_WarBeast_Ability3" radius="9999" targetscheme="my_units" propagatecondition="not_illusion" stack="true" />
	</modifier>
</ability>
