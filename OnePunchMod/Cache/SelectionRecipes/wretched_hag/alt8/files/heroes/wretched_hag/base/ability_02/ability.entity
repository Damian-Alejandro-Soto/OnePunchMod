<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_WretchedHag2"

	icon="/heroes/babayaga/alt8/ability_02/icon.dds"
	
	anim="ability_2"
	casttime="800"
	castactiontime="330"
	casteffect="/heroes/babayaga/alt8/ability_02/effects/bats_base.effect"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	activatescheme="movement"
	
	manacost="60"
	cooldowntime="12000,10000,8000,6000"
	
	allowoutofrangecast="true"
	range="800,900,1000,1100"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	dynamicprecache="effects/bats_reform.effect"
>
	<onimpact>
		<teleport interpolate="false" target="target_position" />
		<disjoint target="source_entity" />
		<unbind target="source_entity" />

		<!-- VFX -->
		<playanim name="ability_2_end" target="source_entity" />
		<setstr0 a="altavatar_path" b="effects/bats_reform.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/bats_reform.effect" source="source_entity" target="source_entity" />
		</else>
	</onimpact>	
</ability>