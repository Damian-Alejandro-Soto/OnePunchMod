<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_WretchedHag4"

	icon="../../icon.dds"
	
	anim="ability_4"
	casttime="1450"
	castactiontime="450"
	statuseffecttooltip="State_WretchedHag_Ability4"

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_dual_position"
	casteffecttype="Magic"
	casteffect="/heroes/babayaga/alt6/ability_04/effects/sound_cast.effect"
	
	targetscheme="enemy_units"
	
	manacost="200,325,450"
	cooldowntime="135000,120000,105000"
	
	range="900"
	targetradius="300"
	
	showconecast="true"
	conecastmaterial="/shared/materials/cone_cast_wide3.material"
	conecastwidth="412"
	conecastrange="1100"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/cast.effect"
>
	<onimpact>
		<setvar0 a="0.8" /> <!-- Lifetime (s)) -->
		<getrange />
		<setvar1 a="result" b="0" op="sub" /> <!-- Cast range, minus the initial spawn distance -->
		<setvar1 a="var1" b="var0" op="div" /> <!-- Final Affector Speed, v = d/t -->		
		<setvar0 a="var0" b="1000" op="mult" /> <!-- Lifetime (s) to (ms) -->
		<spawnaffector name="Affector_WretchedHag_Ability4" target="source_position" distance="0" speed="var1" lifetime="var0" />
	</onimpact>

	<modifier key="ult_boost" modpriority="100" casteffecttype="SuperiorMagic"
		cooldowntime="80000"
	>
		<onimpact>
			<setvar0 a="0.8" /> <!-- Lifetime (s)) -->
			<getrange />
			<setvar1 a="result" b="0" op="sub" /> <!-- Cast range, minus the initial spawn distance -->
			<setvar1 a="var1" b="var0" op="div" /> <!-- Final Affector Speed, v = d/t -->		
			<setvar0 a="var0" b="1000" op="mult" /> <!-- Lifetime (s) to (ms) -->
			<spawnaffector name="Affector_WretchedHag_Ability4" target="source_position" distance="0" speed="var1" lifetime="var0" />
		</onimpact>
	</modifier>
</ability>
