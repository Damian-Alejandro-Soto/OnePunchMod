<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_WretchedHag_Ability4"

	radiusstart="100"
	radiusend="300"
	arcstart="180"
	arcend="360"
	
	speed="1285"
	
	lifetime="800"
	maximpactspertarget="1"
	targetselection="all"
	targetscheme="enemy_units"
	effecttype="Magic"
	persist="true"

	impacteffect="/heroes/babayaga/alt3/ability_04/effects/impact.effect"
	effect="effects/cast.effect"
>
	<onimpact>
		<!-- Apply Haunt (Q) based on Haunt's current level -->
		<pushtool name="Ability_WretchedHag1" source="source_entity" />
		<setvar0 a="source_level" source="stack_entity" />
		<compare a="var0" b="0" op="gt">
			<applystate name="State_WretchedHag_Ability4" duration="15000" statelevel="var0" />
		</compare>
		
		<damage effecttype="Magic" amount="300,425,550" />
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100"
		effecttype="SuperiorMagic"
    >
		<onimpact>
			<!-- Apply Haunt (Q) based on Haunt's current level -->
			<pushtool name="Ability_WretchedHag1" source="source_entity" />
			<setvar0 a="source_level" source="stack_entity" />
			<compare a="var0" b="0" op="gt">
				<condition test="hasstate State_ShrunkenHead">
				</condition>
				<else>
					<condition test="hasstate State_Jeraziah_Ability2">
					</condition>
					<else>
						<applystate name="State_WretchedHag_Ability4" duration="15000" statelevel="var0" />
					</else>
				</else>
			</compare>
			<damage effecttype="SuperiorMagic" amount="350,550,750" />
		</onimpact>
	</modifier>
</affector>
