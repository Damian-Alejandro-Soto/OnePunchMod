<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Gunblade_Ability1"

	speed="2500"
	gravity="0"

	modelscale=".45"
	model="/shared/models/invis.mdf"

	traileffect="/heroes/gunblade/alt8/ability_01/effects/trail.effect"
	deatheffect="effects/projectile/death.effect"
	canturn="0"
	
	flying="true"
	flyheight="120"
	
	touchradius="100"
	touchradiusdiradjust="true"
	maxtouchespertarget="1"
	touchtargetscheme="enemy_units"
	toucheffecttype="Physical"
>
	<onimpact>
		<kill target="this_proxy_entity" source="" />
	</onimpact>
	
	<ontouch>
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/projectile/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/projectile/impact.effect" source="target_entity" target="target_entity" />
		</else>
		<condition test="hasstate State_Gunblade_Ability1_Immunity" target="target_entity" />
		<else>
			<damage effecttype="Physical" amount="90,150,210,270" b="1" op="mult" />
			<applystate name="State_Gunblade_Ability1_Slow" target="target_entity" duration="3000" />
			<applystate name="State_Gunblade_Ability1_Immunity" target="target_entity" duration="100" />
		</else>
	</ontouch>
</projectile>
