<?xml version="1.0" encoding="UTF-8"?>
<statenetaccum
	name="State_Gunblade_Ability2"

	icon="/heroes/gunblade/alt8/ability_02/icon.dds"
	passiveeffect="/heroes/gunblade/alt8/ability_02/effects/state.effect"
	effecttype=""
	
	movespeed="20,40,60,80"
	
	displaylevel="true"
	
	shield="true"
	maxaccumulator="550"
	dynamicprecache="effects/impact.effect,effects/state_expire.effect"
>	
	<oninflict>
		<setvar1 source="source_entity" a="source_agility" b="0.75,1,1.25,1.5" op="mult" />
		<setaccumulator value="result" valueb="60,100,140,180" valueop="add" />
	</oninflict>

	<ondamaged>
		<damageeffecttype effecttype="DOT" />
		<else>
			<targettype type="enemy">
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="source_entity" />
		</else>
			</targettype>
		</else>
		
		<setvar0 a="source_damage" b="1" op="mult" />
		<compare a="var0" b="accumulator" op="ge">
			<evaluate a="var0" b="accumulator" op="sub" />
			<changedamage b="result" op="min" />
			<expire />
		</compare>
		<else>
			<changedamage b="0" op="mult" />
			<evaluate a="accumulator" b="var0" op="sub" />
			<setaccumulator value="result" />
		</else>
	</ondamaged>
	
	<onattackedpostimpact>
		<targettype type="enemy">
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="source_entity" />
		</else>
		</targettype>
	</onattackedpostimpact>
	
	<onexpired>
		<setstr0 a="altavatar_path" b="effects/state_expire.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/state_expire.effect" source="source_entity" />
		</else>
	</onexpired>
</statenetaccum>
