<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Gunblade_Ability4_Reveal"

	icon="icon_b.tga"

	passiveeffect="/heroes/gunblade/alt9/ability_04/effects/link.effect"

	sighted="true"
	revealed="true"
	restrained="true"

	negativeeffect="restrained"
>
	<oninflict>
		<!--
			Apply the 25%-less-damage debuff as a victim-side state on Gunblade
			(source_entity) instead of an attacker-side ondamage here, so the
			floating damage numbers over Gunblade reflect the reduction.

			Applied here rather than from the ability's onimpact on purpose:
			applystate drags the named state into the caller's precache graph, and a
			failed precache there propagates and stops the ult_boost modifier from
			registering at all.

			Outlasts the grapple so it still covers the 8s armor debuff, including the
			staff AOE stamped at projectile impact. It only reduces damage from units
			that still carry Reduced, so the extra tail is inert.
		-->
		<applystate name="State_Gunblade_Ability4_DamageReduction" target="source_entity" duration="9000" />
	</oninflict>

	<onorderdisjointed>
		<order command="follow" force="true" source="this_proxy_entity" target="source_entity" />
	</onorderdisjointed>
	
	<onframe>
		<targettype type="alive" target="target_entity" />
		<else>
			<expirestate name="State_Gunblade_Ability4" target="source_entity" />
			<expire />
		</else>
		
		<compare a="target_entity" b="0" op="eq">
			<expirestate name="State_Gunblade_Ability4" target="source_entity" />
			<expire />
		</compare>
	</onframe>

	<onexpired>
		<targettype type="alive" target="source_entity">
			<playanim name="idle" target="source_entity" />
		</targettype>
		<expirestate name="State_Gunblade_Ability4" target="source_entity" />
	</onexpired>
</state>