<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_Scout_Ability2"

	icon="../../../icon.dds"
	portrait="../../../icon.dds"

	model="/heroes/scout/alt9/ability_02/effects/ward/model.mdf"

	preglobalscale="0.9"
	modelscale="2.5"
	effectscale="0.9"
	boundsheight="64"
	boundsradius="16"
	isselectable="true"
	iscontrollable="true"
	selectionradius="20"
	targetoffset="0 0 64"

	canrotate="false"
	ismobile="false"
	unitwalking="true"

	showsightrange="true"
	showrevealrange="true"

	maxhealth="1"
	inventory0=""
	inventory1="Ability_Gadget_Scout2"
	inventory2="Ability_Gadget_Scout2_2"

	immunity="GadgetImmunity"
	unittype="electriceye"

	attacktype="none"
	combattype="Ranged"
	stealthtype="hero"
	fadetime="500"
	stealthproximity="300"

	sightrangeday="700,800,900,1000"
	sightrangenight="700,800,900,1000"
	revealtype="ward"
	revealrange="700,800,900,1000"

	goldbountymin="15"
	goldbountymax="21"
	experiencebounty="0"

	nothreat="true"

	corpsetime="1000"
	corpsefadetime="1000"
	corpsefadeeffect="/shared/effects/corpse_sink.effect"

	noblockneutralspawn="true"
	dynamicprecache="../effects/death.effect"
 passiveeffect="/heroes/scout/alt9/ability_02/effects/elec_eye.effect">
	<onattackedpreimpact>
		<setvalue name="combat_truestrike" a="1" />
	</onattackedpreimpact>

	<onspawn>
		<startfade />
		<addcharges entity="proxy_entity" count="1"  />
	</onspawn>

	<ondeath>
		<!-- Dynamic visual effects: resolve against the caster's active avatar, fall back to base -->
		<setstr0 a="altavatar_path" b="../effects/death.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="../effects/death.effect" source="source_entity" target="" />
		</else>
		<addcharges entity="proxy_entity" count="-1" />
	</ondeath>
</gadget>
