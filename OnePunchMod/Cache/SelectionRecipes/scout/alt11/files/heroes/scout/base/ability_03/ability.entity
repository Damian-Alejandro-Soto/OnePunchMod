<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Scout3"

	icon="/heroes/scout/alt11/ability_03/icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="passive"
	cooldowntime="11000,10000,9000,8000"
	frontqueue="true"
	dynamicprecache="effects/impact.effect"
>
	<onattackimpact />
	
	<onattackstart>
		<cantarget targetscheme="enemy_units">
			<canactivate>
				<playanim name="ability_1b" speed="source_attackspeed" target="source_entity" />
			</canactivate>
			<else>
				<!-- Predict: if remaining cooldown <= reducecooldown amount (1s), the crit will proc -->
				<getremainingcooldown target="this_entity" />
				<compare a="result" b="1.0" op="le">
					<playanim name="ability_1b" speed="source_attackspeed" target="source_entity" />
				</compare>
			</else>
		</cantarget>
	</onattackstart>
	
	<onattackimpact>
		<cantarget targetscheme="enemy_units">
			<canactivate>
				<targettype type="Boss" />
				<else>
					<applystate name="State_Scout_Ability3" duration="2000" />
					
					<!-- VFX -->
					<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
					<exists path="str0">
						<playeffectdynamic effect="str0" source="target_entity" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
					</else>
				</else>
				
				<startcooldown />
			</canactivate>
		</cantarget>
	</onattackimpact>
		
	<onattack>
		<reducecooldown duration="1000" />
		
		<canactivate>
			<cantarget targetscheme="enemy_units">
				<addcritical chance="1.0" multiplier="1.4,1.6,1.8,2.0" />
			</cantarget>
		</canactivate>
	</onattack>

	<modifier key="rapidfire" modpriority="101"
	
	>
		<onattack>
			<reducecooldown duration="200" />
		</onattack>
	</modifier>
</ability>