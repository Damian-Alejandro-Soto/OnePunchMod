	<onframe />
	
	<modifier key="Raultform"
		modpriority="100"
	>
	</modifier>
	
	<modifier key="Raultinitial"
		modpriority="100"
	>
		<onrespawn>
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/respawn_2.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/respawn_2.effect" target="source_entity" />
			</else>
			<playanim name="ability_4_spawn" target="source_entity" source="source_entity" />
			
			<!-- Ult logic -->
			<hasmodifier name="Rault1">
				<applystate name="State_AmunRa_Ability4" duration="10000" target="source_entity" statelevel="1" />
			</hasmodifier>
			<hasmodifier name="Rault2">
				<applystate name="State_AmunRa_Ability4" duration="10000" target="source_entity" statelevel="2" />
			</hasmodifier>
			<hasmodifier name="Rault3">
				<applystate name="State_AmunRa_Ability4" duration="10000" target="source_entity" statelevel="3" />
			</hasmodifier>
		</onrespawn>
	</modifier>

	<modifier key="alt3_full_armor" model="/heroes/ra/alt3/upgraded_full_body/model.mdf" />
	<modifier key="amunra_trail" walkanim="walk_2" />
