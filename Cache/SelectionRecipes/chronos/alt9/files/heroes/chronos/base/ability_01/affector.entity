<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Chronos_Ability1"

	radius="300"
	targetselection="all"
	targetscheme="enemy_units"
	effecttype="Magic"
 passiveeffect="/heroes/chronos/alt9/ability_01/effects/area.effect">
	<onimpact>
		<damage effecttype="Magic" amount="80,120,160,200" />
		<applystate name="State_Chronos_Ability1_Enemy" duration="3000" />
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" occlude="true" />
		</else>
	</onimpact>
</affector>