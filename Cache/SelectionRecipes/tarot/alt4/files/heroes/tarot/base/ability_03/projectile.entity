<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Tarot_Ability3"

	speed="1600"
	
	flying="true"
	flyheight="60"

	modelscale="2.5"
	model="/shared/models/invis.mdf"
	deatheffect=""

	effectscale="1"
	impacteffect=""
	traileffect="/heroes/tarot/alt4/ability_03/effects/trail.effect"
>
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<cantarget effecttype="Magic">
					<compare a="param" b="3" op="eq">
						<areaofeffect
							radius="500"
							targetselection="closest"
							targetscheme="visible_enemy_heroes"
							effecttype="Magic"
							maxtotalimpacts="1"
							center="target_entity"
							ignore="target_entity"
						>
							<setproxy entity="this_entity" target="target_entity" />
						</areaofeffect>
						<compare a="result" b="0" op="eq">
							<areaofeffect
								radius="500"
								targetselection="closest"
								targetscheme="nonboss_visible_enemy_units"
								effecttype="Magic"
								maxtotalimpacts="1"
								center="target_entity"
								ignore="target_entity"
							>
								<setproxy entity="this_entity" target="target_entity" />
							</areaofeffect>
							<compare a="result" b="0" op="eq">
								<setproxy entity="this_entity" target="" />
							</compare>
						</compare>

						<compare a="this_proxy_entity" b="0" op="eq">
							<applystate name="State_Tarot_Ability3_Slow_Restrain" target="target_entity" duration="6000" />
							<damage effecttype="Physical" amount="1" target="target_entity" />
						</compare>
						<else>
							<applystate name="State_Tarot_Ability3_Slow_Restrain" target="target_entity" duration="6000" />
							<applystate name="State_Tarot_Ability3_Restrain" target="target_entity" duration="6000" proxy="this_proxy_entity" stack="true" />
							<applystate name="State_Tarot_Ability3_Restrain" target="this_proxy_entity" duration="6000" proxy="target_entity" stack="true" />

							<!-- This is necessary if you want the above state to deal damage, since the source needs to be Tarot so the damage is attributed correctly -->
							<compare a="this_proxy_entity" b="target_entity" op="ne">
								<applystate name="State_Tarot_Ability3_Effect" inflictor="this_proxy_entity" target="target_entity" duration="6000" proxy="this_proxy_entity" />
							</compare>

							<damage effecttype="Physical" amount="1" target="target_entity" />
							<damage effecttype="Physical" amount="1" target="this_proxy_entity" />
						</else>
					</compare>
					<else>
						<areaofeffect
							radius="500"
							targetselection="closest"
							targetscheme="visible_enemy_heroes"
							effecttype="Magic"
							maxtotalimpacts="1"
							center="target_entity"
							ignore="target_entity"
						>
							<setproxy entity="this_entity" target="target_entity" />
						</areaofeffect>
						<compare a="result" b="0" op="eq">
							<areaofeffect
								radius="500"
								targetselection="closest"
								targetscheme="nonboss_visible_enemy_units"
								effecttype="Magic"
								maxtotalimpacts="1"
								center="target_entity"
								ignore="target_entity"
							>
								<setproxy entity="this_entity" target="target_entity" />
							</areaofeffect>
							<compare a="result" b="0" op="eq">
								<setproxy entity="this_entity" target="" />
							</compare>
						</compare>

						<compare a="this_proxy_entity" b="0" op="eq">
							<applystate name="State_Tarot_Ability3_Slow" target="target_entity" duration="6000" />
							<damage effecttype="Physical" amount="1" target="target_entity" />
						</compare>
						<else>
							<applystate name="State_Tarot_Ability3_Slow" target="target_entity" duration="6000" />
							<applystate name="State_Tarot_Ability3" target="target_entity" duration="6000" proxy="this_proxy_entity" stack="true" />
							<applystate name="State_Tarot_Ability3" target="this_proxy_entity" duration="6000" proxy="target_entity" stack="true" />

							<!-- This is necessary if you want the above state to deal damage, since the source needs to be Tarot so the damage is attributed correctly -->
							<compare a="this_proxy_entity" b="target_entity" op="ne">
								<applystate name="State_Tarot_Ability3_Effect" inflictor="this_proxy_entity" target="target_entity" duration="6000" proxy="this_proxy_entity" />
							</compare>

							<damage effecttype="Physical" amount="1" target="target_entity" />
							<damage effecttype="Physical" amount="1" target="this_proxy_entity" />
						</else>
					</else>
				</cantarget>
			</onimpact>
		</combatevent>
	</onimpact>
</projectile>