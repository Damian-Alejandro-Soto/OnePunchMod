<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Deadwood_Ability3"

	icon="/heroes/Deadwood/alt9/ability_03/icon.dds"
	passiveeffect="/heroes/deadwood/alt9/ability_03/effects/state.effect"

	maxcharges="1"
	treewalking="true"
	movespeed="30,45,60,75"
	
	effecttype="StatusBuff"
	allowtransfer="true"
	dynamicprecache="effects/ability_03.effect"
>
	<onframe>
		<setvar0 a="0" />
		<killtrees radius="50" usealtdeathanims="true" />
		<setvar0 a="result" />
		<addcharges count="var0"/>
		
		<compare a="var0" b="0" op="gt">
			<applystate name="State_Deadwood_Ability3_Buff" duration="2000" target="source_entity" />			
			<!-- Art -->
			<setstr0 a="altavatar_path" b="effects/ability_03.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/ability_03.effect" target="target_entity" />
			</else>
		</compare>
	</onframe>
</state>
