<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_Deadwood_Ability1"

	model="/shared/models/invis.mdf"
	skin=""
	unitwalking="true"
	diewithowner="false"

	stealthtype="unrevealable"
	fadetime="0"

	passiveeffect="/heroes/deadwood/alt5/ability_01/effects/delay.effect"
	spawneffect=""
	
	
	
	isselectable="false"
	

	preglobalscale="1.35"
	modelscale="1.0"
	effectscale="0.9"
	boundsheight="64"
	boundsradius="16"
	selectionradius="36"
	targetoffset="0 0 0"

	drawonmap="false"
	invulnerable="true"
	canattack="false"

	corpsetime="0"
	corpsefadetime="0"
	deathtime="0"

	lifetime="1200"
	noblockneutralspawn="true"
	dynamicprecache="effects/treeaoe.effect" 
>
	<onexpired>
		<spawnaffector name="Affector_Deadwood_Ability1" target="this_position" owner="this_owner_entity" source="this_owner_entity" />
		<areaofeffect
			radius="125"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Physical"
		>
			<applystate name="State_Deadwood_Ability1_PushImmunity" duration="1500,2000,2500,3000" />
		</areaofeffect>
		
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/treeaoe.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/treeaoe.effect" source="this_position" target="" occlude="true" />
		</else>
	</onexpired>
</gadget>