<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_SoulReaper_Ability1"

	speed="600"
	gravity="0"
	flying="true"
	flyheight="100"
	
	modelscale="2"
	model="effects/reaper_green/model.mdf"


	traileffect="/heroes/helldemon/alt4/ability_01/effects/trail.effect"
>
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" target="" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
				</else>
				<heal target="target_entity" a="60,85,110,135" />
			</onimpact>
		</combatevent>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100">
		<onimpact>
			<combatevent effecttype="AbilityBasedProjectile">
				<onimpact>
					<targettype type="Boss" >
						<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
						<exists path="str0">
							<playeffectdynamic effect="str0" source="target_entity" target="" />
						</exists>
						<else>
							<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
						</else>
						<heal target="target_entity" a="60,85,110,135" />
					</targettype>
					<else>
						<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
						<exists path="str0">
							<playeffectdynamic effect="str0" source="target_entity" target="" />
						</exists>
						<else>
							<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
						</else>
						<evaluate a="target_maxhealth" b="target_health" op="sub" />
						<evaluate a="result" b="0.05" op="mult" />
						<heal target="target_entity" a="60,85,110,135" b="result" op="add" />
					</else>
				</onimpact>
			</combatevent>
		</onimpact>
	</modifier>
</projectile>
