<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_Revenant_Ability2"
	
	model="/shared/models/invis.mdf"
	boundsheight="0"
	boundsradius="0"
	isselectable="false"
	iscontrollable="false"
	canrotate="false"
	ismobile="false"
	effectscale="1"

	attacktype="none"

	deathtime="0"
	corpsetime="0"
	
	invulnerable="true"
	flying="true"
	drawonmap="false"
	
	attackprojectile="Projectile_Rev_Attack_Alt"
	canattack="false"
	
	passiveeffect="/heroes/revenant/alt3/ability_02/effects/state_aura.effect"
	
	modifierkey=""
>

	<onframe>
		<isstealthed entity="proxy_entity">
			<setactivemodifierkey name="hide" />
		</isstealthed>
	</onframe>

	
	<modifier key="hide" modpriority="100" 
		stealthtype="hero"
	>
		<onframe>
			<isstealthed entity="proxy_entity" />
			<else>
				<setactivemodifierkey name="" />
			</else>
		</onframe>
	</modifier>

</gadget>
