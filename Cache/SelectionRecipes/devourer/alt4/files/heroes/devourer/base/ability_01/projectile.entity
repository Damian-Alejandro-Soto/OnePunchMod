<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Devourer_Ability1"

	speed="1600"
	gravity="0"

	impactdistance="32"

	modelscale="2.2"
	model="/shared/models/invis.mdf"
	
	canturn="false"
	flying="true"
	flyheight="100"
	
	touchradius="75"
	touchradiusdiradjust="true"
	touchtargetscheme="hook_targets"
	toucheffecttype="Physical"
 traileffect="/heroes/devourer/alt4/ability_01/effects/blood_trail.effect" dynamicprecache="/heroes/devourer/alt4/ability_01/effects/impact.effect,../alt4/ability_01/effects/sound_impact.effect">
	<onspawn>
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/trail.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="this_entity" occlude="false" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/trail.effect" source="source_entity" target="this_entity" occlude="false" />
		</else>
		
		<setparam a="0" />
	</onspawn>

	<onimpact>
		<condition test="not_redirect">
			<targettype type="alive" target="source_entity">
				<playanim name="ability_1_end" target="source_entity" />
			</targettype>
			<retarget target="this_owner_entity" />
		</condition>
		<else>
			<expirestate target="this_proxy_entity" name="State_Devourer_Ability1" />
			<expirestate target="this_proxy_entity" name="State_Devourer_Ability1_Unbind" />
		</else>
	</onimpact>
	
	<ontouch>
		<condition test="not_bound">
			<compare a="param" b="0" op="eq">
				<condition test="not_redirect">
					<combatevent effecttype="AbilityBasedProjectile">
						<onimpact>
							<!-- Hooked someone! -->
							<cantarget targetscheme="enemy_units">
								<applystate name="State_Stunned" duration="100" />
								<damage effecttype="Physical" amount="135,210,285,360" />
								
								<!-- Dynamic visual effects -->
								<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
								<exists path="str0">
									<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" />
								</exists>
								<else>
									<playeffectdynamic effect="effects/impact.effect" source="target_position" target="" occlude="true" />
								</else>
							</cantarget>
							
							<cantarget effecttype="Push">
								<unbind target="target_entity" />
								<bind target="target_entity" />
							</cantarget>
							
							<cantarget targetscheme="enemy_heroes">
								<hasmodifier entity="source_entity" name="track_abilities">
									<setgameplaystat index="1" target="source_entity" a="target_gameplaystat1" b="1" op="add" /> <!-- Hook hits! +1 -->
									<evaluate target="source_entity" a="target_gameplaystat1" b="target_gameplaystat0" op="div" />
									<evaluate a="result" b="100" op="mult" />
									<chatmessage target="source_entity" entity="source_entity" important="false" message="track_abilities_devohook" paramvalue="result" paramvalueprecision="2" />
								</hasmodifier>
							</cantarget>
						</onimpact>
					</combatevent>
					<setproxy entity="this_entity" target="target_entity" />
					<setparam a="1" />
					
					<cantarget effecttype="Push">
						<applystate name="State_Devourer_Ability1" target="target_entity" duration="-1" pushentity="true" />
						<applystate name="State_Devourer_Ability1_Unbind" target="target_entity" duration="1500" proxy="stack_entity" />
					</cantarget>
					<retarget target="this_owner_entity" />
					<targettype type="alive" target="source_entity">
						<playanim name="ability_1_end" target="source_entity" />
					</targettype>
				</condition>
			</compare>
		</condition>
	</ontouch>	
</projectile>
