<?xml version="1.0" encoding="UTF-8"?>
<state
    name="State_Devourer_Ability3"
    
    ishidden="true"
    icon="/heroes/Devourer/alt14/ability_03/icon.dds"
    serverentity="true"
>
    <onkilled>
        <targettype type="illusion" target="source_entity" />
		<else>
			<targettype type="mimic" target="source_entity" />
			<else>
				<targettype type="self" source="this_inflictor_entity" />
				<else>
					<targettype type="heropet" target="source_entity" />
					<else>
						<addcharges entity="this_spawner_entity" />
					</else>
				</else>
			</else>
		</else>
    </onkilled>
	
    <onframe />
</state>