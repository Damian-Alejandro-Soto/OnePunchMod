<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_MasterOfArms4"

	icon="icon.tga"
	statuseffecttooltip=""
	
	maxlevel="3"
	requiredlevel="6,11,16"
	
	anim="ability_4"
	casttime="500"
	castactiontime="100"

	actiontype="target_dual"
	casteffecttype="SuperiorMagic"
	targetscheme="ally_heroes"
	
	range="99999"
	dontshowhovercast="true"
	doubleactivate="true"
	
	manacost="100,125,150"
	cooldowntime="80000,70000,60000"
	
	dynamicprecache="/heroes/master_of_arms/alt7/ability_04/effects/sound.effect"
>
	
	<onimpact>
		<!-- Shield -->
		<compare a="target_entity" b="0" op="ne">
			<applystate name="State_MasterOfArms_Ability4" target="target_entity" duration="8000" />
		</compare>
		<else>
			<pushentity searchfortarget="true" searchorigin="target_position" radius="99999" targetscheme="ally_heroes" ignoreinvulnerable="true" />
			<compare a="stack_entity" b="0" op="ne">
				<applystate name="State_MasterOfArms_Ability4" target="stack_entity" duration="8000" />
			</compare>
		</else>
		
		<applystate name="State_MasterOfArms_Ability4_Weapon" target="source_entity" duration="14000" pushentity="true" />
		<pushtool name="Ability_MasterOfArms3" />
		<hasmodifier name="MasterOfArms_Magnetic" entity="stack_entity">
			<popentity />
			<activatemodifierkey name="MasterOfArms_AttackSpeed" entity="stack_entity" />
		</hasmodifier>
		
		<!-- Dynamic sound effect -->
		<setstr0 a="altavatar_path" b="effects/sound.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="source_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/sound.effect" target="source_entity" occlude="true" />
		</else>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100">
		<onframe />
		
		<!-- Copy of the above for tooltips -->
		<onimpact>
			<!-- Shield -->
			<compare a="target_entity" b="0" op="ne">
				<applystate name="State_MasterOfArms_Ability4" target="target_entity" duration="8000" />
			</compare>
			<else>
				<pushentity searchfortarget="true" searchorigin="target_position" radius="99999" targetscheme="ally_heroes" ignoreinvulnerable="true" />
				<compare a="stack_entity" b="0" op="ne">
					<applystate name="State_MasterOfArms_Ability4" target="stack_entity" duration="8000" />
				</compare>
			</else>
			
			<applystate name="State_MasterOfArms_Ability4_Weapon" target="source_entity" duration="14000" pushentity="true" />
			<pushtool name="Ability_MasterOfArms3" />
			<hasmodifier name="MasterOfArms_Magnetic" entity="stack_entity">
				<popentity />
				<activatemodifierkey name="MasterOfArms_AttackSpeed" entity="stack_entity" />
			</hasmodifier>
			
			<!-- Dynamic sound effect -->
			<setstr0 a="altavatar_path" b="effects/sound.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="source_entity" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/sound.effect" target="source_entity" occlude="true" />
			</else>
		</onimpact>
	</modifier>
</ability>
