		<setcharges entity="stack_entity" a="charges" b="var1" op="add" />
		<setcharges entity="this_entity" a="charges" b="var1" op="add" />
		<applystate name="State_AmunRa_Ability3_Timer" target="source_entity" duration="4000" proxy="stack_entity" spawner="this_entity" />
	</onattackeddamageevent>
	
	<ondeath>
