<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Ellonia_Ability1"

	speed="1100"
	gravity="0"

	modelscale="1.65"
	model="/shared/models/invis.mdf"
	
	impacteffect="/heroes/ellonia/alt6/ability_01/effects/impact.effect"
	traileffect="/heroes/ellonia/alt6/ability_01/effects/trail.effect"
	deatheffect="/heroes/ellonia/alt6/ability_01/effects/death.effect"
	
	canturn="false"
	flying="true"
	flyheight="70"
	
	touchradius="110"
	maxtouchespertarget="1"
	touchtargetscheme="enemy_units"
	toucheffecttype="Magic"
	touchradiusdiradjust="true"
	
	lifetime="-1"
>
	<ontouch>
		<damage effecttype="Magic" amount="80,120,160,200" />
		<applystate name="State_Ellonia_Ability3" duration="4000" pushentity="true" />
		<addcharges entity="stack_entity" count="5" />
		<spawnunit name="Gadget_Ellonia_Ability1_Linger" count="1" target="this_position" />

		<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" />
		</else>
	</ontouch>
</projectile>
