<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Midas3"

	icon="/heroes/midas/alt2/ability_03/icon.dds"
	
	anim="ability_3_sink"
	casttime="500"
	castactiontime="500"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetscheme="enemy_units_and_trees"
	casteffecttype="Magic"
	
	targetradius="250"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	activatescheme="movement"
	
	manacost="105"
	range="700"
	cooldowntime="15000"
	noturntotarget="true"
	casteffect="/heroes/midas/alt2/ability_03/effects/cast.effect"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/explosion.effect"
>
	<onimpact>
		<!-- Distance check to prevent long-range casts on the same frame -->
		<setpos0 position="target_position" />
		<distance target="pos0" />
		<compare a="result" b="2100" op="lt">
			<disjoint target="source_entity" />
			<unbind target="source_entity" />
		
			<spawnaffector name="Affector_Midas_Ability3" target="source_position" />
			<spawnunit name="Gadget_Midas_Ability3" count="1" target="target_position" pushentity="true" />
			<applystate name="State_Midas_Ability3" duration="500" target="source_entity" proxy="stack_entity" />
			<spawnprojectile name="Projectile_Midas_Ability3" source="source_entity" target="stack_entity" bind="source_entity" />
		</compare>		
	</onimpact>

	<modifier key="Midas1" modpriority="95"
		cooldowntime="13000"
	/>
	
	<modifier key="Midas2" modpriority="95"
		cooldowntime="12000"
	/>
	
	<modifier key="Midas3" modpriority="95"
		cooldowntime="11000"
	/>
</ability>