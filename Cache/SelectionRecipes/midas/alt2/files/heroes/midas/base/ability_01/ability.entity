<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Midas1"
	
	icon="/heroes/midas/alt2/ability_01/icon.dds"

	anim="ability_1"
	casttime="200"
	castactiontime="200"
	casteffect=""

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	casteffecttype="Magic"
	
	manacost="100,115,130,145"
	cooldowntime="16000"
	range="1000"
	targetradius="175"
	
	showlinecast="true"
	linecastrange="1030"
	linecastwidth="175"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/impact.effect"
>
	<onimpact>
		<getrange />
		<setvar0 a="result" b="5" op="div" /> <!-- Interval -->
		<setvar1 a="var0" /> <!-- Updated range per interval -->
		
		<setpos0 position="source_position" positionend="target_position" positionmodifier="pointonline" positionvalue="var1" />
		<spawnprojectile name="Projectile_Midas1" source="source_entity" target="pos0" />
		
		<setvar1 a="var1" b="var0" op="add" />
		<setpos0 position="source_position" positionend="target_position" positionmodifier="pointonline" positionvalue="var1" />
		<spawnprojectile name="Projectile_Midas2" source="source_entity" target="pos0" />
		
		<setvar1 a="var1" b="var0" op="add" />
		<setpos0 position="source_position" positionend="target_position" positionmodifier="pointonline" positionvalue="var1" />
		<spawnprojectile name="Projectile_Midas3" source="source_entity" target="pos0" />
		
		<setvar1 a="var1" b="var0" op="add" />
		<setpos0 position="source_position" positionend="target_position" positionmodifier="pointonline" positionvalue="var1" />
		<spawnprojectile name="Projectile_Midas4" source="source_entity" target="pos0" />
		
		<setvar1 a="var1" b="var0" op="add" />
		<setpos0 position="source_position" positionend="target_position" positionmodifier="pointonline" positionvalue="var1" />
		<spawnprojectile name="Projectile_Midas5" source="source_entity" target="pos0" />
	</onimpact>

	<modifier key="Midas1" modpriority="95"
		cooldowntime="14000"
	/>
	
	<modifier key="Midas2" modpriority="95"
		cooldowntime="12000"
	/>
	
	<modifier key="Midas3" modpriority="95"
		cooldowntime="10000"
	/>
</ability>
