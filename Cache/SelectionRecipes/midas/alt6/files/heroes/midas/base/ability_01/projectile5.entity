<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Midas5"

	speed="1200"
	gravity="1000"
	lifetime="1250"
	useexactlifetime="true"

	modelscale="1.75"
	model="/shared/models/invis.mdf"

	impacteffect=""
	
	traileffect="/heroes/midas/alt6/ability_01/effects/trail.effect"
>

	<onexpired>
		<spawnaffector name="Affector_Midas_Ability1" target="target_position" />
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="target_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_position" target="target_position" occlude="true" />
		</else>
	</onexpired>

	<modifier key="Midas1" modpriority="100">
		<onimpact>
			<spawnaffector name="Affector_Midas_Reagent1" target="target_position" />
		</onimpact>
	</modifier>
	
	<modifier key="Midas2" modpriority="100">
		<onimpact>
			<spawnaffector name="Affector_Midas_Reagent1" target="target_position" />
		</onimpact>
	</modifier>
	
	<modifier key="Midas3" modpriority="100">
		<onimpact>
			<spawnaffector name="Affector_Midas_Reagent1" target="target_position" />
		</onimpact>
	</modifier>
</projectile>
