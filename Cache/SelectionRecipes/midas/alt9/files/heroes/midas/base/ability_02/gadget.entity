	model="/core/null/invis.mdf"
	passiveeffect="/heroes/midas/alt9/ability_02/effects/trail.effect"

	preglobalscale="1.4"
	modelscale="1.0"
	effectscale="1.0"
	boundsheight="0"
	boundsradius="0"
	isselectable="false"
	iscontrollable="false"
	drawonmap="false"
	selectionradius="0"
	targetoffset="0 0 0"

	canrotate="true"
	ismobile="false"

	attacktype="none"
	combattype="Ranged"

	sightrangeday="800"
	sightrangenight="800"
	unitwalking="true"
	canattack="false"
	deathtime="0"
	corpsetime="1000"
	
	invulnerable="true"
