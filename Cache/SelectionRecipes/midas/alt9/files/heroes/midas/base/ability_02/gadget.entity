	maxhealth="360"
	immunity="AllImmunity"
	dynamicprecache="effects/explosion.effect"

>
	<ondeath>
		<unbind target="this_entity" />
			<setstr0 a="altavatar_path" b="effects/explosion.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="target_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/explosion.effect" source="source_position" target="target_position" occlude="true" />
		</else>
		<expirestate name="State_Midas_Ability2" target="this_owner_entity" />
	</ondeath>

	<onspawn>
		<changehealth a="-285,-240,-195,-150" />
	</onspawn>
</gadget>