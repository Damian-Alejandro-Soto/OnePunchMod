		manacost="115"
		cooldowntime="15000"
	>
		<onimpact>
			<targettype type="self">
				<applystate name="State_Midas_Staff_Ability4" duration="2500" target="target_entity" proxy="source_entity" />
			</targettype>
			<else>
				<spawnprojectile name="Projectile_Midas_Staff_Ability4" target="target_entity" />
			</else>
