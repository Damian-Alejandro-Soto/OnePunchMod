<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_DoctorRepulsor2"

	icon="/heroes/doctor_repulsor/alt10/ability_02/icon.dds"
	statuseffecttooltip="State_DoctorRepulsor_Ability2_Self"
	
	anim="ability_2"
	casttime="300"
	castactiontime="300"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="enemy_units"
	casteffecttype="Magic"
	
	manacost="100"
	cooldowntime="16000,15000,14000,13000"
	
	range="300"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes"
>
	<onimpact>
		<spawnunit name="Gadget_DoctorRepulsor_Ability2" count="1" target="source_position" pushentity="true" />
		<setproxy entity="this_entity" target="stack_entity" />
		
		<cantarget effecttype="Push">
			<unbind target="target_entity" />
			<spawnprojectile name="Projectile_DoctorRepulsor_Ability2" source="target_entity" bind="target_entity" target="stack_entity" pushentity="true" noresponse="true" />
			<applystate name="State_DoctorRepulsor_Ability2" target="target_entity" duration="1200,1500,1800,2100" proxy="stack_entity" />
		</cantarget>		
	</onimpact>
</ability>