<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_DoctorRepulsor_Ability4"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/doctor_repulsor/alt3/ability_04/effects/state.effect"
	
	effecttype=""
	
	invulnerable="true"
	immobilized="true"
	perplexed="true"
	
	modifierkey="DoctorRepulsor_R"
	dynamicprecache="effects/state_end.effect"
	manacostpersecond="150,200,250"
	manapercentcostpersecond="13.5,18,22.5"
>
	<oninflict>
	</oninflict>
	
	<onframe />
	
	<onexpired>
		<applystate name="State_DoctorRepulsor_Ability4_Perplex" duration="800" target="source_entity" />
		<kill target="this_proxy_entity" source="" />
		
		<!-- Dynamic VFX -->
		<setstr0 a="altavatar_path" b="effects/state_end.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/state_end.effect" source="source_entity" target="" occlude="true" />
		</else>
		<playanim name="idle" target="source_entity" />
	</onexpired>
	
	<modifier key="ult_boost" modpriority="100"
		perplexed="false"
	>
		<onexpired>
			<kill target="this_proxy_entity" source="" />
			
			<!-- Dynamic VFX -->
			<getscriptvalue name="land_effect" destvar="str0" entity="this_entity" />
			<playeffectdynamic effect="str0" source="source_entity" target="" occlude="true" />
			<playanim name="idle" target="source_entity" />
		</onexpired>
	</modifier>
</state>
