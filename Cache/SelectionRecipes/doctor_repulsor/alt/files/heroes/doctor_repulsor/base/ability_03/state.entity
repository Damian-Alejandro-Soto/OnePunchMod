<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_DoctorRepulsor_Ability3"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/doctor_repulsor/alt/ability_03/effects/passive.effect"
	
	effecttype="StatusBuff"
	modifierkey="doctorRepulsorAbility3_active"
	dynamicprecache="effects/cast.effect,effects/impact.effect"
>
	<onattackstart>
		<setattackprojectile name="Projectile_DoctorRepulsorEpicAttack" />
	</onattackstart>

	<onattack>
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" target="source_entity" />
		</else>
		<expire />
	</onattack>
	
	<onattackimpact>
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="" source="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" target="" source="target_entity" />
		</else>
		<areaofeffect
			radius="300"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
		>
			<damage effecttype="Magic" amount="40,60,80,100" />
			<applystate name="State_DoctorRepulsor_Ability3_Slow" duration="600" />
		</areaofeffect>
	</onattackimpact>
	<onframe />
	
	<modifier key="ult_boost" modpriority="100">
		<onattackimpact>
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="" source="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" target="" source="target_entity" />
			</else>
			<setvar0 a="source_maxmana" b="0.03" op="mult" />
			<areaofeffect
				radius="300"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="Magic"
			>
				<damage effecttype="Magic" amount="40,60,80,100" b="var0" op="add" />
				<applystate name="State_DoctorRepulsor_Ability3_Slow" duration="600" />
			</areaofeffect>
		</onattackimpact>
	</modifier>
</state>
