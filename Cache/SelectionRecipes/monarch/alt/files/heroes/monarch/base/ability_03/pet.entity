<?xml version="1.0" encoding="UTF-8"?>
<pet
	name="Pet_Monarch_Ability3"
	
	movespeed="400"
	maxmovespeed="2000"
	
	flyheight="0"
	flying="true"
	unitwalking="true"
	treewalking="true"
	cliffwalking="true"
	buildingwalking="true"
	
	effectscale="1"
	modelscale="1.5"
	boundsheight="64"
	boundsradius="16"
	isselectable="true"
	iscontrollable="false"
	selectionradius="20"
	targetoffset="0 0 64"
	
	turnrate="2500"
	
	icon="icon2.tga"
	portrait="icon2.tga"
	model="/heroes/monarch/alt/ability_03/effects/bug/model.mdf"
	skin=""
	
	corpsetime="0"
	corpsefadetime="1000"
	corpsefadeeffect="/shared/effects/corpse_sink.effect"
	
	maxhealth="1"
	immunity="GadgetImmunity"
	
	attacktype="none"
	combattype="Ranged"
	
	goldbountymin="50"
	goldbountymax="50"
	experiencebounty="0"
	
	nothreat="true"
	
	noblockneutralspawn="true"
	unittype="PseudoPet"
	dynamicprecache="effects/cast2.effect"
>

	<onattackedpreimpact>
		<setvalue name="combat_truestrike" a="1" />
	</onattackedpreimpact>
	
	<onspawn>
		<setstr0 a="altavatar_path" b="effects/cast2.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast2.effect" source="this_position" occlude="true" />
		</else>

		<distance source="this_entity" target="this_proxy_entity" />
		<compare a="result" b="80" op="le">
			<expirestate name="State_Monarch_Ability3_Spawner" />
		</compare>
	</onspawn>

	<onframe>
		<distance source="this_entity" target="this_proxy_entity" />
		<compare a="result" b="25" op="le">
			<expirestate name="State_Monarch_Ability3_Spawner" />
			<expirestate name="State_Monarch_Ability3_Spawner_Main" />
		</compare>
	</onframe>
	
	<ondeath />
</pet>
