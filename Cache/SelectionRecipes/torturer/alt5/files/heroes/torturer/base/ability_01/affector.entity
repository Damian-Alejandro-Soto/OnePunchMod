<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Torturer_Ability1"

	radius="225"
	
	targetselection="all"
	targetscheme="enemy_units"
	effecttype="Magic"
	destroytrees="true"
	impactdelay="350"
	impacteffect="/heroes/xalynx/alt5/ability_01/effects/impact.effect"
 dynamicprecache="/heroes/xalynx/alt5/ability_01/effects/chaintrail.effect">
	<onspawn>
	</onspawn>
	
	<onimpact>
		<applystate name="State_Stunned" duration="1250,1500,1750,2000" />
		<damage effecttype="Magic" amount="65,130,195,260" />
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/chaintrail.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/chaintrail.effect" source="target_position" occlude="true" />
		</else>
	</onimpact>
</affector>
