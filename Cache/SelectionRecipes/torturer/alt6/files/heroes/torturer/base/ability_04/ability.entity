<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Torturer4"

	icon="/heroes/xalynx/alt6/ability_04/icon.dds"
	
	anim=""
	casttime="0"
	castactiontime="0"
	casteffect=""

	maxlevel="3"
	requiredlevel="6,11,16"

	casteffecttype="Magic"
	actiontype="toggle"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"
	
	noresponse="false"
	manacost="40,70,100"
	toggleoffmanacost="0"
	cooldowntime="750"
	targetradius="400"
	autotoggleoffwhendisabled="true"
	dynamicprecache="effects/cast.effect,effects/impact.effect"
>
	
	<onimpact effectdescription="true" />
	
	<ontoggleon>
		<spawnaffector name="Affector_Torturer_Ability4" target="source_entity" istoggle="true" />	
	</ontoggleon>
	
	<onabilityimpact>
		<entitytype type="Ability_Torturer4" target="inflictor_entity" />
		<else>
			<setactivemodifierkey name="tort_R_regen" entity="this_entity" />
			<starttimer duration="4000" />
		</else>
	</onabilityimpact>
	
	<ontimer>
		<setactivemodifierkey name="" entity="this_entity" />
	</ontimer>
	
	<modifier key="manabatterytort" condition="toggle_active" modpriority="90"
		noresponse="true"
	>
	</modifier>
	
	<modifier key="tort_R_regen" modpriority="100"
		healthregen="4,7,10"
	>		
	</modifier>

	<modifier key="ult_boost" modpriority="99"
		displayname="true"
		autotoggleoffwhendisabled="false"
	>
		<onimpact />
	</modifier>
</ability>
