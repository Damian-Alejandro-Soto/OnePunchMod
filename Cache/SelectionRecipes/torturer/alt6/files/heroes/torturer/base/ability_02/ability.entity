	name="Ability_Torturer2"

	icon="/heroes/xalynx/alt6/ability_02/icon.dds"

	anim="ability_2"
	casttime="800"
	castactiontime="0"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_self"
	targetscheme="enemy_units_and_structures"
	targetradius="500"
	
	manacost="95,115,135,155"
	cooldowntime="30000,28000,26000,24000"
	dynamicprecache="effects/area.effect,effects/chaintrail.effect,effects/impact.effect,effects/impact_character.effect"
>
	<onimpact >
		<spawnaffector name="Affector_Torturer_Ability2" target="source_entity" />
		<starttimer duration="8000" />
		<setstr0 a="altavatar_path" b="effects/chaintrail.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/chaintrail.effect" source="source_entity" />
		</else>
	</onimpact>
</ability>
