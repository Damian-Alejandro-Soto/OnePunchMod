<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Prophet_Ability2_Split"

	speed="2250"
	gravity="0"

	flying="true"
	flyheight="80"
	
	modelscale="0.7"
	model="/shared/models/invis.mdf"
	traileffect="/heroes/prophet/alt8/ability_02/effects/trail.effect"
	effectscale="0.7"
