<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Prophet_Ability4_Debuff"

	icon="../../icon.dds"
	passiveeffect="/heroes/prophet/alt9/ability_04/effects/state_enemy.effect"
	
	movespeedslowpercharge="0.01"
	maxcharges="40"
	
	impactinterval="250"
	
	modifierkey="Prophet_Ability4_Debuff"
>
	<oninflict>
		<setcharges a="40" />
		<setaccumulator value="0" />
	</oninflict>

	<onrefresh>
		<setcharges a="40" />
		<setaccumulator value="0" />
	</onrefresh>
	
	<onimpact>
		<!-- Timer mechanic -->
		<compare a="accumulator" b="1000,1500,2000" op="lt">
			<changeaccumulator b="250" op="add" />
		</compare>
		<else>
			<evaluate a="charges" b="5" op="sub" />
			<evaluate a="result" b="0" op="max" />
			<setcharges a="result" />
		</else>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100">
		<onimpact>
			<!-- Timer mechanic -->
			<compare a="accumulator" b="1500,2000,2500" op="lt">
				<changeaccumulator b="250" op="add" />
			</compare>
			<else>
				<evaluate a="charges" b="5" op="sub" />
				<evaluate a="result" b="0" op="max" />
				<setcharges a="result" />
			</else>
		</onimpact>
	</modifier>
</state>
