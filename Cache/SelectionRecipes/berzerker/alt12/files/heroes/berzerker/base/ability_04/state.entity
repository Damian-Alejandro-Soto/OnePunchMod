<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Berzerker_Ability4"

	icon="/heroes/berzerker/alt12/ability_04/icon.dds"
	passiveeffect="/heroes/berzerker/alt12/ability_04/effects/state.effect"

	effecttype=""
	incomingdamagemultiplier="0.15"
	slowresistance="1.0"

	modifierkey="Berzerker_ability4"
	dynamicprecache="effects/state_end.effect"
>
	<onattack>
		<bonusdamageadd target="" a="0.05,0.07,0.09" b="source_maxhealth" op="mult"/>
	</onattack>
	
	<onattackingpostimpact>
		<cantarget targetscheme="enemy_heroes">
			<applystate name="State_Berzerker_Ability4_Target" duration="2000" />
		</cantarget>
	</onattackingpostimpact>

	<onexpired>
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/state_end.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/state_end.effect" source="source_entity" target="source_entity" />
		</else>
	</onexpired>
	
	<modifier key="stun_and_debuff_duration_reduction" modpriority="40,60,80" exclusive="true"
		stunneddurationmultiplier="-0.4,-0.55,-0.7"
		debuffdurationmultiplier="-0.4,-0.55,-0.7"
	/>
</state>
