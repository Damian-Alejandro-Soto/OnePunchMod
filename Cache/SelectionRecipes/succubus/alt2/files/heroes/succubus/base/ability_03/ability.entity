<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Succubus3"

	statuseffecttooltip="State_Succubus_Ability3"
	icon="/heroes/succubis/alt2/ability_03/icon.dds"
	passiveeffect=""
	impacteffect=""
	
	anim="ability_3"
	casttime="1000"
	castactiontime="400"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="enemy_and_willing_ally_units"
	manacost="130"
	cooldowntime="15000"
	casteffecttype="Magic"
	novoiceresponse="true"
	
	range="530,570,610,650"
	doubleactivate="true"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes,ally_heroes"
	
	dynamicprecache="effects/impact.effect"
>
	
	<onimpact>
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" occlude="true" />
		</else>
		
		<applystate name="State_Succubus_Ability3" duration="3000,4000,5000,6000" proxy="source_entity" />
		<applystate name="State_Succubus_Ability3_Invulnerable" proxy="source_entity" duration="1000" />
	</onimpact>
	
	<modifier key="Succubus_E_active" modpriority="100"
		nostun="true"
		nosilence="true"		
		anim=""
		ignorecooldown="true"
		icon="/shared/icons/off.tga"
		actiontype="target_self"
		casteffecttype=""
		manacost="0"
		casttime="0"
		castactiontime="0"
		cooldowntime="0"
		dontshowhovercast="true"
	>
		<onimpact>
			<expirestate name="State_Succubus_Ability3" target="source_entity" />
			<expirestate name="State_Succubus_Ability3_Invulnerable" target="source_entity" />
		</onimpact>
	</modifier>
</ability>
