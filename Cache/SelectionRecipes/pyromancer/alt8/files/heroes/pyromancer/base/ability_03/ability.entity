<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Pyromancer3"

	icon="/heroes/Pyromancer/alt8/ability_03/icon.dds"
	statuseffecttooltip="State_Pyromancer_Ability3"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_self"
	casttime="0"
	castactiontime="0"
	
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nonaggressive="true"
	
	manacost="50"
	cooldowntime="30000"
	
	castspeed="0.3,0.45,0.6,0.75"
	casteffect=""
	
	counter="1,2,3,4"
	dynamicprecache="effects/cast.effect"
>
	<onimpact>
		<applystate name="State_Pyromancer_Ability3" duration="6000" target="source_entity" pushentity="true" />
		<addcharges count="3" entity="stack_entity" />
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="source_entity" />
		</else>
	</onimpact>
	
	<onabilityimpact>
		<applystate name="State_Pyromancer_Ability3" duration="6000" target="source_entity" />
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="source_entity" />
		</else>
	</onabilityimpact>
	
	<onattackimpact>
		<cantarget targetscheme="enemy_units">
			<applystate name="State_Pyromancer_Ability3_Burning" duration="3000" />
		</cantarget>
		<cantarget targetscheme="enemy_buildings">
			<applystate name="State_Pyromancer_Ability3_Burning_Building" duration="3000" />
		</cantarget>
	</onattackimpact>

	<modifier key="tutorial_disable3" modpriority="100" requiredlevel="30" />
</ability>
