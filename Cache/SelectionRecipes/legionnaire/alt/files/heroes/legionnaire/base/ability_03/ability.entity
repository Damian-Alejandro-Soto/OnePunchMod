<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Legionnaire3"
	
	icon="../../icon.dds"
	targetradius="300"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	
	maxcharges="8"

	actiontype="passive"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"
	
	casttime="0"
	castactiontime="0"
	cooldowntime="500,400,300,200"
	cooldowntype="legionnaire_E"
	noresponse="true"
	
	dynamicprecache="/heroes/legionnaire/ability_03/effects/cast_alt.effect"
>
	
	<onimpact>
		<setactivemodifierkey name="legionnaire_E_inactive" />	
	</onimpact>
	
	<onattackedpreimpact>
		<combatsupertype supertype="attack">
			<isready>
				<setaccumulator value="0" />

				<compare a="charges" b="8" op="ge">
					<setaccumulator value="1" />
				</compare>
				<else>
					<evaluate a="9" b="charges" op="mult" />
					<evaluate a="0" b="result" op="add" />
					<evaluate a="result" b="100" op="div" />
					<chance threshold="result">
						<setaccumulator value="1" />
					</chance>
					<else>
						<addcharges count="1" />
						<starttimer duration="5000" />
					</else>
				</else>

				<compare a="accumulator" b="1" op="eq">
					<startcooldown />
					
					<spawnaffector name="Affector_Legionnaire_Ability3" target="source_entity" firsttarget="" />
					
					<!-- Dynamic visual effects -->
					<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
					<exists path="str0">
						<playeffectdynamic effect="str0" source="source_entity" target="" occlude="true" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="" occlude="true" />
					</else>

					<setcharges a="0" />
					<resettimer />
				</compare>
			</isready>
		</combatsupertype>
	</onattackedpreimpact>
	
	<ontimer>
		<setcharges a="0" />
	</ontimer>
	
	<modifier key="legionnaire_E_inactive" modpriority="100"
		icon="/shared/icons/off.tga"
	>
		<onimpact>
			<setactivemodifierkey name="" />
		</onimpact>
		
		<onattackedpreimpact />
	</modifier>
</ability>
