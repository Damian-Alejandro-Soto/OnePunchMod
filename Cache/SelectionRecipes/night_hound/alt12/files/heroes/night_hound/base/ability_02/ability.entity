<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_NightHound2"

	icon="/heroes/hantumon/alt12/ability_02/icon.dds"

	anim="ability_2_start"
	casttime="1000"
	castactiontime="300"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="all_other_units"
	casteffecttype="Physical"
	activatescheme="movement"

	manacost="50"
	cooldowntime="14000,11000,8000,5000"

	range="700"

	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes,ally_heroes"
	dynamicprecache="effects/warpin.effect,effects/ability_02.effect"
>
	<onlearn>
		<setcharges a="1" />
	</onlearn>

	<onpreimpact>
		<!-- State that makes Backstab trigger 100% of the time while active -->
		<evaluate a="frametime" b="2" op="mult" />
		<applystate name="State_NightHound_Ability2_SotM_Attacking" duration="result" target="source_entity" />
	</onpreimpact>

	<ontimer>
		<deactivatemodifierkey name="night_hound_w_disabled" />
		<setcharges a="1" />
	</ontimer>

	<onready>
		<compare a="charges" b="0" op="le">
			<addcharges count="1" />
		</compare>
	</onready>
	
	<onimpact>
		<teleport interpolate="false" facetarget="true" specifyangle="true" angle="180" />

		<!-- Art for allies -->
		<cantarget targetscheme="ally_units">
			<setstr0 a="altavatar_path" b="effects/warpin.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" target="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/warpin.effect" source="source_entity" target="target_entity" />
			</else>
		</cantarget>

		<cantarget targetscheme="enemy_units">
			<bonusdamageadd a="25,50,75,100" target="source_entity" />

			<attack />
			<order command="attack" />

			<!-- Art -->
			<playanim name="ability_2_attack" variations="1" length="400" target="source_entity" />
			<setstr0 a="altavatar_path" b="effects/warpin.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" target="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/warpin.effect" source="source_entity" target="target_entity" />
			</else>
			<setstr0 a="altavatar_path" b="effects/ability_02.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/ability_02.effect" source="target_entity" target="" />
			</else>
		</cantarget>

		<setcharges a="0" /> <!-- Accounts for the case where SotM is dropped/sold -->
	</onimpact>

	<modifier key="ult_boost" modpriority="110"
		targetradius="300"
		targetmaterial="/shared/materials/area_cast_indicator_simple.material"

		actiontype="target_dual"
		maxcharges="2"
		cooldowntime="2000"
	>
		<ontimer>
			<addcharges count="1" />
			<compare a="charges" b="2" op="lt">
				<starttimer duration="20000,15000,10000,5000" />
			</compare>

			<deactivatemodifierkey name="night_hound_w_disabled" />
		</ontimer>

		<onready />

		<onimpact>
			<compare a="target_entity" b="0" op="eq">
				<teleport interpolate="false" facetarget="true" target="target_position" />

				<!-- VFX when targeting ground -->
				<setstr0 a="altavatar_path" b="effects/warpin.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/warpin.effect" source="source_entity" target="source_entity" />
				</else>
			</compare>
			<else>
				<teleport interpolate="false" facetarget="true" specifyangle="true" angle="180" />

				<!-- Art for allies -->
				<cantarget targetscheme="ally_units">
					<setstr1 a="altavatar_path" b="effects/warpin.effect" op="add" />
					<exists path="str1">
						<playeffectdynamic effect="str1" source="source_entity" target="target_entity" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/warpin.effect" source="source_entity" target="target_entity" />
					</else>
				</cantarget>

				<cantarget targetscheme="enemy_units">
					<bonusdamageadd a="25,50,75,100" target="source_entity" />
	
					<attack />
					<order command="attack" />
	
					<!-- Art -->
					<playanim name="ability_2_attack" variations="1" length="400" target="source_entity" />
					<setstr1 a="altavatar_path" b="effects/warpin.effect" op="add" />
					<exists path="str1">
						<playeffectdynamic effect="str1" source="source_entity" target="target_entity" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/warpin.effect" source="source_entity" target="target_entity" />
					</else>
					<setstr1 a="altavatar_path" b="effects/ability_02.effect" op="add" />
					<exists path="str1">
						<playeffectdynamic effect="str1" source="target_entity" target="" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/ability_02.effect" source="target_entity" target="" />
					</else>
				</cantarget>
			</else>

			<!-- AoE attack -->
			<areaofeffect
				radius="300"
				center="source_entity"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="Physical"
				ignore="target_entity"
			>
				<!-- Ignore non-revealed Stealthed targets -->
				<targettype type="stealth" />
				<else>
					<bonusdamageadd a="25,50,75,100" target="source_entity" />

					<attack />
				</else>
			</areaofeffect>

			<!-- VFX edge case fix for http://app.juvio.com/bug/bug-viewer?bug_id=HON-BUG-0126-263 -->
			<compare a="result" b="0" op="gt">
				<setstr0 a="altavatar_path" b="effects/warpin.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_entity" target="target_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/warpin.effect" source="source_entity" target="target_entity" />
				</else>
			</compare>

			<!-- Effective cooldown -->
			<compare a="charges" b="2" op="ge">
				<starttimer duration="20000,15000,10000,5000" />
			</compare>
			<removecharge />
			<compare a="charges" b="0" op="le">
				<activatemodifierkey name="night_hound_w_disabled" />
			</compare>
		</onimpact>
	</modifier>

	<modifier key="night_hound_w_disabled" modpriority="99"
		disabled="true"
	>
	</modifier>
</ability>
