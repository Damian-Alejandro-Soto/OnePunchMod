<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_NightHound4"
	
	icon="/heroes/hantumon/alt11/ability_04/icon.dds"

	maxlevel="3"
	requiredlevel="1,6,11"
	
	actiontype="no_target"
	noresponse="true"
	
	casttime="0"
	castactiontime="0"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"
	
	manacost="0"
	cooldowntime="0"
	
	agility="6,12,18"	
>
	
	<onimpact>
		<setactivemodifierkey name="NightHound_invisoff" />
		<expirestate name="State_NightHound_Ability4" />
		<expirestate name="State_NightHound_Ability4_Respawn" />
	</onimpact>
	
	<onrespawn>
		<applystate name="State_NightHound_Ability4_Respawn" duration="4000,3250,2500" />
	</onrespawn>
		
	<onframe>
		<targettype type="alive">
			<targettype type="silenced">
				<expirestate name="State_NightHound_Ability4" />
			</targettype>
			<else>
				<applystate name="State_NightHound_Ability4" continuous="true" pushentity="true" proxy="this_entity" />
			</else>
		</targettype>
		<else>
			<expirestate name="State_NightHound_Ability4" />
		</else>
	</onframe>
	
	<ondeath>
		<setactivemodifierkey name="" />
	</ondeath>
	
	<modifier key="NightHound_invisoff" condition="toggle_active" modpriority="100"
		icon="/shared/icons/off.tga"
	>	
		<onimpact>
			<setactivemodifierkey name="" />
			<applystate name="State_NightHound_Ability4" continuous="true" pushentity="true" proxy="this_entity" />
		</onimpact>
		
		<onframe>
			<expirestate name="State_NightHound_Ability4" />			
		</onframe>		
	</modifier>
</ability>
