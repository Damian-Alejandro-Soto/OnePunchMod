<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Pestilence_Ability4"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/pestilence/alt4/ability_04/effects/state.effect"
	revealed="true"
	sighted="true"
	
	armor="-7,-12,-17"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	dynamicprecache="effects/anger.effect"
>
	<onattackedpreimpact>
		<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/anger.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/anger.effect" source="source_entity" target="source_entity" />
		</else>
	</onattackedpreimpact>
	
	<aura
		gadget="Gadget_Pestilence_Ability4"
		radius="0"
		targetscheme="self"
	/>

	<modifier key="pestilence_nobossarmor" modpriority="100" condition="Boss" notooltooltip="true"
		armor="0"
	/>
</state>
