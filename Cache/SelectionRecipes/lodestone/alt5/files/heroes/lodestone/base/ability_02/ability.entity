<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Lodestone2"

	icon="/heroes/lodestone/alt5/ability_02/icon.dds"
	
	anim="ability_2"
	casttime="1000"
	castactiontime="300"
	casteffect="/heroes/lodestone/alt5/ability_02/effects/cast.effect"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="enemy_units"
	casteffecttype=""
	
	manacost="40"
	cooldowntime="7000"
	cooldowntype="Lodestone_W"
	
	
	range="200"

	targetradius="180"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes"
	modifierkey="Lodestone_W"
	dynamicprecache="effects/impact.effect"
>
	<onimpact>
		<areaofeffect
			radius="180"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype=""
		>
			<cantarget effecttype="Magic" >
				<damage target="target_entity" effecttype="Magic" amount="70,110,150,190" />
			</cantarget>
			<cantarget effecttype="Physical" >
				<damage target="target_entity" effecttype="Physical" amount="70,110,150,190" />
			</cantarget>
		</areaofeffect> 

		<!-- Damage Lodestone -->
		<damage target="source_entity" effecttype="SuperiorMagic" amount="70,110,150,190" nonlethal="true" />
		<damage target="source_entity" effecttype="SuperiorPhysical" amount="70,110,150,190" nonlethal="true" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
		</else>
	</onimpact>
</ability>