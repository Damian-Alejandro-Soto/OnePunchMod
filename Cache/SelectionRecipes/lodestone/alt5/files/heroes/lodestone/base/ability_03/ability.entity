<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Lodestone3"

	icon="../../icon.dds"
	passiveeffect="/heroes/lodestone/alt5/ability_03/effects/bubble4.effect"
	
	anim="ability_1"
	
	baselevel="1"
	maxlevel="5"
	requiredlevel="0,1,3,5,7"
	actiontype="no_target,passive"

	deflectionchance="0,1"
	deflection="0,15,30,45,60"
	
	disabled="true,false"
	dynamicprecache="effects/proc.effect"

>
	<onimpact />
	
	<ontimer>
		<setactivemodifierkey name="" />
	</ontimer>

	<ondamaged priority="-1">
		<hasmodifier name="lodestone_noblock" entity="this_entity" />
		<else>
			<compare a="level" b="1" op="gt">
				<cantarget targetscheme="all_heroes" ignoreinvulnerable="true">
					<damageeffecttype effecttype="DOT" />
					<else>
						<compare a="damage_attempted" b="150" op="ge">
							<changedamage b="1.0,0.60" op="mult" />
							<starttimer duration="0,11000,9000,7000,5000" />
							<setactivemodifierkey name="lodestone_noblock" />

							<!-- VFX -->
							<setstr0 a="altavatar_path" b="effects/proc.effect" op="add" />
							<exists path="str0">
								<playeffectdynamic effect="str0" source="source_entity" occlude="true" />
							</exists>
							<else>
								<playeffectdynamic effect="effects/proc.effect" source="source_entity" occlude="true" />
							</else>
						</compare>
					</else>
				</cantarget>
			</compare>
		</else>
	</ondamaged>

	<modifier key="lodestone_noblock" modpriority="100"
		passiveeffect=""
		icon="icon2.tga"	
	>

		<ondamaged />

		<ontimer>
			<setactivemodifierkey name="" />
		</ontimer>
	</modifier>
	
	<modifier key="Lodestone_W" modpriority="110"
		cooldowntype="Lodestone_W"
		actiontype="no_target"
		disabled="false"
		
		noresponse="true"
	>
		<checkcost>
			<areaofeffect
				radius="250"
				effecttype=""
				targetscheme="visible_enemy_heroes"
				targetselection="all"
				maxtotalimpacts="1"
			>
			</areaofeffect>
			<compare a="result" b="1" op="lt">
				<invalidate />
			</compare>
		</checkcost>
		
		<onimpact>
			<areaofeffect
				radius="250"
				effecttype=""
				targetscheme="visible_enemy_heroes"
				targetselection="closest"
				maxtotalimpacts="1"				
			>
				<useability slot="1" source="source_entity" target="target_entity" />
			</areaofeffect>
		</onimpact>
	</modifier>

	<modifier key="rapidfire" modpriority="99"
	>
		<onframe>
			<compare a="charges" b="0,1,2,3,4" op="eq">
				<setaccumulator value="0" op="min" />
			</compare>
			<else>
				<setaccumulator value="accumulator" valueb="frametime" valueop="add" />
			</else>

			<compare a="accumulator" b="1.2" op="gt">
				<setaccumulator value="0" />
				<addcharges count="1" />
				<compare a="charges" b="0,1,2,3,4" op="eq" />
				<else>
					<starttimer duration="1200" />
				</else>
			</compare>
		</onframe>

		<ondamaged priority="-1">
			<isready>
				<compare a="level" b="1" op="gt">
					<cantarget targetscheme="all_heroes" ignoreinvulnerable="true">
						<damageeffecttype effecttype="DOT" />
						<else>
							<compare a="damage_attempted" b="150" op="ge" >
								<changedamage b="0.65" op="mult" />
								<starttimer duration="0,2200,1800,1400,1000" />
								<setactivemodifierkey name="lodestone_noblock" />

								<!-- VFX -->
								<setstr0 a="altavatar_path" b="effects/proc.effect" op="add" />
								<exists path="str0">
									<playeffectdynamic effect="str0" source="source_entity" />
								</exists>
								<else>
									<playeffectdynamic effect="effects/proc.effect" source="source_entity" />
								</else>
							</compare>
						</else>
					</cantarget>
				</compare>
			</isready>
		</ondamaged>
	</modifier>
</ability>