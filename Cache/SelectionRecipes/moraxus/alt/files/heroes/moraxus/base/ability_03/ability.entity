<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Moraxus3"

	
	icon="/heroes/moraxus/alt/ability_03/icon.dds"	
	anim="ability_3"
	casttime="0"
	castactiontime="0"
	casteffect=""
	
	baselevel="1"
	maxlevel="5"
	requiredlevel="0,1,3,5,7"
	statuseffecttooltip="State_Moraxus_Ability3_Slow"

	actiontype="target_position"
	
	manacost="25"
	cooldowntime="1500"
	frontqueue="true"
	targetscheme="enemy_units"
	disabled="true,false"
	
	casteffecttype="Magic"	
	range="1000"
	forcerange="1000"
	targetradius="60"
	
	maxcharges="2,2,3,4,5"
	chargerefreshtime="5000"
	allowoutofrangecast="false"
	allowoutofboundscast="true"
	
	showlinecast="true"
	linecastrange="1030"
	linecastwidth="60"
	
	showrangeandradiusintooltip="true"
	
	dynamicprecache="effects/newaxe.effect,effects/impact.effect"
>
	<onspawn>
		<setcharges a="2" />		
	</onspawn>
	
	
	<onupgrade>
		<addcharges count="1" />
	</onupgrade>
	
	<onframe>
		<compare a="charges" b="0" op="gt">
			<setactivemodifierkey name="" />
		</compare>
	</onframe>

	<onimpact>
		<spawnunit name="Gadget_Moraxus_Ability3_Reveal" count="1" target="source_position" pushentity="true" />
		<spawnprojectile name="Projectile_Moraxus_Ability3" source="source_entity" target="target_position" bind="stack_entity" proxy="stack_entity" />

		<!-- Charges tracking -->
		<removecharge />
		<compare a="charges" b="0" op="eq">
			<setactivemodifierkey name="moraxus_E_Disabled" />
		</compare>
	</onimpact>
	
	<ondeath>
		<setcharges a="2,2,3,4,5" />
		<setactivemodifierkey name="" />
		<starttimer entity="this_entity" duration="0" />
	</ondeath>

	<ontimer>
		<setstr0 a="altavatar_path" b="effects/newaxe.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/newaxe.effect" source="source_entity" target="source_entity" occlude="true" />
		</else>
	</ontimer>
	
	<modifier key="moraxus_E_Disabled" modpriority="90"
		disabled="true"
	>
	</modifier>

</ability>
