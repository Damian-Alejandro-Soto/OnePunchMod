<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Moraxus_Ability3_Slow"
	
	icon="/heroes/moraxus/alt/ability_03/icon.dds"
	passiveeffect="/heroes/moraxus/alt/ability_03/effects/state_slow.effect"
	effecttype="StatusDebuff"
	allowtransfer="true"
	maxcharges="3"
	
	movespeedslowpercharge="0.15"

	negativeeffect="slowed"
>
	<oninflict>
		<addcharges count="1" />
		<setaccumulator value="1" />
	</oninflict>
	
	<onrefresh>
		<addcharges count="1" />
		<changeaccumulator b="1" op="add" />
		<compare a="accumulator" b="4" op="eq">
			<applystate name="State_Moraxus_Ability3_Immobilize" duration="1500" />
			<setaccumulator value="0" />
		</compare>
	</onrefresh>
	
	<onframe />
</state>
