<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Moraxus_Ability3"

	speed="1300"

	modelscale="2.5"
	model="/heroes/moraxus/alt/ability_03/effects/projectile.mdf"
	effectscale="1"
	impacteffect="/heroes/moraxus/alt/ability_03/effects/impact.effect"
	traileffect="/heroes/moraxus/alt/ability_03/effects/trail.effect"
	canturn="0"
	flying="true"
	flyheight="80"
	
	touchradius="90"
	touchradiusdiradjust="true"
	maxtouches="1"
	touchtargetscheme="enemy_units"
	toucheffecttype="Magic"
>	
	<ontouch>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<targettype type="Boss">
					<damage effecttype="Magic" amount="0,30,40,50,60" />
				</targettype>
				<else>
					<evaluate a="target_maxhealth" b="0,0.03,0.04,0.05,0.06" op="mult" />
					<evaluate a="result" b="0,30,40,50,60" op="add" />
					<damage effecttype="Magic" amount="1" b="result" op="mult" />
				</else>
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" target="" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
				</else>
				<applystate name="State_Moraxus_Ability3_Slow" target="target_entity" duration="3000" />
			</onimpact>
		</combatevent>
		<kill target="proxy_entity" source="" />
		<delete target="this_entity" />
	</ontouch>
	
	<onimpact>
		<kill target="proxy_entity" source="" />
	</onimpact>
</projectile>
