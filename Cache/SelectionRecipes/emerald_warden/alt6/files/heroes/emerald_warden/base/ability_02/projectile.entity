<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_EmeraldWarden_Ability2"

	speed="1200"
	gravity=""
	
	effectscale="1.0"
	modelscale="1.35"
	canturn="true"
	flying="true"
	flyheight="0"
	
	icon="../../icon.dds"
	portrait="../../icon.dds"
	model="/heroes/emerald_warden/alt6/ability_02/effects/wolves/model.mdf"
	skin=""
	impacteffect="/heroes/emerald_warden/alt6/ability_02/effects/impact.effect"
	traileffect="/heroes/emerald_warden/alt6/ability_02/effects/trail.effect"
	
	impactdistance="60"

	impactstealth="true"
>
	<onspawn>
		<setstr0 a="altavatar_path" b="effects/warp.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/warp.effect" source="this_entity" target="" />
		</else>

		<!-- Optional alt-avatar ground burst, anchored to the target-lock world position. -->
		<setstr1 a="altavatar_path" b="effects/warp_ground.effect" op="add" />
		<exists path="str1">
			<playeffectdynamic effect="str1" source="this_position" target="this_position" occlude="true" />
		</exists>
	</onspawn>

	<onimpact>
		<compare a="target_entity" b="0" op="ne">
			<cantarget targetscheme="enemy_units" effecttype="Magic" ignoreinvulnerable="false">
				<combatevent effecttype="AbilityBasedProjectile">
					<onimpact>
						<!-- Damage -->
						<setvar0 a="90,155,220,285" />
						<targettype type="visible">
							<damage source="source_entity" effecttype="Magic" amount="1" b="var0" op="mult" />
						</targettype>
						<else>
							<damage source="source_entity" effecttype="Magic" amount="0.75" b="var0" op="mult" />
						</else>
						
						<applystate name="State_EmeraldWarden_Ability2_Debuff" duration="4000" proxy="this_proxy_entity" />
					</onimpact>
				</combatevent>
			</cantarget>
		</compare>
		<else>
			<setstr0 a="altavatar_path" b="effects/nullimpact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="this_position" source="this_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/nullimpact.effect" target="this_position" source="this_position" occlude="true" />
			</else>
		</else>
	</onimpact>
</projectile>
