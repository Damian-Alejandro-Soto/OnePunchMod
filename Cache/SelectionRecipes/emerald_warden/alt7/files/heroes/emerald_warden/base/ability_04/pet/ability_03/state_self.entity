<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_EmeraldWardenpet_Ability3_Self"

	passiveeffect="/heroes/emerald_warden/alt7/ability_04/effects/ability_03/storm.effect"
	immobilized="true"
	disarmed="true"
	ishidden="true"
	icon="../../../../icon.dds"
	
	modifierkey="Gawain_3_Channeling"
>
	<aura state="State_EmeraldWardenpet_Ability3_Storm" radius="500" targetscheme="enemy_units" effecttype="Magic" />
	
	<oninflict>
		<pushentity entity="source_entity" />
		<hasmodifier name="ult_boost" entity="stack_proxy_entity">
			<setactivemodifierkey name="ult_boost" entity="this_entity" />
		</hasmodifier>
	</oninflict>
	
	<modifier key="ult_boost" modpriority="100">
		<aura state="State_EmeraldWardenpet_Ability3_Storm_Reveal" duration="8000" radius="500" targetscheme="enemy_units" effecttype="Magic" /> 
	</modifier>
</state>
