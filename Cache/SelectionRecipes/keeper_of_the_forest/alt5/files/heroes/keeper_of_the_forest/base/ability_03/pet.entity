<?xml version="1.0" encoding="UTF-8"?>
<pet
	name="Pet_KeeperOfTheForest_Ability3"
	
	icon="../../icon.dds"
	portrait="../../icon.dds"
	model="/heroes/treant/alt5/minion/model.mdf"
	skin=""
	
	passiveeffect="/heroes/treant/alt5/minion/effects/body.effect"
	spawneffect=""
	
	
	
	
	preglobalscale="1.0"
	modelscale="1.3"
	effectscale="0.9"
	boundsheight="64"
	boundsradius="16"
	selectionradius="32"
	targetoffset="0 0 0"

	movespeed="300"
	turnrate="450"
	turnsmoothing="0.05"

	maxhealth="170,205,240,275"
	healthregen="0.25"
	maxmana="0"
	manaregen="0"

	armor="2"
	magicarmor="0"

	
	inventory0=""
	inventory1=""
	inventory2=""
	inventory3=""
	
	attackduration="1000"
	attackactiontime="600"
	attackcooldown="1250"
	attackdamagemin="18,22,26,30"
	attackdamagemax="18,22,26,30"
	attacknumanims="2"
	attackoffset="0 30 100"
	attackprojectile=""
	attackrange="90"
	attackstarteffect=""
	attackactioneffect=""
	attackimpacteffect="../ability_02/pet/effects/impact.effect"
	attacktype="melee"
	combattype="Melee"

	aggrorange="600"
	sightrangeday="1200"
	sightrangenight="800"
	
	goldbountymin="10"
	goldbountymax="10"
	experiencebounty="10"
	
	deniablepercent="0.5"
	showlifetime="true"
	
	unittype="summoned TreantTree"
	nocorpse="true"
	corpsetime="4000"
	corpsefadetime="4500"
	corpsefadeeffect="/shared/effects/corpse_sink.effect"
>
	<onframe>
		<targettype type="alive" target="source_owner_entity" >
			<distance source="source_entity" target="source_owner_entity" />
			<compare a="result" b="925" op="ge">
				<setactivemodifierkey name="treant_pet_notowers" />
			</compare>
		</targettype>
		<else>
			<setactivemodifierkey name="treant_pet_notowers" />
		</else>
	</onframe>

	<modifier key="treant_pet_notowers" modpriority="100"
		attacktargetscheme="everything_but_towers"
	>
		<onframe>
			<distance source="source_entity" target="source_owner_entity" />
			<compare a="result" b="925" op="lt">
				<targettype type="alive" target="source_owner_entity" >
					<setactivemodifierkey name="" />
				</targettype>
			</compare>
		</onframe>
	</modifier>
</pet>
