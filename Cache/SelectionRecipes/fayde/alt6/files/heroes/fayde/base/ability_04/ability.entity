<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Fayde4"

	icon="/heroes/fade/alt6/ability_04/icon.dds"
	statuseffecttooltip="State_Fayde_Ability4_Stealth"
	
	maxlevel="3"
	requiredlevel="6,11,16"
	
	anim=""
	casttime="0"
	castactiontime="0"
	casteffect="effects/cast.effect"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"	

	actiontype="target_self"
	
	manacost="150,175,200"
	cooldowntime="80000,70000,60000"
	
	maxcharges="3"
	dynamicprecache="../effects/impact.effect"
>
	<onimpact>
		<applystate name="State_Fayde_Ability4_Vision" continuous="true" duration="2000" target="source_entity" pushentity="true" />
		<applystate name="State_Fayde_Ability4_Stealth" duration="22000,40000,55000" target="source_entity" proxy="stack_entity" />
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100">
		<onimpact>
			<applystate name="State_Fayde_Ability4_Vision" continuous="true" duration="2000" target="source_entity" pushentity="true" />
			<applystate name="State_Fayde_Ability4_Stealth" duration="22000,40000,55000" target="source_entity" proxy="stack_entity" pushentity="true" />
			<applystate name="State_Fayde_Ability4_Umbral" duration="22000,40000,55000" target="source_entity" proxy="stack_entity" pushentity="true" />
			<setcharges a="3" />
			<setproxy entity="this_entity" target="stack_entity" />
		</onimpact>
	</modifier>
	
	<modifier key="fade_umbral" modpriority="120"
		actiontype="target_entity"
		targetscheme="enemy_units"
		
		range="700"
		showareacast="true"
		
		ignorecooldown="true"
		cooldowntime="0"
		frontqueue="false"
		inheritmovement="false"
		noninterrupting="false"
		nonaggressive="false"
		
		manacost="0"
	>
		<onimpact>
			<teleport interpolate="false" facetarget="true" specifyangle="true" angle="180" />
			
			<!-- Shadow Walk -->
			<applystate name="State_Fayde_Ability3" duration="1000" target="source_entity" />
			<pushtool name="Ability_Fayde3" />
			<evaluate a="source_level" source="stack_entity" />
			<spawnaffector name="Affector_Fayde_Ability3" lifetime="1000" target="source_entity" level="result" />
			
			<!-- If this is your first cast, then immediately force an attack to expire the R state -->
			<compare a="charges" b="3" op="ge">
				<attack />
			</compare>
			<else>
				<!-- Apply mini-DoT state -->
				<applystate name="State_Fayde_Ability4_DoT_Mini" duration="2000" />
				
				<!-- VFX/SFX that occur on-teleport -->
				<setstr0 a="altavatar_path" b="../effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" occlude="true" />
				</exists>
				<else>
					<playeffectdynamic effect="../effects/impact.effect" occlude="true" />
				</else>
			</else>
			
			<!-- Charge management -->
			<compare a="this_proxy_entity" b="0" op="ne">
				<removecharge entity="this_entity" />
				<compare a="result" b="0" op="le">
					<expirestate name="State_Fayde_Ability4_Umbral" target="source_entity" />
					<resettimer />
				</compare>
				<else>
					<setvar3 a="5000" /> <!-- Timer duration -->
					<starttimer duration="var3" />
					<changeduration b="var3" op="min" entity="this_proxy_entity" />
					<changeduration b="var3" op="max" entity="this_proxy_entity" />
				</else>
			</compare>
			
			<order command="attack" />
		</onimpact>
	</modifier>
</ability>