<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Fayde1"
	
	icon="/heroes/fade/alt6/ability_01/icon.dds"
	anim="ability_1"
	
	casttime="600"
	castactiontime="200"
	casteffect=""
	maxlevel="4"
	requiredlevel="1,3,5,7"
	
	actiontype="self_position"
	targetscheme="enemy_units"
	targetradius="300"
	casteffecttype="Magic"
	
	manacost="100"
	cooldowntime="10000"
	dynamicprecache="effects/cast.effect,effects/impact.effect"
>
		<onimpact>
			<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="" source="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/cast.effect" target="" source="source_entity" />
			</else>	
		<areaofeffect
			radius="300"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"

		>
			<cantarget targetscheme="enemy_mana_units">
				<manaburn amount="0.07,0.14,0.21,0.28" b="target_maxmana" op="mult" nopopup="false" />
				
				<!-- Mana gain on Fade -->			
				<setvar0 a="result" b="0.5" op="mult" />
				<targettype type="Boss" />
				<else>
					<givemana amount="var0" target="source_entity" />
				</else>
			</cantarget>
			
			<damage effecttype="Magic" amount="100,160,220,280" />
			<cantarget targetscheme="enemy_heroes">
				<spawnillusion owner="source_entity" source="target_entity" count="1" lifetime="3500,4000,4500,5000" receivedamagemultiplier="3.5" inflictdamagemultiplier="0.1,0.12,0.14,0.16" pushentity="true" /> 
				<order command="attack" force="true" forceduration="5000" source="stack_entity" target="target_entity" />
				<applystate name="State_Fayde_Ability1_SecondPhase" target="stack_entity" duration="3500,4000,4500,5000" />
				<applystate name="State_Fayde_Ability2_ExpirePet" target="target_entity" proxy="stack_entity" duration="3500,4000,4500,5000" />
			</cantarget>
			
			<!-- VFX -->
			<compare a="var0" b="0" op="gt">
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" target="" source="target_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact.effect" target="" source="target_entity" />
				</else>
			</compare>
		</areaofeffect>
	</onimpact>	
</ability>