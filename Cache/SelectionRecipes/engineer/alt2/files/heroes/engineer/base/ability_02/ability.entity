<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Engineer2"

	icon="/heroes/engineer/alt2/ability_02/icon.dds"
	statuseffecttooltip="State_Engineer_Ability2_Suppression"
	
	anim="ability_2"
	casttime="300"
	castactiontime="0"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	
	casteffecttype="Physical"
	targetscheme="enemy_units"
	casteffect=""
	
	range="650"
	
	manacost="40,60,80,100"
	cooldowntime="26000,22000,18000,14000"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	
	interface="single_plus_one"
>
	<onimpact>
		<spawnprojectile name="Projectile_Engineer_Ability2" target="target_position" />
	</onimpact>
	
	<onattack>
		<!-- Midwars-only: don't hand the turret a target while it is outside the 800 leash, or attacking would clear the disable -->
		<setvar1 a="0" />
		<hasmodifier name="OnlyMidMap">
			<distance source="source_entity" target="this_proxy_entity" />
			<compare a="result" b="800" op="gt">
				<setvar1 a="1" />
			</compare>
		</hasmodifier>

		<compare a="var1" b="0" op="eq">
			<targettype type="alive" source="this_proxy_entity" target="this_proxy_entity">
				<cantarget effecttype="Physical" targetscheme="visible_enemy_objects">
					<setvar0 source="this_proxy_entity" a="source_attackrange" b="0" op="add" />
					<distance source="this_proxy_entity" target="target_entity" />
					<compare a="result" b="var0" op="le">
						<pushtool source="this_proxy_entity" name="Ability_Engineer2_Turret_1" />
						<compare source="stack_proxy_entity" target="target_entity" a="source_entity" b="target_entity" op="ne">
							<setproxy entity="stack_entity" target="target_entity" />
							<expirestate name="State_Engineer_Ability2_TurretDisabled" target="this_proxy_entity" />
							<order command="attack" source="this_proxy_entity" target="target_entity" />
						</compare>
					</compare>
				</cantarget>
			</targettype>
		</compare>
	</onattack>

	<!-- Midwars-only modifier context for tooltip routing to :OnlyMidMap strings -->
	<modifier key="OnlyMidMap" modpriority="100" />

</ability>