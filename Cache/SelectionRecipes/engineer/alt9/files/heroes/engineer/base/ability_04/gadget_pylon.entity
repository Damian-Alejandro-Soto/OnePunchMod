<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_Engineer_Ability4_Pylon"

	icon="../../icon.dds"
	portrait=""
	model="/heroes/engineer/alt9/ability_04/effects/fence/model.mdf"
	skin=""
	
	passiveeffect="/heroes/engineer/alt9/ability_04/effects/pylon.effect"
	spawneffect=""
	respawneffect=""
	selectsound=""
	orderconfirmedsound=""
	

	preglobalscale="1.6"
	modelscale="1.0"
	effectscale="1.0"
	boundsheight="64"
	boundsradius="16"
	selectionradius="48"
	targetoffset="0 0 64"

	unitwalking="true"
	ismobile="false"
	isselectable="false"
	iscontrollable="false"
	canrotate="false"
	drawonmap="false"

	invulnerable="true"

	armor="0"
	magicarmor="0"
	immunity="GadgetImmunity"

	canattack="false"
	
	attacktype="none"
	combattype="Ranged"

	sightrangeday="0"
	sightrangenight="0"

	
	lifetime="6000,8000,10000"
	
	unittype="PseudoPet"
	
	corpsetime="1000"
	noblockneutralspawn="true"
	dynamicprecache="pylon/effects/death.effect"
>
	<onframe>
		<targettype type="alive" target="this_proxy_entity" />
		<else>
			<expire entity="this_entity" />
		</else>
	</onframe>
	
	<onexpired>
		<setstr0 a="altavatar_path" b="pylon/effects/death.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" />
		</exists>
		<else>
			<playeffectdynamic effect="pylon/effects/death.effect" />
		</else>
	</onexpired>
</gadget>