<?xml version="1.0" encoding="UTF-8"?>
<heropet
	name="Heropet_Gemini_Ability4_Ice"

	icon="../../icon.dds"
	portrait="../../icon.dds"
	model="/heroes/gemini/alt/frostpet/model.mdf"
	skin=""
	
	passiveeffect="../pets/ice/effects/body.effect"
	spawneffect="effects/spawn.effect"
	
	selectedsound="/heroes/gemini/alt/sounds/voice/vox_%.wav"
	selectedflavorsound="../pets/ice/sounds/voice/select_flavour_%.wav"
	confirmmovesound="../pets/ice/sounds/voice/move_%.wav"
	confirmattacksound="../pets/ice/sounds/voice/attack_%.wav"
	nomanasound="../pets/ice/sounds/voice/no_mana.wav"
	cooldownsound="../pets/ice/sounds/voice/cooldown.wav"
	tauntedsound="../pets/ice/sounds/voice/taunt_prior.wav"
	tauntkillsound="../pets/ice/sounds/voice/taunt_after.wav"
	
	preglobalscale="1.5"
	modelscale="1.0"
	effectscale="0.7"
	boundsheight="112"
	boundsradius="24"
	selectionradius="62"
	targetoffset="0 0 90"
	
	movespeed="300"
	turnrate="600"
	turnsmoothing="0.05"
	
	maxhealth="150"
	healthregen="1.00"
	maxmana="0"
	manaregen="0.01"
	
	mapicon="../../icon.dds"
	mapiconsize="0.05"
	mapiconcolor="0 .3 1 1"
	
	immunity="TransfigureImmunity"
	invulnerable="false"
	
	armor="1.0"
	magicarmor="5.5,7.5,9.5"
	
	
	inventory0="Ability_Icecat1"
	inventory1="Ability_Icecat2"
	inventory2="Ability_Icecat3"
	inventory3="Ability_Icecat4"
	inventory5="Ability_Icecat3b"
	inventory6="Ability_Icecat_Stats"
	
	attackduration="900"
	attackactiontime="400"
	attackcooldown="1700"
	attackdamagemin="24"
	attackdamagemax="29"
	attacknumanims="2"
	attackoffset="0 30 100"
	attackprojectile=""
	attackrange="150"
	attackstarteffect=""
	attackactioneffect=""
	attackimpacteffect="../pets/ice/effects/impact.effect"
	attacktype="melee"
	combattype="Hero"
	
	aggrorange="600"
	sightrangeday="1800"
	sightrangenight="800"
	wanderrange="250"
	
	primaryattribute="agility"
	strength="0"
	agility="0"
	intelligence="0"
	
	continuousmodifiers="false"
	diewithowner="true"
	relayexperience="true"
	
	unittype="catz heropet Icecat"
	
	corpsetime="0"
	deathtime="0"
>
	<onattackedpredamage>
		<cantarget targetscheme="player_controlled_enemy_units">
			<applystate name="Gemini_Ability4_Assist" duration="100" inflictor="target_entity" target="source_owner_entity" />
		</cantarget>
	</onattackedpredamage>
	
	<ondamaged>
		<hasmodifier name="alt_Doombringer" entity="source_owner_entity">
			<cantarget targetscheme="player_controlled_enemy_units_and_gadgets" ignoreinvulnerable="true">
				<targettype type="mimic" target="source_owner_entity" />
				<else>
					<targettype type="illusion" target="source_owner_entity" />
					<else>
						<applystate name="State_Doombringer_ItemDrop" target="source_owner_entity" duration="8000" pushentity="true" />
					</else>
				</else>
			</cantarget>
		</hasmodifier>
	</ondamaged>
	
	<onframe>
		<!-- Shop state check -->
		<hasmodifier name="ShopAccess_Main" entity="this_entity">
			<applystate name="State_ShopAccess_Main" target="source_owner_entity" timeout="frametime" />
		</hasmodifier>
		<else>
			<hasmodifier name="ShopAccess_Outpost" entity="this_entity">
				<applystate name="State_ShopAccess_Outpost" target="source_owner_entity" timeout="frametime" />
			</hasmodifier>
			<else>
				<hasmodifier name="ShopAccess_Secret" entity="this_entity">
					<applystate name="State_ShopAccess_Secret" target="source_owner_entity" timeout="frametime" />
				</hasmodifier>
			</else>
		</else>
	</onframe>
	
	<modifier key="Gemini_Ult_Invuln" modpriority="100"
		invulnerable="true"
	/>
	
	<modifier key="iamsheeped" modpriority="1000"
		passiveeffect=""
	/>
</heropet>
