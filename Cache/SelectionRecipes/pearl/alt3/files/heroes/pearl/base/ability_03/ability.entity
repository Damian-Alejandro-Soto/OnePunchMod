<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Pearl3"

	icon="/heroes/pearl/alt3/ability_03/icon.dds"
	
	anim="ability_3"
	casteffect=""

	casttime="0"
	castactiontime="0"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="false"
	nonaggressive="true"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	targetradius="600"
	
	actiontype="target_self"
	casteffecttype="SuperiorMagic"
	targetscheme="ally_heroes"
	
	manacost="70,80,90,100"
	cooldowntime="25000"
	
	interface="single_plus_one"
	modifierkey="Pearl_E1,Pearl_E2,Pearl_E3,Pearl_E4"
	dynamicprecache="effects/impact_ally.effect"
>
	<onframe>
		<setcharges entity="this_entity" a="0" />
	</onframe>
	
	<onimpact>
		<areaofeffect
			targetselection="all"
			targetscheme="ally_heroes"
			radius="600"
			effecttype=""
			ignoreinvulnerable="true"
		>
			<heal a="100,150,200,250" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact_ally.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact_ally.effect" source="target_entity" target="" />
			</else>
		</areaofeffect>
	</onimpact>
	
	<modifier key="ready" modpriority="100" condition="ready">
		<aura state="State_Pearl_Ability3_Tooltip" radius="500" targetscheme="ally_heroes" effecttype="" propagatecondition="not_stealthed" ignoreinvulnerable="true" />
		
		<onframe>
			<areaofeffect
				targetselection="all"
				targetscheme="ally_heroes"
				radius="500"
				effecttype=""
				ignoreinvulnerable="true"
			>
			</areaofeffect>
			<setvar0 a="result" />
			<compare a="var0" b="2" op="ge">
				<areaofeffect
					targetselection="all"
					targetscheme="ally_heroes"
					radius="500"
					effecttype=""
					ignoreinvulnerable="true"
				>
					<applystate name="State_Pearl_Ability3_Ally" continuous="true" timeout="frametime" pushentity="true" />
					<setcharges entity="stack_entity" a="var0" />
					<setcharges entity="this_entity" a="var0" />
				</areaofeffect>
			</compare>
			<else>
				<applystate name="State_Pearl_Ability3_Ally" target="source_entity" continuous="true" timeout="frametime" pushentity="true" />
				<setcharges entity="stack_entity" a="var0" />
				<setcharges entity="this_entity" a="var0" />
			</else>
		</onframe>
	</modifier>
</ability>