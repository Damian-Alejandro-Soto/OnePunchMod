<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Pearl_Ability3"

	gravity="5500"
	lifetime="750"
	useexactlifetime="true"
	
	model="/shared/models/invis.mdf"
	traileffect="/heroes/pearl/alt10/ability_03/trail.tga"
>
	<onimpact>		
		<!-- Impact VFX -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_position" target="this_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="this_position" target="this_position" occlude="true" />
		</else>
	</onimpact>
</projectile>
