<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Pearl_Ability4"

	icon="/heroes/pearl/alt8/ability_04/icon.dds"

	passiveeffect=""
	effecttype=""
	
	modifierkey="pearl_ability4_Affected"
>
	<oninflict>
		<cantarget targetscheme="enemy_objects" source="this_inflictor_entity" target="this_owner_entity" ignoreinvulnerable="true">
			<setactivemodifierkey name="pearl_ability4_Enemy" />
		</cantarget>
	</oninflict>
	
	<onframe />

	<ondamaged priority="5">
		<hasmodifier entity="target_entity" name="pearl_ability4_Affected" />
		<else>
			<scaledamage scale="0.55,0.4,0.25" />
		</else>
	</ondamaged>
	
	<modifier key="pearl_ability4_Enemy" modpriority="100"
	>
		<onframe />
		
		<ondamaged />
		
		<ondamage priority="5">
			<hasmodifier entity="target_entity" name="pearl_ability4_Affected" />
			<else>
				<scaledamage scale="0.55,0.4,0.25" />
			</else>
		</ondamage>
	</modifier>
</state>
