<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Riptide3"
	statuseffecttooltip="State_Riptide_Ability3"

	icon="/heroes/riptide/alt/ability_03/icon.dds"

	anim="ability_1"
	casttime="500"
	castactiontime="300"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="self_position"
	targetradius="350"
	
	manacost="20"
	cooldowntime="20000"
	
	noshuffle="true"
	dynamicprecache="effects/splash.effect"
>
	<onimpact>
				<setstr0 a="altavatar_path" b="effects/splash.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_owner_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/splash.effect" source="this_owner_position" occlude="true" />
		</else>
		<spawnunit name="Gadget_Riptide_Ability3" target="this_owner_position" maxactive="1" />
	</onimpact>
	
	<onframe>
		<targettype type="alive" target="source_entity">
			<comparetiledefinition name="water" position="source_entity">
				<applystate name="State_Riptide_Ability3" target="source_entity" duration="3000" continuous="true" timeout="frametime" />
			</comparetiledefinition>
			<else>
				<hasmodifier entity="source_entity" name="riptide_ult_active">
					<applystate name="State_Riptide_Ability3" target="source_entity" duration="3000" continuous="true" timeout="frametime" />
				</hasmodifier>
			</else>
		</targettype>
	</onframe>
	
	<modifier key="ult_boost" modpriority="100">
		<onframe>
			<targettype type="alive" target="source_entity">
				<comparetiledefinition name="water" position="source_entity">
					<applystate name="State_Riptide_Ability3" target="source_entity" duration="3000" continuous="true" timeout="frametime" />
					<applystate name="State_Riptide_Ability3_Staff" target="source_entity" continuous="true" />
				</comparetiledefinition>
				<else>
					<hasmodifier entity="source_entity" name="riptide_ult_active">
						<applystate name="State_Riptide_Ability3" target="source_entity" duration="3000" continuous="true" timeout="frametime" />
					</hasmodifier>
					<else>
						<hasmodifier entity="source_entity" name="riptide_staff_active">
							<applystate name="State_Riptide_Ability3" target="source_entity" duration="3000" continuous="true" timeout="frametime" />
						</hasmodifier>
					</else>
				</else>
			</targettype>
		</onframe>
	</modifier>

</ability>