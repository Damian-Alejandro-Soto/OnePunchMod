<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_FlintBeastwood_Ability1"

	speed="2200"
	gravity="15000"

	modelscale="1"
	model="/shared/models/invis.mdf"

	effectscale="1.0"
	traileffect="/heroes/flint_beastwood/alt14/ability_01/effects/trail.effect"
	impacteffect=""
>	
	<onimpact>
		<areaofeffect
			radius="300"
			targetselection="all"
			targetscheme="enemy_units_and_Towers"
			effecttype="Magic"
		>
			<cantarget targetscheme="enemy_units">
				<applystate name="State_FlintBeastwood_Ability1_DoT" duration="2000" />
			</cantarget>
			<else>
				<damage effecttype="Magic" amount="40,60,80,100" />
			</else>
		</areaofeffect>
		<spawnunit name="Gadget_FlintBeastwood_Ability1" count="1" target="target_position" />
		<spawnaffector name="Affector_FlintBeastwood_Ability1" target="target_position" />
	</onimpact>
</projectile>
