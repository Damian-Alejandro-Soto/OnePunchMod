<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_VoodooJester_Ability4"
	
	icon="icon.tga"
	portrait=""
	model="/heroes/voodoo/alt8/ability_04/effects/ward.mdf"
	skin=""
	
	passiveeffect="/heroes/voodoo/alt8/ability_04/effects/body.effect"
	spawneffect="effects/spawn.effect"
	
	
	isselectable="false"
	drawonmap="false"
	
	
	preglobalscale="0.9"
	modelscale="1.0"
	effectscale="0.9"
	boundsheight="64"
	boundsradius="16"
	selectionradius="26"
	targetoffset="0 0 64"
	
	portraitcampos="-15 40 55"

	movespeed="0"
	turnrate="900"
	ismobile="false"
	canrotate="true"

	maxhealth="0"
	healthregen="0"
	maxmana="0"
	manaregen="0"

	invulnerable="true"
	canattack="true"
	immunity="GadgetImmunity"

	attackduration="300"
	attackactiontime="0"
	attackcooldown="300"
	attackdamagemin="60,90,120"
	attackdamagemax="60,90,120"
	attacknumanims="1"
	attackoffset="0 25 110"
	attackprojectile="Projectile_Ward_Attack"
	attackrange="700"
	attackstarteffect=""
	attackactioneffect="effects/attack.effect"
	attackimpacteffect=""
	attacktype="ranged"
	combattype="Hero"
	attacktargetscheme="enemy_heroes"
	attackeffecttype=""
	
	aggrorange="600"
	sightrangeday="1200"
	sightrangenight="800"

	experiencebounty="31"
	goldbountymin="23"
	goldbountymax="38"
	
	unittype="PseudoPet"
	
	lifetime="8000"
	noblockneutralspawn="true"

>
	<onattackimpact activateonbounces="true">
		<bounce count="0,0,1" range="550" damagemult="1" targetscheme="visible_enemy_heroes" />
	</onattackimpact>
	
	<onframe>
		<activatemodifierkey name="VJ_Ult_Selectable" />
	</onframe>
	
	<modifier key="VJ_Ult_Selectable" modpriority="100"
		isselectable="true"
	/>
	
	<modifier key="ult_boost" modpriority="100"
		displayname="true"
		attackdamagemin="90,120,150"
		attackdamagemax="90,120,150"
		passiveeffect="/heroes/voodoo/alt8/ability_04/effects/body_boost.effect,../alt8/ability_04/effects/body_boost2.effect,../alt8/ability_04/effects/body_boost3.effect"
	>
		<onspawn>
			<activatemodifierkey name="VJ_Ult_Selectable" />
		</onspawn>
		
		<onattackimpact activateonbounces="true">
			<bounce count="0,1,2" range="550" damagemult="1" targetscheme="visible_enemy_heroes" maxbouncespertarget="1" />
		</onattackimpact>
		
		<onframe>
			<targettype type="alive" source="this_owner_entity" target="this_owner_entity">
				<targettype type="stunned" source="this_owner_entity" target="this_owner_entity">
					<hidechannelbar toolname="Ability_VoodooJester4" target="this_owner_entity" />
					<kill target="this_entity" source="" />
				</targettype>
				<else>
					<targettype type="silenced" source="this_owner_entity" target="this_owner_entity">
						<hidechannelbar toolname="Ability_VoodooJester4" target="this_owner_entity" />
						<kill target="this_entity" source="" />
					</targettype>
					<else>
						<compare a="source_entity" b="0" op="eq">
							<hidechannelbar toolname="Ability_VoodooJester4" target="this_owner_entity" />
							<kill target="this_entity" source="" />
						</compare>
					</else>
				</else>
			</targettype>
			<else>
				<hidechannelbar toolname="Ability_VoodooJester4" target="this_owner_entity" />
				<kill target="this_entity" source="" />
			</else>
		</onframe>
	</modifier>
</gadget>
