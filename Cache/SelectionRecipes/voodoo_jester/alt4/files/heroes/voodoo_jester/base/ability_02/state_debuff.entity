<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_VoodooJester_Ability2_Debuff"

	icon="icon.tga"
	passiveeffect="/heroes/voodoo/alt4/ability_02/effects/state_enemy.effect"
	deniable="true"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
>		
	<aura
		gadget="Gadget_VoodooJester_Ability2"
		radius="0"
		targetscheme="self"
		proxy="proxy_entity"
		gadgetowner="proxy_entity"
	/>
	
	<onframe>
		<damage effecttype="Magic DOT" amount="15,25,35,45" b="frametime" op="mult" />
		
		<areaofeffect
			center="target_entity"
			radius="500"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
			ignore="target_entity"
		>
			<applystate name="State_VoodooJester_Ability2_Debuff_Aura" continuous="true" timeout="frametime" />
		</areaofeffect>
	</onframe>
</state>
