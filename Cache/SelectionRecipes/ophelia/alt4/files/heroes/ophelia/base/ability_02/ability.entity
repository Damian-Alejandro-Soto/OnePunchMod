<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Ophelia2"

	icon="../../icon.dds"
	statuseffecttooltip="State_Ophelia_Ability2"

	anim="ability_2"
	casttime="800"
	castactiontime="300"
	casteffect="/heroes/ophelia/alt4/ability_02/effects/cast.effect"
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	casteffecttype="Magic"
	targetscheme="enemy_and_ally_nonlanecreep_willing_units"
	deferchannelcost="true"

	manacost="100,115,130,145"
	cooldowntime="16000"

	doubleactivate="true"

	range="600"

	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	dynamicprecache="effects/damage_impact.effect,effects/teleport_impact.effect,effects/teleport_impact_well.effect"
>
	<onimpact>
		<cantarget targetscheme="enemy_units">
			<damage effecttype="Magic" amount="90,160,230,300" />

			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/damage_impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/damage_impact.effect" source="target_entity" />
			</else>
		</cantarget>
		<else>
			<cantarget targetscheme="other_ally_heroes">
				<applystate name="State_Ophelia_Ability2" duration="5500,5000,4500,4000" />
			</cantarget>
			<else>
				<!-- Teleport a friendly siege creep to safety (same fountain-recall buff as ally heroes) -->
				<cantarget targetscheme="ally_siege_creeps">
					<applystate name="State_Ophelia_Ability2" duration="5500,5000,4500,4000" />
				</cantarget>
				<else>
					<targettype type="self">
						<!-- Teleport delay -->
						<setvar0 a="3000" />

						<areaofeffect
							radius="99999"
							targetselection="all"
							targetscheme="my_neutral_units_and_pets"
							effecttype="Magic"
							ignore="target_entity"
						>
							<applystate name="State_Ophelia_Ability2_Creep" duration="var0" />
						</areaofeffect>
						<starttimer duration="var0" />
					</targettype>
					<else>
						<targettype type="mine">
							<pushentitysearch global="true" targetscheme="ally_well" ignoreinvulnerable="true" />
							<compare a="stack_entity" b="0" op="ne">
								<!-- VFX -->
								<setstr1 a="altavatar_path" b="effects/teleport_impact.effect" op="add" />
								<exists path="str1">
									<playeffectdynamic effect="str1" source="target_position" />
								</exists>
								<else>
									<playeffectdynamic effect="effects/teleport_impact.effect" source="target_position" />
								</else>
								<setstr1 a="altavatar_path" b="effects/teleport_impact_well.effect" op="add" />
								<exists path="str1">
									<playeffectdynamic effect="str1" source="target_entity" />
								</exists>
								<else>
									<playeffectdynamic effect="effects/teleport_impact_well.effect" source="target_entity" />
								</else>

								<unbind target="target_entity" />
								<teleport source="target_entity" target="stack_position" interpolate="false" />
								<disjoint target="target_entity" />
								<expirestate name="State_Ophelia_Ability2" target="target_entity"/>
							</compare>
							<order command="stop" force="true" source="target_entity" target="target_entity" />
						</targettype>
					</else>
				</else>
			</else>
		</else>
	</onimpact>
</ability>
