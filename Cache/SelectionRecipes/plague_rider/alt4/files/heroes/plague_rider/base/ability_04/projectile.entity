<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_PlagueRider_Ability4"

	speed="900"
	gravity="0"
	
	flying="true"
	flyheight="48"

	modelscale="1.2"
	model="/heroes/diseasedrider/alt4/ability_04/effects/model.mdf"

	impacteffect=""
	invalideffect=""
	traileffect="/heroes/diseasedrider/alt4/ability_04/effects/trail.effect"
 dynamicprecache="/heroes/diseasedrider/alt4/ability_04/effects/impact.effect">
	<onspawn>
	</onspawn>
	
	<onimpact>
		<!-- Deal damage and apply state if the target is still valid -->
		<combatevent source="source_entity" target="this_proxy_entity" effecttype="AbilityBasedProjectile">
			<onimpact>
				<applystate name="State_PlagueRider_Ability4" duration="3000" />
				<!-- Do not insta-kill Bosses -->
				<targettype type="Boss" target="this_proxy_entity">
					<damage effecttype="Magic" amount="280,370,460" target="this_proxy_entity" />
				</targettype>
				<else>
					<cantarget targetscheme="enemy_creeps" target="this_proxy_entity">
						<!-- Special behaviour for Ancients -->
						<targettype type="Ancient" target="this_proxy_entity">
							<kill goldbountymult="0.6,0.8,1.0" experiencebountymult="0.6,0.8,1.0" />
						</targettype>
						<else>
							<kill />
						</else>
					</cantarget>
					<else>
						<cantarget targetscheme="summoned_enemy_units" target="this_proxy_entity">
							<targettype type="ElitePet" target="this_proxy_entity">
								<damage effecttype="Magic" amount="280,370,460" target="this_proxy_entity" />
							</targettype>
							<else>
								<kill />
							</else>
						</cantarget>
						<else>
							<cantarget targetscheme="nonstealth_enemy_units" target="this_proxy_entity">
								<damage effecttype="Magic" amount="280,370,460" target="this_proxy_entity" />
							</cantarget>
						</else>
					</else>
				</else>
			</onimpact>
		</combatevent>
		
		<!-- Dynamic visual impact effect -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="this_proxy_entity" source="this_proxy_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" target="this_proxy_entity" source="this_proxy_entity" occlude="true" />
		</else>

		<!-- Bounce -->
		<compare a="param" b="0" op="gt">
			<setvar0 a="param" b="1" op="sub" />
			<compare a="this_proxy_entity" b="0" op="ne">
				<areaofeffect
					radius="600"
					maxtotalimpacts="1"
					targetselection="random"
					targetscheme="nonstealth_enemy_units"
					center="this_position"
					ignore="this_proxy_entity"
				>
					<spawnprojectile name="Projectile_PlagueRider_Ability4" source="this_position" target="target_position" proxy="target_entity" param="var0" />
				</areaofeffect>
			</compare>
			<else>
				<areaofeffect
					radius="600"
					maxtotalimpacts="1"
					targetselection="random"
					targetscheme="nonstealth_enemy_units"
					center="this_position"
				>
					<spawnprojectile name="Projectile_PlagueRider_Ability4" source="this_position" target="target_position" proxy="target_entity" param="var0" />
				</areaofeffect>
			</else>
		</compare>
	</onimpact>
</projectile>