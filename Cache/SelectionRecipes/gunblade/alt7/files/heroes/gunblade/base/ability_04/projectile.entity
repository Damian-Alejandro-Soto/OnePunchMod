<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Gunblade_Ability4"

	gravity="0"
	lifetime="500"
	useexactlifetime="true"

	modelscale="1.0"
	traileffect="/heroes/gunblade/alt7/ability_04/effects/trail_feet.effect"
	model="/shared/models/invis.mdf"
	
	canturn="false"
	flying="false"
	flyheight="0"
>
	<onimpact>
		<targettype type="alive" target="source_entity" >
			<compare a="this_proxy_entity" b="0" op="ne">
				<unbind target="source_entity" />
				<playanim name="idle" target="source_entity" />
				<applystate name="State_Gunblade_Ability4" target="source_entity" duration="4000,5000,6000" proxy="this_proxy_entity" />
				<order command="attack" source="source_entity" target="this_proxy_entity" />
			</compare>
		</targettype>
	</onimpact>

	<modifier key="ult_boost" modpriority="101"
		impacteffect="effects/impact_staff.effect"
	>
		<onimpact>
			<targettype type="alive" target="source_entity" >
				<compare a="this_proxy_entity" b="0" op="ne">
					<unbind target="source_entity" />
					<playanim name="idle" target="source_entity" />
					<applystate name="State_Gunblade_Ability4" target="source_entity" duration="4000,5000,6000" proxy="this_proxy_entity" />
					<areaofeffect
						radius="650"
						center="source_entity"
						targetscheme="enemy_units"
						targetselection="all"
						effecttype="Physical" 
						ignore="this_proxy_entity"
					>
						<applystate name="State_Gunblade_Ability4_Fear" duration="1500" target="target_entity" />
						<applystate name="State_Gunblade_Ability4_Reduced" duration="8000" target="target_entity" proxy="source_entity" />
					</areaofeffect>
					<order command="attack" source="source_entity" target="this_proxy_entity" />
				</compare>
			</targettype>
		</onimpact>
	</modifier>
	
</projectile>