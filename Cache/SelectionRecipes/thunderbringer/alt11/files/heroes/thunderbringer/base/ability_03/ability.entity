<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Thunderbringer3"

	icon="../../icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="passive"
	targetradius="900"
	
	noshuffle="true"
	dynamicprecache="/heroes/kunas/alt11/ability_03/effects/static.effect"
	
	modifierkey="lightningrod1,lightningrod2,lightningrod3,lightningrod4"
>
	
	<!-- When inflicting ability damage, apply the bonus damage -->
	<ondamage>
		<!-- Prevent infinite loops -->
		<entitytype type="Ability_Thunderbringer3" target="inflictor_entity" />
		<else>
			<cantarget targetscheme="enemy_heroes" effecttype="Magic">
				<!-- Q is the damage source -->
				<entitytype type="Ability_Thunderbringer1" target="inflictor_entity">
					<setaccumulator value="1" />
				</entitytype>
				<entitytype type="Affector_Thunderbringer_Ability1" target="inflictor_entity">
					<setaccumulator value="1" />
				</entitytype>
				
				<!-- W is the damage source -->
				<entitytype type="Ability_Thunderbringer2" target="inflictor_entity">
					<setaccumulator value="1" />
				</entitytype>
				
				<!-- R is the damage source -->
				<entitytype type="Ability_Thunderbringer4" target="inflictor_entity">
					<setaccumulator value="1" />
				</entitytype>
				<entitytype type="Affector_Thunderbringer_Ability4" target="inflictor_entity">
					<setaccumulator value="1" />
				</entitytype>
				
				<!-- If any of the above conditions pass true, then deal the bonus damage -->
				<compare a="accumulator" b="1" op="eq">
					<!-- Base Damage percentage -->
					<setvar0 a="0.025,0.040,0.055,0.070" b="target_health" op="mult" />
					
					<!-- Damage based on distance from Thunderbringer -->
					<distance source="source_entity" target="target_entity" />
					<compare a="result" b="1100" op="le">
						<damage effecttype="Magic Splash" amount="1" b="var0" op="mult" />
						<popup name="bonus_damage" a="result" source="target_entity" target="source_entity" />
					</compare>
					<else>
						<damage effecttype="Magic Splash" amount="0.5" b="var0" op="mult" />
						<popup name="bonus_damage" a="result" source="target_entity" target="source_entity" />
					</else>
					
					<!-- Dynamic VFX -->
					<setstr0 a="altavatar_path" b="effects/static.effect" op="add" />
					<exists path="str0">
						<playeffectdynamic effect="str0" source="target_entity" occlude="true" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/static.effect" source="target_entity" occlude="true" />
					</else>
				</compare>
				<setaccumulator value="0" />
			</cantarget>
		</else>
	</ondamage>
	
	<onimpact />

</ability>
