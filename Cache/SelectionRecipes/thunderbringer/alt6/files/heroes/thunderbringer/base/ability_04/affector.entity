<?xml version="1.0" encoding="UTF-8"?>
<affector
        name="Affector_Thunderbringer_Ability4"

        radius="600"
        lifetime="-1"

        impactinterval="3000,2250,1800"
        targetscheme="enemy_units"
        targetselection="all"
        effecttype="Magic"
        persist="true"

        impacteffect="/heroes/kunas/alt6/ability_04/light_strike_engine.effect"
        effect="effects/aoe_sotm.effect"
>
        <onspawn>
                <setparam a="0" />
        </onspawn>

        <onimpact>
                <targettype type="ally">
                        <!-- <applystate name="State_Thunderbringer_Ability4_Ally" duration="1000" /> -->
                </targettype>
                <else>
                        <applystate name="State_Thunderbringer_Ability4_Enemy" duration="1000" />
                        <damage effecttype="Magic" amount="250" />
                </else>
        </onimpact>

        <oninterval>
                <setparam a="param" b="1" op="add" />
                <compare a="param" b="4,5,6" op="ge">
                        <delete target="this_entity" />
                </compare>
        </oninterval>

        <!-- Midwars-only changes -->
        <modifier key="OnlyMidMap" modpriority="100"
                radius="400"
        >
                <onimpact>
                        <targettype type="ally">
                                <!-- <applystate name="State_Thunderbringer_Ability4_Ally" duration="1000" /> -->
                        </targettype>
                        <else>
                                <applystate name="State_Thunderbringer_Ability4_Enemy" duration="50" />
                                <damage effecttype="Magic" amount="150,175,200" />
                        </else>
                </onimpact>
        </modifier>
</affector>
