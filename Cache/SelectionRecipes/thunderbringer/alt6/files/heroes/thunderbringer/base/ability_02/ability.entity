<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Thunderbringer2"
	
	icon="../../icon.dds"
	
	anim="ability_2"
	casttime="1000"
	castactiontime="300"
	casteffect="effects/weapons_impact.effect"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="all_units"
	casteffecttype="Magic"
	
	manacost="90,105,120,135"
	cooldowntime="6000"
	
	targetradius="450"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	
	range="700"
	impacteffect="/heroes/kunas/alt6/ability_02/bolt_lightning_02_viewer.effect"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	doubleactivate="true"
	targetpriorities="enemy_heroes,ally_heroes"
	
>
	<onimpact>
		<spawnunit name="Gadget_ThunderbringerDummyReveal" target="target_position" />
		<spawnunit name="Gadget_ThunderbringerDummyReveal_Ward" target="target_position" />
		
		<cantarget targetscheme="ally_units">
			<applystate name="State_Thunderbringer_Ability2" duration="5000" />
		</cantarget>
		
		<cantarget targetscheme="enemy_units">
			<applystate name="State_Stunned" duration="100,200,300,400" />
			<damage effecttype="Magic" amount="105,180,255,330" />
		</cantarget>
	</onimpact>
</ability>
