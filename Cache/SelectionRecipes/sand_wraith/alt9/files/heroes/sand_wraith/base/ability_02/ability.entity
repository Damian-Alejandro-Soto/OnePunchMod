<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_SandWraith2"
	
	icon="/heroes/sand_wraith/alt9/ability_02/icon.dds"
	
	anim="idle"
	casttime="0"
	castactiontime="0"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="no_target"
	
	cooldowntime="30000"
	manacost="15,25,35,45"
	dynamicprecache="effects/implode.effect,effects/impact.effect"
	
>
	<onimpact>
		<disjoint target="this_owner_entity" />
		<orderdisjoint target="this_owner_entity" />
		<applystate name="State_SandWraith_Ability2_Self" target="this_owner_entity" duration="200" />
		<setstr0 a="altavatar_path" b="effects/implode.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_owner_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/implode.effect" source="this_owner_position" occlude="true" />
		</else>
		
		<cantarget effecttype="Push" target="this_owner_entity" ignoreinvulnerable="true">
			<spawnillusion 
				target="this_owner_entity"
				count="2"
				spawncircular="true"
				spawncircularradius="100"
				spawncircularrotate="false"
				pushentity="true"
				lifetime="20000"
				receivedamagemultiplier="4,3.5,3,2.5"
				inflictdamagemultiplier="0.25,0.3,0.35,0.4"
				spawneffect="effects/multiple_images.effect"
			/>
			
			<!-- Visual cast effect propagation to illusions -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="stack_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="stack_position" occlude="true" />
			</else>
			<popentity />
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="stack_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="stack_position" occlude="true" />
			</else>
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="this_owner_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="this_owner_position" occlude="true" />
			</else>
		</cantarget>
		
		<!-- Visual cast effect propagation to illusions -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="stack_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="stack_position" occlude="true" />
		</else>
		<popentity />
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="stack_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="stack_position" occlude="true" />
		</else>
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_owner_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="this_owner_position" occlude="true" />
		</else>
			
		<starttimer duration="20000" />
		<clearteamtarget />		
	</onimpact>
</ability>

