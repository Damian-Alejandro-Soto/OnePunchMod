	passiveeffect="/heroes/kraken/alt4/ability_04/effects/ability_self.effect"
	spawneffect="effects/spawn.effect"
	
	
	isselectable="false"
	iscontrollable="false"
	drawonmap="false"
	
	
	preglobalscale="1.3"
	modelscale="1.3,1.45,1.6"
	effectscale="1.1,1.25,1.45"
	boundsheight="64"
	boundsradius="16"
	selectionradius="36"
	targetoffset="0 0 0"

	movespeed="0"
	turnrate="0"
	ismobile="false"
	canrotate="false"

	maxhealth="0"
	healthregen="0"
	maxmana="0"
	manaregen="0"

	invulnerable="true"
