>
	<aura state="State_Kraken_Ability4_Slow" radius="250,275,300" targetscheme="enemy_nonboss_units" effecttype="Push" disablenegativeeffectpopuponrefresh="true" />

	<onexpired>
		<setstr0 a="altavatar_path" b="effects/death.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/death.effect" source="source_position" target="" occlude="true" />
		</else>
	</onexpired>
</gadget>
