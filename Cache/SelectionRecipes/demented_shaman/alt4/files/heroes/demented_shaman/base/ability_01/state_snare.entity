	movespeedslowstart="0.55"
	movespeedslowmid="0.55,0.7,0.85,1.0"
	movespeedslowend="0.55,0.7,0.85,1.0"
	movespeedslowmidpos="0.8"
	movespeedslowduration="2000"
	
	effecttype="StatusDebuff"
	allowtransfer="true"

	negativeeffect="slowed"
>
	<oninflict>
