<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Hellbringer_Ability2"

	icon="../../icon.dds"
	passiveeffect="/heroes/hellbringer/alt6/ability_02/effects/state.effect"
	displaylevel="true"
	deniable="true"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	impactinterval="1000"
	maxcharges="8"
	
	
>
	<onframe />
	
	<onimpact>
		<addcharges />
		<damage effecttype="Magic DOT" amount="10" b="charges" op="mult" />
		<popup name="poison" a="result" source="target_entity" target="source_entity" />
		<compare a="charges" b="8" op="eq" >
			<setcharges a="0" />
		</compare>
	</onimpact>
</state>
