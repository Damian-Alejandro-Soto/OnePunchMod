<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Hellbringer_Ability4"

	radius="600"
	
	lifetime="500"
	impactinterval="500"
	impactdelay="500"
	targetselection="all"
	targetscheme="enemy_units"
	effecttype=""
	destroytrees="true"
 dynamicprecache="/heroes/hellbringer/alt6/ability_04/effects/star.effect">
	<onspawn>
	</onspawn>
	
	<oninterval>
		<spawnunit name="Pet_Hellbringer_Ability4" count="1" target="target_position" />
	</oninterval>
	
	<onimpact>
		<applystate name="State_Stunned" duration="1000"/>
		<damage effecttype="Magic" amount="100"/>
		<applystate name="State_Hellbringer_Ability4" duration="3000" />
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100">
		<!-- Use first affector as a timer to spawn the visual effects of the second one -->
		<onexpired>
			<!-- Dynamic visual effects -->
			<setstr0 a="altavatar_path" b="effects/star.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/star.effect" source="target_position" target="" occlude="true" />
			</else>
		</onexpired>
	</modifier>
</affector>
