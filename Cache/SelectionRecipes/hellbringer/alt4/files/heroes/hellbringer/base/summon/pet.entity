<?xml version="1.0" encoding="UTF-8"?>
<pet
	name="Pet_Hellbringer_Ability4"
	
	icon="../../icon.dds"
	portrait="../../icon.dds"

	model="/heroes/hellbringer/alt/summon/model.mdf"
	skin=""
	
	passiveeffect="/heroes/hellbringer/alt/summon/effects/body.effect"
	spawneffect=""
	
	showlifetime="true"
	
	immunity="TransfigureImmunity"
	
	preglobalscale="2.2"
	modelscale="1"
	effectscale="1.26"
	boundsheight="96"
	boundsradius="24"
	selectionradius="50"
	targetoffset="0 0 64"

	movespeed="375,400,425"
	turnrate="540"
	turnsmoothing="0.05"

	maxhealth="900,1350,1800"
	healthregen="10,14,18"
	maxmana="400"
	manaregen="0"

	armor="5,10,15"
	magicarmor="17"

	
	inventory0="Ability_Malphas2"
	inventory1="Ability_Malphas3"
	inventory2="Ability_Malphas4"
	

	attackduration="1000"
	attackactiontime="800"
	attackcooldown="1500"
	attackdamagemin="80,120,160"
	attackdamagemax="80,120,160"
	attacknumanims="2"
	attackoffset="60 60 100"
	attackprojectile=""
	attackrange="128"
	attackstarteffect=""
	attackactioneffect=""
	attackimpacteffect="effects/impact.effect"
	attacktype="melee"
	combattype="Hero"

	aggrorange="600"
	sightrangeday="1800"
	sightrangenight="1800"
	
	goldbountymin="150,200,250"
	goldbountymax="150,200,250"
	experiencebounty="100"
	
	deniablepercent="0.5"
	
	lifetime="60000"

	corpsetime="2000"
	corpsefadetime="10000"
	corpsefadeeffect="/shared/effects/corpse_sink.effect"
	
	unittype="summoned Malphas ElitePet"
 icon2="/heroes/hellbringer/alt/summon/icon.dds">
	<onspawn>
		<hasmodifier name="ult_boost" entity="this_owner_entity">
			<applystate name="State_Malphas_Ability4_Sotm" target="this_entity" continuous="true" />
		</hasmodifier>
	</onspawn>
	
	<onframe>
		<targettype type="alive" target="source_owner_entity" >
			<distance source="source_entity" target="source_owner_entity" />
			<compare a="result" b="925" op="ge">
				<setactivemodifierkey name="malphas_notowers" />
			</compare>
		</targettype>
		<else>
			<setactivemodifierkey name="malphas_notowers" />
		</else>
	</onframe>
	
	<modifier key="malphas_notowers" modpriority="300"
		attacktargetscheme="everything_but_towers"
	>
		<onframe>
			<distance source="source_entity" target="source_owner_entity" />
			<compare a="result" b="925" op="lt">
				<targettype type="alive" target="source_owner_entity" >
					<setactivemodifierkey name="" />
				</targettype>
			</compare>
		</onframe>
	</modifier>
	
	<modifier key="iamsheeped" modpriority="1000"
		passiveeffect=""
	/>
</pet>