<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Malphas4"
	
	icon="/heroes/hellbringer/summon/ability_04/icon.dds"
	
	maxlevel="3"
	actiontype="passive"
	dynamicprecache="effects/impact.effect"

>
	<onattackingdamageevent>
		<targettype type="building">
			<setvalue name="damage_attempted" a="damage_attempted" b="1.25" op="mult" />
			
			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="target_entity" source="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" target="target_entity" source="target_entity" />
			</else>
		</targettype>
	</onattackingdamageevent>
</ability>
