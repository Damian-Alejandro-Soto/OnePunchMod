<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Hellbringer_Ability3_Pet_Attacking"
	
	serverentity="true"
	
	buildingwalking="true"
	unitwalking="true"
	treewalking="true"
	cliffwalking="true"
	
	movespeed="1600"
	
	modifierkey="hellbringer_pet_attacking"
	
	dynamicprecache="/heroes/hellbringer/alt2/ability_03/effects/spawn.effect"
 model="/heroes/hellbringer/alt2/ability_03/demon/model.mdf">
	<oninflict>
	</oninflict>
	
	<onframe>
		<targettype type="alive" target="this_proxy_entity" source="this_proxy_entity">
			<distance source="this_owner_entity" target="this_proxy_entity" />
			<compare a="result" b="48" op="le">
				<kill target="this_owner_entity" source="" />
				<expirestate name="State_Hellbringer_Ability3_Sight" target="this_proxy_entity" />
			</compare>
		</targettype>
		<else>
			<kill target="this_owner_entity" source="" />
		</else>
	</onframe>
	
	<onexpired>
		<kill target="this_owner_entity" source="" />		
		<expirestate name="State_Hellbringer_Ability3_Sight" target="this_proxy_entity" />
	</onexpired>
	
	<ondeath>
		<compare a="this_proxy_entity" b="0" op="ne">
			<spawnaffector name="Affector_Hellbringer_Ability3" target="this_proxy_position" />
			
			<!-- Dynamic visual effects -->
			<setstr0 a="altavatar_path" b="effects/spawn.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="this_proxy_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/spawn.effect" source="this_proxy_position" occlude="true" />
			</else>
		</compare>
		<else>
			<spawnaffector name="Affector_Hellbringer_Ability3" target="this_owner_position" />
			
			<!-- Dynamic visual effects -->
			<setstr0 a="altavatar_path" b="effects/spawn.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="this_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/spawn.effect" source="this_position" occlude="true" />
			</else>
		</else>
	</ondeath>
</state>
