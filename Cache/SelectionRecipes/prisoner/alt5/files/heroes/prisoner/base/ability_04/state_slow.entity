	<onframe />
	
	<onattackingdamageevent>
		<compare source="this_proxy_entity" target="target_entity" a="source_entity" b="target_entity" op="eq">
			<setvalue name="damage_attempted" a="damage_attempted" b="0.75,0.5,0.25" op="mult" />
		</compare>
	</onattackingdamageevent>
</state>