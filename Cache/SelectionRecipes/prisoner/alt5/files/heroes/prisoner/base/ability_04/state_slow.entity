<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Prisoner_Ability4_Slow"

	icon="/heroes/prisoner/alt5/ability_04/icon.dds"
	passiveeffect=""
	
	movespeedslow="0.8"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	
	negativeeffect="slowed"
