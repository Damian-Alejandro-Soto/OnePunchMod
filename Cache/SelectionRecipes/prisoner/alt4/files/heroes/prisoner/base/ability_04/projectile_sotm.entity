<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Prisoner_Ability4_Sotm"
	
	lifetime="1000"
	useexactlifetime="true"
	gravity="3000"
	
	modelscale="2.0"
	model="/heroes/prisoner/alt4/ability_01/effects/ball/model.mdf"
	traileffect="/heroes/prisoner/alt4/ability_04/effects/trail.effect"
	effectscale="1.0"
	impacteffect=""

	
	
	disjointable="false"
	
	dynamicprecache="effects/cast.effect"
>
	<onspawn>
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<setscriptvalue name="cast_effect" value="str0" entity="this_entity" />
		</exists>
		<else>
			<setscriptvalue name="cast_effect" value="effects/cast.effect" entity="this_entity" />
		</else>
	</onspawn>
		
	<onimpact>
		<compare a="target_entity" b="0" op="ne">
			<setent0 entity="target_entity" />
			<areaofeffect
				center="target_entity"
				ignore="target_entity"
				radius="650"
				targetselection="all"
				targetscheme="enemy_heroes"
				effecttype="SuperiorPhysical"
			>
				<applystate name="State_Prisoner_Ability4_Sotm" inflictor="ent0" proxy="this_owner_entity" duration="2500" />
				<damage effecttype="SuperiorPhysical" amount="100,150,200" />
			</areaofeffect>

			<applystate name="State_Prisoner_Ability4_Self" target="target_entity" duration="2500" />
			<applystate name="State_Prisoner_Ability4_Sotm" inflictor="ent0" proxy="this_owner_entity" duration="2500" />
			
			<!-- Apply the 2nd ability -->
			<pushtool source="this_owner_entity" name="Ability_Prisoner2" />
			<setvar0 source="stack_entity" a="source_level" />
			<setvar1 a="2000" b="var0" op="mult" />
			<setvar1 a="var1" b="1000" op="add" />
			<compare a="var0" b="1" op="ge">
				<applystate name="State_Prisoner_Ability2" duration="var1" statelevel="var0" />
			</compare>

			<damage effecttype="SuperiorPhysical" amount="100,150,200" />
			
			<!-- Dynamic visual effects -->
			<getscriptvalue name="cast_effect" destvar="str0" entity="this_entity" />
			<playeffectdynamic effect="str0" source="target_entity" target="" />
		</compare>
	</onimpact>
</projectile>