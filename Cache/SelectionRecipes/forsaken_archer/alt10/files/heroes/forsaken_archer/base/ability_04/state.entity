<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_ForsakenArcher_Ability4"

	icon="../../icon.dds"
	
	impactinterval="500"
	
	passiveeffect="/heroes/forsaken_archer/alt10/ability_04/effects/cast.effect"
	
	effecttype=""
	dynamicprecache="effects/attack.effect"
>
	<onimpact>
		<pushtool name="Ability_ForsakenArcher4" source="source_owner_entity" />
		<setvar0 a="1.0" /> <!-- Lifetime (s) -->
		<getrange entity="stack_entity" />
		<setvar1 a="var1" b="var0" op="div" /> <!-- Final Affector Speed, v = d/t -->		
		<setvar0 a="var0" b="1000" op="mult" /> <!-- Lifetime (s) to (ms) -->
		<spawnaffector name="Affector_ForsakenArcher_Ability4" owner="source_owner_entity" target="source_position" distance="175" speed="var1" lifetime="var0" />
		
		<!-- Art -->
		<playanim name="ability_4" target="source_entity" />	
	</onimpact>
</state>
