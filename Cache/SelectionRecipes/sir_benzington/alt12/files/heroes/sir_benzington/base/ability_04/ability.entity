<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_SirBenzington4"

	icon="icon.tga"

	statuseffecttooltip="State_SirBenzington_Ability4_Enemy_Slow"
	
	anim="ability_4"
	casttime="850"
	castactiontime="300"
	ischanneling="true"
	safechannel="true"
	channeltime="2000"

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_position"
	targetscheme="enemy_heroes"
	casteffecttype="SuperiorMagic"
	targetradius="400,500,600"
	targetmaterial="/shared/materials/area_cast_indicator_simple.material"
	activatescheme="movement"
	
	manacost="100,150,200"
	cooldowntime="120000,110000,100000"
	range="99999"
	
	casteffect=""
	
	dontshowhovercast="true"
	showareacast="false"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/channel_sound.effect"
	
 traileffect="/heroes/sir_benzington/alt12/ability_04/effects/cast.effect">
	<onimpact />
	
	<onchannelstart>
		<spawnunit name="Gadget_SirBenzington_Ability4_Shadow" count="1" target="target_position" pushentity="true" />
		<applystate name="State_SirBenzington_Ability4_Delay" target="this_owner_entity" ischannel="true" proxy="stack_entity" />
		<setproxy target="stack_entity" />
			<setstr0 a="altavatar_path" b="effects/channel_sound.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_owner_entity" target="" occlude="false" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/channel_sound.effect" source="this_owner_entity" target="" occlude="false" />
		</else>
	</onchannelstart>
	
	<onchannelbreak>
		<delete target="this_proxy_entity" />
		
	</onchannelbreak>
	
	<onchannelend>
		<disjoint target="source_entity" />
		<unbind target="source_entity" />
		<spawnprojectile name="Projectile_SirBenzington_Ability4_Selfbind" source="this_owner_entity" target="this_proxy_entity" bind="this_owner_entity" bindstate="State_SirBenzington_Ability4_Selfbind" noresponse="true" />
	</onchannelend>
</ability>
