<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_SirBenzington_Active_Ability2"

	icon="icon.tga"
	
	maxcharges="3"
	
	passiveeffect="/heroes/sir_benzington/alt3/ability_03/effects/state_self.effect"
	
	effecttype="StatusBuff"
	allowtransfer="true"
	attackrange="150"
	dynamicprecache="effects/impact.effect"
	
>
	<onframe>
		<hasmodifier name="iamsheeped" entity="this_owner_entity" >
			<activatemodifierkey entity="this_entity" name="sheeped" />
		</hasmodifier>
	</onframe>
	
	<onspawn>
		<entitytype type="Hero_SirBenzington"/>
		<else>
			<activatemodifierkey name="not_benzington"/>
		</else>
	</onspawn>
	
	<onattackimpact>
		<cantarget targetscheme="enemy_units" effecttype="Magic">
			<setvar0 a="charges" b="15,30,45,60" op="mult" />
			<damage effecttype="Magic" amount="30,60,90,120" b="var0" op="add" />

			<!-- VFX -->
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" occlude="true" />
		</else>
		</cantarget>
		
		<expire />
	</onattackimpact>
	
	<modifier key="sheeped" modpriority="100"
		passiveeffect=""
	/>
	
	<!-- Parasite Ability04 -->
	<modifier key="not_benzington" modpriority="100"
		passiveeffect="effects/state_parasite.effect"
	/>
</state>
