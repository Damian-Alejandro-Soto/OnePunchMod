<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Chipper_Ability2"

	lifetime="650"
	useexactlifetime="true"
	gravity="5500"

	model="/heroes/chipper/trophy_skin/model_02/ability_02/effects/tar_projectile/model.mdf"
	modelscale="1.25"
	traileffect="/heroes/chipper/trophy_skin/model_02/ability_02/effects/trail.effect"
	impacteffect=""
>
	<onimpact>
		<spawnaffector name="Affector_Chipper_Ability2" target="target_position" />
		<setstr0 a="altavatar_path" b="effects/aoe.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/aoe.effect" source="target_position" target="" occlude="true" />
		</else>	
	</onimpact>		
</projectile>
