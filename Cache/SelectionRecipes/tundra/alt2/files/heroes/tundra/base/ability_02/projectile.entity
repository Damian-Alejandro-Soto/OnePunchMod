<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Tundra_Ability2"

	speed="1300"
	gravity=""
	
	effectscale="1.0"
	model="/shared/models/invis.mdf"
	canturn="true"
	flying="true"
	flyheight="0"
	traileffect="/heroes/tundra/alt2/ability_03/effects/trail.effect"
	
	impactdistance="60"
>
	<onspawn>
		<playanim name="ability_3" target="source_entity" />
	</onspawn>

	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<applystate name="State_Tundra_Ability2_Debuff" target="target_entity" duration="8000" />
				<applystate name="State_Tundra_Ability2_Slow" target="target_entity" duration="2000" />
				<attack source="this_owner_entity" target="target_entity" startcooldown="false" />
			</onimpact>
		</combatevent>
		<unbind target="source_entity" />
		<targettype type="alive" target="source_entity">
			<playanim name="idle" target="source_entity"/>
		</targettype>

		<order command="attack" source="source_entity" target="target_entity" queue="front" />

		<!-- Art stuff -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" target="source_entity" />
		</else>
	</onimpact>
</projectile>
