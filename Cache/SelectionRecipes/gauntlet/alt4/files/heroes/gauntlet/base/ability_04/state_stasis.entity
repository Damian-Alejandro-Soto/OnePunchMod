<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Gauntlet_Ability4_Stasis"

	icon="/heroes/gauntlet/alt4/ability_04/icon.dds"
	passiveeffect="effects/state_stasis.effect"
	
	immunitytype="IndirectImmunity"
	nothreat="true"
	
	unitwalking="true"
	stunned="true"
	frozen="true"
	revealed="true"
	
	impactinterval="1000"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
>

	<onimpact>
		<compare a="accumulator" b="0" op="eq">
			<setaccumulator value="1" />
		</compare>
	</onimpact>

	<onframe />
	
	<onexpired>
		<targettype type="alive" target="target_entity">
			<playanim name="idle" target="target_entity" />
		</targettype>
	</onexpired>
	
	<ondamaged>
		<compare a="accumulator" b="1" op="eq">
			<compare a="source_damage" b="0" op="gt">
				<cantarget targetscheme="player_controlled_enemy_units">
					<expire />
				</cantarget>
			</compare>
		</compare>
	</ondamaged>
</state>
