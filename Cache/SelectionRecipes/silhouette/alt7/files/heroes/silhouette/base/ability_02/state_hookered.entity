<?xml version="1.0" encoding="UTF-8"?>
<state 
    name="State_Silhouette_Ability2_Hookered" 

    icon="../../icon.dds" 
	passiveeffect="/heroes/silhouette/alt8/ability_02/effects/link.effect" 
    inheritvisibilityfromowner="true"
	
> 
	<oninflict>
		<applystate name="State_Silhouette_Ability2_Hooker" target="this_inflictor_entity" inflictor="this_inflictor_entity" duration="6000" />
	</oninflict>
	
	<onframe>
		<distance target="target_entity" source="this_inflictor_entity" /> 
        <compare a="result" b="1800" op="gt"> 
            <expirestate name="State_Silhouette_Ability2_Hooker" target="this_inflictor_entity" /> 
            <expire /> 
        </compare>
	</onframe>
</state>