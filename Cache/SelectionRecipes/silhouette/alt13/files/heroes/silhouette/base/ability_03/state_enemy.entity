<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Silhouette_Ability3_Enemy"

	icon="../../icon.dds"
	passiveeffect="/heroes/silhouette/alt13/ability_03/effects/state_enemy.effect"
	maxcharges="15"
>
	<oninflict>
		<addcharges count="1" />
	</oninflict>
	
	<onrefresh>
		<addcharges count="1" />
	</onrefresh>
	
	<onattackedpostimpact>
		<targettype type="illusion" source="this_inflictor_entity" />
		<else>
			<cantarget targetscheme="self" source="this_inflictor_entity">
				<!-- Exception for Silhouette's SotM Q targeted projectiles -->
				<entitytype type="Projectile_Silhouette_Ability1_SotM" target="inflictor_entity" />
				<else>
					<setvar0 a="charges" b="4,8,12,16" op="mult" />
					<damage effecttype="Physical" target="this_owner_entity" amount="1" b="var0" op="mult" source="this_inflictor_entity" nonlethal="true" />
				</else>
			</cantarget>
		</else>
	</onattackedpostimpact>
</state>
