				<!-- Right now the current this_proxy_entity is the last orbit in the chain. Link it to Ability 1! -->
				
				<setproxy entity="this_entity" target="this_proxy_entity" />
			</isready>
		</onrespawn>
	
		<onimpact>
			<foreachproxy>
				<pushprojectiletarget entity="target_entity" />

				<!-- Original hero -->
				<compare a="stack_entity" b="source_entity" op="eq">
					<setpos0 position="stack_position" positionend="target_position" positionmodifier="pointonline" positionvalue="1000" />
					<spawnprojectile name="Projectile_Silhouette_Ability1" source="target_position" target="pos0" />
					<kill target="target_entity" source="" />
				</compare>
				<else> <!-- Shadow illusion -->
					<setpos0 position="stack_position" positionend="target_position" positionmodifier="pointonline" positionvalue="1000" />
					<spawnprojectile name="Projectile_Silhouette_Ability1_NoDamage" source="target_position" target="pos0" />
					<kill target="target_entity" source="" />
				</else>
				<playanim name="ability_1" source="stack_entity" target="stack_entity" />
			</foreachproxy>
		</onimpact>
		
		<ondeath>
			<foreachproxy>
				<kill target="target_entity" source="" />
			</foreachproxy>
		</ondeath>
	</modifier>

	<!-- TODO: it's lower modpriority now to not override previously defined XML events in the silhouetteshadow modifier-->
	<modifier key="ult_boost" modpriority="99">
		<onattackimpact>
			<isready>
				<cantarget targetscheme="enemy_heroes">
					<setent0 entity="target_entity" />

					<!-- TODO: for now, all Silhouette Q projectiles will fire off when the real hero attacks -->
					<!-- TODO: rewrite proxy chain sync logic in the future if this SotM is kept -->
					<!-- Illusion -->
					<targettype type="illusion" target="source_entity">
						<!-- TODO: make sure to also check for silhouetteillusionmod if we do -->
					</targettype>
					<else> <!-- Real Silhouette -->
						<foreachproxy>
							<pushprojectiletarget entity="target_entity" />

							<!-- Original hero -->
							<compare a="stack_entity" b="source_entity" op="eq">
								<spawnprojectile name="Projectile_Silhouette_Ability1_SotM" source="target_position" target="ent0" proxy="ent0" param="1" noresponse="true" />
							</compare>
							<else> <!-- Shadow illusion -->
								<spawnprojectile name="Projectile_Silhouette_Ability1_SotM" source="target_position" target="ent0" proxy="ent0" noresponse="true" />
							</else>

							<kill target="target_entity" source="" />
						</foreachproxy>

						<!-- Apply Silhouette's E buff state to herself and her Shadow illusion -->
						<pushtool name="Ability_Silhouette3" />
						<setvar0 a="source_level" source="stack_entity" />
						<compare a="var0" b="0" op="gt">
							<applystate name="State_Silhouette_Ability3" duration="4000" target="source_entity" statelevel="var0" />
							<pushtool name="Ability_Silhouette4_Swap" />
							<applystate name="State_Silhouette_Ability3" duration="4000" target="stack_proxy_entity" statelevel="var0" />
						</compare>
						
						<startcooldown />
					</else>
				</cantarget>
			</isready>
			<else>
				<targettype type="illusion" target="source_entity" />
				<else>
					<reducecooldown duration="1500" />
				</else>				
			</else>
		</onattackimpact>
	</modifier>
</ability>