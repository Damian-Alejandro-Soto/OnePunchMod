<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Silhouette2_Pull"

	icon="/heroes/silhouette/alt12/ability_02/icon_b.dds"
	statuseffecttooltip=""
	
	casttime="0"
	castactiontime="0"
	casteffect=""
	anim="ability_2_pull"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	
	actiontype="no_target"
	frontqueue="true"
	
	manacost="25,50,75,100"
	cooldowntime="0"
	
	targetradius="120"
	dynamicprecache="effects/impact_tree.effect,effects/impact_logbolas_sound.effect"
	
>
	<onimpact>
		<pushtool name="Ability_Silhouette2" />
		<setproxy target="stack_proxy_entity" />
		<spawnunit name="Gadget_Silhouette_Ability2_Action" count="1" target="this_proxy_entity" pushentity="true" />
		<!-- Save this gadget as ent0 for future use -->
		<setent0 entity="stack_entity" />
		<spawnaffector name="Affector_Silhouette_Ability2" target="this_proxy_entity" />
		
		<!-- Play sound effects at the tree's position & at Silhouette's position -->
		<setstr0 a="altavatar_path" b="effects/impact_tree.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="this_proxy_position" source="this_proxy_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact_tree.effect" target="this_proxy_position" source="this_proxy_position" occlude="true" />
		</else>
		<setstr0 a="altavatar_path" b="effects/impact_logbolas_sound.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="source_position" source="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact_logbolas_sound.effect" target="source_position" source="source_position" occlude="true" />
		</else>
		
		<kill target="this_proxy_entity" source="" />
		<spawnprojectile name="Projectile_Silhouette_Ability2_Tree" source="stack_entity" target="source_entity" proxy="ent0" pushentity="true" bindturn="true" />
		<spawnaffector name="Affector_Silhouette_Ability2_Stun" target="stack_entity" />
		<expirestate name="State_Silhouette_Ability2_Hooker" target="source_entity" />
	</onimpact>

	<modifier key="ninjahooker1" modpriority="90"
		baselevel="1"
		keyslot="2"
	/>
	
	<modifier key="ninjahooker2" modpriority="90"
		baselevel="2"
		keyslot="2"
	/>
	
	<modifier key="ninjahooker3" modpriority="90"
		baselevel="3"
		keyslot="2"
	/>
	
	<modifier key="ninjahooker4" modpriority="90"
		baselevel="4"
		keyslot="2"
	/>
</ability>