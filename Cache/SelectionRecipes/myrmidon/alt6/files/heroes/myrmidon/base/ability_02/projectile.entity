<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Myrmidon_Ability2"

	speed="600"
	gravity="0"

	modelscale="1"
	model="projectile/effects/leviathan_invis/model.mdf"
	traileffect="/heroes/hydromancer/alt6/ability_02/projectile/effects/trail.effect"
	impacteffect="/heroes/hydromancer/alt6/ability_02/projectile/effects/impact.effect"
	canturn="true"
	flying="true"
	flyheight="0"
	
>
	<onimpact>
		<combatevent effecttype="AbilityBasedProjectile">
			<onimpact>
				<cantarget target="target_entity" effecttype="Magic">
					<targettype type="moving" entity="target_entity">
						<applystate name="State_Myrmidon_Ability2" duration="50" />
						<applystate name="State_Stunned_Knockdown" duration="1000,1500,2000,2500" />
					</targettype>
					<else>
						<applystate name="State_Myrmidon_Ability2_Slow" duration="600" />
					</else>
				</cantarget>
				<damage effecttype="Magic" amount="100,150,200,250" />
				<spawnunit name="Gadget_Myrmidon_Ability2_Reveal_Linger" count="1" target="this_position" />
			</onimpact>
		</combatevent>
		<kill target="proxy_entity" source="" />
	</onimpact>
</projectile>
