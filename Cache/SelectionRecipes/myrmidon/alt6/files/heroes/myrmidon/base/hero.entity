	<oninflicted>
		<entitytype type="State_Taunting" target="inflictor_entity">
			<setproxy entity="this_entity" target="inflictor_entity" />
		</entitytype>
	</oninflicted>

	<!-- Avatar level-form swap (e.g. Alpha): activate the avatar's Level_6/Level_11 modifier and play its level-up sound if it provides one -->
	<onlevelup>
		<compare a="level" b="11" op="ge">
			<setactivemodifierkey name="Level_11" />
			<setstr0 a="altavatar_path" b="sounds/level11.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="source_entity" />
			</exists>
		</compare>
		<else>
			<compare a="level" b="6" op="ge">
				<setactivemodifierkey name="Level_6" />
				<setstr0 a="altavatar_path" b="sounds/level6.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="source_entity" />
				</exists>
			</compare>
			<else>
				<setactivemodifierkey name="" />
			</else>
		</else>
	</onlevelup>

