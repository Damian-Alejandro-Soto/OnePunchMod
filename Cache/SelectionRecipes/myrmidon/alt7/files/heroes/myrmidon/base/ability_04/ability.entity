<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Myrmidon4"
	
	statuseffecttooltip="State_Myrmidon_Ability4"
	statuseffecttooltip2="State_Myrmidon_Ability4_Slow"
	
	icon="/heroes/Hydromancer/alt7/ability_04/icon.dds"
	
	anim="ability_4"
	casttime="300"
	castactiontime="300"
	
	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_self"
	targetscheme=""
	effecttype="Magic"
	
	frontqueue="true"
	inheritmovement="true"
	nonaggressive="true"
	
	manacost="100,150,200"
	cooldowntime="50000"
	casteffect="/heroes/hydromancer/alt7/ability_04/effects/cast.effect"
>
	<onimpact>
		<!-- save old max health -->
		<setvar0 a="source_maxhealth" /> 
		
		<applystate name="State_Myrmidon_Ability4" duration="20000" target="source_entity" pushentity="true" />
		
		<!-- max health bonus -->
		<setvar1 a="source_maxhealth" b="var0" op="sub" /> 
		
		<!-- target health -->
		<setvar2 a="source_health" b="var1" op="add" />
		
		<!-- current health adjusted for bonus -->
		<setvar3 a="source_health" b="var0" op="div" />
		<setvar3 a="var3" b="source_maxhealth" op="mult" />
		
		<!-- final adjustment to reach target health after the game rescales current health -->
		<changehealth a="var2" b="var3" op="sub" />
		
		<!-- save bonus as the state's accumulator -->
		<setaccumulator entity="stack_entity" value="var1" />
	</onimpact>

	<modifier key="ult_boost" modpriority="100"
		displayname="true"
		targetradius="250"
		actiontype="toggle"
		
		keeptoggleonwhendead="true"
		
		cooldowntime="4000"
		toggleoffmanacost="0"
	>
		<onaction>
			<resetcooldown />
			<startcooldown duration="4000" />
		</onaction>
		
		<ontoggleon>			
			<!-- save old max health -->
			<setvar0 a="source_maxhealth" />
			
			<applystate name="State_Myrmidon_Ability4" target="source_entity" istoggle="true" pushentity="true" />
			
			<!-- max health bonus -->
			<setvar1 a="source_maxhealth" b="var0" op="sub" /> 
			
			<!-- target health -->
			<setvar2 a="source_health" b="var1" op="add" />
			
			<!-- current health adjusted for bonus -->
			<setvar3 a="source_health" b="var0" op="div" />
			<setvar3 a="var3" b="source_maxhealth" op="mult" />
			
			<!-- final adjustment to reach target health after the game rescales current health -->
			<changehealth a="var2" b="var3" op="sub" />
			
			<!-- save bonus as the state's accumulator -->
			<setaccumulator entity="stack_entity" value="var1" />
		</ontoggleon>
		
		<onimpact />
	</modifier>
	
	<!-- Fixes SFX clips from being played inappropriately -->
	<modifier key="Hydromancer_R_On" modpriority="99" condition="toggle_active"
		casteffect=""
	>

	</modifier>
</ability>
