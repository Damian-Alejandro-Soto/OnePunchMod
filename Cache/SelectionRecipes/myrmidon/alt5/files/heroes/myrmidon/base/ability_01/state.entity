<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Myrmidon_Ability1"
	
	icon="/heroes/hydromancer/alt5/ability_01/icon.dds"
	passiveeffect="/heroes/hydromancer/alt5/ability_01/effects/state.effect"
	revealed="true"
	stunned="true"
	frozen="true"
	effecttype="StatusDebuff"
	allowtransfer="true"
	impactinterval="50"

	negativeeffect="stunned"
>
	<oninflict>
		<setaccumulator value="0" />
	</oninflict>
	
	<onimpact>
		<!-- Loop only once -->
		<compare a="accumulator" b="0" op="eq">
			<damage effecttype="Magic" amount="0.000001" />
		</compare>
		<setaccumulator value="1" />
	</onimpact>
	
	<onframe>
		<damage effecttype="Magic DOT" amount="125" b="frametime" op="mult"/>
	</onframe>
	
	<onexpired>
		<playanim name="idle" target="target_entity" />
	</onexpired>
</state>
