<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Valkyrie1"
	
	statuseffecttooltip="State_Valkyrie_Ability1"
	icon="/heroes/Valkyrie/alt12/ability_01/icon.dds"
	
	anim="ability_1"
	casttime="500"
	castactiontime="400"
	casteffect=""

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="self_position"
	targetscheme="visible_enemy_units"
	casteffecttype="Magic"
	targetradius="650"
	
	manacost="80,95,110,125"
	cooldowntime="12000"
	dynamicprecache="effects/cast.effect"
>
	<onimpact>
			<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="source_entity" />
		</else>
		<areaofeffect
			radius="300"
			targetselection="closest"
			targetscheme="visible_enemy_heroes"
			effecttype="Magic"
			maxtotalimpacts="1"
			impacteffect="effects/impact.effect"
		>
			<spawnaffector name="Affector_Valkyrie_Ability1_Half" target="target_position" proxy="target_entity" />
		</areaofeffect>
		<else>
			<areaofeffect
				radius="300"
				targetselection="closest"
				targetscheme="visible_enemy_units"
				effecttype="Magic"
				maxtotalimpacts="1"
				impacteffect="effects/impact.effect"
			>
				<spawnaffector name="Affector_Valkyrie_Ability1_Half" target="target_position" proxy="target_entity" />
			</areaofeffect>
		</else>
	
		<spawnaffector name="Affector_Valkyrie_Ability1_Normal" target="source_position" />
	</onimpact>
</ability>
