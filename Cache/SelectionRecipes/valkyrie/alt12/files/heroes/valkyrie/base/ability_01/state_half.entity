<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Valkyrie_Ability1_Half"

	icon="/heroes/Valkyrie/alt12/ability_01/icon.dds"
	
	impactinterval="1000"
	
	ishidden="true"
	
	effecttype=""
	dynamicprecache="effects/impact.effect"
>
	<oninflict>
		<setaccumulator value="0" />
	</oninflict>
	
	<onrefresh>
		<changeduration b="950" op="add" />
	</onrefresh>
	
	<onimpact>
		<damage effecttype="Magic" amount="50,100,150,200" />

		<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" />
		</else>
	</onimpact>
</state>
