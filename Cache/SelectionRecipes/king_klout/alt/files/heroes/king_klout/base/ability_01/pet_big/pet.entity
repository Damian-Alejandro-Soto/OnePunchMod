<?xml version="1.0" encoding="UTF-8"?>
<pet
	name="Pet_KingKlout_Ability1_Big"

	icon="../../../icon.dds"
	portrait="../../../icon.dds"
	model="/heroes/king_klout/alt/minion/model.mdf"
	skin=""
	
	
	
	passiveeffect="effects/pet_state_red.effect"
	spawneffect=""
	
	
	
	
	preglobalscale="1.0"
	modelscale="2.5"
	effectscale="1.0"
	boundsheight="64"
	boundsradius="16"
	selectionradius="40"
	targetoffset="0 0 0"
	
	flying="false"
	flyheight="0"

	unitwalking="true"
	buildingwalking="true"
	cliffwalking="true"
	treewalking="true"
	
	wanderrange="30"

	maxhealth="1"
	armor="0"
	magicarmor="0"
	healthregen="0"

	minmovespeed="0"
	maxmovespeed="1000"
	movespeed="100"
	turnrate="900"
	turnsmoothing="0.05"

	
	
	deathtime="2000"
	corpsetime="0"

	deathnumanims="3"
	deathanim="death_%"
	
	borednumanims="2"
	boredanim="bored_%"
	
	canattack="false"
	ismobile="true"
	drawonmap="false"

	sightrangeday="0"
	
	unittype="AntiTP no_Overhead_Visuals"

	hidehealthbar="true"
	invulnerable="true"
	isselectable="false"
	iscontrollable="false"

	diewithowner="true"
	inheritvisibilityfromowner="true"
	isdragselectablemulti="false"

	immunity="GadgetImmunity"
	noblockneutralspawn="true"
	dynamicprecache="../effects/spawn_red.effect"
>
	<onspawn>
		<!-- If KingKlout is dead, kill me -->
		<targettype type="dead" target="source_entity">
			<kill target="this_entity" />
		</targettype>
		<setstr0 a="altavatar_path" b="../effects/spawn_red.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_position" target="target_position" />
		</exists>
		<else>
			<playeffectdynamic effect="../effects/spawn_red.effect" source="source_position" target="target_position" />
		</else>
	</onspawn>

	<onframe>
		<distance source="this_entity" target="this_owner_entity" />
		<compare a="result" b="2000" op="gt">
			<teleport source="this_entity" target="this_owner_entity" interpolate="false" />
		</compare>
		
		<!-- delete me if my owner doesn't exist -->
		<compare source="this_owner_entity" a="source_entity" b="0" op="eq" >
			<delete/>
		</compare>
	</onframe>

	<modifier key="Minion_is_flying" modpriority="1"
		modelscale="3.5"
	/>
</pet>