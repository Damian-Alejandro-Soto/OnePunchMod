<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_CorruptedDisciple3"

	icon="/heroes/corrupted_disciple/alt8/ability_03/icon.dds"
	statuseffecttooltip="State_CorruptedDisciple_Ability3"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="passive"
	targetscheme="enemy_heroes"
	casteffecttype="Magic"

	movespeedmultiplier="0.04,0.08,0.12,0.16"
	dynamicprecache="effects/impact.effect"
>
	<onattackedpreimpact>
		<cantarget targetscheme="enemy_heroes">
			<combatsupertype supertype="spell">
				<combateffecttype effecttype="AbilityBasedProjectile BindingProjectile" />
				<else>
					<applystate name="State_CorruptedDisciple_Ability3" target="target_entity" duration="600,900,1200,1500" />
					<damage effecttype="Magic Returned" amount="40,80,120,160" target="target_entity" />

					<!-- VFX -->
					<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
					<exists path="str0">
						<playeffectdynamic effect="str0" source="target_entity" target="" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
					</else>
				</else>
			</combatsupertype>
		</cantarget>
	</onattackedpreimpact>

	<onimpact />
</ability>