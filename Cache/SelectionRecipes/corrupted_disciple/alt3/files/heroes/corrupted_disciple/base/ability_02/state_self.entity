<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_CorruptedDisciple_Ability2_Self"

	icon="../../icon.dds"
	effecttype=""
	
	damagepercharge="1.3,2.6,3.9,5.2"
	impactinterval="200"

	maxcharges="50"
	passiveeffect="/heroes/corrupted_disciple/alt3/ability_02/effects/state_self.effect"

>
	<oninflict>
		<addcharges count="1" />
	</oninflict>
	
	<onimpact>
		<addcharges count="1" />
		<compare a="charges" b="50" op="eq">
			<expire />
		</compare>
	</onimpact>
	
	<onexpired>
		<expire entity="this_proxy_entity" />
		<setproxy entity="this_entity" target="" />
		<applystate name="State_CorruptedDisciple_Ability2_Self_Damage" target="target_entity" duration="13000" pushentity="true" />
		<setcharges entity="stack_entity" a="charges" />
		<expirestate name="State_CorruptedDisciple_Ability2_Check" target="target_entity" />
	</onexpired>
</state>