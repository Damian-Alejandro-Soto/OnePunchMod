<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_CorruptedDisciple_Ability1"

	radiusstart="0"
	radiusend="800"
	lifetime="700"
	innerradiusoffset="80"
	
	targetselection="all"
	targetscheme="enemy_units"
	maximpactspertarget="1"
	effecttype="Magic"
	persist="true"
	canturn="false"	
	impacteffect="/heroes/corrupted_disciple/alt3/ability_01/effects/impact.effect"
>
	<onimpact>
		<distance target="target_entity" source="source_entity" />
		<setvar0 a="result" b="800" op="min" />

		<!-- var0's b field = Distance for Maximum Damage ; adjust below in the div step if this is changed -->
		<!-- var1 = Minimum Damage -->
		<!-- var2 = Maximum Damage -->
		
		<setvar1 a="35,55,75,95" />
		<setvar2 a="75,115,155,195" />
		<setvar3 a="var0" b="800" op="div" />
		<setvar0 a="var2" b="var1" op="sub" />
		<setvar0 a="var3" b="var0" op="mult" />
		<setvar0 a="var1" b="var0" op="add" />
		<damage effecttype="Magic" amount="1" b="var0" op="mult" />
	</onimpact>	
</affector>