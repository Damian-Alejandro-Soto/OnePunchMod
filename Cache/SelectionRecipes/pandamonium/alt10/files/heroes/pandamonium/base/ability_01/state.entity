<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Pandamonium_Ability1"
	
	icon="/heroes/panda/alt10/ability_01/icon.dds"
	passiveeffect=""
	basedamagemultiplier="0.15,0.25,0.35,0.45"

	stunned="true"
	stunnedreduction="ignore"

	ishidden="true"

	unitwalking="true"
	effecttype=""
	
	modifierkey="panda_Q_flurry"
>
	<modifier key="ult_boost" modpriority="100">
		<onattackimpact>
			<!-- Push effect from Flurry, only when SotM is active (so it takes places upon attacking) -->
			<spawnunit name="Gadget_Pandamonium_Ability1" target="target_entity" offsetspace="source_entity" pushentity="true" offset="0 -150" />
			<targettype type="hero">
				<cantarget effecttype="Push">
					<push force="400" duration="300" source="stack_entity" />
					<applystate name="State_Pandamonium_Ability1_Bound" duration="-1" target="target_entity" proxy="source_entity" />
				</cantarget>		
			</targettype>
			<else>
				<push force="400" duration="300" source="stack_entity" />
				<applystate name="State_Pandamonium_Ability1_Bound" duration="-1" target="target_entity" proxy="source_entity" />
			</else>
		</onattackimpact>
	</modifier>
</state>
