<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Riftwalker2"
	
	icon="/heroes/riftmage/alt4/ability_02/icon.dds"
	statuseffecttooltip="State_Riftwalker_Ability2"
	
	anim="ability_2"
	casttime="500"
	castactiontime="100"
	maxlevel="4"
	requiredlevel="1,3,5,7"
	
	actiontype="target_entity"
	casteffecttype="SuperiorMagic"
	targetscheme="enemy_heroes"
	
	manacost="75"
	cooldowntime="10000"
	
	range="600"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	dynamicprecache="effects/portal.effect,effects/portal_self.effect"
>
	<onimpact>
		<applystate name="State_Riftwalker_Ability2" duration="4000" />
		<setstr0 a="altavatar_path" b="effects/portal.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/portal.effect" source="target_entity" target="target_entity" />
		</else>
		<setstr0 a="altavatar_path" b="effects/portal_self.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="source_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/portal_self.effect" source="source_entity" target="source_entity" />
		</else>
	</onimpact>
</ability>