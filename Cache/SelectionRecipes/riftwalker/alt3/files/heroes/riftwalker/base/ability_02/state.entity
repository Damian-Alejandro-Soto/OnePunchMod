<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Riftwalker_Ability2"
	
	icon="../../icon.dds"
	effecttype="StatusDebuff"
	allowtransfer="true"
	
	movespeedslow="0.3,0.35,0.40,0.45"
	movespeedslowpercharge="0.04,0.06,0.08,0.10"
	
	maxcharges="5"
	passiveeffect="/heroes/riftmage/alt3/ability_02/effects/state.effect"

	negativeeffect="slowed"
	dynamicprecache="effects/portal.effect"
>
	<onimpact />
	
	<ondamaged>
		<damageeffecttype effecttype="DOT" />
		<else>
			<addcharges count="1" />
			<setstr0 a="altavatar_path" b="effects/portal.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="source_entity" source="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/portal.effect" target="source_entity" source="source_entity" />
			</else>
		</else>
	</ondamaged>
</state>