<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Magebane4"

	icon="../../icon.dds"
	
	anim="ability_4"
	casttime="1000"
	castactiontime="500"

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_entity"
	targetscheme="enemy_mana_units"
	casteffecttype="SuperiorMagic"
	casteffect="/heroes/javaras/alt5/ability_04/effects/cast.effect"
	
	manacost="100,160,220"
	cooldowntime="105000,90000,75000"

	range="600"
	targetradius="225"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	
	impacteffect="/heroes/javaras/alt5/ability_04/effects/impact.effect"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes"
	dynamicprecache="effects/impact_mini.effect"
>
	<onimpact>
		<applystate name="State_Stunned" duration="100,200,300" />
		<applystate name="State_Magebane_Ability4" duration="1000" />
		<setvar0 a="0.90,1.20,1.50" b="target_missingmana" op="mult" />
		<popup name="bonus_damage" a="var0" source="target_entity" />
		<damage effecttype="Magic" amount="1" b="var0" op="mult" />
		
		<areaofeffect
			center="target_entity"
			radius="225"
			targetscheme="enemy_units"
			targetselection="all"
			ignore="target_entity"
			effecttype="Magic"
		>
			<damage effecttype="Magic" amount="0" b="var0" op="add" />

			<!-- VFX -->
			<setstr0 a="altavatar_path" b="effects/impact_mini.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact_mini.effect" source="target_entity" />
			</else>
		</areaofeffect>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100"
		targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	>
		<onimpact>
			<applystate name="State_Stunned" duration="100,200,300" />
			<applystate name="State_Magebane_Ability4_Mark" duration="1000" />
			<applystate name="State_Magebane_Ability4" duration="1000" />
			<setvar0 a="0.90,1.20,1.50" b="target_missingmana" op="mult" />
			<popup name="bonus_damage" a="var0" source="target_entity" />
			<damage effecttype="Magic" amount="0" b="var0" op="add" />
			
			<areaofeffect
				center="target_entity"
				radius="225"
				targetscheme="enemy_units"
				targetselection="all"
				ignore="target_entity"
				effecttype="Magic"
			>
				<applystate name="State_Magebane_Ability4_Mark" duration="1000" />
				<damage effecttype="Magic" amount="0" b="var0" op="add" />

				<!-- VFX -->
				<setstr0 a="altavatar_path" b="effects/impact_mini.effect" op="add" />
				<exists path="str0">
					<playeffectdynamic effect="str0" source="target_entity" />
				</exists>
				<else>
					<playeffectdynamic effect="effects/impact_mini.effect" source="target_entity" />
				</else>
			</areaofeffect>			
			
			<spawnaffector name="Affector_Magebane_Ability4" target="target_position" param="var0" />
		</onimpact>
	</modifier>
</ability>