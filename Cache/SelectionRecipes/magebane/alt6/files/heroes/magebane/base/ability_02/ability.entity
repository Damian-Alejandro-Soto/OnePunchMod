<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Magebane2"
	
	icon="../../icon.dds"
	
	anim="ability_2"
	casttime="650"
	castactiontime="250"
	casteffect="/heroes/javaras/alt6/ability_02/effects/cast.effect"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetradius="350"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	activatescheme="movement"
	
	manacost="65"
	cooldowntime="10000"
	
	allowoutofrangecast="false"
	range="600,700,800,900"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/affector.effect"
>	
	<onimpact>
		<teleport interpolate="false" target="target_position" />
		<disjoint target="source_entity" />
		<unbind target="source_entity" />
		
		<spawnaffector name="Affector_Magebane_Ability2" target="target_position" />
	</onimpact>
</ability>