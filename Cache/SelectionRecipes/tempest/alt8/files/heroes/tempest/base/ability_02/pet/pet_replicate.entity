<?xml version="1.0" encoding="UTF-8"?>
<pet
	name="Pet_Tempest_Ability2_Replicate"

	icon="/heroes/tempest/base/ability_02/icon.tga"
	portrait="/heroes/tempest/base/ability_02/icon.tga"

	model="/heroes/tempest/alt8/ability_02/effects/minion/model.mdf"
	skin=""
	
	passiveeffect="/heroes/tempest/alt8/ability_02/effects/minion/effects/body.effect"
	spawneffect="effects/spawn.effect"
	
	
	
	
	
	preglobalscale="0.9"
	modelscale="1.0,1.25,1.65,1.8"
	effectscale="0.6,.7,.775,.85"
	boundsheight="96"
	boundsradius="24"
	selectionradius="50"
	targetoffset="0 0 55"

	movespeed="260,280,300,320"
	turnrate="450"
	turnsmoothing="0.05"

	maxhealth="240,270,300,330"
	healthregen="0.25"
	maxmana="0"
	manaregen="0"

	armor="2,3,4,5"
	magicarmor="15"

	
	inventory0=""
	inventory1=""
	inventory2=""
	inventory3=""

	attackduration="1170"

	attackactiontime="300"

	attackcooldown="1500"
	attackdamagemin="20,26,32,38"
	attackdamagemax="20,26,32,38"
	attacknumanims="2"
	attackoffset="0 35 100"
	attackprojectile="Projectile_Elemental_Attack"
	attackrange="500"
	attackstarteffect=""
	attackactioneffect=""
	attackimpacteffect=""
	attacktype="ranged"
	combattype="Melee"

	aggrorange="800"
	sightrangeday="1200"
	sightrangenight="800"
	
	goldbountymin="32"
	goldbountymax="46"
	experiencebounty="6"
	
	deniablepercent="0.5"
	
	lifetime="100"
	showlifetime="true"

	unittype="summoned"

	corpsetime="2000"
	corpsefadetime="10000"
	corpsefadeeffect="/shared/effects/corpse_sink.effect"
	
	selectiontype="Pet_Tempest_Ability2"
>
	<onframe>
		<targettype type="alive" target="this_proxy_entity" >
			<distance source="source_entity" target="this_proxy_entity" />
			<compare a="result" b="925" op="ge">
				<setactivemodifierkey name="treant_pet_notowers" />
			</compare>
		</targettype>
		<else>
			<setactivemodifierkey name="treant_pet_notowers" />
		</else>
	</onframe>
	
	<onattackpreimpact>
		<!-- Staff of the Master -->
		<hasmodifier name="ult_boost" entity="this_proxy_entity">
			<seteffecttype name="combat_damagetype" effecttype="" />
			<seteffecttype name="combat_effecttype" effecttype="Attack" />
		</hasmodifier>
	</onattackpreimpact>

	<modifier key="treant_pet_notowers" modpriority="100"
		attacktargetscheme="everything_but_towers"
	>
		<onframe>
			<distance source="source_entity" target="this_proxy_entity" />
			<compare a="result" b="925" op="lt">
				<targettype type="alive" target="this_proxy_entity" >
					<setactivemodifierkey name="" />
				</targettype>
			</compare>
		</onframe>
	</modifier>
</pet>
