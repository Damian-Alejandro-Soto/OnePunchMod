<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Accursed1"
	
	icon="../../icon.dds"
	
	anim="ability_1"
	casttime="700"
	castactiontime="300"

	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="all_other_units"
	casteffecttype="SuperiorMagic"
	casteffect="/heroes/accursed/alt5/ability_01/effects/cast.effect"
	
	manacost="75"
	cooldowntime="6000"
	
	range="700"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	targetpriorities="all_heroes"
	dynamicprecache="effects/ability_ally.effect,effects/ability.effect"
>
	<onactivatestart>
		<setproxy target="target_entity" />
	</onactivatestart>

	<activatecost>
		<targettype type="ally" target="this_proxy_entity" />
		<else>
			<cantarget target="this_proxy_entity" effecttype="Magic" />
			<else>
				<invalidate />
			</else>
		</else>
	</activatecost>
	
	<onimpact>
		<cantarget targetscheme="ally_units">
			<heal a="100,150,200,250" />
			
			<!-- Apply Accursed's Sear -->
			<hasmodifier name="Accursed_E_Leveled" >
				<pushtool name="Ability_Accursed3" />
				<setvar0 a="source_level" source="stack_entity" />
				<applystate name="State_Accursed_Ability3_Buff" target="target_entity" duration="4500" statelevel="var0" attribution="Ability_Accursed3" />
			</hasmodifier>

			<!-- Art -->
			<setstr0 a="altavatar_path" b="effects/ability_ally.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/ability_ally.effect" source="target_entity" target="" />
			</else>

		</cantarget>
		
		<cantarget targetscheme="enemy_units">
			<damage effecttype="Magic" amount="100,150,200,250" />
			
			<!-- Apply Accursed's Sear -->
			<hasmodifier name="Accursed_E_Leveled" >
				<pushtool name="Ability_Accursed3" />
				<setvar0 a="source_level" source="stack_entity" />
				<applystate name="State_Accursed_Ability3_Debuff" duration="2000" statelevel="var0" disablenegativeeffectpopuponrefresh="true" attribution="Ability_Accursed3" />
			</hasmodifier>

			<!-- Art -->
			<setstr0 a="altavatar_path" b="effects/ability.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_entity" target="" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/ability.effect" source="target_entity" target="" />
			</else>
			
		</cantarget>
		
		<!-- Damage to self -->
		<damage effecttype="Magic" amount="50,75,100,125" target="source_entity" />
	</onimpact>
	
</ability>
