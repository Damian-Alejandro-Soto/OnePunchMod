<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Zephyr3"

	icon="/heroes/zephyr/alt8/ability_03/icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	passiveeffect="/heroes/zephyr/alt8/ability_03/effects/state.effect"

	actiontype="passive"

	targetradius="250"
>
	<onattackedpreimpact>
		<!-- Evasion will not take place if a target is within 250 radius of Zephyr -->
		<distance />
		<setvar0 a="result" />
		
		<setvar1 a="0.15,0.25,0.35,0.45" /> <!-- Evasion -->
		
		<targettype type="Tower"> <!-- Exception for towers, since they have a large boundsradius -->
			<compare a="var0" b="350" op="ge">
				<combatsupertype supertype="attack">
					<combateffecttype effecttype="Attack">
						<setvalue name="combat_evasion" a="combat_evasion" b="var1" op="add" />
					</combateffecttype>
				</combatsupertype>
			</compare>
		</targettype>
		<else>
			<compare a="var0" b="250" op="ge">
				<combatsupertype supertype="attack">
					<combateffecttype effecttype="Attack">
						<!-- Only apply to enemy ranged units -->
						<targettype type="ranged">
							<setvalue name="combat_evasion" a="combat_evasion" b="var1" op="add" />
						</targettype>						
					</combateffecttype>
				</combatsupertype>
			</compare>
		</else>
	</onattackedpreimpact>
</ability>
