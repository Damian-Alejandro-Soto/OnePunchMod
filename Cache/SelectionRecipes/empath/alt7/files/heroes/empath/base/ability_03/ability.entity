<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Empath3"

	icon="/heroes/empath/alt7/ability_03/icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	dontshowhovercast="true"
	actiontype="passive"
>
	<aura name="empathaura" state="State_Empath_Ability3" radius="99999" targetscheme="ally_heroes" ignoreinvulnerable="true" />

	<!-- Make the aura stack and not work with illusions -->
	<modifier key="krosmode" modpriority="101"
	>
		<aura name="empathaura" state="State_Empath_Ability3" radius="99999" targetscheme="ally_heroes" propagatecondition="not_illusion" ignoreinvulnerable="true" stack="true" />
	</modifier>
</ability>
