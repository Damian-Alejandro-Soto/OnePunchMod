<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Empath_Ability2_Effects"

	icon="../../icon.dds"
	effecttype="StatusDebuff"
	passiveeffect="/heroes/empath/alt5/ability_02/effects/state.effect"
	dynamicprecache="effects/impact.effect"
>
	<oninflict>
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="target_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="target_entity" />
		</else>
	</oninflict>
	
	<onframe>
		<damage source="source_owner_entity" effecttype="Magic DOT" amount="30,40,50,60" b="frametime" op="mult" />
	</onframe>	
</state>
