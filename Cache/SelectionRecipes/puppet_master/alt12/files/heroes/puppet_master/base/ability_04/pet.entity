<?xml version="1.0" encoding="UTF-8"?>
<heropet
	name="Pet_PuppetMaster_Ability4"

	icon="/heroes/puppetmaster/alt12/ability_04/icon.dds"
	portrait="../../icon.dds"
	model="/heroes/puppetmaster/alt12/ability_04/statue/statue.mdf"
	skin=""

	passiveeffect="/heroes/puppetmaster/alt12/ability_04/effects/state.effect"
	spawneffect=""
	
	isselectable="true"
	iscontrollable="false"
	invulnerable="false"

	maxhealth="500,750,1000"
	healthregen="0"
	maxmana="0"
	manaregen="0"

	preglobalscale="1.8"
	modelscale="1.0"
	effectscale=".8"
	boundsheight="64"
	boundsradius="40"
	selectionradius="48"
	targetoffset="0 0 100"
	deniable="false"

	

	canrotate="false"
	ismobile="false"
	flying="false"
	clearvision="false"
	drawonmap="false"
	canattack="false"
	immunity="PuppetImmunity"

	deathnumanims="1"
	deathanim="death_%"

	expirenumanims="1"
	expireanim="death_%"

	magicarmor="0"

	attacktype="none"

	unittype="AntiTP PuppetPuppet heropet"

	corpsetime="0"
	corpsefadetime="0"
	deathtime="0"

	lifetime="0"
	showlifetimeall="true"

	dynamicprecache="/heroes/puppetmaster/alt12/ability_04/statue/damage.effect,../alt12/ability_04/statue/death/death.effect,../alt12/ability_04/effects/transfer.effect"
>
	<onspawn>
		<setstr0 a="altavatar_path" b="effects/link.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_entity" target="this_proxy_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/link.effect" source="this_entity" target="this_proxy_entity" />
		</else>
		
		<!-- Dynamic death & transfer effects -->
		<setstr0 a="altavatar_path" b="ragdoll/death/death.effect" op="add" />
		<exists path="str0">
			<setscriptvalue name="death_effect" value="str0" entity="this_entity" />
		</exists>
		<else>
			<setscriptvalue name="death_effect" value="ragdoll/death/death.effect" entity="this_entity" />
		</else>
		
		<setstr0 a="altavatar_path" b="effects/transfer.effect" op="add" />
		<exists path="str0">
			<setscriptvalue name="death_effect" value="str0" entity="this_entity" />
		</exists>
		<else>
			<setscriptvalue name="death_effect" value="effects/transfer.effect" entity="this_entity" />
		</else>
		
	</onspawn>

	<onframe>
		<hasmodifier name="ult_boost" entity="this_owner_entity">
			<distance source="this_entity" target="this_proxy_entity" />
			<compare a="result" b="2000" op="gt">
				<expire entity="this_entity" />
			</compare>
		</hasmodifier>
		<else>
			<distance source="this_entity" target="this_proxy_entity" />
			<compare a="result" b="1500" op="gt">
				<expire entity="this_entity" />
			</compare>
		</else>
		
		<compare a="this_proxy_entity" b="0" op="eq">
			<expire entity="this_entity" />
		</compare>
		<targettype type="alive" target="this_proxy_entity" />
		<else>
			<expire entity="this_entity" />
		</else>

		<cantarget source="this_entity" target="this_proxy_entity" effecttype="Magic">
			<copystates source="this_entity" target="this_proxy_entity" effecttype="StatusDebuff" inflictor="this_owner_entity" transfer="true" />
			<copystates source="this_entity" target="this_proxy_entity" effecttype="StatusDisable" inflictor="this_owner_entity" transfer="true" />
			<compare a="result" b="0" op="ne">
				<!-- Dynamic visual effects for state transfers -->
				<getscriptvalue name="transfer_effect" destvar="str0" entity="this_entity" />
				<playeffectdynamic effect="str0" source="this_entity" target="this_proxy_entity" />
			</compare>

			<copystates source="this_entity" target="this_proxy_entity" effecttype="ForceTransferrable" inflictor="this_owner_entity" transfer="true" />
			<compare a="result" b="0" op="ne">
				<!-- Dynamic visual effects for state transfers -->
				<getscriptvalue name="transfer_effect" destvar="str0" entity="this_entity" />
				<playeffectdynamic effect="str0" source="this_entity" target="this_proxy_entity" />
			</compare>

			<hasmodifier name="channeled_stun_ability">
				<applystate name="State_Stunned" target="this_proxy_entity" inflictor="this_owner_entity" timeout="frametime" continuous="true" />
			</hasmodifier>
		</cantarget>
	</onframe>

	<ondamaged priority="-1">
		<compare a="source_damage" b="0" op="gt">
			<!-- Staff of the Master -->
			<hasmodifier name="ult_boost" entity="this_owner_entity">
				<compare a="source_health" b="damage_applied" op="ge">
					<damageeffecttype effecttype="DOT">
						<damage effecttype="Magic Returned DOT" amount="1.3,1.55,1.8" b="damage_applied" op="mult" source="this_owner_entity" target="this_proxy_entity"  />
					</damageeffecttype>
					<else>
						<damage effecttype="Magic Returned" amount="1.3,1.55,1.8" b="damage_applied" op="mult" source="this_owner_entity" target="this_proxy_entity"  />
					</else>
					<cantarget targetscheme="ally_units" source="this_owner_entity" target="target_entity">
						<applystate name="State_PuppetMaster_Ability4_Assist" inflictor="target_entity" target="this_proxy_entity" duration="100" />
					</cantarget>
				</compare>
				<else>
					<evaluate a="damage_applied" b="1" op="mult" />
					<setvar0 a="result" b="source_health" op="sub" />
					<evaluate a="source_health" b="1.3,1.55,1.8" op="mult" />
					<setvar1 a="var0" b="result" op="add" />
					<damageeffecttype effecttype="DOT">
						<damage effecttype="Magic Returned DOT" amount="1" b="var1" op="mult" source="this_owner_entity" target="this_proxy_entity" />
					</damageeffecttype>
					<else>
						<damage effecttype="Magic Returned" amount="1" b="var1" op="mult" source="this_owner_entity" target="this_proxy_entity" />
					</else>

					<cantarget targetscheme="ally_units" source="this_owner_entity" target="target_entity">
						<applystate name="State_PuppetMaster_Ability4_Assist" inflictor="target_entity" target="this_proxy_entity" duration="100" />
					</cantarget>
				</else>
			</hasmodifier>
			
			<!-- Regular -->
			<else>
				<compare a="source_health" b="damage_applied" op="ge">
					<damageeffecttype effecttype="DOT">
						<damage effecttype="Magic Returned DOT" amount="1.1,1.2,1.3" b="damage_applied" op="mult" source="this_owner_entity" target="this_proxy_entity"  />
					</damageeffecttype>
					<else>
						<damage effecttype="Magic Returned" amount="1.1,1.2,1.3" b="damage_applied" op="mult" source="this_owner_entity" target="this_proxy_entity"  />
					</else>
					<cantarget targetscheme="ally_units" source="this_owner_entity" target="target_entity">
						<applystate name="State_PuppetMaster_Ability4_Assist" inflictor="target_entity" target="this_proxy_entity" duration="100" />
					</cantarget>
				</compare>
				<else>
					<evaluate a="damage_applied" b="1" op="mult" />
					<setvar0 a="result" b="source_health" op="sub" />
					<evaluate a="source_health" b="1.1,1.2,1.3" op="mult" />
					<setvar1 a="var0" b="result" op="add" />
					<damageeffecttype effecttype="DOT">
						<damage effecttype="Magic Returned DOT" amount="1" b="var1" op="mult" source="this_owner_entity" target="this_proxy_entity" />
					</damageeffecttype>
					<else>
						<damage effecttype="Magic Returned" amount="1" b="var1" op="mult" source="this_owner_entity" target="this_proxy_entity" />
					</else>

					<cantarget targetscheme="ally_units" source="this_owner_entity" target="target_entity">
						<applystate name="State_PuppetMaster_Ability4_Assist" inflictor="target_entity" target="this_proxy_entity" duration="100" />
					</cantarget>
				</else>
			</else>			
		</compare>
		
		<hasavatarkey name="Hero.PuppetMaster.Freakshow">
			<playanim name="hit" target="this_entity" source="this_entity" />		
		</hasavatarkey>
	</ondamaged>

	<onexpired>
		<!-- Death dynamic effects -->
		<getscriptvalue name="death_effect" destvar="str0" entity="this_entity" />
		<playeffectdynamic effect="str0" source="this_entity" />
	</onexpired>

	<ondeath>
		<!-- Death dynamic effects -->
		<getscriptvalue name="death_effect" destvar="str0" entity="this_entity" />
		<playeffectdynamic effect="str0" source="this_entity" />
	</ondeath>

	<modifier key="Puppet_ExpireStart" modpriority="100"
		lifetime="2000,2500,3000"
	>
		<ondamaged priority="-1">
			<!-- Non-amplified damage -->
			<compare a="source_damage" b="0" op="gt">
				<damageeffecttype effecttype="DOT">
					<damage effecttype="Magic Returned DOT" amount="1" b="damage_applied" op="mult" source="this_owner_entity" target="this_proxy_entity" />
				</damageeffecttype>
				<else>
					<damage effecttype="Magic Returned" amount="1" b="damage_applied" op="mult" source="this_owner_entity" target="this_proxy_entity" />
				</else>

				<cantarget targetscheme="ally_units" source="this_owner_entity" target="target_entity">
					<applystate name="State_PuppetMaster_Ability4_Assist" inflictor="target_entity" target="this_proxy_entity" duration="100" />
				</cantarget>
			</compare>
		</ondamaged>
	</modifier>
</heropet>