<?xml version="1.0" encoding="UTF-8"?>
<gadget
	name="Gadget_PuppetMaster_Ability1_DummyPush"

	icon=""
	portrait=""
	model="/heroes/puppetmaster/alt6/effects/minion/model.mdf"

	preglobalscale="2.54"
	modelscale="1.7"
	effectscale="1.0"
	boundsheight="0"
	boundsradius="0"
	isselectable="false"
	iscontrollable="false"
	selectionradius="0"
	targetoffset="0 0 0"

	canrotate="false"
	ismobile="false"

	attacktype="none"
	combattype="Ranged"

	sightrangeday="800"
	sightrangenight="500"


	deathtime="0"
	corpsetime="0"
	unitwalking="true"
	
	invulnerable="true"
	flying="false"
	drawonmap="false"
	
	lifetime="5000"
	dynamicprecache="effects/beam.effect"
>
	<aura state="State_PuppetMaster_Ability1_PushImmunity" radius="30" targetscheme="all_units" />
	
	<onspawn>
		<setstr0 a="altavatar_path" b="effects/beam.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="this_entity" target="this_proxy_entity" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/beam.effect" source="this_entity" target="this_proxy_entity" />
		</else>
	</onspawn>
	
	<ondeath>
		<expirestate name="State_PuppetMaster_Ability1_ImmobilePush" target="this_proxy_entity" />
	</ondeath>
</gadget>
