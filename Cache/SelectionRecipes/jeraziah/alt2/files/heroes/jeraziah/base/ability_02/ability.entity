<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Jeraziah2"

	statuseffecttooltip="State_Jeraziah_Ability2"
	statuseffectheader="true"
	icon="../../icon.dds"
	
	anim="ability_2"
	casttime="700"
	castactiontime="300"
	casteffect="/heroes/jereziah/alt2/ability_02/effects/cast.effect"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_entity"
	targetscheme="ally_units"
	casteffecttype=""
	
	manacost="60,70,80,90"
	cooldowntime="24000"
	
	range="500"
	targetradius="350"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"

	doubleactivate="true"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="ally_heroes"
>
	<onimpact>
		<dispel type="StatusDebuff" />
		<applystate name="State_Jeraziah_Ability2" duration="6000" proxy="this_entity" />
		<setactivemodifierkey name="Jeraziah_W_AuraOff" entity="this_entity" />
	</onimpact>
	
	<aura name="jeraziahaura" state="State_Jeraziah_Ability2_Aura" radius="350" effecttype="Debuff" targetscheme="enemy_units" propagatecondition="not_stealthed" disablenegativeeffectpopuponrefresh="true" />
	
	<modifier key="Jeraziah_W_AuraOff" modpriority="100">
		<aura name="jeraziahaura" state="State_Jeraziah_Ability2_Aura" radius="0" effecttype="Debuff" targetscheme="nothing" notooltip="true" propagatecondition="not_stealthed" />
	</modifier>

	<!-- Midwars-only changes -->
	<modifier key="OnlyMidMap" modpriority="101"
		cooldowntime="30000"
	>
		<onimpact>
			<dispel type="StatusDebuff" />
			<applystate name="State_Jeraziah_Ability2" duration="5000" proxy="this_entity" />
			<setactivemodifierkey name="Jeraziah_W_AuraOff" entity="this_entity" />
		</onimpact>
	</modifier>
</ability>
