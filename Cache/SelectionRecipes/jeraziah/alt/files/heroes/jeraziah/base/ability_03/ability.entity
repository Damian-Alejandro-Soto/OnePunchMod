<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Jeraziah3"
	
	icon="../../icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"
	passiveeffect=""
	
	actiontype="passive"
	
	cooldowntime="5000"
	dynamicprecache="effects/impact.effect"
>
	<onattackstart>
		<!-- E attack animation -->
		<isready>
			<playanim name="ability_3" speed="source_attackspeed" target="source_entity" />
		</isready>
	</onattackstart>
	
	<onattackimpact>
		<canactivate>
			<cantarget targetscheme="enemy_units" effecttype="">
				<applystate name="State_Jeraziah_Ability3" duration="2000" />
				
				<!-- Damage -->
				<targettype type="illusion" target="source_entity">
					<evaluate a="1,1.25,1.5,1.75" b="source_strength" op="mult" />
					<damage amount="0.33" b="result" op="mult" />
					<popup name="bonus_damage" a="result" source="target_entity" />
				</targettype>
				<else>
					<damage amount="1,1.25,1.5,1.75" b="source_strength" op="mult" />
					<popup name="bonus_damage" a="result" source="target_entity" />
				</else>				
				
				<!-- Cleave -->
				<targettype type="illusion" target="source_entity">
					<evaluate a="1,1.25,1.5,1.75" b="source_strength" op="mult" />
					<evaluate a="result" b="total_adjusted_damage" op="add" />
					<evaluate a="result" b="0.30" op="mult" /> <!-- Cleave damage % -->
					<evaluate a="result" b="0.33" op="mult" />
					<spawnaffector name="Affector_Jeraziah_Ability3" target="target_position" ignore="target_entity" positionmodifier="pointonline" positionorigin="source_entity" positionvalue="250" param="result" />
				</targettype>
				<else>
					<evaluate a="1,1.25,1.5,1.75" b="source_strength" op="mult" />
					<evaluate a="result" b="total_adjusted_damage" op="add" />
					<evaluate a="result" b="0.30" op="mult" /> <!-- Cleave damage % -->
					<spawnaffector name="Affector_Jeraziah_Ability3" target="target_position" ignore="target_entity" positionmodifier="pointonline" positionorigin="source_entity" positionvalue="250" param="result" />
				</else>			
				
				<!-- VFX -->
					<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
					<exists path="str0">
						<playeffectdynamic effect="str0" source="target_entity" />
					</exists>
					<else>
						<playeffectdynamic effect="effects/impact.effect" source="target_entity" />
					</else>
				<startcooldown />
			</cantarget>
		</canactivate>
	</onattackimpact>
	
	<modifier key="ready" modpriority="90" condition="ready"
		passiveeffect="/heroes/jereziah/hd_alt/ability_03/effects/active.effect"
	>
	</modifier>
	
	<modifier key="iamsheeped" modpriority="1001"
		passiveeffect=""
	/>
</ability>
