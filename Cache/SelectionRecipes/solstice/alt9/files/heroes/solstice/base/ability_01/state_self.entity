<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Solstice_Ability1_Self"
	
	icon="../../icon.dds"
	passiveeffect="/heroes/solstice/alt9/ability_01/effects/state_charge.effect"
	
	movespeed="350"

	unitwalking="true"
	treewalking="true"
	perplexed="true"
	
	effecttype=""
	allowtransfer="false"
	
	modifierkey="SolsticeAbility1Charging"
>
	<oninflict>
		<spawnaffector name="Affector_Solstice_Ability1" target="source_entity" pushentity="true" />
		<setproxy entity="this_entity" target="stack_entity" />			
	</oninflict>
	
	<onframe>
		<condition target="source_entity" test="hastrait stunned or hastrait immobilized or hastrait restrained">
			<expire />
			<delete target="this_proxy_entity" source="" />
		</condition>
	</onframe>
	
	<onexpired>
		<delete target="this_proxy_entity" source="" />
		<compare a="accumulator" b="1" op="eq">
			<targettype type="alive" target="source_entity">
				<playanim name="idle" />
			</targettype>
		</compare>
	</onexpired>
</state>