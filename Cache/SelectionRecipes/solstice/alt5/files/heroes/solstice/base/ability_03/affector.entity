<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Solstice_Ability3"

	radius="250"
	arc="180"
	
	maximpactspertarget="1"
	targetselection="all"
	targetscheme="enemy_units"
	effecttype="Physical"
	
	effect=""
	impacteffect="/heroes/solstice/alt5/ability_03/effects/day_cleave_impact.effect"
>
	<onimpact>
		<!-- Damage -->
		<setvar0 a="55,75,100,125" />
		
		<cantarget targetscheme="enemy_heroes">
			<damage effecttype="Physical" amount="1" b="var0" op="mult" /> 
			<calculatedamage amount="var0" effecttype="Physical" /> <!-- Calculate damage specifically for lifesteal -->
			<heal target="source_entity" a="0.10,0.15,0.20,0.25" b="result" op="mult" />
		</cantarget>
		<else>
			<setvar0 a="var0" b="2.2" op="mult" /> <!-- Bonus damage multiplier vs. creeps -->
			
			<damage effecttype="Physical" amount="1" b="var0" op="mult" />
			<calculatedamage amount="var0" effecttype="Physical" />
			<heal target="source_entity" a="0.10,0.15,0.20,0.25" b="result" op="mult" />
		</else>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100">
		<onimpact>
			<!-- Damage -->
			<setvar0 a="75,95,120,145" />

			<cantarget targetscheme="enemy_heroes">
				<damage effecttype="Physical" amount="1" b="var0" op="mult" /> 
				<calculatedamage amount="var0" effecttype="Physical" /> <!-- Calculate damage specifically for lifesteal -->
				<heal target="source_entity" a="0.25,0.3,0.35,0.4" b="result" op="mult" />
			</cantarget>
			<else>
				<setvar0 a="var0" b="2.2" op="mult" /> <!-- Bonus damage multiplier vs. creeps -->

				<damage effecttype="Physical" amount="1" b="var0" op="mult" />
				<calculatedamage amount="var0" effecttype="Physical" />
				<heal target="source_entity" a="0.25,0.3,0.35,0.4" b="result" op="mult" />
			</else>
		</onimpact>
	</modifier>
</affector>