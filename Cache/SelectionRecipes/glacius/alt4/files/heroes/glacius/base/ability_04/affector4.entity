<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Glacius_Ability4_4"

	radius="700"
	innerradiusoffset="520"
	arc="90"
	angle="270"
	
	impactinterval="400"
	impactdelay="300"
	maxintervals="99"
	maximpactsperinterval="1"
	targetselection="random_angle_distance"
	targetscheme="nothing"
 icon="/heroes/frosty/alt4/ability_04/icon.dds">
	<onimpact>
		<spawnaffector name="Affector_Glacius_Ability4_Burst" target="target_position" />
		
		<!-- VFX -->
		<setstr0 a="altavatar_path" b="effects/impacts.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impacts.effect" source="target_position" target="" occlude="true" />
		</else>
	</onimpact>
</affector>
