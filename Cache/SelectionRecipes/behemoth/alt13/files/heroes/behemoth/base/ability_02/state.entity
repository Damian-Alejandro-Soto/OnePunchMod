<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Behemoth_Ability2"

	icon="/heroes/behemoth/alt13/ability_02/icon.dds"
	passiveeffect=""
	
	basedamagemultiplier="1.25,2.0,2.75,3.5"
	
	effecttype="StatusBuff"
	allowtransfer="true"
	
	modifierkey="ability2_active"
	
	dynamicprecache="effects/impact.effect"
>
	<oninflict>
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<setscriptvalue name="impact_effect" value="str0" entity="this_entity" />
		</exists>
		<else>
			<setscriptvalue name="impact_effect" value="effects/impact.effect" entity="this_entity" />
		</else>
	</oninflict>
	
	<onattack>
		<!-- Dynamic visual effects -->
		<getscriptvalue name="impact_effect" destvar="str0" entity="this_entity" />
		<playeffectdynamic effect="str0" source="target_position" target="" occlude="true" /> 

		<expire />
	</onattack>
	
	<modifier key="ult_boost" modpriority="100"
		truestrike="true"
	>	
	</modifier>
</state>