<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_Behemoth_Ability2"

	gravity="10000"
	lifetime="650"
	useexactlifetime="true"

	modelscale="1.0"
	model=""
	
	canturn="false"
	flying="false"
	flyheight="0"
 dynamicprecache="/heroes/behemoth/alt14/ability_02/effects/cast.effect">
	<onspawn>
		<!-- Dynamic cast effect -->
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<setscriptvalue name="cast_effect" value="str0" entity="this_entity" />
		</exists>
		<else>
			<setscriptvalue name="cast_effect" value="effects/cast.effect" entity="this_entity" />
		</else>
	</onspawn>
		
	<onimpact>
		<applystate name="State_Behemoth_Ability2" duration="14000" target="source_entity" />
		
		<pushtool name="Ability_Behemoth3" />
		<setvar0 a="source_level" source="stack_entity" />
		<compare a="var0" b="0" op="gt" source="stack_entity">
			<spawnaffector name="Affector_Behemoth_Ability3" source="source_position" target="source_position" level="var0" />
		</compare>
		
		<!-- Dynamic visual effects -->
		<getscriptvalue name="cast_effect" destvar="str0" entity="this_entity" />
		<playeffectdynamic effect="str0" source="target_position" occlude="true" />
	</onimpact>
</projectile>
