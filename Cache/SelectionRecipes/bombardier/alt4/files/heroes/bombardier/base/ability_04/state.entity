<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Bombardier_Ability4"
	
	icon="/heroes/bomb/alt4/ability_04/icon.dds"
	passiveeffect=""

	ishidden="true"

	unitwalking="true"
	effecttype=""
	impactinterval="250"
	dynamicprecache="effects/bomb.effect,effects/cast.effect"
	
>
	<oninflict>
		<setaccumulator value="0" />
	</oninflict>
	
	<onimpact>
		<compare a="accumulator" b="0" op="eq">
			<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/cast.effect" target="source_entity" />
			</else>
			<setaccumulator value="1" />
		</compare>
		<spawnaffector name="Affector_Bombardier_Ability4" target="target_position" owner="this_inflictor_entity" source="target_entity" firsttarget="" />
	</onimpact>
</state>
