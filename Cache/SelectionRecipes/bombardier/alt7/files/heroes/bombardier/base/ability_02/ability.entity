<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Bombardier2"

	icon="../../icon.dds"
	statuseffecttooltip=""
	
	anim="ability_2"
	casttime="800"
	castactiontime="300"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="target_position"
	targetradius="300"
	targetmaterial="/shared/materials/area_cast_indicator.material"
	casteffecttype="Magic"
	targetscheme="enemy_units"

	manacost="85,95,105,115"
	cooldowntime="12000"

	range="700"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/area.effect,effects/cast.effect"
 casteffect="/heroes/bomb/alt7/ability_02/effects/cast_sound.effect">
	
	<onimpact>
		<spawnaffector name="Affector_Bombardier_Ability2" target="target_position" />
		<setstr0 a="altavatar_path" b="effects/area.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="target_position" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/area.effect" source="target_position" target="target_position" />
		</else>		
		<setstr0 a="altavatar_path" b="effects/cast.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="target_position" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/cast.effect" source="source_entity" target="target_position" />
		</else>
	</onimpact>
</ability>
