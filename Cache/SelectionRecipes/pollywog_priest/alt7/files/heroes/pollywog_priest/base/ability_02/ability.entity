<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_PollywogPriest2"

	statuseffecttooltip="State_PollywogPriest_Ability2"
	icon="/heroes/pollywogpriest/alt7/ability_02/icon.dds"
	
	anim="ability_2"
	casttime="0"
	castactiontime="0"
	casteffect="/heroes/pollywogpriest/alt7/ability_02/effects/cast.effect"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	frontqueue="true"

	actiontype="target_entity"
	targetscheme="enemy_units_and_self"
	casteffecttype="Magic"
	
	manacost="90,120,150,180"
	cooldowntime="13000"
	
	range="500"
	
	doubleactivate="true"

	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"

	targetpriorities="enemy_heroes"
	dynamicprecache="effects/impact.effect"
>
	<onimpact>
		<cantarget targetscheme="enemy_units">
			<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
		</else>
			<killillusions />
			<dispel type="StatusStealth" />
			<applystate name="State_PollywogPriest_Ability2" duration="1250,2000,2750,3500" />
			<breakchannel entity="target_entity" />	
	
			<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
		</else>
		</cantarget>	
		<else>
			<targettype type="self">
				<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
		</else>
				<applystate name="State_PollywogPriest_Ability2_Self" duration="1250,2000,2750,3500" />
				<breakchannel entity="target_entity" />

				<!-- Art -->
				<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_entity" target="" />
		</else>
			</targettype>
		</else>
	</onimpact>
</ability>
