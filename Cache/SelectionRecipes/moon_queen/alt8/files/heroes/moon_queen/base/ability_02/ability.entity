<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_MoonQueen2"

	icon="/heroes/krixi/alt8/ability_02/icon.dds"
	
	maxlevel="4"
	requiredlevel="1,3,5,7"

	casteffecttype="Physical"
	actiontype="no_target"
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"

	cooldowntime="1000"
	
	targetradius="500"
	
	nosilence="true"
	nostun="true"
	noresponse="true"

>
	<onattackstart priority="90">
		<hasmodifier name="krosmode">
			<targettype type="melee" target="source_entity">
				<cantarget targetscheme="enemy_units">
					<setattackprojectile name="Projectile_MoonQueenAttack_HD" />
				</cantarget>
			</targettype>
		</hasmodifier>
	</onattackstart>

	<onimpact>
		<setactivemodifierkey name="Ability_MoonQueen2_active" entity="this_entity" />
	</onimpact>

	<onattackimpact
		priority="999"
		activateonbounces="true"
	>
		<targettype type="building">
			<bounce count="1,2,3,5" range="500" damagemult="0.5" targetscheme="visible_enemy_objects" seek="closest" maxbouncespertarget="1"/>
		</targettype>
		<else>
			<bounce count="1,2,3,5" range="500" damagemult="0.75" targetscheme="visible_enemy_objects" seek="closest" maxbouncespertarget="1"/>
		</else>
	</onattackimpact>
	
	<modifier key="Ability_MoonQueen2_active" condition="toggle_active" modpriority="100"
		icon="icon_b.tga"
	>
		<onattackimpact
			priority="999"
			activateonbounces="true"
		>
			<bounce count="1,2,3,5" range="500" damagemult="0.75" targetscheme="visible_enemy_heroes" seek="closest" maxbouncespertarget="1"/>
		</onattackimpact>

		<onimpact>
			<setactivemodifierkey name="" entity="this_entity" />
		</onimpact>

	</modifier>
</ability>