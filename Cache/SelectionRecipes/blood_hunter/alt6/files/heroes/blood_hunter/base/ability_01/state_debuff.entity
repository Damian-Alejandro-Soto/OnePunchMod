<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_BloodHunter_Ability1_Debuff"

	icon="../../icon.dds"
	
	passiveeffect="/heroes/hunter/alt6/ability_01/effects/state_debuff.effect"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
	
	silenced="true"

	negativeeffect="silenced"
	
	modifierkey="Hunter_Q_Active"
>
	<onframe>
		<damage effecttype="Magic DOT" amount="10,20,30,40" b="frametime" op="mult" />
	</onframe>
	
	<onattackedpreimpact>
		<compare a="this_proxy_entity" b="target_entity" op="eq">
			<cantarget targetscheme="enemy_units">
				<combatsupertype supertype="attack">
					<combateffecttype effecttype="Attack">
						<changeduration b="500" op="add" />
					</combateffecttype>
				</combatsupertype>
			</cantarget>
		</compare>
	</onattackedpreimpact>
</state>
