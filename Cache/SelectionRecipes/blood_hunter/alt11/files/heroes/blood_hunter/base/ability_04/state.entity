<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_BloodHunter_Ability4"

	icon="../../icon.dds"
	
	passiveeffect="/heroes/hunter/alt11/ability_04/effects/gush.effect"
	
	effecttype="ForceTransferrable"
	allowtransfer="true"
>
	
	<onframe>
		<distance source="this_proxy_entity" target="target_entity" />
		<setvar0 a="result" />
		<compare a="var0" b="2" op="gt">
			<hasmodifier name="Teleport_Channel_Aftereffect" entity="target_entity" />
			<else>
				<damage amount="0.40,0.60,0.80" b="var0" op="mult" effecttype="SuperiorMagic DOT" />
			</else>
			
			<teleport source="this_proxy_entity" target="target_position" noninterrupting="true" />
		</compare>
	</onframe>
</state>
