<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_Slither_Ability3"

	icon="../../icon.dds"
	passiveeffect="/heroes/ebulus/alt6/ability_03/effects/state.effect"
	
	deniable="true"
	healthregenreduction="0.2,0.4,0.6,0.8"
	movespeedslow="0.06,0.09,0.12,0.15"
	negativeeffect="slowed"
	
	effecttype="StatusDebuff"
	allowtransfer="true"
>
	<oninflict>
		<!-- Krosmode change -->
		<setaccumulator entity="this_proxy_entity" value="1" />
	</oninflict>

	<onexpired>
		<!-- Krosmode -->
		<setaccumulator entity="this_proxy_entity" value="0" />
	</onexpired>

	<onframe>
		<damage effecttype="Magic DOT" amount="6,12,18,24" b="frametime" op="mult"/>		
	</onframe>
	
	<onattackedpostimpact>
		<entitytype target="inflictor_entity" type="Projectile_SlitherWardAttack">
			<changeduration entity="this_entity" b="1000" op="add" />
		</entitytype>
	</onattackedpostimpact>
</state>
