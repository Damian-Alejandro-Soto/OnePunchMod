<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_Pharaoh_Ability1"

	radius="275"
	
	lifetime="10000"
	impactinterval="750"
	maximpactsperinterval="1"
	targetselection="random"
	targetscheme="visible_enemy_units"
	effecttype="Magic"
	
	effect="effects/self.effect"
 dynamicprecache="/heroes/mumra/alt7/ability_01/effects/impact.effect">
	<onspawn>
	</onspawn>
	
	<onimpact>
		<applystate name="State_Stunned_Static" duration="100"/>
		<damage effecttype="Magic" amount="25,50,75,100" />
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="target_entity" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" target="target_entity" source="target_entity" occlude="true" />
		</else>
	</onimpact>
</affector>
