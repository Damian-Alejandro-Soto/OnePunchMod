<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Vindicator4"

	icon="/heroes/vindicator/alt9/ability_04/icon.dds"
	statuseffecttooltip="State_Vindicator_Ability4"
	
	anim="ability_4"
	casttime="500"
	castactiontime="200"
	
	casteffect=""

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="self_position"
	targetscheme="enemy_heroes"
	
	casteffecttype="SuperiorMagic"
	
	manacost="175,225,275"
	cooldowntime="125000"
	ignoreinvulnerable="true"
	
	maxcharges="30,40,50"
	dynamicprecache="effects/vo.effect,effects/pages.effect"
	
>
	<onlearn>
		<setcharges a="30" />
	</onlearn>
	
	<onupgrade>
		<isready>
			<compare a="charges" b="30,40,50" op="lt">
				<starttimer duration="4500" />
			</compare>
		</isready>
	</onupgrade>
	
	<onready>
		<!-- Base silence duration of 2/2.5/3 seconds -->
		<setcharges a="20,25,30" />
		<starttimer duration="4500" />
	</onready>
	
	<onaction>
		<setstr0 a="altavatar_path" b="effects/vo.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="source_entity" target="this_owner_entity" ignoreculling="true" occlude="false" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/vo.effect" source="source_entity" target="this_owner_entity" ignoreculling="true" occlude="false" />
		</else>
			<setstr0 a="altavatar_path" b="effects/pages.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="source_entity" source="source_entity" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/pages.effect" target="source_entity" source="source_entity" />
			</else>
	</onaction>
	
	<onimpact>
		<areaofeffect
				global="true"
				targetselection="all"
				targetscheme="enemy_heroes"
				effecttype="StatusDebuff"
		>		
			<compare a="charges" b="50" op="ge">
				<delayannouncer duration="5000" source="target.entity" sourceonly="true" teamonly="false" />
			</compare>
			<else>
				<compare a="charges" b="40" op="ge">
					<delayannouncer duration="4000" source="target.entity" sourceonly="true" teamonly="false" />
				</compare>
				<else>
					<compare a="charges" b="30" op="ge">
						<delayannouncer duration="3000" source="target.entity" sourceonly="true" teamonly="false" />
					</compare>
					<else>
						<delayannouncer duration="3000" source="target.entity" sourceonly="true" teamonly="false" />
					</else>
				</else>
			</else>
			<!-- Silence_Duration = (100 * Charges) ms -->
			<setvar0 a="charges" b="100" op="mult" target="source_entity" />		
			<applystate name="State_Vindicator_Ability4" duration="var0" pushentity="true" />
			<!-- Slow duration = 1s -->
			<evaluate a="var0" b="1000" op="sub" />
			<setaccumulator value="result" entity="stack_entity" />
		</areaofeffect>
	</onimpact>
	
	<ontimer>
		<addcharges count="1" />
		<compare a="charges" b="30,40,50" op="lt">
			<starttimer duration="4500" />
		</compare>
	</ontimer>
	
	<oncomplete>
		<setcharges a="0" />
		<resettimer />
	</oncomplete>
</ability>