<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Kinesis4"
	
	statuseffecttooltip="State_Kinesis_Ability4"
	icon="/heroes/kenisis/alt2/ability_04/icon.dds"
	
	anim="ability_1"
	casttime="540"
	castactiontime="300"

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="no_target"
	targetscheme="all_nonhero_units_and_trees"
	targetradius="250"
	targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	
	casteffecttype="Magic"
	
	manacost="150,200,250"
	cooldowntime="90000,80000,70000"
	
	range="750"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	showrangeandradiusintooltip="true"
	dynamicprecache="effects/initial_impact_tree.effect,effects/aoe_impact.effect"
>
	<onimpact>
		<setaccumulator value="0" />
		<areaofeffect
			center="source_entity"
			radius="1000"
			targetscheme="all_willing_nonhero_units_and_trees"
			targetselection="closest"
			includetrees="true"
			ignoreinvulnerable="false"
			maxtotalimpacts="3,5,7"
			maximpactspertarget="1"
		>	
			<unbind />
			
			<!-- Determine which gadget to spawn -->
			<cantarget targetscheme="trees">
				<spawnunit name="Gadget_Kinesis4_Tree" target="target_position" pushentity="true" />
				<applystate name="State_Kinesis_Ability4_Tree" duration="8000" target="stack_entity" proxy="stack_entity" />
				<killtrees />
			</cantarget>
			<else>
				<spawnunit name="Gadget_Kinesis4" target="target_position" mount="target_entity" pushentity="true" proxy="target_entity" />
				<applystate name="State_Kinesis_Ability4_Tree" duration="8000" target="stack_entity" proxy="stack_entity" />
				<applystate name="State_Kinesis_Ability4" duration="8000" proxy="stack_entity" />
			</else>
			<setaccumulator value="accumulator" valueb="1" valueop="add" />
		</areaofeffect>
		
		<!-- Generate lifted trees equal to the difference between the number of found targets & max number of units lifted -->
		<setvar0 a="3,5,7" />
		<while test="var0 gt accumulator">
			<random min="0" max="360" />
			<evaluate a="result" b="180" op="sub" />
			<spawnunit name="Gadget_Kinesis2_Tree" target="this_owner_position" angle="result" pushentity="true" />
			<setpos0 position="stack_entity" offsetspace="stack_entity" offset="0 -300 0" />
			<teleport source="stack_entity" target="pos0" />
			<applystate name="State_Kinesis_Ability2_Tree" duration="8000" target="stack_entity" proxy="stack_entity" />
			<changeaccumulator b="1" op="add" />
		</while>

		<applystate name="State_Kinesis_Ability4_Modifier" target="source_entity" duration="8000" />
		<starttimer duration="8000" />
	</onimpact>
	
	<modifier key="Kinesis_ult_secondary" modpriority="100"
		ignorecooldown="true"
		icon="icon_b.tga"
		anim="ability_4_throw"
		noresponse="true"
		
		range="750"
		manacost="0"
		casttime="0"
		castactiontime="0"
		cooldowntime="0"

		actiontype="target_position"
		targetscheme="all_willing_nonhero_units_and_trees"
		targetmaterial="/shared/materials/area_cast_indicator_pointed.material"
	>
		<activatecost>
			<setaccumulator value="0" />
			<areaofeffect
				center="source_entity"
				radius="1200"
				targetscheme="KinesisLiftedTargets"
				targetselection="all"
				ignoreinvulnerable="true"
				maximpactspertarget="1"
			>
				<hasmodifier name="Kinesis_Launched" entity="target_entity" />
				<else>
					<setaccumulator value="1" />
				</else>
			</areaofeffect>
			<compare a="accumulator" b="0" op="eq" >
				<invalidate />
			</compare>
			<setaccumulator value="0" />
		</activatecost>
		
		<onimpact>
			<setpos0 position="target_position" />
			<areaofeffect
				center="source_entity"
				radius="1200"
				targetscheme="KinesisLiftedTargets"
				targetselection="closest"
				ignoreinvulnerable="true"
				maximpactspertarget="1"
			>		
				<hasmodifier name="Kinesis_Lifted" entity="target_entity">
					<hasmodifier name="Kinesis_Launched" entity="target_entity" />
					<else>
						<unbind />
						
						<applystate name="State_Kinesis_Launched" duration="8000" target="target_entity" />

						<entitytype type="Gadget_Kinesis2_Tree">
							<spawnprojectile name="Projectile_Kinesis_Ability4_Tree" 
								source="target_position"
								target="pos0"
								bind="target_entity"
								bindstate="State_Kinesis_Ability4_Projectile"
								unbindondeath="true"
								noresponse="true"
								proxy="target_entity"
							/>
						</entitytype>
						<entitytype type="Gadget_Kinesis4_Tree">
							<spawnprojectile name="Projectile_Kinesis_Ability4_Tree" 
								source="target_position"
								target="pos0"
								bind="target_entity"
								bindstate="State_Kinesis_Ability4_Projectile"
								unbindondeath="true"
								noresponse="true"
								proxy="target_entity"
							/>
						</entitytype>
						<entitytype type="Gadget_Kinesis2">
							<pushentity entity="target_entity" />
							<unbind target="stack_proxy_entity" />
							<spawnprojectile name="Projectile_Kinesis_Ability4"
								source="target_position"
								target="pos0"
								bind="stack_proxy_entity"
								bindstate="State_Kinesis_Ability4_Projectile"
								unbindondeath="true"
								noresponse="true"
								proxy="stack_proxy_entity"
							/>
							<kill target="stack_entity" source="" />
						</entitytype>
						<entitytype type="Gadget_Kinesis4">
							<pushentity entity="target_entity" />
							<unbind target="stack_proxy_entity" />
							<spawnprojectile name="Projectile_Kinesis_Ability4" 
								source="target_position"
								target="pos0"
								bind="stack_proxy_entity"
								bindstate="State_Kinesis_Ability4_Projectile"
								unbindondeath="true"
								noresponse="true"
								proxy="stack_proxy_entity"
							/>
							<kill target="stack_entity" source="" />
						</entitytype>
					</else>
				</hasmodifier>
			</areaofeffect>
		
			<expirestate name="State_Kinesis_Ability4_Modifier" target="source_entity" />
			<resettimer />
		</onimpact>

		<oncomplete />

	</modifier>
</ability>
