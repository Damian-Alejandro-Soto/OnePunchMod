<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_LordSalforis4"

	icon="../../icon.dds"
	statuseffecttooltip="State_LordSalforis_Ability4"
	
	anim="ability_4"
	casttime="1000"
	castactiontime="350"
	casteffect="/heroes/dreadknight/alt5/ability_04/effects/stage1/cast.effect"
	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_entity"
	casteffecttype="SuperiorMagic"
	targetscheme="enemy_heroes"
	
	manacost="100,150,200"
	cooldowntime="80000,70000,60000"
	
	range="600"
	
	novoiceresponse="true"
	
	showareacast="true"
	areacastmaterial="/shared/materials/area_cast_indicator_spokes.material"
	
	maxcharges="10"

	dynamicprecache="effects/impact.effect"
>
	
	<onimpact>
		<applystate name="State_LordSalforis_Ability4" duration="12000" proxy="this_owner_entity" />
		
		<!-- Only art stuff below -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_position" target="target_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" source="target_position" target="target_position" occlude="true" />
		</else>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="99">		
		<onimpact>
			<applystate name="State_LordSalforis_Ability4" duration="12000" proxy="this_owner_entity" pushentity="true" />
			<addcharges entity="stack_entity" count="charges" />
			
			<!-- Only art stuff below -->
			<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" source="target_position" target="target_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact.effect" source="target_position" target="target_position" occlude="true" />
			</else>
		</onimpact>
	</modifier>
</ability>