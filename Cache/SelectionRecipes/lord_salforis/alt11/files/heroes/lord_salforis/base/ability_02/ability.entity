<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_LordSalforis2"
	
	statuseffectheader="true"
	icon="/heroes/dreadknight/alt11/ability_02/icon.dds"
	statuseffecttooltip="State_LordSalforis_Ability2"
	
	anim="ability_2"
	casttime="0"
	castactiontime="0"

	casteffect=""
	maxlevel="4"
	requiredlevel="1,3,5,7"

	actiontype="no_target"
	frontqueue="true"
	inheritmovement="true"
	nonaggressive="true"
	casteffecttype="Magic"
	targetscheme="enemy_units"

	manacost="60"
	cooldowntime="8000,7000,6000,5000"
	novoiceresponse="true"
	targetradius="275"

	dynamicprecache="effects/stomp.effect"
>
	<onimpact>
		<resetattackcooldown />
		<applystate name="State_LordSalforis_Ability2" target="source_entity" duration="5000" />
		
		<!-- Art -->
		<setstr0 a="altavatar_path" b="effects/stomp.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="source_position" source="source_position" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/stomp.effect" target="source_position" source="source_position" occlude="true" />
		</else>

		<areaofeffect
			radius="275"
			targetselection="all"
			targetscheme="enemy_units"
			effecttype="Magic"
		>
			<applystate name="State_LordSalforis_Ability2_Slow" duration="2000" />
		</areaofeffect>
	</onimpact>
	
	<modifier key="ult_boost" modpriority="100"
		cooldowntime="3000"
	>
		<onimpact>
			<resetattackcooldown />
			<applystate name="State_LordSalforis_Ability2" target="source_entity" duration="5000" />
			
			<!-- Art -->
			<setstr0 a="altavatar_path" b="effects/stomp.effect" op="add" />
			<exists path="str0">
				<playeffectdynamic effect="str0" target="source_position" source="source_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/stomp.effect" target="source_position" source="source_position" occlude="true" />
			</else>

			<areaofeffect
				radius="275"
				targetselection="all"
				targetscheme="enemy_units"
				effecttype="Magic"
			>
				<applystate name="State_LordSalforis_Ability2_Slow" duration="2000" />
			</areaofeffect>
		</onimpact>	
	</modifier>
</ability>