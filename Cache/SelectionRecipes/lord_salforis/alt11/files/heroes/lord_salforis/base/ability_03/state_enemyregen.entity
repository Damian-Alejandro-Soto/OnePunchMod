<?xml version="1.0" encoding="UTF-8"?>
<state
	name="State_LordSalforis_Ability3_EnemyRegen"

	icon="/heroes/dreadknight/alt11/ability_03/icon.dds"
	passiveeffect=""
	effecttype=""

>	
	<onframe>
		<!-- Reduce target's HP regen by 30/45/60/75% -->
		<evaluate a="target_healthregen_prereduction" b="-0.3,-0.45,-0.6,-0.75" op="mult" />
		<evaluate a="result" b="frametime" op="mult" />
		<changehealth a="result" ishealingovertime="true" />
	</onframe>
</state>
