<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Cthulhuphant3"

	icon="../../icon.dds"
	
	casttime="800"
	castactiontime="300"

	maxlevel="4"
	requiredlevel="1,3,5,7"
	
	passiveeffect="/heroes/cthulhuphant/ability_03/effects/state_trophy_skin03.effect"

	actiontype="passive"
	targetradius="2000"
	dynamicprecache="effects/reflect.effect"
>
	<onattackedpredamage>
		<!-- Distance constraint -->
		<distance />
		<compare a="result" b="2000" op="le">
			<cantarget targetscheme="enemy_units">
				<applystate name="State_Cthulhuphant_Ability3" target="target_entity" duration="100" />
			</cantarget>
		</compare>
	</onattackedpredamage>

	<ondamaged>
		<!-- Distance constraint -->
		<distance />
		<compare a="result" b="2000" op="le">
			<cantarget targetscheme="enemy_units">
				<!-- Front_Angle = 180 - Back_Angle -->
				<evaluate a="back_impact_angle" />
				<compare a="result" b="115" op="ge">
					<applystate name="State_Cthulhuphant_Ability3_Regen" target="source_entity" duration="2000" />
				</compare>
			
				<!-- Return Damage -->
				<currentdamageeffecttype effecttype="Returned" />
				<else>
					<damageeffecttype effecttype="DOT" />
					<else>
						<damageeffecttype effecttype="Physical">
							<!-- Return damage value -->
							<setvar0 a="source_strength" b="0.2,0.3,0.4,0.5" op="mult" />
							<targettype type="illusion" target="source_entity">
								<setvaro a="var0" b="0.33" op="mult" />
								<targettype type="hero">
									<damage effecttype="Physical Returned DOT" amount="1" b="var0" op="mult" />
								</targettype>
								<else>
									<damage effecttype="Physical Returned DOT" amount="2" b="var0" op="mult" />
								</else>
							</targettype>
							<else>
								<targettype type="hero">
									<damage effecttype="Physical Returned DOT" amount="1" b="var0" op="mult" />
								</targettype>
								<else>
									<damage effecttype="Physical Returned DOT" amount="2" b="var0" op="mult" />
								</else>
							</else>
							
							
							<!-- VFX -->
							<setstr0 a="altavatar_path" b="../ability_03/effects/reflect.effect" op="add" />
							<exists path="str0">
								<playeffectdynamic effect="str0" source="target_entity" />
							</exists>
							<else>
								<playeffectdynamic effect="../ability_03/effects/reflect.effect" source="target_entity" />
							</else>	
						</damageeffecttype>
						<else>
							<damageeffecttype effecttype="SuperiorPhysical">
								<!-- Return damage value -->
							<setvar0 a="source_strength" b="0.2,0.3,0.4,0.5" op="mult" />
							<targettype type="illusion" target="source_entity">
								<setvaro a="var0" b="0.33" op="mult" />
								<targettype type="hero">
									<damage effecttype="Physical Returned DOT" amount="1" b="var0" op="mult" />
								</targettype>
								<else>
									<damage effecttype="Physical Returned DOT" amount="2" b="var0" op="mult" />
								</else>
							</targettype>
							<else>
								<targettype type="hero">
									<damage effecttype="Physical Returned DOT" amount="1" b="var0" op="mult" />
								</targettype>
								<else>
									<damage effecttype="Physical Returned DOT" amount="2" b="var0" op="mult" />
								</else>
							</else>
								
								<!-- Same VFX -->
								<setstr0 a="altavatar_path" b="../ability_03/effects/reflect.effect" op="add" />
								<exists path="str0">
									<playeffectdynamic effect="str0" source="target_entity" />
								</exists>
								<else>
									<playeffectdynamic effect="../ability_03/effects/reflect.effect" source="target_entity" />
								</else>
							</damageeffecttype>
						</else>					
					</else>
				</else>
			</cantarget>
		</compare>
	</ondamaged>

	<modifier key="ult_boost" modpriority="100" />
	
</ability>
