<?xml version="1.0" encoding="UTF-8"?>
<affector
	name="Affector_MonkeyKing_Ability3"

	radius="200"
	
	lifetime="800"
	maximpactspertarget="1"
	targetselection="all"
	targetscheme="enemy_units"
	effecttype="Magic"
	persist="true"
	effect=""
 dynamicprecache="/heroes/monkey_king/alt16/ability_03/effects/impact_enemy.effect">

	<onspawn>
	</onspawn>
	
	<onimpact>
		<unbind target="target_entity" />
		<applystate name="State_Stunned" duration="500" />
		<damage effecttype="Magic" amount="70,100,130,160" />
		<spawnprojectile name="Projectile_MonkeyKing_Ability3_Toss" source="target_entity" target="target_entity" bind="target_entity" ignoretargetoffset="true" noresponse="true" />
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/impact_enemy.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" source="target_entity" target="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact_enemy.effect" source="target_entity" target="target_entity" occlude="true" />
		</else>
	</onimpact>
	
</affector>
