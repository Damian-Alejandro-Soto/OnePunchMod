<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_MonkeyKing_Ability1_2"

	speed="1500"
	gravity="0"

	modelscale="1.0"
	model="/shared/models/invis.mdf"
	traileffect="/heroes/monkey_king/alt/ability_01/effects/trail_2.effect"
		
	canturn="false"
	flying="false"
	flyheight="0"
	
	touchradius="200"
	touchradiusdiradjust="true"
	maxtouchespertarget="1"
	touchtargetscheme="enemy_units"
	toucheffecttype=""
	impacteffect=""
 dynamicprecache="/heroes/monkey_king/ability_01/effects/second_impact.effect,../alt/ability_01/effects/second_impact_image.effect">
	<onspawn>
	</onspawn>
	
	<ontouch>
		<!-- Last dash of Illusive Dash for SotM -->
		<hasmodifier name="ult_boost">
			<evaluate a="15,30,45,60" b="source_attackdamage" op="add" />
			<damage effecttype="Physical" amount="0.7" b="result" op="mult" />
		</hasmodifier>
		<else>
			<evaluate a="15,30,45,60" b="source_attackdamage" op="add" />
			<damage effecttype="Physical" amount="1" b="result" op="mult" />
		</else>
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/second_impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="target_entity" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/second_impact.effect" target="target_entity" source="target_entity" occlude="true" />
		</else>
		<cantarget targetscheme="enemy_heroes">
			<setstr1 a="altavatar_path" b="effects/second_impact_image.effect" op="add" />
			<exists path="str1">
				<playeffectdynamic effect="str1" target="source_position" source="source_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/second_impact_image.effect" target="source_position" source="source_position" occlude="true" />
			</else>
		</cantarget>
	</ontouch>

</projectile>
