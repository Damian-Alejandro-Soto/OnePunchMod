<?xml version="1.0" encoding="UTF-8"?>
<projectile
	name="Projectile_MonkeyKing_Ability1_1"

	speed="1500"
	gravity="0"

	modelscale="1.0"
	model="/shared/models/invis.mdf"
	traileffect="/heroes/monkey_king/alt5/ability_01/effects/trail_1.effect"
		
	canturn="false"
	flying="false"
	flyheight="0"
	
	touchradius="200"
	touchradiusdiradjust="true"
	maxtouchespertarget="1"
	touchtargetscheme="enemy_units"
	toucheffecttype=""
	impacteffect=""
 dynamicprecache="/heroes/monkey_king/ability_01/effects/impact.effect,../alt5/ability_01/effects/impact_image.effect">
	<onspawn>
	</onspawn>
	
	<ontouch>
		<damage effecttype="Physical" amount="15,30,45,60" b="source_attackdamage" op="add" />
		
		<!-- Dynamic visual effects -->
		<setstr0 a="altavatar_path" b="effects/impact.effect" op="add" />
		<exists path="str0">
			<playeffectdynamic effect="str0" target="target_entity" source="target_entity" occlude="true" />
		</exists>
		<else>
			<playeffectdynamic effect="effects/impact.effect" target="target_entity" source="target_entity" occlude="true" />
		</else>
		<cantarget targetscheme="enemy_heroes">
			<setstr1 a="altavatar_path" b="effects/impact_image.effect" op="add" />
			<exists path="str1">
				<playeffectdynamic effect="str1" target="source_position" source="source_position" occlude="true" />
			</exists>
			<else>
				<playeffectdynamic effect="effects/impact_image.effect" target="source_position" source="source_position" occlude="true" />
			</else>
		</cantarget>
		
		<setparam a="1" />
	</ontouch>
	
	<ondeath>
		<hasmodifier name="monkeyKing_Q_expired" entity="this_entity" />
		<else>
			<compare a="param" b="1" op="eq">
				<starttimer duration="2000" entity="this_proxy_entity" />
				<applystate name="State_MonkeyKing_Ability1" target="source_entity" duration="2000" />
			</compare>
			<else>
				<applystate name="State_MonkeyKing_Ability1" target="source_entity" pushentity="true" />
				<setaccumulator value="1" entity="stack_entity" />
				<expirestate name="State_MonkeyKing_Ability1" target="source_entity" />
			</else>
		</else>
		
		<!-- Kinesis Thoughtsteal accommodation -->
		<pushtool name="Ability_MonkeyKing1" />
		<deactivatemodifierkey name="monkeyking_Q_disabled" entity="stack_entity" />
	</ondeath>
</projectile>
