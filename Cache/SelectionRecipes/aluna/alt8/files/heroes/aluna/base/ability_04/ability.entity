<?xml version="1.0" encoding="UTF-8"?>
<ability
	name="Ability_Aluna4"
	
	icon="/heroes/aluna/alt8/ability_04/icon.dds"
	anim="ability_4"
	
	casttime="0"
	castactiontime="0"

	maxlevel="3"
	requiredlevel="6,11,16"

	actiontype="target_self"
	targetscheme=""
	
	casteffecttype="SuperiorMagic"
	casteffect=""
	
	manacost="50"
	cooldowntime="60000"
	
	statuseffecttooltip="State_Aluna_Ability4"
	
	frontqueue="true"
	inheritmovement="true"
	noninterrupting="true"
	nobreakchannel="true"
	nonaggressive="true"
	
	noshuffle="true"
>

	<onimpact>
		<applystate name="State_Aluna_Ability4" target="source_entity" duration="10000" pushentity="true" />
		
		<pushtool name="Ability_Aluna2" />
		<setcharges a="0,1,2" entity="stack_entity" />
		
		<!-- Since level 1 grants 0 charges to Power Throw, this ability should only be activated if R is higher than level 1 -->
		<compare a="level" b="1" op="gt">
			<activatemodifierkey name="aluna_red_PowerThrow" entity="stack_entity" />
		</compare>
	</onimpact>

</ability>